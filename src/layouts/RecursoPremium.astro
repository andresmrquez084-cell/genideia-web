---
// Molde Premium para guías largas de Andrés Albornoz (lead magnets).
// Autocontenido a propósito (su propio <html>): se ve igual en pantalla, en celular y impreso a PDF.
// El contenido de cada guía va en el <slot/>; la marca, el índice, la barra de lectura y el cierre salen de acá.
interface Props {
  titulo: string;
  descripcion: string;
  tipo?: string;
  barLabel?: string;
  palabraClave?: string;
  chips?: string[];
  indice?: { id: string; label: string }[];
  mclassUrl?: string;
  mclassBullets?: string[];
}
const {
  titulo,
  descripcion,
  tipo = 'Guía',
  barLabel = 'Guía · @andresalbornoz.ai',
  palabraClave,
  chips = [],
  indice = [],
  mclassUrl,
  mclassBullets = [
    'Guías y prompts nuevos, antes que en ningún lado',
    'Clases grabadas para aprender Claude desde cero',
    'Resuelvo dudas puntuales de lo que estés armando',
    'Aviso primero de todo lo nuevo',
  ],
} = Astro.props;

const WA = '59892302941';
const waUrl = `https://wa.me/${WA}?text=${encodeURIComponent(`Hola Andrés, vi "${titulo}" y quiero preguntarte algo. Te cuento:`)}`;
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() ?? 'recurso';
const empresaUrl = `https://andres.genideiacompany.com/?utm_source=recurso&utm_medium=lead-magnet&utm_content=${slug}`;
const canonical = `https://andres.genideiacompany.com${Astro.url.pathname}`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} — Andrés Albornoz · GENIDEIA</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="article" />
  <meta property="og:image" content="https://genideiacompany.com/og-genideia.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0A0F1A" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Poppins:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <noscript><style>.pane[hidden]{display:block!important}</style></noscript>
  <style is:global>
    :root{--bg:#0A0F1A;--tx:#F2F4F7;--tx2:#B8BEC7;--tx3:#7E8796;--line:rgba(255,255,255,.08);--line2:rgba(255,255,255,.14);--p:#007BFF;--s:#00C8FF;--sl:#BFEFFF;--ok:#4BE39A;--warn:#FFB454;--bad:#FF6B7A;--display:Montserrat,system-ui,sans-serif;--sans:Poppins,system-ui,sans-serif;--mono:"JetBrains Mono",ui-monospace,monospace;--ease:cubic-bezier(.2,.8,.2,1)}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:90px;-webkit-text-size-adjust:100%}
    body{margin:0;background:var(--bg);color:var(--tx);font:300 16px/1.7 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip}
    a{color:var(--s)}
    code{font-family:var(--mono);font-size:.88em;padding:2px 7px;border-radius:7px;background:rgba(0,200,255,.1);color:var(--sl);overflow-wrap:anywhere}

    /* fondo */
    .amb{position:fixed;inset:0;z-index:-2;overflow:hidden;pointer-events:none}
    .amb i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.55}
    .amb .b1{width:620px;height:620px;left:-180px;top:-200px;background:radial-gradient(circle,rgba(0,123,255,.5),transparent 68%);animation:d1 26s ease-in-out infinite alternate}
    .amb .b2{width:560px;height:560px;right:-200px;top:18%;background:radial-gradient(circle,rgba(0,200,255,.3),transparent 70%);animation:d2 30s ease-in-out infinite alternate}
    @keyframes d1{to{transform:translate(120px,100px)}}@keyframes d2{to{transform:translate(-100px,140px)}}
    .grain{position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.06;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
    .readbar{position:fixed;top:0;left:0;right:0;height:3px;z-index:60;background:linear-gradient(90deg,var(--p),var(--s));transform:scaleX(0);transform-origin:left}

    /* barra superior */
    .bar{position:sticky;top:10px;z-index:50;width:min(920px,calc(100% - 24px));margin:10px auto 0;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 10px 8px 14px;border-radius:999px;background:rgba(13,20,36,.72);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:inset 0 0 0 1px var(--line),0 20px 50px -30px rgba(0,0,0,.8)}
    .bb{display:flex;align-items:center;gap:10px;color:var(--tx);text-decoration:none;min-width:0}
    .bb img{width:32px;height:32px;border-radius:50%;box-shadow:0 0 18px -4px rgba(0,140,255,.8)}
    .bb span{font:500 11.5px var(--mono);color:var(--tx2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .btn,.bar button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 20px;border:0;border-radius:999px;font:600 14px var(--sans);color:#fff;text-decoration:none;cursor:pointer;background:linear-gradient(135deg,var(--p),var(--s));box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 10px 30px -10px rgba(0,123,255,.8);transition:transform .2s var(--ease),box-shadow .3s}
    .btn:hover,.bar button:hover{transform:translateY(-2px)}
    .btn.g{background:rgba(255,255,255,.06);box-shadow:inset 0 0 0 1px var(--line2);color:var(--tx)}

    /* hero */
    .wrap{width:min(920px,calc(100% - 32px));margin:0 auto}
    .hero{padding:56px 0 28px}
    .kicker{display:inline-flex;align-items:center;gap:9px;font:500 11.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--s)}
    .kicker::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--s);box-shadow:0 0 10px var(--s)}
    h1{font:600 clamp(32px,6vw,56px)/1.06 var(--display);letter-spacing:-.035em;margin:14px 0 14px;text-wrap:balance}
    h1 em{font-style:normal;background:linear-gradient(90deg,#5FB4FF,var(--s) 60%,#9FF0FF);-webkit-background-clip:text;background-clip:text;color:transparent}
    .lead{font-size:clamp(17px,2.3vw,20px);line-height:1.65;color:var(--tx2);max-width:680px;margin:0 0 20px}
    .by{font:400 12.5px var(--mono);color:var(--tx3)}.by b{color:var(--sl);font-weight:500}
    .chips{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 0}
    .chip{padding:8px 14px;border-radius:999px;font:500 12.5px var(--sans);color:var(--sl);background:rgba(0,200,255,.08);box-shadow:inset 0 0 0 1px rgba(0,200,255,.25)}

    /* índice */
    .toc{margin:8px 0 8px;padding:20px 22px;border-radius:22px;background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.015));box-shadow:inset 0 0 0 1px var(--line)}
    .toc b{display:block;font:500 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--tx3);margin-bottom:10px}
    .toc ol{list-style:none;counter-reset:t;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 22px}
    .toc li{counter-increment:t}
    .toc a{display:flex;gap:10px;align-items:baseline;padding:6px 0;color:var(--tx2);text-decoration:none;font-size:14.5px}
    .toc a::before{content:counter(t,decimal-leading-zero);font:500 11px var(--mono);color:var(--s)}
    .toc a:hover{color:var(--tx)}

    /* contenido */
    .doc{padding:8px 0 40px}
    .doc h2{font:600 clamp(24px,3.4vw,32px)/1.15 var(--display);letter-spacing:-.03em;margin:54px 0 14px;text-wrap:balance}
    .doc h2 .n{display:inline-grid;place-items:center;min-width:36px;height:36px;margin-right:10px;border-radius:12px;font:600 15px var(--display);color:#fff;background:linear-gradient(135deg,var(--p),var(--s));box-shadow:0 8px 24px -8px rgba(0,123,255,.8);vertical-align:middle}
    .doc h3{font:600 18px/1.3 var(--display);margin:26px 0 8px}
    .doc p{margin:0 0 14px;color:var(--tx2)}
    .doc p b,.doc li b{color:var(--tx);font-weight:500}
    .card{padding:22px 24px;border-radius:22px;background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.015));box-shadow:inset 0 0 0 1px var(--line),0 30px 70px -40px rgba(0,0,0,.85);margin:16px 0}
    .card>:last-child{margin-bottom:0}

    .steps{list-style:none;counter-reset:s;margin:14px 0;padding:0;display:grid;gap:10px}
    .steps li{counter-increment:s;display:grid;grid-template-columns:34px minmax(0,1fr);gap:14px;align-items:start;padding:14px 16px;border-radius:16px;background:rgba(255,255,255,.03);box-shadow:inset 0 0 0 1px var(--line);color:var(--tx2)}
    .steps li::before{content:counter(s);display:grid;place-items:center;width:30px;height:30px;border-radius:10px;font:600 13px var(--mono);color:var(--sl);background:rgba(0,200,255,.1);box-shadow:inset 0 0 0 1px rgba(0,200,255,.3)}
    .steps li>div>:last-child{margin-bottom:0}

    .check{list-style:none;margin:14px 0;padding:0;display:grid;gap:8px}
    .check li{display:grid;grid-template-columns:26px minmax(0,1fr);gap:12px;align-items:start;padding:12px 14px;border-radius:14px;background:rgba(255,255,255,.03);box-shadow:inset 0 0 0 1px var(--line);cursor:pointer;color:var(--tx2);transition:background .2s}
    .check li::before{content:"";width:22px;height:22px;border-radius:7px;box-shadow:inset 0 0 0 1.5px var(--line2);transition:all .2s}
    .check li.on{background:rgba(75,227,154,.06)}
    .check li.on::before{background:var(--ok) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%230A0F1A' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.5l4.5 4.5L19 7'/></svg>") center/14px no-repeat;box-shadow:none}
    .check li b{display:block}

    .codewrap{position:relative;margin:12px 0 16px}
    pre.code{margin:0;padding:18px 96px 18px 18px;border-radius:16px;background:#070b14;box-shadow:inset 0 0 0 1px var(--line);overflow-x:auto;font:400 13.5px/1.6 var(--mono);color:var(--tx)}
    pre.code code{background:none;padding:0;color:inherit;font-size:inherit;overflow-wrap:normal;white-space:pre}
    .copy{position:absolute;top:10px;right:10px;min-height:32px;padding:0 14px;border:0;border-radius:999px;font:600 12px var(--sans);color:var(--sl);background:rgba(0,200,255,.12);box-shadow:inset 0 0 0 1px rgba(0,200,255,.3);cursor:pointer}
    .copy:hover{background:rgba(0,200,255,.22)}
    .codelabel{display:block;margin:14px 0 -4px;font:500 11px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--tx3)}

    .note{display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px;margin:16px 0;padding:15px 18px;border-radius:16px;background:rgba(0,200,255,.07);box-shadow:inset 0 0 0 1px rgba(0,200,255,.22);color:var(--tx2);font-size:15px}
    .note::before{content:"i";display:grid;place-items:center;width:24px;height:24px;border-radius:50%;font:600 13px var(--display);color:#fff;background:linear-gradient(135deg,var(--p),var(--s))}
    .note.warn{background:rgba(255,180,84,.07);box-shadow:inset 0 0 0 1px rgba(255,180,84,.3)}
    .note.warn::before{content:"!";background:var(--warn);color:#1a1205}
    .note.ok{background:rgba(75,227,154,.06);box-shadow:inset 0 0 0 1px rgba(75,227,154,.28)}
    .note.ok::before{content:"✓";background:var(--ok);color:#06150d}
    .note>div>:last-child,.note p:last-child{margin-bottom:0}.note b{color:var(--tx)}

    .tabs{display:flex;gap:6px;flex-wrap:wrap;margin:16px 0 0;padding:5px;border-radius:999px;width:max-content;max-width:100%;background:rgba(255,255,255,.04);box-shadow:inset 0 0 0 1px var(--line)}
    .tabs button{min-height:38px;padding:0 20px;border:0;border-radius:999px;font:500 14px var(--sans);color:var(--tx2);background:transparent;cursor:pointer}
    .tabs button[aria-selected=true]{color:#fff;background:linear-gradient(135deg,var(--p),var(--s));box-shadow:0 8px 22px -10px rgba(0,123,255,.9)}
    .pane{margin-top:14px}
    .js .pane[hidden]{display:none}

    .grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:14px 0}
    .mini{padding:16px 18px;border-radius:18px;background:rgba(255,255,255,.03);box-shadow:inset 0 0 0 1px var(--line)}
    .mini b{display:block;font:600 15px var(--display);margin-bottom:4px}
    .mini p{margin:0;font-size:14.5px}
    .mini code{display:inline-block;margin-bottom:6px}

    details{margin:10px 0;border-radius:16px;background:rgba(255,255,255,.03);box-shadow:inset 0 0 0 1px var(--line);overflow:hidden}
    summary{cursor:pointer;list-style:none;padding:15px 48px 15px 18px;position:relative;font:500 15.5px var(--sans);color:var(--tx)}
    summary::-webkit-details-marker{display:none}
    summary::after{content:"+";position:absolute;right:18px;top:50%;transform:translateY(-50%);font:400 22px var(--display);color:var(--s);transition:transform .25s}
    details[open] summary::after{transform:translateY(-50%) rotate(45deg)}
    details>div{padding:0 18px 16px;color:var(--tx2)}
    details>div>:last-child{margin-bottom:0}

    table.t{width:100%;border-collapse:separate;border-spacing:0;font-size:14.5px;margin:12px 0;border-radius:16px;overflow:hidden;box-shadow:inset 0 0 0 1px var(--line)}
    .t th{text-align:left;padding:11px 14px;font:500 11px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--tx3);background:rgba(255,255,255,.04)}
    .t td{padding:12px 14px;border-top:1px solid var(--line);color:var(--tx2);vertical-align:top}
    .t td:first-child{width:36%;color:var(--tx)}

    /* cierre */
    .mclass{margin:56px 0 0;padding:34px;border-radius:28px;background:radial-gradient(500px circle at 0 0,rgba(0,123,255,.28),transparent 60%),linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));box-shadow:inset 0 0 0 1px rgba(0,200,255,.28),0 40px 90px -50px rgba(0,120,255,.8)}
    .badge{display:inline-block;padding:6px 12px;border-radius:999px;font:500 11px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--sl);background:rgba(0,200,255,.1);box-shadow:inset 0 0 0 1px rgba(0,200,255,.3)}
    .mclass h3{font:600 clamp(22px,3vw,30px)/1.15 var(--display);letter-spacing:-.03em;margin:14px 0 8px}
    .mclass .sub{color:var(--tx2);margin:0 0 14px}
    .learn{list-style:none;margin:0 0 20px;padding:0;display:grid;gap:8px}
    .learn li{position:relative;padding-left:26px;color:var(--tx2)}
    .learn li::before{content:"✓";position:absolute;left:0;color:var(--ok);font-weight:600}
    .fineprint{margin:12px 0 0;font:400 12px var(--mono);color:var(--tx3)}
    .cta2{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;margin:18px 0 0;padding:20px 24px;border-radius:22px;background:rgba(255,255,255,.03);box-shadow:inset 0 0 0 1px var(--line)}
    .cta2 .q{font:600 17px var(--display)}.cta2 p{margin:4px 0 0;color:var(--tx2);font-size:14.5px;max-width:520px}
    .foot{text-align:center;margin:40px 0 50px;font:400 12px var(--mono);color:var(--tx3)}.foot a{color:var(--tx2)}

    .rj .doc h2,.rj .doc .card,.rj .doc .codewrap,.rj .doc .note,.rj .doc .steps,.rj .doc .check,.rj .doc details{opacity:0;transform:translateY(14px);transition:opacity .6s var(--ease),transform .6s var(--ease)}
    .rj .in{opacity:1!important;transform:none!important}

    .repo{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:16px;align-items:center;margin:8px 0 34px;padding:22px 24px;border-radius:24px;text-decoration:none;color:var(--tx);background:radial-gradient(420px circle at 0 0,rgba(0,200,255,.22),transparent 60%),linear-gradient(135deg,rgba(0,123,255,.2),rgba(255,255,255,.03));box-shadow:inset 0 0 0 1.5px rgba(0,200,255,.55),0 30px 70px -36px rgba(0,140,255,.9);transition:transform .25s var(--ease),box-shadow .3s}
    .repo:hover{transform:translateY(-3px);box-shadow:inset 0 0 0 1.5px var(--s),0 36px 80px -34px rgba(0,160,255,1)}
    .repo-ic{display:grid;place-items:center;width:56px;height:56px;border-radius:18px;background:#0b1424;color:#fff;box-shadow:inset 0 0 0 1px var(--line2)}
    .repo-t b{display:block;font:600 18px/1.3 var(--display);margin-bottom:4px}
    .repo-t small{display:block;color:var(--tx2);font-size:14px;line-height:1.5}
    .repo-go{display:inline-flex;align-items:center;min-height:44px;padding:0 20px;border-radius:999px;font:600 14px var(--sans);color:#fff;background:linear-gradient(135deg,var(--p),var(--s));box-shadow:0 10px 30px -10px rgba(0,123,255,.9);white-space:nowrap}
    .mclass.big{margin:64px 0 0;padding:44px 40px;border-radius:32px;box-shadow:inset 0 0 0 1.5px rgba(0,200,255,.6),0 50px 110px -48px rgba(0,140,255,1)}
    .mclass.big h3{font-size:clamp(28px,4vw,40px)}
    .mclass.big .sub{font-size:17px}
    .btn.xl{min-height:58px;padding:0 34px;font-size:17px}
    .expand{display:inline-flex;align-items:center;min-height:40px;padding:0 18px;margin:0 0 12px;border:0;border-radius:999px;font:600 13.5px var(--sans);color:var(--sl);background:rgba(0,200,255,.1);box-shadow:inset 0 0 0 1px rgba(0,200,255,.35);cursor:pointer}
    @media(max-width:700px){.repo{grid-template-columns:auto minmax(0,1fr)}.repo-go{grid-column:1/-1;justify-content:center}.mclass.big{padding:28px 20px}.btn.xl{width:100%}}
    @media(max-width:700px){
      .toc ol{grid-template-columns:1fr}.grid2{grid-template-columns:1fr}
      .hero{padding-top:40px}.card{padding:18px}.mclass{padding:24px 18px}
      .bar span{display:none}.bar button{padding:0 16px}
      pre.code{padding-right:18px;padding-top:50px}.copy{top:8px}
      .tabs{width:100%}.tabs button{flex:1;padding:0 8px}
      .t td:first-child{width:auto}
    }
    @media (prefers-reduced-motion:reduce){.amb i{animation:none}html{scroll-behavior:auto}.rj .doc *{transition:none!important}}
    @media print{
      body{background:#fff;color:#111;font-size:12px}.amb,.grain,.readbar,.bar,.copy,.tabs,.cta2{display:none!important}
      .card,.mini,.note,.steps li,.check li,details,.toc,.mclass{background:#fff!important;box-shadow:none!important;border:1px solid #ccc;color:#111}
      .doc p,.steps li,.check li,.note,.lead,.mini p,details>div,.t td{color:#222!important}
      h1,.doc h2,.doc h3,.doc p b{color:#111!important}h1 em{color:#007BFF;-webkit-text-fill-color:#007BFF;background:none}
      pre.code{background:#f4f6f8;color:#111;box-shadow:none;border:1px solid #ccc;white-space:pre-wrap}pre.code code{white-space:pre-wrap}
      .pane[hidden]{display:block!important}details>div{display:block}.rj .doc *{opacity:1!important;transform:none!important}
      a{color:#0050b3}.doc h2 .n{background:#007BFF}
    }
  </style>
</head>
<body>
  <div class="readbar" aria-hidden="true"></div>
  <div class="amb" aria-hidden="true"><i class="b1"></i><i class="b2"></i></div>
  <div class="grain" aria-hidden="true"></div>

  <header class="bar">
    <a class="bb" href="https://andres.genideiacompany.com/"><img src="/img/symbol-gii.png" alt="" width="32" height="32" /><span>{barLabel}</span></a>
    <button type="button" onclick="window.print()">Guardar en PDF</button>
  </header>

  <main class="wrap">
    <section class="hero">
      <div class="kicker">{tipo} · GENIDEIA</div>
      <h1><slot name="titulo">{titulo}</slot></h1>
      <p class="lead"><slot name="lead">{descripcion}</slot></p>
      <div class="by">Andrés Albornoz{palabraClave && (<Fragment> · palabra clave del DM: <b>{palabraClave}</b></Fragment>)}</div>
      {chips.length > 0 && (<div class="chips">{chips.map((c) => <span class="chip">{c}</span>)}</div>)}
    </section>

    {indice.length > 0 && (
      <nav class="toc" aria-label="Índice de la guía">
        <b>En esta guía</b>
        <ol>{indice.map((i) => <li><a href={`#${i.id}`}>{i.label}</a></li>)}</ol>
      </nav>
    )}

    <article class="doc">
      <slot />

      <section class="mclass big">
        <div class="badge">Comunidad gratuita</div>
        <h3>Sumate a la comunidad de Claude</h3>
        <p class="sub">Recursos, clases grabadas y dudas resueltas — todo gratis, todo en el grupo.</p>
        <ul class="learn">{mclassBullets.map((b) => <li>{b}</li>)}</ul>
        <a class="btn xl" href={mclassUrl ?? waUrl} target="_blank" rel="noopener noreferrer">Unirme al grupo →</a>
        <p class="fineprint">Es gratis — entrás y ya estás adentro.</p>
      </section>

      <aside class="cta2">
        <div>
          <div class="q">¿Tenés una empresa?</div>
          <p>Si no sabés si estás perdiendo dinero con las operaciones que se llevan a cabo, tengo algo para vos.</p>
        </div>
        <a class="btn g" href={empresaUrl}>Ver solución →</a>
      </aside>
    </article>
  </main>
  <p class="foot"><a href="https://genideiacompany.com/">GENIDEIA Company</a> · Montevideo, Uruguay</p>

  <script is:inline>
    (function () {
      var doc = document.documentElement;
      doc.classList.add('js');
      var bar = document.querySelector('.readbar');
      addEventListener('scroll', function () {
        var h = doc.scrollHeight - innerHeight;
        if (bar) bar.style.transform = 'scaleX(' + (h > 0 ? scrollY / h : 0) + ')';
      }, { passive: true });

      // Aparecen al bajar (no en impresión ni con movimiento reducido).
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var items = document.querySelectorAll('.doc h2,.doc .card,.doc .codewrap,.doc .note,.doc .steps,.doc .check,.doc details');
      if (!reduce && 'IntersectionObserver' in window) {
        doc.classList.add('rj');
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: 0.05 });
        items.forEach(function (el) { io.observe(el); });
        addEventListener('beforeprint', function () { items.forEach(function (el) { el.classList.add('in'); }); });
      }

      // Pestañas por sistema (Mac / Windows / Linux). Se recuerda la última elegida.
      var KEY = 'gii_guia_os';
      function getOs() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
      function setOs(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
      function guess() {
        var p = (navigator.userAgent || '') + ' ' + (navigator.platform || '');
        return /Mac/i.test(p) ? 'mac' : /Win/i.test(p) ? 'win' : /Linux|X11/i.test(p) ? 'linux' : 'mac';
      }
      function showOs(os) {
        document.querySelectorAll('[data-ostabs] button').forEach(function (b) { b.setAttribute('aria-selected', String(b.dataset.os === os)); });
        document.querySelectorAll('.pane[data-os]').forEach(function (p) { p.hidden = p.dataset.os !== os; });
      }
      if (document.querySelector('[data-ostabs]')) {
        showOs(getOs() || guess());
        document.querySelectorAll('[data-ostabs] button').forEach(function (b) {
          b.addEventListener('click', function () { setOs(b.dataset.os); showOs(b.dataset.os); });
        });
      }

      // Checklist que se puede tildar (se recuerda en este navegador).
      document.querySelectorAll('.check').forEach(function (ul, gi) {
        var k = 'gii_guia_check_' + location.pathname + '_' + gi, saved = [];
        try { saved = JSON.parse(localStorage.getItem(k) || '[]'); } catch (e) {}
        ul.querySelectorAll('li').forEach(function (li, i) {
          if (saved.indexOf(i) > -1) li.classList.add('on');
          li.addEventListener('click', function () {
            li.classList.toggle('on');
            var on = []; ul.querySelectorAll('li').forEach(function (x, j) { if (x.classList.contains('on')) on.push(j); });
            try { localStorage.setItem(k, JSON.stringify(on)); } catch (e) {}
          });
        });
      });

      document.querySelectorAll('[data-expand-all]').forEach(function (b) {
        b.addEventListener('click', function () {
          var all = document.querySelectorAll('details'); var open = !(all[0] && all[0].open);
          all.forEach(function (d) { d.open = open; });
          b.textContent = open ? 'Cerrar todas las respuestas' : 'Abrir todas las respuestas';
        });
      });
      // Botón "Copiar" de los bloques de código.
      document.querySelectorAll('.codewrap .copy').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var code = btn.parentElement.querySelector('code');
          var txt = code ? code.innerText : '';
          function ok() { var prev = btn.textContent; btn.textContent = '¡Copiado!'; setTimeout(function () { btn.textContent = prev; }, 1800); }
          if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(ok, function () { sel(code); });
          else sel(code);
          function sel(node) { var r = document.createRange(); r.selectNodeContents(node); var s = getSelection(); s.removeAllRanges(); s.addRange(r); btn.textContent = 'Seleccionado: copiá con Cmd/Ctrl+C'; }
        });
      });
    })();
  </script>
</body>
</html>
