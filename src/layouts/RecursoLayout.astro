---
// Molde ÚNICO de los recursos (lead magnets) de Andrés Albornoz.
// Cada recurso vive en src/pages/recursos/<slug>.astro y usa este layout:
// solo escribe su contenido en el <slot/>; la marca, el botón "Guardar en PDF"
// y el CTA final salen de acá. Cambiar un token en :root actualiza TODOS los recursos.
//
// Es autocontenido a propósito (su propio <html>, NO importa global.css) para que
// los estilos no choquen con el resto del sitio y el recurso se vea igual impreso a PDF.
interface Props {
  titulo: string;
  descripcion: string;
  tipo?: string;          // kicker, ej: "Mini-guía" · "Checklist" · "Prompt"
  barLabel?: string;      // etiqueta de la barra superior, ej: "Guía · @andresalbornoz.ai"
  palabraClave?: string;  // palabra clave del DM (ManyChat), ej: "AUTOMATIZAR"
  ctaTitulo?: string;
  ctaTexto?: string;
  ctaBtn?: string;
  waMsg?: string;
  masterclass?: boolean;   // true → reemplaza el CTA genérico por el bloque destacado de la masterclass
  mclassBullets?: string[];
  mclassUrl?: string;      // link del botón de la masterclass (ej: grupo de WhatsApp). Si no, usa el WhatsApp de Andrés.
}
const {
  titulo,
  descripcion,
  tipo = 'Recurso',
  barLabel = 'Recurso · @andresalbornoz.ai',
  palabraClave,
  // CTA genérico: el que llega por contenido orgánico es audiencia B2C (no el ICP).
  // La puerta para dueños de empresa es el bloque "¿Tenés una empresa?" → landing.
  ctaTitulo = '¿Tenés alguna duda o necesitás ayuda con algún proyecto o herramienta?',
  ctaTexto = 'Escribime por DM y contame qué estás intentando resolver.',
  ctaBtn = 'Click acá →',
  waMsg,
  masterclass = false,
  // La masterclass en vivo ya pasó (queda grabada en el grupo) — este bloque ya no vende
  // "un lugar en la clase", invita a sumarse a la comunidad donde se comparten recursos,
  // clases grabadas y se resuelven dudas (Andrés, 14/9).
  mclassBullets = [
    'Guías y prompts nuevos, antes que en ningún lado',
    'Clases grabadas para aprender Claude desde cero',
    'Resuelvo dudas puntuales de lo que estés armando',
    'Aviso primero de todo lo nuevo',
  ],
  mclassUrl,
} = Astro.props;

const WA = '59892302941';
const waFinal = waMsg ?? `Hola Andrés, vi "${titulo}" y quiero preguntarte algo. Te cuento:`;
const waUrl = `https://wa.me/${WA}?text=${encodeURIComponent(waFinal)}`;
const mclassHref = mclassUrl ?? waUrl;

// Puente al embudo de empresas: etiquetado por recurso para medir cuál convierte.
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() ?? 'recurso';
const empresaUrl = `/andres?utm_source=recurso&utm_medium=lead-magnet&utm_content=${slug}`;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} — Andrés Albornoz · GENIDEIA</title>
  <meta name="description" content={descripcion} />
  <meta name="robots" content="noindex" /><!-- no listado: solo entra quien tiene el link -->
  <meta property="og:title" content={`${titulo} — Andrés Albornoz`} />
  <meta property="og:description" content={descripcion} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Poppins:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <meta name="theme-color" content="#0A0F1A" />
  <style is:global>
    /* Formato premium (mismo sistema que la Academy y las propuestas). Las clases
       de contenido (.lead, .arrow, .steps, .codewrap...) no cambian: los 60+ recursos siguen igual. */
    :root{ --bg:#0A0F1A; --card:rgba(255,255,255,.035); --ink:#F2F4F7; --dim:#B8BEC7; --faint:#7E8796; --cy:#00C8FF; --blue:#007BFF; --sl:#BFEFFF; --amber:#FFB84D; --line:rgba(255,255,255,.08);
      --display:"Montserrat","Poppins",system-ui,sans-serif; --mono:"JetBrains Mono",ui-monospace,Menlo,monospace; --ease:cubic-bezier(.2,.7,.2,1);
      --glass:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.015)); }
    *{box-sizing:border-box}
    html{overflow-x:clip}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:"Poppins",system-ui,sans-serif;-webkit-font-smoothing:antialiased;display:flex;flex-direction:column;align-items:center;padding:12px 14px 40px;line-height:1.6}
    .amb{position:fixed;inset:0;z-index:-2;overflow:hidden;pointer-events:none}
    .amb i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.55}
    .amb .b1{width:620px;height:620px;left:-160px;top:-180px;background:radial-gradient(circle,rgba(0,123,255,.5),transparent 68%);animation:rd1 26s ease-in-out infinite alternate}
    .amb .b2{width:560px;height:560px;right:-180px;top:30%;background:radial-gradient(circle,rgba(0,200,255,.28),transparent 70%);animation:rd2 30s ease-in-out infinite alternate}
    @keyframes rd1{to{transform:translate(140px,120px) scale(1.12)}}@keyframes rd2{to{transform:translate(-120px,160px) scale(.92)}}
    .grain{position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.06;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
    .bar{position:sticky;top:12px;z-index:20;width:760px;max-width:100%;display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px;padding:7px 8px 7px 10px;border-radius:999px;background:rgba(10,15,26,.74);backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4);border:1px solid rgba(0,200,255,.14);box-shadow:0 18px 55px rgba(0,0,0,.35)}
    .bar .bb{display:flex;align-items:center;gap:10px;min-width:0;color:inherit;text-decoration:none}
    .bar img{width:32px;height:32px;border-radius:50%;flex:none;border:1px solid rgba(0,200,255,.35);box-shadow:0 0 18px -4px rgba(0,140,255,.75)}
    .bar span{color:var(--faint);font-family:var(--mono);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    button{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--blue),var(--cy));color:#fff;border:none;border-radius:999px;padding:9px 16px;font-weight:600;font-size:13px;cursor:pointer;font-family:inherit;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 10px 30px -12px rgba(0,123,255,.8);white-space:nowrap;transition:transform .2s var(--ease)}
    button:active{transform:scale(.97)}
    .doc{position:relative;width:760px;max-width:100%;background:var(--glass),rgba(13,24,40,.58);border:1px solid var(--line);border-radius:26px;padding:44px 48px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 40px 90px -40px rgba(0,0,0,.85)}
    .doc::before{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;background:linear-gradient(140deg,rgba(0,200,255,.45),transparent 30%,transparent 70%,rgba(0,123,255,.35));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
    .kicker{display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);color:var(--sl);font-size:12px;letter-spacing:.06em}
    .kicker::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--cy);box-shadow:0 0 10px var(--cy)}
    h1{font-family:var(--display);font-weight:700;font-size:clamp(28px,4.4vw,40px);line-height:1.08;letter-spacing:-.035em;margin:12px 0 6px}
    .by{color:var(--faint);font-family:var(--mono);font-size:11.5px;margin-bottom:28px}
    .lead{border-left:2px solid var(--cy);background:linear-gradient(90deg,rgba(0,200,255,.09),rgba(0,200,255,.02));padding:16px 20px;border-radius:0 16px 16px 0;font-size:16px;color:var(--ink);line-height:1.6;margin:22px 0}
    p{color:var(--dim);line-height:1.7;font-size:15px}
    h2{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:600;font-size:21px;letter-spacing:-.02em;color:var(--ink);margin:36px 0 10px}
    h2::before{content:"";flex:none;width:8px;height:8px;border-radius:3px;background:linear-gradient(135deg,var(--blue),var(--cy));box-shadow:0 0 12px rgba(0,200,255,.7)}
    h3{font-family:var(--display)}
    b,strong{color:var(--ink);font-weight:600}
    a{color:var(--cy)}
    /* Listas con flecha (guía) */
    .arrow{padding-left:0;list-style:none;margin:10px 0}
    .arrow li{color:var(--dim);line-height:1.6;font-size:15px;padding:7px 0 7px 26px;position:relative}
    .arrow li::before{content:"→";position:absolute;left:0;color:var(--cy);font-weight:700}
    .arrow li.no::before{content:"✕";color:var(--amber)}
    /* Sí / No a dos columnas (guía) */
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0}
    .col{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px 20px}
    .col h3{margin:0 0 6px;font-family:var(--mono);font-weight:500;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase}
    .col.si h3{color:var(--cy)} .col.no h3{color:var(--amber)}
    .col ul{padding-left:0;list-style:none;margin:0}
    .col li{color:var(--dim);line-height:1.5;font-size:13.5px;padding:5px 0 5px 22px;position:relative}
    .col li::before{content:"→";position:absolute;left:0;color:var(--cy);font-weight:700}
    .col.no li::before{content:"✕";color:var(--amber)}
    /* Checklist con casilla */
    .check{list-style:none;padding:0;margin:14px 0}
    .check li{color:var(--dim);line-height:1.5;font-size:15px;padding:12px 0 12px 34px;position:relative;border-bottom:1px solid var(--line)}
    .check li::before{content:"";position:absolute;left:0;top:12px;width:18px;height:18px;border:1.5px solid var(--cy);border-radius:6px;box-shadow:0 0 10px -2px rgba(0,200,255,.6)}
    /* Bloque de puntaje/resultado */
    .score{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:6px 20px;margin:14px 0;list-style:none}
    .score li{border:none;padding:9px 0;color:var(--dim);font-size:14px;list-style:none}
    .score b{color:var(--cy)}
    /* Pasos numerados (tutoriales/prompt) */
    .steps{list-style:none;counter-reset:s;padding:0;margin:14px 0}
    .steps li{counter-increment:s;color:var(--dim);line-height:1.6;font-size:15px;padding:10px 0 10px 42px;position:relative}
    .steps li::before{content:counter(s);position:absolute;left:0;top:8px;width:26px;height:26px;background:linear-gradient(135deg,var(--blue),var(--cy));color:#fff;border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:11.5px;font-weight:500;box-shadow:0 8px 20px -8px rgba(0,160,255,.9)}
    /* Bloque de código con botón copiar */
    .codewrap{position:relative;margin:16px 0;border-radius:18px;background:rgba(4,9,18,.7);border:1px solid rgba(255,255,255,.09);box-shadow:inset 0 1px 0 rgba(255,255,255,.05)}
    .codewrap::before{content:"";display:block;height:34px;border-bottom:1px solid rgba(255,255,255,.06);background:radial-gradient(circle at 18px 17px,#FF6B7A88 4px,transparent 5px),radial-gradient(circle at 34px 17px,#FFB84D88 4px,transparent 5px),radial-gradient(circle at 50px 17px,#4BE39A88 4px,transparent 5px)}
    .codewrap .copy{position:absolute;top:5px;right:6px;padding:5px 12px;font-size:11.5px;z-index:2}
    pre.code{background:transparent;border:0;border-radius:0 0 18px 18px;padding:18px;overflow:auto;margin:0}
    pre.code code{font-family:var(--mono);font-size:12.5px;line-height:1.65;color:#D6E6F5;white-space:pre-wrap;word-break:break-word}
    /* Nota / consejo */
    .note{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 18px;color:var(--dim);font-size:14px;line-height:1.6;margin:16px 0}
    .note b{color:var(--sl)}
    /* Aviso "leé todo" (ámbar, para que la gente no copie y se vaya) */
    .alert{background:linear-gradient(90deg,rgba(255,184,77,.1),rgba(255,184,77,.02));border-left:2px solid var(--amber);border-radius:0 16px 16px 0;padding:14px 18px;color:var(--dim);font-size:14px;line-height:1.6;margin:22px 0}
    .alert b{color:var(--amber)}
    /* Mini-CTA en línea (va cerca del recurso, sin robar protagonismo al bloque final) */
    .minicta{margin:14px 0 0;padding:12px 16px;border:1px dashed rgba(0,200,255,.25);border-radius:14px;font-size:13.5px;color:var(--dim);text-align:center;line-height:1.5}
    .minicta a{color:var(--cy);text-decoration:none;font-weight:600;white-space:nowrap}
    /* CTA final (empuja al embudo → llamada) */
    .cta{margin-top:36px;border-top:1px solid var(--line);padding-top:26px;text-align:center}
    .cta .big{font-family:var(--display);font-size:20px;letter-spacing:-.02em;color:var(--ink);font-weight:600}
    .cta p{margin:8px 0 16px}
    .cta a.btn,.mclass a.btn{position:relative;overflow:hidden;display:inline-block;background:linear-gradient(135deg,var(--blue),var(--cy));color:#fff;text-decoration:none;font-weight:600;font-size:15px;padding:14px 26px;border-radius:999px;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 10px 30px -10px rgba(0,123,255,.8);transition:transform .2s var(--ease)}
    .cta a.btn::after,.mclass a.btn::after{content:"";position:absolute;top:0;left:0;width:45%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.45),transparent);transform:translateX(-130%) skewX(-20deg)}
    .cta a.btn:hover::after,.mclass a.btn:hover::after{transition:transform .8s;transform:translateX(320%) skewX(-20deg)}
    .sign{color:var(--sl);font-family:var(--mono);font-size:12px;margin-top:16px}
    /* Bloque MASTERCLASS — CTA destacado para la serie "Claude desde 0" */
    .mclass{position:relative;margin-top:36px;border:1px solid rgba(0,200,255,.3);border-radius:22px;padding:32px 26px;text-align:center;background:linear-gradient(145deg,rgba(0,123,255,.16),rgba(255,255,255,.02));box-shadow:0 40px 80px -40px rgba(0,120,255,.7)}
    .mclass .badge{display:inline-block;font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--sl);background:rgba(0,200,255,.1);box-shadow:inset 0 0 0 1px rgba(0,200,255,.3);border-radius:999px;padding:5px 13px;margin-bottom:14px}
    .mclass h3{font-family:var(--display);font-weight:700;font-size:25px;letter-spacing:-.03em;line-height:1.2;color:var(--ink);margin:0 0 6px}
    .mclass .sub{color:var(--dim);font-size:14.5px;margin:0 0 22px}
    .mclass .learn{list-style:none;padding:0;margin:0 auto 24px;max-width:440px;text-align:left}
    .mclass .learn li{color:var(--ink);font-size:14.5px;line-height:1.45;padding:11px 0 11px 32px;position:relative;border-bottom:1px solid var(--line)}
    .mclass .learn li:last-child{border-bottom:none}
    .mclass .learn li::before{content:"";position:absolute;left:0;top:13px;width:16px;height:16px;border-radius:50%;background:radial-gradient(circle,var(--cy) 0 3px,rgba(0,200,255,.16) 4px)}
    .mclass .fineprint{color:var(--faint);font-family:var(--mono);font-size:11px;margin:14px 0 0}
    /* Puente al embudo de empresas (el ICP que cae acá por excepción) */
    .cta2{margin-top:22px;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px 20px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;text-align:left}
    .cta2 .q{font-family:var(--display);color:var(--ink);font-weight:600;font-size:16px}
    .cta2 p{margin:4px 0 0;font-size:13.5px}
    .cta2 a{color:var(--sl);text-decoration:none;font-weight:600;font-size:14px;white-space:nowrap}
    /* barra de lectura + secciones que aparecen al bajar */
    .readbar{position:fixed;top:0;left:0;right:0;z-index:30;height:2px;transform-origin:left;transform:scaleX(0);background:linear-gradient(90deg,var(--blue),var(--cy));box-shadow:0 0 14px rgba(0,200,255,.6)}
    .rj .doc>h2,.rj .doc>.codewrap,.rj .doc>.note,.rj .doc>.grid,.rj .doc>ul,.rj .doc>ol{opacity:0;transform:translateY(16px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
    .rj .doc>.in{opacity:1!important;transform:none!important}
    .doc>h2.in::before{animation:rpop .6s var(--ease)}
    @keyframes rpop{0%{transform:scale(.4)}60%{transform:scale(1.5)}100%{transform:scale(1)}}
    .codewrap{transition:box-shadow .3s,border-color .3s}
    .codewrap:hover{border-color:rgba(0,200,255,.35);box-shadow:0 20px 50px -30px rgba(0,140,255,.8)}
    .check li{cursor:pointer;transition:color .2s}
    .check li.on{color:var(--ink);text-decoration:line-through;text-decoration-color:rgba(0,200,255,.5)}
    .check li.on::before{background:linear-gradient(135deg,var(--blue),var(--cy));border-color:transparent}
    .check li.on::after{content:"✓";position:absolute;left:4px;top:11px;font-size:12px;color:#fff}
    .foot{width:760px;max-width:100%;margin-top:22px;text-align:center;font-family:var(--mono);font-size:11px;color:var(--faint)}
    .foot a{color:var(--faint);text-decoration:none}
    @media print{
      body{background:#fff;color:#111;padding:0}
      .amb,.grain,.bar,.foot,.readbar{display:none}
      .rj .doc>*{opacity:1!important;transform:none!important}
      .cta a.btn,.mclass a.btn{display:none}
      .doc{border:none;border-radius:0;background:#fff;box-shadow:none;backdrop-filter:none;padding:0}
      .doc::before{display:none}
      h1,h2,b,strong,.lead,.cta .big,.mclass h3,.mclass .learn li,.cta2 .q{color:#111}
      p,.arrow li,.check li,.steps li,.col li,.note,.alert,.score li{color:#333}
      .lead,.note,.alert,.col,.score,.cta2,.mclass{background:#f5f7fa}
      .codewrap{background:#f5f7fa;border-color:#dde3ea}.codewrap::before{display:none}
      pre.code code{color:#111}
      .steps li::before{color:#fff}
    }
    @media(max-width:560px){ .grid{grid-template-columns:1fr} .doc{padding:28px 22px;border-radius:22px} .mclass{padding:24px 18px} .bar span{display:none} }
    @media (prefers-reduced-motion:reduce){ .amb i{animation:none} }
  </style>
</head>
<body>
  <div class="readbar" aria-hidden="true"></div>
  <div class="amb" aria-hidden="true"><i class="b1"></i><i class="b2"></i></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="bar"><a class="bb" href="/"><img src="/img/symbol-gii.png" alt="" width="32" height="32" /><span>{barLabel}</span></a><button onclick="window.print()">Guardar en PDF</button></div>
  <article class="doc">
    <div class="kicker">{tipo} · GENIDEIA</div>
    <h1>{titulo}</h1>
    <div class="by">
      Andrés Albornoz{palabraClave && (<Fragment> · palabra clave del DM: <b style="color:var(--sl)">{palabraClave}</b></Fragment>)}
    </div>

    <slot />

    {masterclass ? (
      <section class="mclass">
        <div class="badge">Comunidad gratuita</div>
        <h3>Sumate a la comunidad de Claude</h3>
        <p class="sub">Recursos, clases grabadas y dudas resueltas — todo gratis, todo en el grupo.</p>
        <ul class="learn">
          {mclassBullets.map((b) => <li>{b}</li>)}
        </ul>
        <a class="btn" href={mclassHref} target="_blank" rel="noopener noreferrer">Unirme al grupo →</a>
        <p class="fineprint">Es gratis — entrás y ya estás adentro.</p>
      </section>
    ) : (
      <Fragment>
        <div class="cta">
          <div class="big">{ctaTitulo}</div>
          <p>{ctaTexto}</p>
          <a class="btn" href={waUrl} target="_blank" rel="noopener noreferrer">{ctaBtn}</a>
          <div class="sign">— Andrés</div>
        </div>

        <aside class="cta2">
          <div>
            <div class="q">¿Tenés una empresa?</div>
            <p>Si no sabés si estás perdiendo dinero con las operaciones que se llevan a cabo, tengo algo para vos.</p>
          </div>
          <a href={empresaUrl}>Ver solución →</a>
        </aside>
      </Fragment>
    )}
  </article>
  <p class="foot"><a href="/">GENIDEIA Company</a> · Montevideo, Uruguay</p>

  <script>
    // Barra de lectura, secciones que aparecen al bajar y checklist que se puede tildar.
    {
      const bar = document.querySelector<HTMLElement>('.readbar');
      addEventListener('scroll', () => {
        const h = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`;
      }, { passive: true });
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('.doc>h2,.doc>.codewrap,.doc>.note,.doc>.grid,.doc>ul,.doc>ol');
      if (!reduce && 'IntersectionObserver' in window && !matchMedia('print').matches) {
        document.documentElement.classList.add('rj');
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.08 });
        items.forEach((el) => io.observe(el));
        addEventListener('beforeprint', () => items.forEach((el) => el.classList.add('in')));
      }
      document.querySelectorAll('.check li').forEach((li) => li.addEventListener('click', () => li.classList.toggle('on')));
    }
    // Botón "Copiar" de los bloques de código (recursos tipo prompt).
    document.querySelectorAll('.codewrap .copy').forEach((btn) => {
      btn.addEventListener('click', () => {
        const code = btn.parentElement?.querySelector('code')?.innerText ?? '';
        navigator.clipboard.writeText(code).then(() => {
          const prev = btn.textContent;
          btn.textContent = '¡Copiado!';
          setTimeout(() => { btn.textContent = prev; }, 1800);
        });
      });
    });
  </script>
</body>
</html>
