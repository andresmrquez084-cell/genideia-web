---
// Molde ÚNICO de los recursos (lead magnets) de Andrés Albornoz.
// Cada recurso vive en src/pages/recursos/<slug>.astro y usa este layout:
// solo escribe su contenido en el <slot/>; la marca, el botón "Guardar en PDF"
// y el CTA final salen de acá. Cambiar un token en :root actualiza TODOS los recursos.
//
// Es autocontenido a propósito (su propio <html>, NO importa global.css) para que
// los estilos no choquen con el resto del sitio y el recurso se vea igual impreso a PDF.
interface Props {
  titulo: string;
  descripcion: string;
  tipo?: string;          // kicker, ej: "Mini-guía" · "Checklist" · "Prompt"
  barLabel?: string;      // etiqueta de la barra superior, ej: "Guía · @andresalbornozia"
  palabraClave?: string;  // palabra clave del DM (ManyChat), ej: "AUTOMATIZAR"
  ctaTitulo?: string;
  ctaTexto?: string;
  ctaBtn?: string;
  waMsg?: string;
  masterclass?: boolean;   // true → reemplaza el CTA genérico por el bloque destacado de la masterclass
  mclassBullets?: string[];
  mclassUrl?: string;      // link del botón de la masterclass (ej: grupo de WhatsApp). Si no, usa el WhatsApp de Andrés.
}
const {
  titulo,
  descripcion,
  tipo = 'Recurso',
  barLabel = 'Recurso · @andresalbornozia',
  palabraClave,
  // CTA genérico: el que llega por contenido orgánico es audiencia B2C (no el ICP).
  // La puerta para dueños de empresa es el bloque "¿Tenés una empresa?" → landing.
  ctaTitulo = '¿Tenés alguna duda o necesitás ayuda con algún proyecto o herramienta?',
  ctaTexto = 'Escribime por DM y contame qué estás intentando resolver.',
  ctaBtn = 'Click acá →',
  waMsg,
  masterclass = false,
  mclassBullets = [
    'Qué es Claude y cuáles son sus modalidades',
    'Cómo usar cada modalidad y para qué sirve cada función',
    'Construir una solución paso a paso (sin ser programador)',
    'Dejarla funcionando, con su sistema de mantenimiento',
    'Cómo vender esta solución',
  ],
  mclassUrl,
} = Astro.props;

const WA = '59892302941';
const waFinal = waMsg ?? `Hola Andrés, vi "${titulo}" y quiero preguntarte algo. Te cuento:`;
const waUrl = `https://wa.me/${WA}?text=${encodeURIComponent(waFinal)}`;
const mclassHref = mclassUrl ?? waUrl;

// Puente al embudo de empresas: etiquetado por recurso para medir cuál convierte.
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() ?? 'recurso';
const empresaUrl = `/andres?utm_source=recurso&utm_medium=lead-magnet&utm_content=${slug}`;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} — Andrés Albornoz · GENIDEIA</title>
  <meta name="description" content={descripcion} />
  <meta name="robots" content="noindex" /><!-- no listado: solo entra quien tiene el link -->
  <meta property="og:title" content={`${titulo} — Andrés Albornoz`} />
  <meta property="og:description" content={descripcion} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
  <style is:global>
    :root{ --bg:#0A0F17; --card:#0F1726; --ink:#E8EEF6; --dim:#9db2cc; --faint:#6f86a2; --cy:#00C8FF; --amber:#e0734a; --line:#1d2c44; }
    *{box-sizing:border-box}
    body{margin:0;background:#070b12;color:var(--ink);font-family:Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased;display:flex;flex-direction:column;align-items:center;padding:22px 14px}
    .bar{width:720px;max-width:100%;display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}
    .bar span{color:var(--faint);font-size:12px}
    button{background:var(--cy);color:#06121d;border:none;border-radius:8px;padding:9px 16px;font-weight:700;font-size:13px;cursor:pointer;font-family:inherit}
    .doc{width:720px;max-width:100%;background:var(--bg);border:1px solid var(--line);border-radius:16px;padding:40px 44px}
    .kicker{font-family:'JetBrains Mono',monospace;color:var(--cy);font-size:11px;letter-spacing:2px;text-transform:uppercase}
    h1{font-family:Cinzel,serif;font-weight:700;font-size:32px;line-height:1.1;margin:10px 0 4px}
    .by{color:var(--faint);font-size:12.5px;margin-bottom:26px}
    .lead{border-left:3px solid var(--cy);background:rgba(0,200,255,.05);padding:16px 18px;border-radius:0 10px 10px 0;font-size:16px;color:var(--ink);line-height:1.55;margin:22px 0}
    p{color:var(--dim);line-height:1.65;font-size:14.5px}
    h2{font-family:Cinzel,serif;font-weight:600;font-size:20px;color:var(--ink);margin:30px 0 10px}
    b,strong{color:var(--ink);font-weight:600}
    /* Listas con flecha (guía) */
    .arrow{padding-left:0;list-style:none;margin:10px 0}
    .arrow li{color:var(--dim);line-height:1.55;font-size:14.5px;padding:7px 0 7px 26px;position:relative}
    .arrow li::before{content:"→";position:absolute;left:0;color:var(--cy);font-weight:700}
    .arrow li.no::before{content:"✕";color:var(--amber)}
    /* Sí / No a dos columnas (guía) */
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0}
    .col{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
    .col h3{margin:0 0 6px;font-size:13px;letter-spacing:.5px;text-transform:uppercase}
    .col.si h3{color:var(--cy)} .col.no h3{color:var(--amber)}
    .col ul{padding-left:0;list-style:none;margin:0}
    .col li{color:var(--dim);line-height:1.5;font-size:13px;padding:5px 0 5px 22px;position:relative}
    .col li::before{content:"→";position:absolute;left:0;color:var(--cy);font-weight:700}
    .col.no li::before{content:"✕";color:var(--amber)}
    /* Checklist con casilla */
    .check{list-style:none;padding:0;margin:14px 0}
    .check li{color:var(--dim);line-height:1.5;font-size:14.5px;padding:11px 0 11px 34px;position:relative;border-bottom:1px solid var(--line)}
    .check li::before{content:"";position:absolute;left:0;top:11px;width:18px;height:18px;border:1.5px solid var(--cy);border-radius:5px}
    /* Bloque de puntaje/resultado */
    .score{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:6px 20px;margin:14px 0;list-style:none}
    .score li{border:none;padding:9px 0;color:var(--dim);font-size:14px;list-style:none}
    .score b{color:var(--cy)}
    /* Pasos numerados (tutoriales/prompt) */
    .steps{list-style:none;counter-reset:s;padding:0;margin:14px 0}
    .steps li{counter-increment:s;color:var(--dim);line-height:1.55;font-size:14.5px;padding:10px 0 10px 40px;position:relative}
    .steps li::before{content:counter(s);position:absolute;left:0;top:8px;width:24px;height:24px;background:rgba(0,200,255,.12);border:1px solid var(--cy);color:var(--cy);border-radius:7px;display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700}
    /* Bloque de código con botón copiar */
    .codewrap{position:relative;margin:16px 0}
    .codewrap .copy{position:absolute;top:10px;right:10px;padding:6px 12px;font-size:12px;z-index:2}
    pre.code{background:#060b14;border:1px solid var(--line);border-radius:12px;padding:20px 18px;overflow:auto;margin:0}
    pre.code code{font-family:'JetBrains Mono',monospace;font-size:12.5px;line-height:1.6;color:#cfe0f2;white-space:pre-wrap;word-break:break-word}
    /* Nota / consejo */
    .note{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:13px 16px;color:var(--dim);font-size:13.5px;line-height:1.55;margin:16px 0}
    .note b{color:var(--cy)}
    /* CTA final (empuja al embudo → llamada) */
    .cta{margin-top:34px;border-top:1px solid var(--line);padding-top:24px;text-align:center}
    .cta .big{font-family:Cinzel,serif;font-size:19px;color:var(--ink);font-weight:600}
    .cta p{margin:8px 0 16px}
    .cta a.btn{display:inline-block;background:var(--cy);color:#06121d;text-decoration:none;font-weight:700;font-size:14px;padding:12px 22px;border-radius:9px}
    .sign{color:var(--cy);font-style:italic;margin-top:16px}
    /* Bloque MASTERCLASS — CTA destacado para la serie "Claude desde 0" */
    .mclass{margin-top:34px;border:1px solid var(--cy);border-radius:16px;padding:30px 26px;text-align:center;background:linear-gradient(180deg,rgba(0,200,255,.09),rgba(0,200,255,.02));box-shadow:0 0 0 1px rgba(0,200,255,.14),0 24px 60px -24px rgba(0,200,255,.35)}
    .mclass .badge{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:2.5px;text-transform:uppercase;color:var(--cy);border:1px solid var(--cy);border-radius:999px;padding:5px 13px;margin-bottom:14px}
    .mclass h3{font-family:Cinzel,serif;font-weight:700;font-size:23px;line-height:1.2;color:var(--ink);margin:0 0 6px}
    .mclass .sub{color:var(--dim);font-size:14px;margin:0 0 22px}
    .mclass .learn{list-style:none;padding:0;margin:0 auto 24px;max-width:430px;text-align:left}
    .mclass .learn li{color:var(--ink);font-size:14px;line-height:1.4;padding:11px 0 11px 32px;position:relative;border-bottom:1px solid var(--line)}
    .mclass .learn li:last-child{border-bottom:none}
    .mclass .learn li::before{content:"✓";position:absolute;left:0;top:9px;width:20px;height:20px;border-radius:6px;background:rgba(0,200,255,.14);border:1px solid var(--cy);color:var(--cy);font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center}
    .mclass a.btn{display:inline-block;background:var(--cy);color:#06121d;text-decoration:none;font-weight:700;font-size:15px;padding:14px 30px;border-radius:10px;box-shadow:0 10px 28px -8px rgba(0,200,255,.55)}
    .mclass .fineprint{color:var(--faint);font-size:12px;margin:14px 0 0}
    /* Puente al embudo de empresas (el ICP que cae acá por excepción) */
    .cta2{margin-top:22px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;text-align:left}
    .cta2 .q{font-family:Cinzel,serif;color:var(--ink);font-weight:600;font-size:15px}
    .cta2 p{margin:4px 0 0;font-size:13px}
    .cta2 a{color:var(--cy);text-decoration:none;font-weight:700;font-size:13.5px;white-space:nowrap}
    @media print{ body{background:#fff;padding:0} .bar{display:none} .cta a.btn,.mclass a.btn{display:none} .doc{border:none;border-radius:0} }
    @media(max-width:560px){ .grid{grid-template-columns:1fr} .doc{padding:26px 22px} .mclass{padding:24px 18px} }
  </style>
</head>
<body>
  <div class="bar"><span>{barLabel}</span><button onclick="window.print()">Guardar en PDF</button></div>
  <article class="doc">
    <div class="kicker">{tipo} · GENIDEIA</div>
    <h1>{titulo}</h1>
    <div class="by">
      Andrés Albornoz{palabraClave && (<Fragment> · palabra clave del DM: <b style="color:var(--cy)">{palabraClave}</b></Fragment>)}
    </div>

    <slot />

    {masterclass ? (
      <section class="mclass">
        <div class="badge">Clase gratuita</div>
        <h3>De usar Claude a construir tu primer sistema</h3>
        <p class="sub">Una clase gratuita, desde cero y sin ser programador.</p>
        <ul class="learn">
          {mclassBullets.map((b) => <li>{b}</li>)}
        </ul>
        <a class="btn" href={mclassHref} target="_blank" rel="noopener noreferrer">Quiero mi lugar →</a>
        <p class="fineprint">Sin fecha todavía: entrás al grupo y ahí aviso cuándo arranca.</p>
      </section>
    ) : (
      <Fragment>
        <div class="cta">
          <div class="big">{ctaTitulo}</div>
          <p>{ctaTexto}</p>
          <a class="btn" href={waUrl} target="_blank" rel="noopener noreferrer">{ctaBtn}</a>
          <div class="sign">— Andrés</div>
        </div>

        <aside class="cta2">
          <div>
            <div class="q">¿Tenés una empresa?</div>
            <p>Si no sabés si estás perdiendo dinero con las operaciones que se llevan a cabo, tengo algo para vos.</p>
          </div>
          <a href={empresaUrl}>Ver solución →</a>
        </aside>
      </Fragment>
    )}
  </article>

  <script>
    // Botón "Copiar" de los bloques de código (recursos tipo prompt).
    document.querySelectorAll('.codewrap .copy').forEach((btn) => {
      btn.addEventListener('click', () => {
        const code = btn.parentElement?.querySelector('code')?.innerText ?? '';
        navigator.clipboard.writeText(code).then(() => {
          const prev = btn.textContent;
          btn.textContent = '¡Copiado!';
          setTimeout(() => { btn.textContent = prev; }, 1800);
        });
      });
    });
  </script>
</body>
</html>
