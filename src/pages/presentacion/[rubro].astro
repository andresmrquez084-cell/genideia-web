---
// Presentación adaptada a un rubro: misma landing, con la pregunta y el video de ese rubro.
import PresentacionLanding from '../../components/PresentacionLanding.astro';
import PresentacionRecorrido from '../../components/PresentacionRecorrido.astro';
import { PRESENTACIONES, type Presentacion } from '../../data/presentaciones';

export function getStaticPaths() {
  return PRESENTACIONES.map((p) => ({ params: { rubro: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Presentacion };
---

{p.recorrido ? (
  <PresentacionRecorrido
    pregunta={p.pregunta}
    rubro={p.rubro}
    recorrido={p.recorrido}
    titulo={`${p.pregunta} — GENIDEIA Company`}
    descripcion={`Una presentación breve y cuatro ejemplos concretos de cómo simplificar tareas en ${p.rubro}.`}
    waTexto="Hola Andrés, vi la presentación para talleres y me gustaría conversar sobre algunas tareas que podríamos simplificar en mi negocio."
  />
) : (
<PresentacionLanding
  pregunta={p.pregunta}
  video={p.video}
  poster={p.poster}
  vertical={p.vertical}
  titulo={`${p.pregunta} — GENIDEIA Company`}
  descripcion={`Te cuento en un minuto cómo GENIDEIA puede ayudar a ${p.rubro}.`}
  waTexto={`Hola Andrés, vi tu presentación para ${p.rubro} y quiero contarte:`}
/>
)}
