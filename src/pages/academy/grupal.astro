---
import '../../styles/global.css';
import '../../styles/academy-enroll.css';
const SIGNATURE = 'https://genideiacompany.com/hub/andres-albornoz-signature.svg';
const PAYONEER = 'https://link.payoneer.com/Token?t=EE9C556526D6414F946CD1122E48E99D&src=mobile';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Genideia Academy — Inscripción Programa Grupal</title>
  <meta name="description" content="Inscripción, acuerdo y medios de pago de Genideia Academy." />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Poppins:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('enj')</script>
</head>
<body class="enroll" data-service="grupal">
<div class="en-amb" aria-hidden="true"><i class="b1"></i><i class="b2"></i></div><div class="en-grain" aria-hidden="true"></div>
<main class="page-shell">
  <header class="topbar"><a class="brand" href="/academy"><img src="/academy/assets/academy-logo.svg" alt="" width="38" height="38" /><span class="bt"><span>GENIDEIA</span><small>ACADEMY</small></span></a><div class="pill">INSCRIPCIÓN · PROGRAMA GRUPAL</div></header>
  <nav class="en-steps" aria-label="Pasos de la inscripción"><a href="#recibis"><b>01</b><span>Qué recibís</span></a><a href="#datos"><b>02</b><span>Tus datos</span></a><a href="#contrato"><b>03</b><span>Acuerdo</span></a><a href="#pago"><b>04</b><span>Pago</span></a></nav>

  <section class="hero card en-spot"><div><p class="eyebrow">GENIDEIA ACADEMY</p><h1>Programa grupal de <span>IA aplicada</span></h1><p>Un recorrido práctico de 4 semanas para aprender a utilizar IA con criterio y llevarla a situaciones reales de trabajo, proyectos y nuevas oportunidades.</p></div><aside><small>INVERSIÓN TOTAL</small><strong>USD 399</strong><span>Pago único</span></aside></section>

  <section class="stats en-rv"><div><strong>4 semanas</strong><span>Duración</span></div><div><strong>8 clases</strong><span>2 por semana</span></div><div><strong>90 min</strong><span>Por sesión</span></div><div><strong>10–50</strong><span>Por cohorte</span></div></section>

  <section class="card en-rv en-spot" id="recibis"><header class="section-title"><b>01</b><div><p class="eyebrow">QUÉ RECIBÍS</p><h2>Todo lo incluido en tu inscripción</h2></div></header><div class="features"><div><strong>8 clases en vivo</strong><p>Dos encuentros semanales durante un mes.</p></div><div><strong>Preguntas en vivo</strong><p>Espacio para dudas sobre la clase, tus proyectos y la herramienta.</p></div><div><strong>Grabaciones</strong><p>Acceso permanente mientras el sistema de alojamiento continúe disponible.</p></div><div><strong>Biblioteca de recursos</strong><p>Prompts, ejemplos, links y materiales listos para adaptar.</p></div><div><strong>Aplicación práctica</strong><p>Ejemplos de soluciones con potencial de uso profesional y comercial.</p></div><div><strong>Grupo privado</strong><p>Avisos, calendario, enlaces, recursos y grabaciones.</p></div></div><div class="notice"><strong>¿Cuándo empieza?</strong><p>La cohorte se confirma al alcanzar un mínimo de 10 participantes y tendrá un máximo de 50. Una vez iniciadas las clases, las inscripciones se cierran hasta la próxima apertura. El plazo máximo de inicio es de 30 días desde tu inscripción.</p></div></section>

  <section class="card en-rv en-spot" id="datos"><header class="section-title"><b>02</b><div><p class="eyebrow">TUS DATOS</p><h2>Completá la información del participante</h2></div></header><form id="academy-form"><div class="form-grid"><label>Nombre completo<input required name="nombre" type="text" autocomplete="name" /></label><label>Documento / identificación<input required name="documento" type="text" /></label><label>País<input required name="pais" type="text" autocomplete="country-name" /></label><label>Ciudad<input required name="ciudad" type="text" /></label><label>Dirección<input required name="direccion" type="text" autocomplete="street-address" /></label><label>Email<input required name="email" type="email" autocomplete="email" /></label><label class="full">WhatsApp<input required name="whatsapp" type="tel" autocomplete="tel" /></label></div><label class="check"><input required type="checkbox" /> Confirmo que la información proporcionada es correcta.</label></form></section>

  <section class="card contract-card en-rv" id="contrato"><header class="section-title"><b>03</b><div><p class="eyebrow">ACUERDO</p><h2>Acuerdo de prestación del servicio</h2></div></header><div class="contract"><h3>GENIDEIA ACADEMY — PROGRAMA GRUPAL</h3><p><strong>Entre:</strong> Genideia, en adelante “el Prestador”, y la persona identificada en este formulario, en adelante “el Participante”, se acuerda lo siguiente:</p><h4>1. Objeto</h4><p>El presente acuerdo regula la participación en Genideia Academy — Programa grupal, un servicio educativo online orientado al aprendizaje y aplicación práctica de herramientas de inteligencia artificial.</p><h4>2. Duración</h4><p>El programa tendrá una duración aproximada de 4 semanas, contadas desde la fecha oficial de inicio de la cohorte.</p><h4>3. Servicio incluido</h4><p>El Participante tendrá derecho a 8 clases grupales online en vivo, de aproximadamente 90 minutos cada una; espacio para preguntas; acceso a grabaciones; recursos, prompts, materiales y ejemplos; y acceso al grupo privado de comunicaciones del programa.</p><h4>4. Grabaciones</h4><p>Las sesiones serán grabadas. El Participante tendrá acceso permanente mientras Genideia mantenga disponible técnicamente el sistema o plataforma utilizada para alojarlas.</p><h4>5. Soporte</h4><p>Las preguntas relacionadas con clases, proyectos, herramientas o aplicaciones prácticas podrán plantearse principalmente durante las sesiones en vivo. El grupo privado se utilizará para avisos, enlaces, recursos, grabaciones, calendario e información. El programa grupal no implica soporte individual ilimitado ni acompañamiento 1:1.</p><h4>6. Responsabilidad del participante</h4><p>El aprovechamiento depende también de la participación, práctica e implementación de cada persona. Genideia se compromete a entregar los componentes descritos, pero no garantiza ingresos, ventas, clientes ni resultados económicos o profesionales específicos.</p><h4>7. Propiedad intelectual</h4><p>Los recursos, materiales, grabaciones, documentos, prompts y contenidos son para uso del Participante. No podrán revenderse en su formato original, distribuirse públicamente, compartirse de manera masiva ni comercializarse como material educativo propio sin autorización previa. El Participante podrá utilizar los conocimientos adquiridos para crear, implementar y comercializar sus propias soluciones.</p><h4>8. Inicio de cohorte</h4><p>El programa comenzará una vez conformado un grupo mínimo de 10 participantes y tendrá un máximo de 50. Genideia comunicará la fecha y calendario. El programa deberá comenzar dentro de los 30 días posteriores a la inscripción, salvo acuerdo diferente.</p><h4>9. Cancelación y reembolsos</h4><p>La inscripción representa la reserva de un lugar dentro de una cohorte limitada. Un simple cambio de opinión no genera automáticamente derecho a reembolso, salvo derecho obligatorio distinto. Una vez iniciada la cohorte, la falta de asistencia, abandono o decisión de no continuar no dará derecho, por sí sola, a devolución.</p><p>Si Genideia no entregara alguno de los elementos expresamente incluidos y el incumplimiento fuera atribuible a Genideia, el Participante podrá solicitar revisión. Si se comprueba y no pudiera subsanarse razonablemente, se realizará el reembolso correspondiente.</p><p>Si Genideia no inicia el programa dentro de los 30 días establecidos, el Participante podrá mantener su lugar para la siguiente cohorte o solicitar el reembolso total.</p><p class="legal">Esta política no limita derechos de cancelación, desistimiento o reembolso que resulten obligatorios conforme a la legislación aplicable al consumidor.</p><div class="provider-signature"><div class="signature-line"><img src={SIGNATURE} alt="Firma de Andrés Albornoz" crossorigin="anonymous" /></div><strong>Andrés Albornoz</strong><span>GENIDEIA COMPANY · Firmado</span></div></div><div class="acceptance"><label class="check"><input form="academy-form" required id="accept-program" type="checkbox" /> Declaro haber leído y entendido qué incluye Genideia Academy, su modalidad, precio, funcionamiento y condiciones.</label><label class="check"><input form="academy-form" required id="accept-contract" type="checkbox" /> Acepto el acuerdo de prestación del servicio y la política de reembolso.</label></div><div class="signature-wrap"><div class="signature-head"><div><p class="eyebrow">FIRMA DEL PARTICIPANTE</p><h3>Firmá dentro del recuadro</h3></div><button type="button" id="clear-signature">Limpiar firma</button></div><canvas id="signature-pad" aria-label="Área de firma"></canvas><div class="signature-meta"><span id="signature-name">Nombre: —</span><span id="signature-date"></span></div></div><div class="actions"><button type="button" class="primary" id="confirm-signature">Confirmar firma e inscripción</button><button type="button" class="secondary" id="print-contract" disabled>Descargar / guardar contrato</button></div><p class="micro" id="save-status">Al confirmar, tus datos y firma quedarán registrados en Genideia Academy.</p></section>

  <section class="card payment is-locked en-rv" id="pago"><header class="section-title"><b>04</b><div><p class="eyebrow">PAGO</p><h2>Confirmá tu inscripción</h2></div></header><div class="total"><span>Total a abonar</span><strong>USD 399</strong></div><div class="payment-grid"><article><small>OPCIÓN 1</small><h3>Transferencia internacional · USD</h3><dl><div><dt>Titular</dt><dd>Andrés Albornoz</dd></div><div><dt>Cuenta · Caja de ahorro USD</dt><dd>0297709 <button data-copy="0297709">Copiar</button></dd></div><div><dt>SWIFT / BIC</dt><dd>ITAUUYMM <button data-copy="ITAUUYMM">Copiar</button></dd></div><div><dt>RUT banco</dt><dd>215393460011</dd></div><div><dt>Banco intermediario</dt><dd>JPMorgan Chase Bank N.A. · New York</dd></div><div><dt>SWIFT intermediario</dt><dd>CHASUS33 <button data-copy="CHASUS33">Copiar</button></dd></div><div><dt>ABA / Routing</dt><dd>021000021 <button data-copy="021000021">Copiar</button></dd></div><div><dt>Dirección</dt><dd>Luis Bonavita 1266, piso 10, Montevideo, Uruguay</dd></div></dl></article><article><small>OPCIÓN 2</small><h3>Pago con tarjeta · Payoneer</h3><p>Realizá el pago online de USD 399 con tarjeta mediante Payoneer.</p><a class="primary wide" id="payoneer-button" href={PAYONEER} target="_blank" rel="noopener noreferrer">Pagar USD 399 con tarjeta</a><p class="micro">El pago se procesa de forma segura fuera de esta página mediante Payoneer.</p></article></div>

    <div class="proof-box"><div><p class="eyebrow">ÚLTIMO PASO</p><h3>Enviá tu comprobante</h3><p>Después de pagar, subí el comprobante para que podamos asociarlo a tu inscripción y validar el pago.</p></div><div class="proof-grid"><label>Método utilizado<select id="payment-method"><option value="">Elegí una opción</option><option value="transfer">Transferencia internacional</option><option value="payoneer">Payoneer / tarjeta</option></select></label><label>Comprobante<input id="proof-file" type="file" accept="image/png,image/jpeg,image/webp,application/pdf" /></label></div><button type="button" class="primary" id="submit-proof">Enviar comprobante</button><p class="micro" id="proof-status">Formatos permitidos: PNG, JPG, WEBP o PDF. Máximo 8 MB.</p></div>

    <div class="notice"><strong>¿Qué pasa después?</strong><p>Una vez validado el pago, tu inscripción queda confirmada y vas a recibir acceso al grupo privado de Genideia Academy con fecha de inicio, calendario, enlaces, recursos y grabaciones.</p></div></section>

  <footer><strong>GENIDEIA · Academy</strong><span>Montevideo, Uruguay</span></footer>
</main>
<script src="/academy-onboarding.js" defer></script>
<script is:inline>
(function(){
  var d=document,reduce=matchMedia('(prefers-reduced-motion: reduce)').matches,fine=matchMedia('(hover: hover) and (pointer: fine)').matches;
  var $=function(s){return d.querySelector(s)},$$=function(s){return [].slice.call(d.querySelectorAll(s))};
  // aparición al bajar
  if('IntersectionObserver' in window && !reduce){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.08});
    $$('.en-rv').forEach(function(el){io.observe(el)});
  } else { d.documentElement.classList.remove('enj'); }
  // brillo que sigue al cursor
  if(fine) d.addEventListener('pointermove',function(e){var c=e.target.closest&&e.target.closest('.en-spot');if(!c)return;var r=c.getBoundingClientRect();c.style.setProperty('--mx',(e.clientX-r.left)+'px');c.style.setProperty('--my',(e.clientY-r.top)+'px')},{passive:true});
  // pasos: cuál se está viendo y cuáles ya están completos
  var links=$$('.en-steps a'),secs=links.map(function(a){return $(a.getAttribute('href'))});
  function active(){var y=innerHeight*.35,cur=0;secs.forEach(function(s,i){if(s&&s.getBoundingClientRect().top<y)cur=i});links.forEach(function(a,i){a.classList.toggle('on',i===cur)})}
  var fm=$('#academy-form'),pago=$('#pago');
  function done(){
    var ok={datos:fm&&fm.checkValidity(),contrato:pago&&!pago.classList.contains('is-locked'),recibis:true};
    links.forEach(function(a){var k=a.getAttribute('href').slice(1);a.classList.toggle('ok',!!ok[k]&&!a.classList.contains('on'))});
  }
  addEventListener('scroll',function(){active();done()},{passive:true});
  if(fm){fm.addEventListener('input',done);fm.addEventListener('change',done)}
  if(pago&&'MutationObserver' in window) new MutationObserver(done).observe(pago,{attributes:true,attributeFilter:['class']});
  active();done();

  // Navegación robusta para los pasos y el regreso a Academy.
  d.addEventListener('click',function(e){
    var a=e.target.closest&&e.target.closest('a[href]');
    if(!a)return;
    var href=a.getAttribute('href')||'';
    if(href.charAt(0)==='#'){
      var target=$(href);
      if(target){
        e.preventDefault();
        target.scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'});
        try{history.replaceState(null,'',href)}catch(_){}
      }
      return;
    }
    if(a.target==='_blank')return;
    if(href.charAt(0)==='/'&&!e.metaKey&&!e.ctrlKey&&!e.shiftKey&&!e.altKey){
      e.preventDefault();
      location.assign(href);
    }
  });
})();
</script>
</body></html>