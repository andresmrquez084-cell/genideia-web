---
// Página principal de Genideia Academy: qué es, cómo funciona, programas y acceso al portal del alumno.
import '../../styles/global.css';

const pad = (n) => String(n).padStart(2, '0');
const MODULOS = [
  ['Diagnóstico y preparación', 'Tu punto de partida, objetivos y casos reales.'],
  ['Conversar bien con IA', 'Instrucciones claras, revisión y mejora en ciclos.'],
  ['Contexto reutilizable', 'Que la IA te conozca sin explicar todo de nuevo.'],
  ['Investigar y verificar', 'Fuentes, comparativas y conclusiones trazables.'],
  ['Materiales reutilizables', 'Skills para repetir lo que ya funciona.'],
  ['Procesos de varios pasos', 'Flujos, decisiones y agentes responsables.'],
  ['Construir una solución', 'Un primer prototipo funcional sobre un caso real.'],
  ['Integración final', 'Todo junto en un sistema que podés sostener.'],
];
const PASOS = [
  ['Diagnóstico', 'El primer módulo entiende tu situación, tu objetivo y dónde conviene empezar.'],
  ['Plan personalizado', 'Los módulos se adaptan a tus proyectos y tareas, no a un temario genérico.'],
  ['Clases aplicadas', 'Cada clase combina la herramienta con un caso tuyo y termina en algo que funciona.'],
  ['Seguimiento', 'Tu portal muestra el plan, el módulo en curso y tu avance.'],
];
const W = 1000, H = 250;
const pts = MODULOS.map((_, i) => [60 + i * (880 / 7), 125 + Math.sin(i * 1.05 + 0.5) * 70]);
const pathD = pts.reduce((d, p, i) => i === 0 ? `M${p[0]},${p[1]}` : `${d} C${(pts[i - 1][0] + p[0]) / 2},${pts[i - 1][1]} ${(pts[i - 1][0] + p[0]) / 2},${p[1]} ${p[0]},${p[1]}`, '');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Genideia Academy · Aprendé IA aplicándola a tu trabajo real</title>
  <meta name="description" content="Programas de Genideia Academy para aprender Claude y aplicarlo sobre tus tareas, proyectos y objetivos reales." />
  <link rel="canonical" href="https://genideiacompany.com/academy" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Poppins:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('hj')</script>
</head>
<body class="hub">
<div class="h-amb" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
<div class="h-grain" aria-hidden="true"></div>

<header class="h-top">
  <a class="h-brand" href="/academy"><img src="/academy/assets/academy-logo.svg" alt="" width="38" height="38" /><span><b>GENIDEIA <em>ACADEMY</em></b><small>Aprendizaje aplicado</small></span></a>
  <nav class="h-links" aria-label="Secciones"><a href="#como">Cómo funciona</a><a href="#modulos">Módulos</a><a href="#programas">Programas</a><a href="#alumnos">Alumnos</a></nav>
  <a class="h-btn p sm" href="#programas">Inscribirme</a>
</header>

<main class="h-shell">
  <section class="h-hero">
    <div>
      <p class="h-eb">Genideia Academy · Aprendizaje aplicado</p>
      <h1 class="h-split">Aprendé IA aplicándola a <em>tu trabajo real.</em></h1>
      <p class="h-lead h-rv">Un sistema de 8 módulos para aprender Claude y llevarlo a tus tareas, tus proyectos y tus objetivos. Avanzás cuando funciona, no solamente cuando se explicó.</p>
      <div class="h-cta h-rv"><a class="h-btn p" href="#programas">Ver programas</a><a class="h-btn g" href="#como">Cómo funciona</a></div>
    </div>
    <div class="h-win h-rv" aria-label="Ejemplo de recorrido de 8 módulos">
      <div class="h-win-top"><i></i><i></i><i></i><span>recorrido de ejemplo</span><b class="h-live"><span></span>en curso</b></div>
      <div class="h-win-body">
        <div class="h-who"><div><b>Alumno de ejemplo</b><small>Plan personalizado · 8 módulos</small></div><div class="h-pct"><b id="hPct">0</b><small>% completo</small></div></div>
        <div class="h-track">
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
            <defs><linearGradient id="hg" x1="0" x2="1"><stop offset="0" stop-color="#4BE39A" /><stop offset=".6" stop-color="#00C8FF" /><stop offset="1" stop-color="#007BFF" /></linearGradient></defs>
            <path class="bg" d={pathD} /><path class="fg" id="hFg" d={pathD} />
          </svg>
          {MODULOS.map((m, i) => <span class="h-node" data-i={i} style={`left:${pts[i][0] / W * 100}%;top:${pts[i][1] / H * 100}%`}>{pad(i + 1)}</span>)}
        </div>
        <div class="h-now"><span class="h-n" id="hN">01</span><div><b id="hT">{MODULOS[0][0]}</b><small id="hD">{MODULOS[0][1]}</small></div></div>
      </div>
    </div>
  </section>

  <section class="h-sec" id="como">
    <div class="h-head"><div><p class="h-eb">Cómo funciona</p><h2 class="h-split">Cuatro pasos, siempre sobre tu caso.</h2></div></div>
    <div class="h-steps">
      {PASOS.map((p, i) => <article class="h-card h-rv h-spot" style={`transition-delay:${i * .07}s`}><span class="h-k">{pad(i + 1)}</span><h3>{p[0]}</h3><p>{p[1]}</p></article>)}
    </div>
  </section>

  <section class="h-sec" id="modulos">
    <div class="h-head"><div><p class="h-eb">El recorrido</p><h2 class="h-split">Ocho módulos que se adaptan a vos.</h2></div><p class="h-side">La estructura es común. Los casos, los ejemplos y el ritmo son tuyos.</p></div>
    <div class="h-mods">
      {MODULOS.map((m, i) => <article class="h-mod h-rv h-spot" style={`transition-delay:${(i % 4) * .06}s`} data-n={pad(i + 1)}><span class="h-k">Módulo {pad(i + 1)}</span><h3>{m[0]}</h3><p>{m[1]}</p></article>)}
    </div>
  </section>

  <section class="h-sec" id="programas">
    <div class="h-head"><div><p class="h-eb">Programas</p><h2 class="h-split">Elegí cómo querés aprender.</h2></div><p class="h-side">En cada programa vas a ver el detalle, el acuerdo y la inscripción.</p></div>
    <div class="h-progs">
      <a class="h-prog h-rv h-spot feat" href="/academy/1a1">
        <span class="h-tag">Individual</span>
        <h3>Acompañamiento 1:1</h3>
        <p>Un recorrido de 8 módulos para aprender Claude y aplicarlo directamente sobre tu situación, tus tareas y tus objetivos diarios.</p>
        <ul><li>8 módulos híbridos</li><li>Hasta 2 módulos por semana</li><li>Diagnóstico inicial y plan personalizado</li><li>Portal con tu plan y tu avance</li></ul>
        <span class="h-go">Ver e inscribirme <i>→</i></span>
      </a>
      <a class="h-prog h-rv h-spot" href="/academy/grupal" style="transition-delay:.08s">
        <span class="h-tag">Grupal</span>
        <h3>Programa grupal de IA aplicada</h3>
        <p>Un recorrido práctico para aprender a usar IA con criterio y llevarla a situaciones reales de trabajo, proyectos y nuevas oportunidades.</p>
        <ul><li>4 semanas</li><li>8 clases, 2 por semana</li><li>90 minutos por sesión</li><li>Cohortes de 10 a 50 personas</li></ul>
        <span class="h-go">Ver e inscribirme <i>→</i></span>
      </a>
    </div>
  </section>

  <section class="h-alum h-card h-rv h-spot" id="alumnos">
    <div><p class="h-eb">Alumnos</p><h2>Tu plan y tu avance, en tu portal.</h2><p>Al empezar recibís el enlace a tu portal personal: ahí ves tu plan de estudio antes de arrancar y después el seguimiento de cada módulo.</p></div>
    <div class="h-alum-v" aria-hidden="true"><div class="h-ring"><svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="52" class="rb" /><circle cx="60" cy="60" r="52" class="rf" /></svg><b>3</b><small>de 8</small></div><div class="h-bars"><i style="--w:100%"></i><i style="--w:100%"></i><i style="--w:62%" class="now"></i><i style="--w:0%"></i></div></div>
  </section>
</main>

<footer class="h-foot"><div><img src="/academy/assets/academy-logo.svg" alt="" width="34" height="34" /><span><b>GENIDEIA ACADEMY</b><small>Montevideo, Uruguay</small></span></div><small>Sistema de aprendizaje aplicado</small></footer>

<script is:inline>
(function(){
  var d=document,reduce=matchMedia('(prefers-reduced-motion: reduce)').matches,fine=matchMedia('(hover: hover) and (pointer: fine)').matches;
  var $=function(s){return d.querySelector(s)},$$=function(s){return [].slice.call(d.querySelectorAll(s))};
  // títulos palabra por palabra: recorre solo los textos, así respeta el <em> del destacado
  $$('.h-split').forEach(function(h){var i=0;(function walk(n){[].slice.call(n.childNodes).forEach(function(c){if(c.nodeType===3){var f=d.createDocumentFragment();c.textContent.split(/(\s+)/).forEach(function(w){if(!w)return;if(/^\s+$/.test(w)){f.appendChild(d.createTextNode(w));return}var o=d.createElement('span');o.className='w';var t=d.createElement('span');t.textContent=w;t.style.transitionDelay=(i++*.06)+'s';o.appendChild(t);f.appendChild(o)});c.replaceWith(f)}else walk(c)})})(h)});
  if('IntersectionObserver' in window&&!reduce){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});$$('.h-rv,.h-split,.h-alum').forEach(function(el){io.observe(el)})}else d.documentElement.classList.remove('hj');
  if(fine)d.addEventListener('pointermove',function(e){var c=e.target.closest&&e.target.closest('.h-spot');if(!c)return;var r=c.getBoundingClientRect();c.style.setProperty('--mx',(e.clientX-r.left)+'px');c.style.setProperty('--my',(e.clientY-r.top)+'px')},{passive:true});
  // recorrido de ejemplo que avanza solo
  var MOD=[].slice.call(d.querySelectorAll('.h-node')),T=$('#hT'),D=$('#hD'),N=$('#hN'),P=$('#hPct'),fg=$('#hFg');
  var info=[].slice.call(d.querySelectorAll('.h-mod')).map(function(m){return [m.querySelector('h3').textContent,m.querySelector('p').textContent]});
  var L=fg.getTotalLength(),step=0,timer=0,vis=true;
  fg.style.strokeDasharray=L;
  function show(k){
    MOD.forEach(function(n,i){n.className='h-node'+(i<k?' done':i===k?' now':'')});
    var f=k/(MOD.length-1);fg.style.strokeDashoffset=L*(1-f);
    var t=info[k]||['',''];N.textContent=String(k+1).padStart(2,'0');T.textContent=t[0];D.textContent=t[1];
    P.textContent=Math.round(k/MOD.length*100);
    var box=$('.h-now');box.classList.remove('sw');void box.offsetWidth;box.classList.add('sw');
  }
  function tick(){if(!vis||d.hidden)return;step=(step+1)%(MOD.length+1);show(Math.min(step,MOD.length-1))}
  show(0);
  if(!reduce){
    timer=setInterval(tick,1700);
    if('IntersectionObserver' in window)new IntersectionObserver(function(e){vis=e[0].isIntersecting}).observe($('.h-win'));
    MOD.forEach(function(n,i){n.addEventListener('mouseenter',function(){clearInterval(timer);show(i)})});
  } else show(3);

  // Navegación robusta: garantiza que los CTA y anclas internas respondan incluso
  // si una capa visual o una transición está activa.
  d.addEventListener('click',function(e){
    var a=e.target.closest&&e.target.closest('a[href]');
    if(!a)return;
    var href=a.getAttribute('href')||'';
    if(href.charAt(0)==='#'){
      var target=d.querySelector(href);
      if(target){
        e.preventDefault();
        target.scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'});
        try{history.replaceState(null,'',href)}catch(_){}
      }
      return;
    }
    if(a.target==='_blank')return;
    if(href.charAt(0)==='/' && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey){
      e.preventDefault();
      location.assign(href);
    }
  });

})();
</script>
</body>
</html>

<style is:global>
.hub{--bg:#0A0F1A;--tx:#F2F4F7;--tx2:#B8BEC7;--tx3:#7E8796;--p:#007BFF;--s:#00C8FF;--sl:#BFEFFF;--ok:#4BE39A;--display:"Montserrat","Poppins",system-ui,sans-serif;--mono:"JetBrains Mono",ui-monospace,Menlo,monospace;--glass:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.015));--ease:cubic-bezier(.2,.7,.2,1);margin:0;background:var(--bg);color:var(--tx);font-family:"Poppins",system-ui,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
html:has(.hub){scroll-behavior:smooth;overflow-x:clip}
.hub *{box-sizing:border-box}.hub a{color:inherit;text-decoration:none}
.hub h1,.hub h2,.hub h3{font-family:var(--display);letter-spacing:-.03em;margin:0}
.h-amb{position:fixed;inset:0;z-index:-2;overflow:hidden;pointer-events:none}
.h-amb i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.55}
.h-amb .b1{width:640px;height:640px;left:-160px;top:-200px;background:radial-gradient(circle,rgba(0,123,255,.55),transparent 68%);animation:hd1 26s ease-in-out infinite alternate}
.h-amb .b2{width:560px;height:560px;right:-180px;top:12%;background:radial-gradient(circle,rgba(0,200,255,.33),transparent 70%);animation:hd2 30s ease-in-out infinite alternate}
.h-amb .b3{width:720px;height:720px;left:28%;bottom:-400px;background:radial-gradient(circle,rgba(56,80,255,.26),transparent 70%);animation:hd1 34s ease-in-out infinite alternate-reverse}
@keyframes hd1{to{transform:translate(140px,120px) scale(1.12)}}@keyframes hd2{to{transform:translate(-120px,160px) scale(.92)}}
.h-grain{position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.06;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
.h-top{position:sticky;top:12px;z-index:40;display:flex;align-items:center;gap:18px;width:min(1160px,calc(100% - 24px));margin:12px auto 0;padding:8px 10px 8px 12px;border-radius:999px;background:rgba(10,15,26,.74);backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4);border:1px solid rgba(0,200,255,.14);box-shadow:0 18px 55px rgba(0,0,0,.35)}
.h-brand{display:flex;align-items:center;gap:12px}
.h-brand img{border-radius:50%;border:1px solid rgba(0,200,255,.35);box-shadow:0 0 22px -4px rgba(0,140,255,.75)}
.h-brand b{display:block;font-family:var(--display);font-weight:600;letter-spacing:.18em;font-size:13px}.h-brand b em{font-style:normal;color:var(--s)}
.h-brand small{display:block;font-family:var(--mono);font-size:10.5px;color:var(--tx3)}
.h-links{display:flex;gap:2px;margin-left:auto}
.h-links a{font-size:13.5px;color:var(--tx3);padding:8px 14px;border-radius:999px;transition:.2s}.h-links a:hover{color:#fff;background:rgba(255,255,255,.05)}
.h-btn{position:relative;overflow:hidden;display:inline-flex;align-items:center;height:48px;padding:0 24px;border-radius:999px;font-weight:500;transition:transform .2s var(--ease),box-shadow .3s,background .2s}
.h-btn.sm{height:40px;padding:0 18px;font-size:14px}
.h-btn.p{background:linear-gradient(135deg,var(--p),var(--s));color:#fff;font-weight:600;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 10px 30px -10px rgba(0,123,255,.8)}
.h-btn.p::after{content:"";position:absolute;top:0;left:0;width:45%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.45),transparent);transform:translateX(-130%) skewX(-20deg)}
.h-btn.p:hover::after{transition:transform .8s;transform:translateX(320%) skewX(-20deg)}
.h-btn.g{background:rgba(255,255,255,.06);box-shadow:inset 0 0 0 1px rgba(255,255,255,.16)}.h-btn.g:hover{background:rgba(255,255,255,.1)}
.h-btn:active{transform:scale(.97)}
.h-shell{width:min(1160px,calc(100% - 32px));margin:auto}
.h-eb{display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-size:12px;letter-spacing:.06em;color:var(--sl);margin:0 0 14px}
.h-eb::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--s);box-shadow:0 0 10px var(--s)}
.hj .h-rv{opacity:0;transform:translateY(20px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.hj .h-rv.in{opacity:1;transform:none}
.w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.08em}.w>span{display:inline-block;transition:transform .8s var(--ease)}
.hj .h-split .w>span{transform:translateY(105%)}.hj .h-split.in .w>span{transform:none}
.h-split em{font-style:normal}
.h-split em .w>span,.h-hero h1 em .w>span{background:linear-gradient(90deg,#5FB4FF,var(--s) 60%,#9FF0FF);-webkit-background-clip:text;background-clip:text;color:transparent}
.h-spot{position:relative;overflow:hidden}
.h-spot::before{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;transition:opacity .35s;background:radial-gradient(420px circle at var(--mx,50%) var(--my,50%),rgba(0,200,255,.13),transparent 45%)}
.h-spot:hover::before{opacity:1}.h-spot>*{position:relative}
.h-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:44px;align-items:center;padding:80px 0 50px}
.h-hero h1{font-size:clamp(42px,6vw,76px);line-height:1;letter-spacing:-.045em;font-weight:700;margin-bottom:22px}
.h-lead{font-size:18px;line-height:1.7;color:var(--tx2);max-width:560px;margin:0}
.h-cta{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}
.h-win{position:relative;border-radius:26px;background:var(--glass),rgba(11,19,32,.72);border:1px solid rgba(255,255,255,.1);box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 50px 120px -40px rgba(0,90,255,.6);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.h-win::before{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;background:linear-gradient(140deg,rgba(0,200,255,.55),transparent 35%,transparent 65%,rgba(0,123,255,.45));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
.h-win-top{display:flex;align-items:center;gap:7px;padding:13px 16px;border-bottom:1px solid rgba(255,255,255,.07)}
.h-win-top>i{width:10px;height:10px;border-radius:50%}.h-win-top>i:nth-child(1){background:#FF6B7A88}.h-win-top>i:nth-child(2){background:#FFB84D88}.h-win-top>i:nth-child(3){background:#4BE39A88}
.h-win-top>span{margin-left:8px;font-family:var(--mono);font-size:11px;color:var(--tx3)}
.h-live{margin-left:auto;display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-weight:400;font-size:11px;color:var(--ok)}
.h-live span{width:7px;height:7px;border-radius:50%;background:var(--ok);animation:hping 2s infinite}
@keyframes hping{0%{box-shadow:0 0 0 0 rgba(75,227,154,.55)}80%,100%{box-shadow:0 0 0 9px rgba(75,227,154,0)}}
.h-win-body{padding:18px}
.h-who{display:flex;justify-content:space-between;align-items:center;margin:0 4px}
.h-who b{font-family:var(--display);font-size:17px}.h-who small{display:block;font-family:var(--mono);font-size:11px;color:var(--tx3)}
.h-pct{white-space:nowrap}.h-pct b{font-family:var(--display);font-size:30px;letter-spacing:-.04em;color:var(--sl)}.h-pct small{display:inline;margin-left:3px}
.h-track{position:relative;aspect-ratio:1000/250;margin:8px 0}
.h-track svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.h-track .bg{fill:none;stroke:rgba(255,255,255,.12);stroke-width:2;stroke-dasharray:2 7}
.h-track .fg{fill:none;stroke:url(#hg);stroke-width:3.5;stroke-linecap:round;filter:drop-shadow(0 0 6px rgba(0,200,255,.7));transition:stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1)}
.h-node{position:absolute;transform:translate(-50%,-50%);width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-family:var(--mono);font-size:10px;color:var(--tx3);background:#0E1626;box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.16);transition:all .5s var(--ease);cursor:default}
.h-node.done{background:radial-gradient(circle at 35% 30%,#7DFFC0,#1FB673);color:#04210F;box-shadow:0 0 16px -2px rgba(75,227,154,.75)}
.h-node.now{background:radial-gradient(circle at 35% 30%,#8FEBFF,#007BFF);color:#fff;transform:translate(-50%,-50%) scale(1.18);box-shadow:0 0 26px rgba(0,200,255,.85)}
.h-now{display:flex;gap:14px;align-items:center;margin-top:12px;padding:14px 16px;border-radius:16px;background:rgba(255,255,255,.035);box-shadow:inset 0 0 0 1px rgba(255,255,255,.07)}
.h-now.sw>div{animation:hsw .45s var(--ease)}@keyframes hsw{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.h-n{font-family:var(--display);font-weight:700;font-size:32px;letter-spacing:-.04em;color:transparent;-webkit-text-stroke:1px rgba(0,200,255,.65);line-height:1}
