---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import ClientCard from '../../components/ClientCard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import { clientes } from '../../data/clientes';

const casos = clientes.filter((c) => c.servicio === 'contenido-marketing');

const incluye = [
  'Branding aplicado: logo, paleta, tipografías y sistema visual',
  'Sistema de contenido y posicionamiento orgánico: pilares, cadencia y métricas',
  'Producción y diseño de piezas para redes',
  'Embudo de captación: posicionar → captar → interactuar → convertir',
];

const problemas = [
  'Tenés redes sociales pero no sabés qué publicar ni con qué frecuencia.',
  'Tu marca no se ve profesional o no transmite lo que realmente hacés.',
  'Publicás de vez en cuando, sin un plan detrás.',
  'No tenés piezas de diseño consistentes entre plataformas.',
];

const faqs = [
  {
    pregunta: '¿Necesito tener ya una marca definida?',
    respuesta: 'No. Si todavía no tenés identidad visual (logo, colores, tipografías), la armamos como parte del servicio. Si ya la tenés, trabajamos sobre lo que existe.',
  },
  {
    pregunta: '¿Cuánto contenido producen por mes?',
    respuesta: 'Depende del plan que armemos según tu rubro y objetivo. Lo definimos juntos en el diagnóstico, no es un paquete cerrado igual para todos.',
  },
  {
    pregunta: '¿Esto incluye pauta publicitaria?',
    respuesta: 'No, contenido y marketing es la base orgánica (lo que publicás vos). Los anuncios pagos son un servicio aparte — podés combinarlos cuando la base ya esté sólida.',
  },
];
---

<BaseLayout
  title="Contenido y marketing — GENIDEIA Company"
  description="Construimos una marca que las personas reconozcan y entiendan: identidad visual, contenido y posicionamiento orgánico. Casos reales en Uruguay."
  path="/servicios/contenido-marketing"
>

  <!-- ── PRESENTACIÓN ──────────────────────────────────────── -->
  <section class="max-w-4xl mx-auto px-6 pt-24 pb-16 text-center">
    <p class="hero-animate text-xs font-medium mb-6 uppercase" data-delay="1" style="color:#00C8FF; letter-spacing:3px;">
      Contenido y marketing
    </p>
    <h1 class="hero-animate mb-6" data-delay="2" style="font-family:'Montserrat',sans-serif; font-weight:700; line-height:1.05; letter-spacing:-1px; font-size:clamp(2.4rem, 5.5vw, 3.8rem);">
      Construí una marca que las personas reconozcan y entiendan.
    </h1>
    <p class="hero-animate mx-auto mb-9 leading-relaxed max-w-xl text-lg" data-delay="3" style="color:#B8BEC7; font-weight:300;">
      Identidad visual, contenido y posicionamiento orgánico — el punto de partida antes de invertir en anuncios.
      Es hoy el área con más proyectos reales y evidencia comprobable.
    </p>
    <a href="https://wa.me/59892302941?text=Hola%2C%20quiero%20ordenar%20el%20contenido%20de%20mi%20negocio" target="_blank" rel="noopener noreferrer" style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600;" class="hero-animate inline-block px-9 py-3.5 rounded-lg hover:opacity-90 transition-opacity" data-delay="4">
      Quiero ordenar mi contenido
    </a>
  </section>

  <!-- ── PROBLEMAS QUE RESUELVE ────────────────────────────── -->
  <Section kicker="Situaciones frecuentes" title="¿Te suena alguna de estas?">
    <div class="grid sm:grid-cols-2 gap-5 max-w-3xl mx-auto">
      {problemas.map((p, i) => (
        <div class="rounded-xl p-5 flex items-start gap-3" style="background:#111111; border:1px solid rgba(255,255,255,0.07);" data-reveal data-delay={String(i + 1)}>
          <span style="color:#00C8FF; flex-shrink:0;">→</span>
          <p style="color:#B8BEC7; font-weight:300;" class="text-sm leading-relaxed">{p}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ── QUÉ INCLUYE ────────────────────────────────────────── -->
  <Section bg="soft" border="both" kicker="Qué incluye" title="Los componentes del servicio">
    <ul class="space-y-4 max-w-2xl mx-auto">
      {incluye.map((item) => (
        <li style="color:#B8BEC7; font-weight:300;" class="text-base flex items-start gap-3" data-reveal>
          <span style="color:#00C8FF; flex-shrink:0; margin-top:2px;">→</span>
          {item}
        </li>
      ))}
    </ul>
  </Section>

  <!-- ── EJEMPLOS / CASOS REALES ────────────────────────────── -->
  {casos.length > 0 && (
    <Section kicker="Proyectos reales" title="Negocios donde ya lo aplicamos">
      <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {casos.map((c) => <ClientCard cliente={c} />)}
      </div>
      <p class="text-center mt-10" data-reveal>
        <a href="/casos" style="color:#00C8FF; font-weight:400;" class="text-sm hover:opacity-70 transition-opacity">Ver todos los casos →</a>
      </p>
    </Section>
  )}

  <!-- ── FAQ ────────────────────────────────────────────────── -->
  <Section bg="soft" border="both" kicker="Preguntas frecuentes" title="Antes de escribirnos">
    <FaqAccordion items={faqs} />
  </Section>

  <CtaBand
    title="Quiero ordenar mi contenido"
    subtitle="Contanos cómo está tu marca hoy y armamos un plan concreto."
    waMessage="Hola, quiero ordenar el contenido y la marca de mi negocio."
    servicio="contenido-marketing"
  />

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
