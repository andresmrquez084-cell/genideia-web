---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DIFERENCIALES } from '../data/soluciones';
import Cinta from '../components/premium/Cinta.astro';
import AntesDespues from '../components/premium/AntesDespues.astro';

const socios = [
  {
    nombre: 'Andrés Albornoz',
    rol: 'Fundador · Sistemas y automatización',
    desc: 'Diagnostica el proceso, diseña el sistema y lo construye. Es con quien hablás primero.',
    ig: 'https://instagram.com/andresalbornoz.ai',
    handle: '@andresalbornoz.ai',
    linkedin: 'https://www.linkedin.com/in/andres-albornoz-b498823a4',
    wsp: 'https://wa.me/59892302941',
    foto: '/img/andres.jpg',
  },
];

const bloques = [
  ['Somos', 'Andrés, fundador de GENIDEIA, trabajando desde Montevideo, Uruguay con empresas de Latinoamérica y todo el mundo.'],
  ['Te ofrecemos', 'Sistemas a medida de tu operación: seguimiento comercial, gestión de personal, paneles internos, logística, automatización de tareas repetitivas. Construimos alrededor de cómo funciona tu empresa hoy.'],
  ['Cómo empezar', 'Un diagnóstico gratis para ver dónde se pierde tiempo. Si hay algo para construir, te lo cotizamos y lo hacemos.'],
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title="Nosotros · GENIDEIA Company"
  description="GENIDEIA diseña sistemas alrededor de cómo funciona cada empresa. Consultoría operativa, no agencia."
  path="/nosotros"
>
  <div class="px-shell">
    <section class="ns-hero">
      <div>
        <p class="px-eb">Quiénes somos</p>
        <h1 class="px-split">Sistemas pensados <em>desde tu operación.</em></h1>
        <p class="px-lead px-rv">Consultoría operativa, no agencia. Primero entendemos cómo trabaja tu empresa y después construimos lo que hace falta.</p>
      </div>
      {socios.map((s) => (
        <article class="px-card px-spot px-rv ns-socio">
          <img src={s.foto} alt={s.nombre} width="120" height="150" />
          <div>
            <span class="px-tag">Fundador</span>
            <h3>{s.nombre}</h3>
            <p class="px-k">{s.rol}</p>
            <p>{s.desc}</p>
            <div class="ns-links">
              <a href={s.ig} target="_blank" rel="noopener noreferrer">{s.handle}</a>
              <a href={s.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <a href={s.wsp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
            </div>
          </div>
        </article>
      ))}
    </section>
  </div>
  <Cinta />
  <div class="px-shell">
    <section class="px-sec">
      <div class="px-grid c3">
        {bloques.map((b, i) => (
          <article class="px-card px-spot px-rv" data-n={pad(i + 1)} style={`transition-delay:${i * 0.07}s`}>
            <span class="px-k">{b[0]}</span>
            <p class="ns-txt">{b[1]}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="px-sec">
      <div class="px-head"><div><p class="px-eb">Qué nos diferencia</p><h2 class="px-split">Primero el problema, <em>después la tecnología.</em></h2></div></div>
      <div class="px-grid c2">
        <article class="px-card px-rv">
          <span class="px-k">Lo que no hacemos</span>
          <ul class="px-list no">{DIFERENCIALES.no.map((item) => <li>{item}</li>)}</ul>
        </article>
        <article class="px-card feat px-rv" style="transition-delay:.08s">
          <span class="px-k">Cómo trabajamos</span>
          <ul class="px-list">{DIFERENCIALES.si.map((item) => <li>{item}</li>)}</ul>
        </article>
      </div>
    </section>

    <AntesDespues titulo="Así cambia el día a día cuando el proceso es un sistema." />

    <section class="px-card px-close px-spot px-rv">
      <div><p class="px-eb">El siguiente paso</p><h2>¿Tiene sentido trabajar juntos?</h2><p>Coordinamos un diagnóstico y lo vemos sobre tu caso.</p></div>
      <a class="px-btn p" href="https://andres.genideiacompany.com">Agendá tu auditoría</a>
    </section>
  </div>
</BaseLayout>

<style>
  .ns-hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:44px;align-items:center;padding:80px 0 30px}
  .ns-hero h1{font-size:clamp(40px,5.6vw,70px);line-height:1.02;letter-spacing:-.045em;font-weight:700;margin:0 0 22px}
  .ns-socio{display:grid;grid-template-columns:120px minmax(0,1fr);gap:22px;align-items:center;padding:24px}
  .ns-socio img{width:120px;height:150px;object-fit:cover;border-radius:18px;border:1px solid rgba(0,200,255,.3);box-shadow:0 20px 50px -24px rgba(0,120,255,.8)}
  .ns-socio h3{font-size:22px;margin:12px 0 2px}
  .ns-socio .px-k{margin:0 0 10px}
  .ns-links{display:flex;flex-wrap:wrap;gap:8px 14px;margin-top:14px}
  .ns-links a{font-family:var(--mono);font-size:12px;color:var(--sl);text-decoration:none}.ns-links a:hover{color:var(--s)}
  .ns-txt{margin-top:12px!important;font-size:16px!important;color:var(--tx)!important;line-height:1.7!important}
  @media(max-width:980px){.ns-hero{grid-template-columns:minmax(0,1fr);padding-top:56px}}
  @media(max-width:520px){.ns-socio{grid-template-columns:minmax(0,1fr)}.ns-socio img{width:100%;height:240px}}
</style>
