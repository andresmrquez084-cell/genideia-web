---
import BaseLayout from '../layouts/BaseLayout.astro';

// Los responsables detrás de la EMPRESA (esta es la web de la marca, no un perfil personal;
// cada socio tendrá su landing personal aparte que enlaza acá).
// Para sumar la foto: dejarla en /public/img/ y completar `foto`. Andrés indica nombre/rol del socio.
const responsables = [
  {
    nombre: 'Andrés Albornoz',
    rol: 'Co-fundador',
    linea: 'Estrategia, ejecución y la cara frente a cada cliente.',
    foto: '', // ej: '/img/responsable-andres.jpg'
  },
  {
    nombre: '[ Nombre del socio ]',
    rol: 'Co-fundador',
    linea: 'Respaldo técnico y operativo del sistema.',
    foto: '',
  },
];
---

<BaseLayout title="Nosotros — GENIDEIA IA">

  <!-- ── HERO NOSOTROS ─────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 pt-28 pb-16 text-center" style="position:relative; overflow:hidden;">
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:min(600px,100%); height:360px; background:radial-gradient(ellipse at center, rgba(74,184,255,0.09) 0%, transparent 68%); pointer-events:none; z-index:0;" aria-hidden="true"></div>
    <div style="position:relative; z-index:1;">
      <p
        class="hero-animate text-xs font-medium mb-7 uppercase"
        data-delay="1"
        style="color:#4ab8ff; letter-spacing:3px;"
      >
        Quiénes somos
      </p>
      <h1
        class="hero-animate mb-7"
        data-delay="2"
        style="font-family:'Cormorant Garamond',serif; font-weight:700; line-height:1.05; letter-spacing:-1px; font-size:clamp(2.5rem, 6vw, 4.5rem);"
      >
        Una empresa con responsables.<br />
        <span style="color:#a0a0a0; font-weight:300; font-style:italic;">Con nombre, apellido y cara.</span>
      </h1>
      <p
        class="hero-animate mx-auto leading-relaxed max-w-xl text-lg"
        data-delay="3"
        style="color:#a0a0a0; font-weight:300;"
      >
        GENIDEIA IA nació de la convicción de que la tecnología bien aplicada
        puede cambiar la forma en que los negocios en América Latina operan y crecen.
      </p>
    </div>
  </section>

  <!-- ── RESPONSABLES + EMPRESA ────────────────────────────── -->
  <section style="border-top:1px solid rgba(255,255,255,0.07);" class="py-24">
    <div class="max-w-3xl mx-auto px-6">

      <!-- Los responsables detrás de la empresa (2 encuadres para fotos) -->
      <div class="mb-16" data-reveal>
        <span style="color:#4ab8ff; font-size:0.65rem; letter-spacing:2.5px; font-weight:500;" class="uppercase mb-6 block">
          Quiénes están al frente
        </span>
        <h2
          style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(1.8rem, 4vw, 3rem);"
          class="mb-4"
        >
          Los responsables detrás de esto
        </h2>
        <p style="color:#a0a0a0; font-weight:300;" class="text-lg mb-10 leading-relaxed">
          Dos socios, un mismo compromiso: que tu negocio crezca — y que sepas quién está atrás.
        </p>

        <div class="grid sm:grid-cols-2 gap-6">
          {responsables.map((r) => (
            <div class="rounded-xl overflow-hidden" style="background:#111111; border:1px solid rgba(255,255,255,0.07);" data-reveal>
              <!-- Encuadre de foto -->
              <div style="aspect-ratio:4/5; background:linear-gradient(180deg, rgba(74,184,255,0.10), rgba(255,255,255,0.02)); border-bottom:1px solid rgba(255,255,255,0.07); display:flex; align-items:center; justify-content:center;">
                {r.foto ? (
                  <img src={r.foto} alt={r.nombre} style="width:100%; height:100%; object-fit:cover;" />
                ) : (
                  <div class="text-center" style="color:rgba(74,184,255,0.5);">
                    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" style="margin:0 auto;">
                      <circle cx="12" cy="8" r="4" />
                      <path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" />
                    </svg>
                    <p style="font-size:0.58rem; letter-spacing:2px;" class="uppercase mt-2">Foto</p>
                  </div>
                )}
              </div>
              <div class="p-5 text-center">
                <h3 style="font-family:'Cormorant Garamond',serif; font-weight:600; color:#e8e8e8; font-size:1.4rem;">{r.nombre}</h3>
                <p style="color:#4ab8ff; font-size:0.62rem; letter-spacing:2px;" class="uppercase mt-1">{r.rol}</p>
                <p style="color:#a0a0a0; font-weight:300;" class="text-sm mt-3 leading-relaxed">{r.linea}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Divisor -->
      <div style="border-top:1px solid rgba(255,255,255,0.07);" class="my-16"></div>

      <!-- GENIDEIA IA -->
      <div data-reveal>
        <span style="color:#4ab8ff; font-size:0.65rem; letter-spacing:2.5px; font-weight:500;" class="uppercase mb-6 block">
          GENIDEIA IA
        </span>
        <h2
          style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(1.8rem, 4vw, 3rem);"
          class="mb-8"
        >
          La alianza que escala la visión
        </h2>

        <div class="space-y-5" style="color:#a0a0a0; font-weight:300; line-height:1.85; font-size:1rem;">
          <p data-reveal data-delay="1">
            GENIDEIA IA es la estructura que permite hacer esto a mayor escala.
            Una alianza entre dos socios con enfoque complementario: visión estratégica
            y ejecución técnica trabajando en paralelo.
          </p>
          <p data-reveal data-delay="2">
            No somos una agencia tradicional. No vendemos paquetes cerrados ni soluciones
            de estantería. Cada proyecto empieza con una pregunta: ¿cuál es el problema real?
          </p>
          <p data-reveal data-delay="3">
            Operamos en la intersección de marketing digital, automatización e inteligencia artificial,
            con foco en PyMEs latinoamericanas que quieren crecer de forma inteligente —
            sin depender de más horas de trabajo manual.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── VALORES / FORMA DE TRABAJAR ──────────────────────── -->
  <section
    style="background:#0d0d0d; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);"
    class="py-24"
  >
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16" data-reveal>
        <h2
          style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
          class="mb-4"
        >
          Cómo trabajamos
        </h2>
        <p style="color:#a0a0a0; font-weight:300;" class="text-lg max-w-lg mx-auto">
          Tres principios que guían cada proyecto.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-10">
        {[
          {
            num: '01',
            titulo: 'Problema primero',
            desc: 'Antes de proponer cualquier solución, entendemos qué está pasando realmente en el negocio. Las herramientas vienen después.',
          },
          {
            num: '02',
            titulo: 'Sin sobre-ingeniería',
            desc: 'Si se resuelve con algo simple, usamos algo simple. La complejidad tiene que justificarse con resultados, no con tecnología por la tecnología.',
          },
          {
            num: '03',
            titulo: 'Presencia posterior',
            desc: 'No entregamos y desaparecemos. Medimos, ajustamos y seguimos. El éxito del cliente es el único indicador que nos importa.',
          },
        ].map((v, i) => (
          <div data-reveal data-delay={String(i + 1)}>
            <p
              style="font-family:'Cormorant Garamond',serif; font-weight:700; color:#4ab8ff; line-height:1;"
              class="text-7xl mb-5"
            >
              {v.num}
            </p>
            <h3 style="color:#e8e8e8; font-weight:500;" class="text-lg mb-3">
              {v.titulo}
            </h3>
            <p style="color:#a0a0a0; font-weight:300;" class="text-sm leading-relaxed">
              {v.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────── -->
  <section class="max-w-3xl mx-auto px-6 py-28 text-center" data-reveal>
    <h2
      style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
      class="mb-5"
    >
      ¿Tiene sentido trabajar juntos?
    </h2>
    <p style="color:#a0a0a0; font-weight:300;" class="text-lg mb-10 leading-relaxed">
      Contame dónde estás y vemos si somos la opción correcta para tu momento.
    </p>
    <a
      href="https://wa.me/59892302941"
      target="_blank"
      rel="noopener noreferrer"
      style="background:#4ab8ff; color:#0a0a0a; font-weight:600;"
      class="px-10 py-4 rounded-lg hover:opacity-90 transition-opacity inline-block text-base"
    >
      Hablar por WhatsApp
    </a>
    <p style="color:rgba(160,160,160,0.35); font-weight:300;" class="text-sm mt-5">
      Sin compromiso · Respondemos en menos de 24 horas
    </p>
  </section>

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
