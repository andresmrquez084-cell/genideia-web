---
import BaseLayout from '../layouts/BaseLayout.astro';

type Tipo = 'caso' | 'herramienta' | 'insight' | 'actualización';

const tipoConfig: Record<Tipo, {
  label: string; color: string; bg: string; border: string; glow: string;
}> = {
  caso:          { label: 'Caso de uso',   color: '#34d399', bg: 'rgba(52,211,153,0.08)',  border: 'rgba(52,211,153,0.22)',  glow: 'rgba(52,211,153,0.07)'  },
  herramienta:   { label: 'Herramienta',   color: '#4ab8ff', bg: 'rgba(74,184,255,0.08)',  border: 'rgba(74,184,255,0.22)',  glow: 'rgba(74,184,255,0.07)'  },
  insight:       { label: 'Insight',       color: '#c084fc', bg: 'rgba(192,132,252,0.08)', border: 'rgba(192,132,252,0.22)', glow: 'rgba(192,132,252,0.07)' },
  actualización: { label: 'Actualización', color: '#fb923c', bg: 'rgba(251,146,60,0.08)',  border: 'rgba(251,146,60,0.22)',  glow: 'rgba(251,146,60,0.07)'  },
};

const feed: Array<{
  tipo: Tipo; titulo: string; resumen: string;
  fecha: string; lectura: string; destacado?: boolean;
}> = [
  {
    tipo: 'actualización',
    titulo: 'GENIDEIA IA arrancó: dos clientes, dos frentes abiertos',
    resumen: 'Empezamos a operar este año con dos clientes activos en Montevideo. Sara Centro Estético en fase de marketing digital y Hecho con el Alma con la plataforma en construcción. Primer paso dado.',
    fecha: '20 may 2025',
    lectura: '2 min',
    destacado: true,
  },
  {
    tipo: 'caso',
    titulo: 'Sara Centro Estético: construyendo presencia digital',
    resumen: 'Trabajamos con Sara en la base: estrategia de contenido, estructura de comunicación y presencia web. El objetivo es generar demanda real antes de escalar con automatización.',
    fecha: '18 may 2025',
    lectura: '3 min',
  },
  {
    tipo: 'caso',
    titulo: 'Hecho con el Alma: plataforma en desarrollo',
    resumen: 'Una plataforma que conecta artistas uruguayos con compradores de arte. Estamos construyendo la web, el sistema de contenido y la estructura de conversión.',
    fecha: '12 may 2025',
    lectura: '3 min',
  },
  {
    tipo: 'herramienta',
    titulo: 'Bot de WhatsApp para negocios: disponible',
    resumen: 'El bot está desarrollado y disponible como herramienta independiente. Gestiona consultas, agenda turnos y envía confirmaciones. Demostración disponible bajo pedido.',
    fecha: '5 may 2025',
    lectura: '3 min',
  },
  {
    tipo: 'herramienta',
    titulo: 'Sistema de contenido para inmobiliarias',
    resumen: 'Genera y publica propiedades de forma automática en redes. Un agente puede tener presencia diaria en Instagram sin intervención manual. Demo en YouTube.',
    fecha: '28 abr 2025',
    lectura: '3 min',
  },
  {
    tipo: 'insight',
    titulo: 'Por qué empezamos siempre por marketing',
    resumen: 'Automatizar un proceso que no genera demanda es automatizar el vacío. Antes de poner tecnología, hay que tener algo que escalar.',
    fecha: '20 abr 2025',
    lectura: '2 min',
  },
  {
    tipo: 'insight',
    titulo: 'El error más común de las PyMEs con IA',
    resumen: 'Comprar la herramienta sin entender el proceso. La IA no arregla procesos rotos — los acelera. Y eso puede ser peor.',
    fecha: '12 abr 2025',
    lectura: '2 min',
  },
  {
    tipo: 'insight',
    titulo: 'n8n vs Make: qué elegimos y por qué',
    resumen: 'Ambas sirven. Pero para PyMEs con procesos cambiantes, n8n da flexibilidad que Make no puede igualar — especialmente en automatizaciones con lógica de negocio compleja.',
    fecha: '5 abr 2025',
    lectura: '3 min',
  },
];

const featured = feed.find(f => f.destacado)!;
const featuredCfg = tipoConfig[featured.tipo];
const rest = feed.filter(f => !f.destacado);
const total = feed.length;
---

<BaseLayout title="El Feed · GENIDEIA IA" path="/feed">
  <div class="px-shell">
    <section class="fd-hero">
      <div>
        <p class="px-eb">GENIDEIA IA · {total} entradas</p>
        <h1 class="px-split">El <em>Feed.</em></h1>
        <p class="px-lead px-rv">Casos reales, herramientas en producción, aprendizajes del camino. Filtrá por lo que te interesa.</p>
      </div>
      <div class="px-tabs fd-filter px-rv" id="filter-bar">
        <button class="feed-pill active" data-filter="todos" style="--pill-color:#00C8FF;">Todos</button>
        {Object.entries(tipoConfig).map(([tipo, cfg]) => (
          <button class="feed-pill" data-filter={tipo} style={`--pill-color:${cfg.color};`}>{cfg.label}</button>
        ))}
      </div>
    </section>

    <section class="px-sec fd-body">
      <article id="featured-card" data-card={featured.tipo} class="px-card feat px-spot px-rv fd-feat" data-n="01" style={`--tc:${featuredCfg.color}`}>
        <span class="fd-badge">{featuredCfg.label} · Destacado</span>
        <h2>{featured.titulo}</h2>
        <p>{featured.resumen}</p>
        <p class="fd-meta">{featured.fecha} · {featured.lectura} de lectura</p>
      </article>

      <div id="feed-grid" class="fd-grid">
        {rest.map((item, i) => {
          const cfg = tipoConfig[item.tipo];
          return (
            <article data-card={item.tipo} class="px-card hov px-spot px-rv fd-card" data-n={String(i + 2).padStart(2, '0')} style={`--tc:${cfg.color};transition-delay:${(i % 3) * 0.07}s`}>
              <span class="fd-badge">{cfg.label}</span>
              <h3>{item.titulo}</h3>
              <p>{item.resumen}</p>
              <p class="fd-meta">{item.fecha} · {item.lectura}</p>
            </article>
          );
        })}
      </div>

      <div id="feed-empty" class="hidden fd-empty"><p>Próximamente contenido en esta categoría</p></div>

      <div class="fd-foot">
        <p>Actualizamos el feed regularmente</p>
        <a class="px-btn g sm" href="https://wa.me/59892302941" target="_blank" rel="noopener noreferrer">Consultanos →</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .fd-hero{display:flex;justify-content:space-between;align-items:end;gap:30px;flex-wrap:wrap;padding:80px 0 10px}
  .fd-hero h1{font-size:clamp(48px,8vw,96px);line-height:1;letter-spacing:-.05em;font-weight:700;margin:0 0 18px}
  .fd-filter{gap:4px}
  .fd-filter .feed-pill{border:0;background:transparent;color:var(--tx3);font-family:var(--sans);font-size:12.5px;padding:7px 14px;border-radius:999px;cursor:pointer;transition:.2s}
  .fd-filter .feed-pill:hover{color:#fff}
  .fd-filter .feed-pill.active{color:#fff;background:color-mix(in srgb,var(--pill-color) 18%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--pill-color) 45%,transparent);font-weight:500}
  .fd-badge{display:inline-flex;font-family:var(--mono);font-size:11px;padding:5px 11px;border-radius:999px;color:var(--tc);background:color-mix(in srgb,var(--tc) 12%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--tc) 35%,transparent)}
  .fd-feat{padding:40px;margin-bottom:16px}
  .fd-feat h2{margin:18px 0 12px;font-size:clamp(26px,3.6vw,42px);line-height:1.1;max-width:720px}
  .fd-feat>p{max-width:640px}
  .fd-grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(min(100%,290px),1fr))}
  .fd-card{display:flex;flex-direction:column}
  .fd-card h3{margin:16px 0 8px}
  .fd-meta{margin-top:auto!important;padding-top:16px;font-family:var(--mono);font-size:11px!important;color:var(--tx3)!important}
  .fd-empty{text-align:center;padding:60px 0;color:var(--tx3)}
  .fd-foot{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-top:40px;padding-top:22px;border-top:1px solid rgba(255,255,255,.06);font-family:var(--mono);font-size:12px;color:var(--tx3)}
  .fd-foot p{margin:0}
  @media(max-width:640px){.fd-feat{padding:26px}}
</style>

<script>
  // ── Feed filter ───────────────────────────────────────────
  const pills     = document.querySelectorAll('.feed-pill');
  const allCards  = document.querySelectorAll('[data-card]');
  const emptyMsg  = document.getElementById('feed-empty');

  function applyFilter(tipo) {
    // Update active pill
    pills.forEach(p => p.classList.toggle('active', p.dataset.filter === tipo));

    // Step 1: fade all cards out
    allCards.forEach(card => {
      card.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
      card.style.opacity    = '0';
      card.style.transform  = 'translateY(10px)';
    });

    setTimeout(() => {
      // Step 2: show/hide
      let visibleCount = 0;
      allCards.forEach(card => {
        const match = tipo === 'todos' || card.dataset.card === tipo;
        card.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });

      // Empty state
      if (emptyMsg) emptyMsg.classList.toggle('hidden', visibleCount > 0);

      // Step 3: staggered fade in
      const visible = [...allCards].filter(c => c.style.display !== 'none');
      visible.forEach((card, i) => {
        setTimeout(() => {
          card.style.opacity   = '1';
          card.style.transform = '';
        }, i * 55);
      });
    }, 210);
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => applyFilter(pill.dataset.filter ?? 'todos'));
  });
</script>
