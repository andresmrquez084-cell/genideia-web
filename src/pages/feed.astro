---
import BaseLayout from '../layouts/BaseLayout.astro';

type Tipo = 'caso' | 'herramienta' | 'insight' | 'actualización';

const tipoConfig: Record<Tipo, {
  label: string; color: string; bg: string; border: string; glow: string;
}> = {
  caso:          { label: 'Caso de uso',   color: '#34d399', bg: 'rgba(52,211,153,0.08)',  border: 'rgba(52,211,153,0.22)',  glow: 'rgba(52,211,153,0.07)'  },
  herramienta:   { label: 'Herramienta',   color: '#4ab8ff', bg: 'rgba(74,184,255,0.08)',  border: 'rgba(74,184,255,0.22)',  glow: 'rgba(74,184,255,0.07)'  },
  insight:       { label: 'Insight',       color: '#c084fc', bg: 'rgba(192,132,252,0.08)', border: 'rgba(192,132,252,0.22)', glow: 'rgba(192,132,252,0.07)' },
  actualización: { label: 'Actualización', color: '#fb923c', bg: 'rgba(251,146,60,0.08)',  border: 'rgba(251,146,60,0.22)',  glow: 'rgba(251,146,60,0.07)'  },
};

const feed: Array<{
  tipo: Tipo; titulo: string; resumen: string;
  fecha: string; lectura: string; destacado?: boolean;
}> = [
  {
    tipo: 'actualización',
    titulo: 'GENIDEIA IA arrancó: dos clientes, dos frentes abiertos',
    resumen: 'Empezamos a operar este año con dos clientes activos en Montevideo. Sara Centro Estético en fase de marketing digital y Hecho con el Alma con la plataforma en construcción. Primer paso dado.',
    fecha: '20 may 2025',
    lectura: '2 min',
    destacado: true,
  },
  {
    tipo: 'caso',
    titulo: 'Sara Centro Estético: construyendo presencia digital',
    resumen: 'Trabajamos con Sara en la base: estrategia de contenido, estructura de comunicación y presencia web. El objetivo es generar demanda real antes de escalar con automatización.',
    fecha: '18 may 2025',
    lectura: '3 min',
  },
  {
    tipo: 'caso',
    titulo: 'Hecho con el Alma: plataforma en desarrollo',
    resumen: 'Una plataforma que conecta artistas uruguayos con compradores de arte. Estamos construyendo la web, el sistema de contenido y la estructura de conversión.',
    fecha: '12 may 2025',
    lectura: '3 min',
  },
  {
    tipo: 'herramienta',
    titulo: 'Bot de WhatsApp para negocios: disponible',
    resumen: 'El bot está desarrollado y disponible como herramienta independiente. Gestiona consultas, agenda turnos y envía confirmaciones. Demostración disponible bajo pedido.',
    fecha: '5 may 2025',
    lectura: '3 min',
  },
  {
    tipo: 'herramienta',
    titulo: 'Sistema de contenido para inmobiliarias',
    resumen: 'Genera y publica propiedades de forma automática en redes. Un agente puede tener presencia diaria en Instagram sin intervención manual. Demo en YouTube.',
    fecha: '28 abr 2025',
    lectura: '3 min',
  },
  {
    tipo: 'insight',
    titulo: 'Por qué empezamos siempre por marketing',
    resumen: 'Automatizar un proceso que no genera demanda es automatizar el vacío. Antes de poner tecnología, hay que tener algo que escalar.',
    fecha: '20 abr 2025',
    lectura: '2 min',
  },
  {
    tipo: 'insight',
    titulo: 'El error más común de las PyMEs con IA',
    resumen: 'Comprar la herramienta sin entender el proceso. La IA no arregla procesos rotos — los acelera. Y eso puede ser peor.',
    fecha: '12 abr 2025',
    lectura: '2 min',
  },
  {
    tipo: 'insight',
    titulo: 'n8n vs Make: qué elegimos y por qué',
    resumen: 'Ambas sirven. Pero para PyMEs con procesos cambiantes, n8n da flexibilidad que Make no puede igualar — especialmente en automatizaciones con lógica de negocio compleja.',
    fecha: '5 abr 2025',
    lectura: '3 min',
  },
];

const featured = feed.find(f => f.destacado)!;
const featuredCfg = tipoConfig[featured.tipo];
const rest = feed.filter(f => !f.destacado);
const total = feed.length;
---

<BaseLayout title="El Feed — GENIDEIA IA">

  <!-- ── HEADER ────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-14">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10" data-reveal>
      <div>
        <p style="color:#4ab8ff; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">
          GENIDEIA IA
        </p>
        <h1
          style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-1.5px; line-height:0.95; font-size:clamp(3.5rem,9vw,6rem);"
        >
          El Feed
        </h1>
      </div>
      <p style="color:rgba(160,160,160,0.35); font-size:0.8rem; font-weight:300; letter-spacing:0.5px;" class="sm:text-right pb-1">
        {total} entradas
      </p>
    </div>

    <p style="color:#a0a0a0; font-weight:300;" class="text-base max-w-md mb-10" data-reveal data-delay="1">
      Casos reales, herramientas en producción, aprendizajes del camino.
      Filtrá por lo que te interesa.
    </p>

    <!-- Filter pills -->
    <div class="flex gap-2 flex-wrap" data-reveal data-delay="2" id="filter-bar">
      <button class="feed-pill active" data-filter="todos" style="--pill-color: #4ab8ff;">
        Todos
      </button>
      {Object.entries(tipoConfig).map(([tipo, cfg]) => (
        <button class="feed-pill" data-filter={tipo} style={`--pill-color: ${cfg.color};`}>
          {cfg.label}
        </button>
      ))}
    </div>
  </section>

  <!-- ── FEED CONTENT ──────────────────────────────────────── -->
  <section style="border-top:1px solid rgba(255,255,255,0.07);" class="pb-28">
    <div class="max-w-5xl mx-auto px-6 pt-10">

      <!-- ── FEATURED ─────────────────────────────────────── -->
      <article
        id="featured-card"
        data-card={featured.tipo}
        class="feed-card-featured rounded-2xl p-10 mb-8 overflow-hidden"
        style={`
          background: #111111;
          border: 1px solid ${featuredCfg.border};
          position: relative;
          --tipo-glow: ${featuredCfg.glow};
          --tipo-border: ${featuredCfg.border};
        `}
        data-reveal
      >
        <!-- Accent line top -->
        <div style={`position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg, ${featuredCfg.color}, transparent); opacity:0.8;`}></div>
        <!-- Glow top -->
        <div style={`position:absolute; top:0; left:0; right:0; height:280px; background:radial-gradient(ellipse at 30% 0%, ${featuredCfg.glow} 0%, transparent 65%); pointer-events:none;`} aria-hidden="true"></div>
        <!-- Big number (decorative) -->
        <p
          style={`position:absolute; right:2rem; bottom:-1rem; font-family:'Cormorant Garamond',serif; font-weight:700; font-size:clamp(7rem,18vw,13rem); line-height:1; color:${featuredCfg.color}; opacity:0.05; pointer-events:none; user-select:none; letter-spacing:-4px;`}
          aria-hidden="true"
        >01</p>

        <div style="position:relative; z-index:1; max-width:640px;">
          <!-- Badge -->
          <span
            style={`color:${featuredCfg.color}; background:${featuredCfg.bg}; border:1px solid ${featuredCfg.border}; font-size:0.62rem; letter-spacing:2.5px; font-weight:500;`}
            class="uppercase px-2.5 py-1 rounded inline-block mb-7"
          >
            {featuredCfg.label} · Destacado
          </span>

          <h2
            style="font-family:'Cormorant Garamond',serif; font-weight:700; color:#e8e8e8; line-height:1.08; letter-spacing:-0.5px; font-size:clamp(1.9rem,4.5vw,3rem);"
            class="mb-5"
          >
            {featured.titulo}
          </h2>

          <p style="color:#a0a0a0; font-weight:300; line-height:1.8;" class="text-base mb-8 max-w-lg">
            {featured.resumen}
          </p>

          <div class="flex items-center gap-4">
            <time style="color:rgba(160,160,160,0.45); font-size:0.8rem; font-weight:300;">
              {featured.fecha}
            </time>
            <span style="color:rgba(160,160,160,0.2);">·</span>
            <span style="color:rgba(160,160,160,0.45); font-size:0.8rem; font-weight:300;">
              {featured.lectura} de lectura
            </span>
          </div>
        </div>
      </article>

      <!-- ── GRID ─────────────────────────────────────────── -->
      <div
        id="feed-grid"
        class="grid gap-5"
        style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));"
      >
        {rest.map((item, i) => {
          const cfg = tipoConfig[item.tipo];
          const num = String(i + 2).padStart(2, '0');
          return (
            <article
              data-card={item.tipo}
              class="feed-card rounded-xl p-7 flex flex-col"
              style={`
                background: #111111;
                border: 1px solid rgba(255,255,255,0.07);
                position: relative;
                overflow: hidden;
                --tipo-glow: ${cfg.glow};
                --tipo-border: ${cfg.border};
              `}
              data-reveal
              data-delay={String((i % 3) + 1)}
            >
              <!-- Accent line top -->
              <div style={`position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg, ${cfg.color}, transparent); opacity:0.55;`}></div>
              <!-- Big number (decorative) -->
              <p
                style={`position:absolute; right:0.75rem; bottom:-0.5rem; font-family:'Cormorant Garamond',serif; font-weight:700; font-size:5.5rem; line-height:1; color:${cfg.color}; opacity:0.05; pointer-events:none; user-select:none; letter-spacing:-2px;`}
                aria-hidden="true"
              >{num}</p>

              <div style="position:relative; z-index:1; display:flex; flex-direction:column; height:100%;">
                <!-- Badge -->
                <span
                  style={`color:${cfg.color}; background:${cfg.bg}; border:1px solid ${cfg.border}; font-size:0.6rem; letter-spacing:2px; font-weight:500;`}
                  class="uppercase px-2 py-0.5 rounded inline-block mb-5 self-start"
                >
                  {cfg.label}
                </span>

                <h3
                  style="font-family:'Cormorant Garamond',serif; font-weight:700; color:#e8e8e8; line-height:1.12; letter-spacing:-0.3px; font-size:clamp(1.2rem,2.5vw,1.55rem);"
                  class="mb-3"
                >
                  {item.titulo}
                </h3>

                <p style="color:#a0a0a0; font-weight:300; line-height:1.7; flex:1;" class="text-sm mb-6">
                  {item.resumen}
                </p>

                <div class="flex items-center gap-3 mt-auto">
                  <time style="color:rgba(160,160,160,0.4); font-size:0.75rem; font-weight:300;">
                    {item.fecha}
                  </time>
                  <span style="color:rgba(160,160,160,0.2); font-size:0.75rem;">·</span>
                  <span style="color:rgba(160,160,160,0.4); font-size:0.75rem; font-weight:300;">
                    {item.lectura}
                  </span>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Empty state (hidden by default) -->
      <div
        id="feed-empty"
        class="hidden text-center py-20"
      >
        <p style="font-family:'Cormorant Garamond',serif; font-size:3rem; color:rgba(160,160,160,0.1); font-weight:700; letter-spacing:-1px;" class="mb-4">
          —
        </p>
        <p style="color:rgba(160,160,160,0.4); font-weight:300; font-size:0.9rem;">
          Próximamente contenido en esta categoría
        </p>
      </div>

      <!-- Footer del feed -->
      <div style="border-top:1px solid rgba(255,255,255,0.06);" class="mt-14 pt-8 flex items-center justify-between gap-4">
        <p style="color:rgba(160,160,160,0.3); font-size:0.78rem; font-weight:300; letter-spacing:0.3px;">
          Actualizamos el feed regularmente
        </p>
        <a
          href="https://wa.me/59892302941"
          target="_blank"
          rel="noopener noreferrer"
          style="color:#4ab8ff; font-size:0.78rem; font-weight:400;"
          class="hover:opacity-70 transition-opacity whitespace-nowrap"
        >
          Consultanos →
        </a>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  // ── Scroll reveal ─────────────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.06, rootMargin: '0px 0px -30px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

  // ── Feed filter ───────────────────────────────────────────
  const pills     = document.querySelectorAll('.feed-pill');
  const allCards  = document.querySelectorAll('[data-card]');
  const emptyMsg  = document.getElementById('feed-empty');

  function applyFilter(tipo) {
    // Update active pill
    pills.forEach(p => p.classList.toggle('active', p.dataset.filter === tipo));

    // Step 1: fade all cards out
    allCards.forEach(card => {
      card.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
      card.style.opacity    = '0';
      card.style.transform  = 'translateY(10px)';
    });

    setTimeout(() => {
      // Step 2: show/hide
      let visibleCount = 0;
      allCards.forEach(card => {
        const match = tipo === 'todos' || card.dataset.card === tipo;
        card.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });

      // Empty state
      if (emptyMsg) emptyMsg.classList.toggle('hidden', visibleCount > 0);

      // Step 3: staggered fade in
      const visible = [...allCards].filter(c => c.style.display !== 'none');
      visible.forEach((card, i) => {
        setTimeout(() => {
          card.style.opacity   = '1';
          card.style.transform = '';
        }, i * 55);
      });
    }, 210);
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => applyFilter(pill.dataset.filter ?? 'todos'));
  });
</script>
