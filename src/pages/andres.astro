  <!-- Calendly widget script -->
  <script src="https://assets.calendly.com/assets/external/widget.js" async is:inline></script>

  <script define:vars={{ calendlyEmbed }}>
    // ── Meta Pixel: eventos del embudo. No-op si el píxel no está instalado. ──
    const track = (evento) => { if (window.fbq) window.fbq('track', evento); };

    // Agendó la llamada: el widget inline de Calendly lo avisa por postMessage.
    window.addEventListener('message', (e) => {
      if (typeof e.origin !== 'string' || e.origin.indexOf('calendly.com') === -1) return;
      if (e.data && e.data.event === 'calendly.event_scheduled') track('Lead');
    });

    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => obs.observe(el));

    // ── Portada-gancho: el overlay arranca el video y se oculta ──
    document.querySelectorAll('[data-video-wrap]').forEach((wrap) => {
      const v = wrap.querySelector('video');
      const cover = wrap.querySelector('[data-video-cover]');
      if (!v || !cover) return;
      cover.addEventListener('click', () => { v.play(); });
      v.addEventListener('play', () => wrap.classList.add('playing'));
    });

    // ── Gating VSL: el video principal desbloquea el CTA (Calendly) ──
    let calendlyReady = false;
    function initCalendly() {
      if (calendlyReady) return;
      const box = document.getElementById('calendly-box');
      if (box && window.Calendly) {
        box.innerHTML = '';
        window.Calendly.initInlineWidget({ url: calendlyEmbed, parentElement: box });
        calendlyReady = true;
      }
    }
    // ── Cascada: cada video abre el bloque siguiente; el último abre el Calendly ──
    // Si un bloque todavía no tiene video subido, no traba a nadie: al llegarle el turno
    // abre el siguiente en el acto (por eso la cadena se activa paso a paso y no toda junta).
    const PASOS = [
      { videos: ['vid-porque'],  gate: 'gate-metodo',   hint: 'porque' },
      { videos: ['vid-metodo'],  gate: 'gate-ejemplos', hint: 'metodo' },
      // el 03 tiene un video por rubro (el visitante solo mira el suyo) — cualquiera de
      // los que existan en el DOM puede disparar el desbloqueo.
      { videos: Array.from(document.querySelectorAll('[data-rubro-video] video')).map((v) => v.id), gate: 'gate-agenda', hint: 'ejemplos', calendly: true },
    ];

    function activarPaso(i) {
      const paso = PASOS[i];
      if (!paso) return;
      const gate = document.getElementById(paso.gate);
      const hint = document.querySelector('[data-lock-hint="' + paso.hint + '"]');
      let unlocked = false;
      const unlock = () => {
        if (unlocked) return; unlocked = true;
        gate && gate.classList.remove('gate-locked');
        hint && hint.classList.add('hide');
        gate && gate.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
        // el widget de Calendly no renderiza dentro de display:none → inicializar al revelar
        if (paso.calendly) setTimeout(initCalendly, 60);
        activarPaso(i + 1);
      };
      const vs = paso.videos.map((id) => document.getElementById(id)).filter(Boolean);
      if (!vs.length) { unlock(); return; }
      vs.forEach((v) => {
        const wrap = v.closest('[data-video-wrap]');
        // la pantalla final aparece SOLO cuando el video termina de verdad
        v.addEventListener('ended', () => { wrap && wrap.classList.add('ended'); unlock(); track('ViewContent'); });
        // salvaguarda: desbloquea muy cerca del final, sin mostrar el end-screen
        v.addEventListener('timeupdate', () => { if (v.duration && v.currentTime / v.duration > 0.99) unlock(); });
        v.addEventListener('error', unlock);
        const src = v.querySelector('source');
        src && src.addEventListener('error', unlock);
      });
    }
    activarPaso(0);

    // ── Selector de rubro (bloque 03) ──
    const rubroBtns = document.querySelectorAll('[data-rubro-btn]');
    const rubroPanels = document.querySelectorAll('[data-rubro-panel]');
    function activarRubro(id) {
      rubroBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-rubro-btn') === id));
      rubroPanels.forEach((p) => p.classList.toggle('active', p.getAttribute('data-rubro-panel') === id));
    }
    rubroBtns.forEach((b) => b.addEventListener('click', () => activarRubro(b.getAttribute('data-rubro-btn'))));
    const rubroDef = document.querySelector('[data-rubro-btn][data-default="true"]');
    if (rubroDef) activarRubro(rubroDef.getAttribute('data-rubro-btn'));
  </script>

  <style>
    /* ── Header flotante (pill) ─────────────────────────────── */
