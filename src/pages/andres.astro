---
// Landing personal de Andrés Albornoz — soluciones operativas.
// Estructura VSL en cascada: Promesa → 3 videos secuenciales → [gate] Agendá (Calendly) + Presentación.
//   01 · Por qué estoy seguro de que puedo ayudarte  (rompe "en mi empresa todo funciona bien")
//   02 · Cuál es el método                            (cómo se trabaja, paso a paso)
//   03 · Ejemplos de lo que podrías desarrollar       (herramientas concretas)
// Cada bloque aparece cuando termina el video del anterior. El Calendly se desbloquea con el 03.
import fs from 'node:fs';
import Loader from '../transitions/Loader.astro';
import '../transitions/transitions.css';
import '../styles/global.css';
import { RUBROS_EJEMPLOS } from '../data/ejemplos-rubros';

const WA = '59892302941';
const waMsg = encodeURIComponent('Hola Andrés, vi tu presentación y quiero coordinar un diagnóstico para mi empresa.');
const waUrl = `https://wa.me/${WA}?text=${waMsg}`;

// Meta Pixel — pegar acá el ID del píxel (~15 dígitos) cuando exista el Business Manager.
// Vacío = no se inyecta nada y la landing funciona igual. Con ID se disparan tres eventos:
//   PageView (al cargar) · ViewContent (cuando termina el video) · Lead (cuando agenda en Calendly).
const FB_PIXEL_ID = '';

// Calendly — llamada de diagnóstico (Google Meet / teléfono, 45 min).
const CALENDLY = 'https://calendly.com/genideiaconsultoraia/llamada-de-diagnostico';
const calendlyEmbed = `${CALENDLY}?hide_gdpr_banner=1&background_color=0b1324&text_color=f2f4f7&primary_color=00c8ff`;

// ───────────────────────────────────────────────────────────────
// VIDEOS DE LA SECUENCIA — subí los archivos a public/videos/
// Mientras un video no exista, ese bloque muestra un aviso y no bloquea
// al visitante: la cascada sigue igual y el Calendly queda accesible.
// ───────────────────────────────────────────────────────────────
const publicDir = new URL('../../public', import.meta.url);
const existeArchivo = (ruta: string) => fs.existsSync(new URL(`.${ruta}`, `${publicDir}/`));

const VIDEO_01 = '/videos/andres-01-porque.mp4';
const VIDEO_02 = '/videos/andres-02-metodo.mp4';

// Hasta que exista el video 01 nuevo, el bloque usa el VSL actual.
const src01 = existeArchivo(VIDEO_01) ? VIDEO_01 : '/videos/landing-andres.mp4';

const BLOQUES = [
  {
    id: 'porque',
    num: '01',
    eyebrow: 'Antes que nada',
    titulo: '¿Por qué estoy seguro de que puedo ayudarte?',
    bajada:
      'Porque no comparo tu empresa contra una empresa estancada, que no quiere crecer. La comparo contra lo que tu propia empresa podría estar haciendo hoy. Y ahí siempre hay diferencia.',
    video: src01,
    poster: '',
    hint: 'Mirá el video para seguir',
  },
  {
    id: 'metodo',
    num: '02',
    eyebrow: 'Cómo trabajo',
    titulo: '¿Cuál es el método?',
    bajada:
      'No se empieza por sumar herramientas. Primero se ordena cómo tu empresa se presenta, atrae y atiende — recién al final se acelera con anuncios.',
    video: VIDEO_02,
    poster: '',
    hint: 'Mirá el video para seguir',
  },
  {
    id: 'ejemplos',
    num: '03',
    eyebrow: 'Qué se puede hacer',
    titulo: '¿Cuáles son los ejemplos que empresas como vos ya están aplicando?',
    bajada:
      'Ninguno de estos es un producto de catálogo: son soluciones que salieron de un diagnóstico concreto. Elegí tu rubro para ver los ejemplos que aplican.',
    hint: 'Mirá un ejemplo para agendar tu diagnóstico',
  },
].map((b) => ({ ...b, disponible: b.video ? existeArchivo(b.video) : true }));

// Bloque 01 — de "está todo perfecto" al ángulo del potencial
const DOS_POTENCIALES = [
  {
    tipo: 'Potencial de venta',
    hoy: 'Vendés lo mismo que el año pasado y el negocio no se cae. Todo bien.',
    real: 'Pero si no ajustás lo que hace falta para vender más, quedás estancado. Contra lo que podrías estar facturando, eso es plata que no entra.',
  },
  {
    tipo: 'Potencial de ahorro',
    hoy: 'Tus costos son los que son y el número cierra a fin de mes. Todo bien.',
    real: 'Pero si esos costos podrían ser más bajos y no los tocaste, la diferencia la estás pagando igual. Es plata que sale sin necesidad.',
  },
];

// Bloque 02 — el método: sistema de 7 etapas (mismo contenido del video)
const METODO = [
  { paso: '01', titulo: 'Punto de partida', desc: 'Tengas web sin usar o no tengas web, es la misma situación: falta un sistema que convierta visitas en consultas.' },
  { paso: '02', titulo: 'Base del sistema', desc: 'No se empieza de cero. Ya tenés oferta, experiencia y canales — falta empaquetarlo de forma clara y accesible.' },
  { paso: '03', titulo: 'Claridad y posicionamiento', desc: 'Primero, que te reconozcan: quién sos, qué resolvés y cómo avanzar, en pocos segundos.' },
  { paso: '04', titulo: 'Contenido con intención', desc: 'Problema → explicación → solución. Así el contenido también le llega a quien todavía no te conoce.' },
  { paso: '05', titulo: 'Centralizar la atención', desc: 'El sistema interpreta la consulta y recién deriva a una persona cuando realmente agrega valor.' },
  { paso: '06', titulo: 'Seguimiento y confianza', desc: 'A quien no tiene urgencia hoy no se lo pierde: se le hace seguimiento hasta que esté listo.' },
  { paso: '07', titulo: 'Crecimiento medible', desc: 'Recién cuando el mensaje ya funciona se acelera con anuncios. Nunca antes.' },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Andrés Albornoz — Soluciones operativas para tu empresa</title>
  <meta name="description" content="Ayudo a empresas a optimizar sus operaciones diarias con herramientas de Inteligencia Artificial. Andrés Albornoz — GENIDEIA." />
  <meta property="og:title" content="Andrés Albornoz — Soluciones operativas" />
  <meta property="og:description" content="Tu negocio podría estar perdiendo dinero en los procedimientos diarios. Te enseño los indicadores que lo comprueban y cómo recuperás ese dinero." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://genideiacompany.com/og-genideia.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://genideiacompany.com/og-genideia.png" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script>import '../transitions/reveal.js';</script>
  {FB_PIXEL_ID && (
    <script define:vars={{ FB_PIXEL_ID }} is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', FB_PIXEL_ID);
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${FB_PIXEL_ID}&ev=PageView&noscript=1`} /></noscript>
  )}
</head>
<body style="background:#07080D radial-gradient(ellipse 90% 55% at 50% -8%, rgba(0,200,255,0.10), transparent 62%) no-repeat fixed; color:#F2F4F7; font-family:'Poppins',sans-serif; -webkit-font-smoothing:antialiased;">
  <Loader logoSrc="/img/logo-nav.png" />

  <!-- ── HEADER (pill flotante) ─────────────────────────────── -->
  <header class="site-header">
    <a href="/andres" class="brand">
      <span class="brand-mark">A</span>
      <span class="brand-copy">
        <strong>Andrés Albornoz</strong>
        <small>Soluciones operativas · GENIDEIA</small>
      </span>
    </a>
    <nav class="header-nav" aria-label="Navegación de la página">
      <a href="#porque">Por qué</a>
      <a href="#metodo">Método</a>
      <a href="#ejemplos">Ejemplos</a>
    </nav>
    <a href={waUrl} target="_blank" rel="noopener noreferrer" class="header-cta">Hablemos</a>
  </header>

  <!-- ── HERO · promesa grande ─────────────────────────────── -->
  <section class="max-w-4xl mx-auto px-6 pt-36 pb-14 text-center">
    <p class="text-xs font-medium mb-6 uppercase" style="color:#00C8FF; letter-spacing:3px;" data-reveal>Soluciones operativas · GENIDEIA</p>
    <h1 class="mb-7 mx-auto" style="font-family:'Montserrat',sans-serif; font-weight:700; line-height:0.98; letter-spacing:-0.04em; font-size:clamp(2.1rem, 6vw, 4.2rem); max-width:22ch;" data-reveal data-delay="1">
      Tu negocio podría estar <span style="color:#00C8FF;">perdiendo dinero</span> en los procedimientos diarios.
    </h1>
    <p class="mb-10 leading-relaxed max-w-xl mx-auto text-lg" style="color:#B8BEC7; font-weight:300;" data-reveal data-delay="2">
      Te lo explico en tres partes: por qué estoy seguro de que puedo ayudarte, cuál es el método
      y cuáles son los ejemplos que empresas como vos ya están aplicando.
    </p>
    <a href="#porque" style="color:#00C8FF; font-weight:500; letter-spacing:1px;" class="text-sm hover:opacity-70 transition-opacity" data-reveal data-delay="3">↓ Empecemos</a>
  </section>

  <!-- ══ 01 · POR QUÉ PUEDO AYUDARTE ══════════════════════════ -->
  <section id="porque" class="max-w-4xl mx-auto px-6 pt-8 pb-16">
    <div class="text-center mb-9" data-reveal>
      <p class="paso-eyebrow">{BLOQUES[0].num} · {BLOQUES[0].eyebrow}</p>
      <h2 class="paso-titulo">{BLOQUES[0].titulo}</h2>
      <p class="paso-bajada">{BLOQUES[0].bajada}</p>
    </div>

    <div class="video-main-wrap" data-video-wrap data-reveal>
      <video id="vid-porque" controls playsinline preload="metadata" style="width:100%; height:100%; object-fit:contain; display:block; background:#0B1324;">
        <source src={BLOQUES[0].video} type="video/mp4" />
        Tu navegador no soporta el video.
      </video>
      <button type="button" class="video-cover" data-video-cover aria-label="Reproducir video">
        <span class="play-btn"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
        <span class="cover-hint">Mirá esto antes<br/>de agendar</span>
      </button>
      <div class="video-end" data-video-end>
        <p class="video-end-title">Ahora sí: así es como se trabaja.</p>
        <a href="#metodo" class="video-end-btn">Ver el método →</a>
      </div>
    </div>

    <!-- La anécdota: la respuesta que da el 99% -->
    <div class="anecdota" data-reveal>
      <p class="anecdota-cita">“Para mí está todo perfecto.”</p>
      <p class="anecdota-pie">
        Es la respuesta que me dio el dueño de un negocio esta semana cuando le pregunté cómo le iba.
        Y es la que voy a escuchar en 99 de cada 100 empresas — <strong style="color:#F2F4F7; font-weight:600;">con razón</strong>.
      </p>
    </div>

    <p class="parrafo-arg" data-reveal>
      Si nadie ve un problema, es porque no lo hay: comprás a un precio, vendés a otro y queda ganancia.
      Mirado así, la empresa funciona. Y no vine a discutirte eso.
    </p>

    <p class="parrafo-arg parrafo-giro" data-reveal>
      Lo que cambia todo es contra qué te comparás. No contra una empresa estancada, que no quiere crecer —
      <span style="color:#00C8FF;">contra lo que tu propia empresa podría estar haciendo hoy</span>.
      Eso es potencial. Y desde ese ángulo, siempre hay diferencia: siempre hay algo para mejorar en la venta y algo para mejorar en el ahorro.
    </p>

    <!-- Las dos formas de perder dinero sin darte cuenta -->
    <div class="grid sm:grid-cols-2 gap-4 mt-9">
      {DOS_POTENCIALES.map((p, i) => (
        <div class="creencia-card" data-reveal data-delay={i % 2}>
          <p class="pot-tipo">{p.tipo}</p>
          <p class="pot-hoy">{p.hoy}</p>
          <p class="pot-real">{p.real}</p>
        </div>
      ))}
    </div>

    <p class="text-center mt-9 mx-auto" style="font-family:'Montserrat',sans-serif; font-weight:600; font-size:clamp(1.05rem,2.4vw,1.45rem); line-height:1.35; max-width:32ch; color:#F2F4F7;" data-reveal>
      Por eso puedo decirte con seguridad que puedo ayudarte: <span style="color:#00C8FF;">no hay empresa sin potencial sin usar</span>.
    </p>
    <p class="text-center mt-4 mx-auto text-sm" style="color:#B8BEC7; font-weight:300; max-width:52ch;" data-reveal>
      La única pregunta que queda es cuánto vale esa diferencia en tu caso. Eso es exactamente lo que medimos en el diagnóstico.
    </p>

    <p class="lock-hint text-center mt-8" data-lock-hint="porque" style="color:rgba(0,200,255,0.75); font-size:0.85rem; letter-spacing:1px;"><span style="font-size:0.95rem;">🔒</span> {BLOQUES[0].hint}</p>
  </section>

  <!-- ╔═══ GATE 02 — se abre al terminar el video 01 ═══╗ -->
  <div id="gate-metodo" class="gate-locked">
  <section id="metodo" style="background:#0B1324; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-16">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-9" data-reveal>
        <p class="paso-eyebrow">{BLOQUES[1].num} · {BLOQUES[1].eyebrow}</p>
        <h2 class="paso-titulo">{BLOQUES[1].titulo}</h2>
        <p class="paso-bajada">{BLOQUES[1].bajada}</p>
      </div>

      {BLOQUES[1].disponible ? (
        <div class="video-main-wrap" data-video-wrap data-reveal>
          <video id="vid-metodo" controls playsinline preload="metadata" style="width:100%; height:100%; object-fit:contain; display:block; background:#0B1324;">
            <source src={BLOQUES[1].video} type="video/mp4" />
            Tu navegador no soporta el video.
          </video>
          <button type="button" class="video-cover" data-video-cover aria-label="Reproducir video">
            <span class="play-btn"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
            <span class="cover-hint">El sistema completo,<br/>paso a paso</span>
          </button>
          <div class="video-end" data-video-end>
            <p class="video-end-title">¿Y qué podrías tener funcionando vos?</p>
            <a href="#ejemplos" class="video-end-btn">Ver ejemplos →</a>
          </div>
        </div>
      ) : (
        <div class="video-pendiente" data-reveal>Video en producción · el bloque queda publicado y no bloquea el resto</div>
      )}

      <!-- Los 4 pasos -->
      <div class="grid sm:grid-cols-2 gap-4 mt-10">
        {METODO.map((m, i) => (
          <div class="metodo-card" data-reveal data-delay={i % 2}>
            <span class="metodo-num">{m.paso}</span>
            <div>
              <h3 class="metodo-titulo">{m.titulo}</h3>
              <p class="metodo-desc">{m.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="lock-hint text-center mt-8" data-lock-hint="metodo" style="color:rgba(0,200,255,0.75); font-size:0.85rem; letter-spacing:1px;"><span style="font-size:0.95rem;">🔒</span> {BLOQUES[1].hint}</p>
    </div>
  </section>
  </div><!-- ╚═══ /GATE 02 ═══╝ -->

  <!-- ╔═══ GATE 03 — se abre al terminar el video 02 ═══╗ -->
  <div id="gate-ejemplos" class="gate-locked">
  <section id="ejemplos" class="max-w-4xl mx-auto px-6 py-16">
    <div class="text-center mb-9" data-reveal>
      <p class="paso-eyebrow">{BLOQUES[2].num} · {BLOQUES[2].eyebrow}</p>
      <h2 class="paso-titulo">{BLOQUES[2].titulo}</h2>
      <p class="paso-bajada">{BLOQUES[2].bajada}</p>
    </div>

    <!-- Selector de rubro -->
    <div class="rubro-picker" data-reveal>
      <p class="rubro-pregunta">¿De qué rubro sos?</p>
      <div class="rubro-btns">
        {RUBROS_EJEMPLOS.map((r, i) => (
          <button type="button" class="rubro-btn" data-rubro-btn={r.id} data-default={i === 0 ? 'true' : undefined}>{r.label}</button>
        ))}
      </div>
    </div>

    <!-- Paneles por rubro -->
    {RUBROS_EJEMPLOS.map((r) => (
      <div class="rubro-panel" data-rubro-panel={r.id}>
        {r.video ? (
          <div class="video-main-wrap" data-video-wrap data-rubro-video={r.id}>
            <video id={`vid-ejemplos-${r.id}`} controls playsinline preload="metadata" style="width:100%; height:100%; object-fit:contain; display:block; background:#0B1324;">
              <source src={r.video} type="video/mp4" />
              Tu navegador no soporta el video.
            </video>
            <button type="button" class="video-cover" data-video-cover aria-label="Reproducir video">
              <span class="play-btn"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              <span class="cover-hint">Ejemplos para {r.label.toLowerCase()}</span>
            </button>
            <div class="video-end" data-video-end>
              <p class="video-end-title">¿Querés saber cuál de estos te conviene primero?</p>
              <a href="#agenda" class="video-end-btn">Agendá tu diagnóstico →</a>
            </div>
          </div>
        ) : (
          <div class="video-pendiente">Todavía no tenemos ejemplos armados para este rubro — escribinos y lo vemos juntos en el diagnóstico.</div>
        )}

        {r.items.length > 0 && (
          <div class="grid sm:grid-cols-2 gap-4 mt-8">
            {r.items.map((e) => (
              <div class="ejemplo-card">
                <h3 class="ejemplo-titulo">{e.titulo}</h3>
                <p class="ejemplo-desc">{e.desc}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    ))}

    <p class="text-center mt-8 text-sm" style="color:#B8BEC7; font-weight:300;" data-reveal>
      Cuál de todos te sirve — y en qué orden — sale del diagnóstico. No al revés.
    </p>

    <p class="lock-hint text-center mt-8" data-lock-hint="ejemplos" style="color:rgba(0,200,255,0.75); font-size:0.85rem; letter-spacing:1px;"><span style="font-size:0.95rem;">🔒</span> {BLOQUES[2].hint}</p>
  </section>
  </div><!-- ╚═══ /GATE 03 ═══╝ -->

  <!-- ╔═══ GATE — se desbloquea cuando termina el video 03 ═══╗ -->
  <div id="gate-agenda" class="gate-locked">

  <!-- ── AGENDÁ (Calendly) ─────────────────────────────────── -->
  <section id="agenda" style="background:#0B1324; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10" data-reveal>
        <p style="color:#00C8FF; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">El siguiente paso</p>
        <h2 style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.2rem);">Agendá tu diagnóstico inicial.</h2>
      </div>
      <!-- Calendly inline -->
      <div id="calendly-box" class="calendly-inline-widget" data-url={calendlyEmbed} style="min-width:320px; height:700px; border-radius:14px; overflow:hidden; border:1px solid rgba(0,200,255,0.2);" data-reveal></div>
      <p class="text-center mt-6 text-sm" style="color:#B8BEC7; font-weight:300;" data-reveal>
        ¿Preferís escribir? <a href={waUrl} target="_blank" rel="noopener noreferrer" style="color:#00C8FF; text-decoration:underline;">Hablemos por WhatsApp →</a>
      </p>
    </div>
  </section>

  <!-- ── PRESENTACIÓN BREVE (opción a conocerme) ───────────── -->
  <section id="presentacion" class="py-20">
    <div class="max-w-4xl mx-auto px-6 grid sm:grid-cols-[auto_1fr] gap-8 items-center">
      <div data-reveal style="width:130px; height:160px; border-radius:14px; overflow:hidden; border:1px solid rgba(0,200,255,0.25); margin:0 auto;">
        <img src="/img/andres.jpg" alt="Andrés Albornoz" style="width:100%; height:100%; object-fit:cover; object-position:center 25%; display:block;" />
      </div>
      <div data-reveal data-delay="1" class="text-center sm:text-left">
        <p style="color:#00C8FF; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-3">Quién soy</p>
        <h3 style="font-family:'Montserrat',sans-serif; font-weight:700;" class="text-2xl mb-3">Andrés Albornoz</h3>
        <p style="color:#B8BEC7; font-weight:300;" class="leading-relaxed">
          Ayudo a empresas a optimizar sus operaciones diarias con herramientas de Inteligencia Artificial.
        </p>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ────────────────────────────────────────────── -->
  <footer style="border-top:1px solid rgba(255,255,255,0.07);" class="py-10">
    <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm" style="color:#B8BEC7;">
      <div>
        <p style="font-family:'Montserrat',sans-serif; font-size:1.05rem; color:#F2F4F7;">Andrés Albornoz</p>
        <p style="font-weight:300; font-size:0.8rem;">Cofundador de <a href="/" style="color:#00C8FF;">GENIDEIA Company</a> · Soluciones operativas</p>
      </div>
      <div class="flex flex-col sm:items-end gap-1">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" style="font-weight:300;" class="hover:text-[#00C8FF] transition-colors">WhatsApp +598 92 302 941</a>
