---
// CARTEL TEMPORAL — landing pausada para corrección (2026-07-08).
// La landing real quedó intacta en `_andres.astro` (el guion bajo desactiva la ruta).
// Para restaurar: borrar este archivo y renombrar `_andres.astro` → `andres.astro`.
const WA = '59892302941';
const waMsg = encodeURIComponent('Hola Andrés, quiero coordinar un diagnóstico para mi empresa.');
const waUrl = `https://wa.me/${WA}?text=${waMsg}`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Andrés Albornoz — Soluciones operativas</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet" />
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #07080D radial-gradient(ellipse 90% 55% at 50% -8%, rgba(0,200,255,0.10), transparent 62%) no-repeat fixed;
      color: #F2F4F7;
      font-family: 'Poppins', sans-serif;
      -webkit-font-smoothing: antialiased;
      text-align: center;
    }
    .box { padding: 2rem 1.5rem; max-width: 30rem; }
    .spinner {
      width: 44px; height: 44px;
      margin: 0 auto 2rem;
      border: 3px solid rgba(0,200,255,0.18);
      border-top-color: #00C8FF;
      border-radius: 50%;
      animation: girar 0.9s linear infinite;
    }
    @keyframes girar { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 3s; } }
    h1 {
      font-family: 'Montserrat', sans-serif;
      font-weight: 700;
      font-size: clamp(1.3rem, 4.5vw, 1.8rem);
      letter-spacing: -0.4px;
      margin: 0 0 0.8rem;
    }
    h1 span { color: #00C8FF; }
    p { color: #B8BEC7; font-weight: 300; line-height: 1.6; margin: 0 0 2.2rem; }
    .wa {
      display: inline-block;
      background: linear-gradient(135deg, #00C8FF, #007BFF);
      color: #0A0F1A;
      font-weight: 600;
      font-size: 0.85rem;
      padding: 0.7rem 1.4rem;
      border-radius: 0.6rem;
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .wa:hover { opacity: 0.9; }
    .marca {
      margin-top: 3rem;
      font-size: 0.6rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: rgba(242,244,247,0.35);
    }
  </style>
</head>
<body>
  <main class="box">
    <div class="spinner" aria-hidden="true"></div>
    <h1>Cargando<span>…</span></h1>
    <p>Estamos ajustando esta presentación.</p>
    <a class="wa" href={waUrl} target="_blank" rel="noopener noreferrer">Escribime por WhatsApp</a>
    <div class="marca">Andrés Albornoz · Soluciones operativas · GENIDEIA</div>
  </main>
</body>
</html>
