---
// Landing personal de Andrés Albornoz — soluciones operativas.
// Flujo de conversión corto: Presentación → Video principal → Agendar (ya, sin gating).
// El resto de los videos (método, ejemplos) quedan como contenido OPCIONAL más abajo,
// para quien quiera profundizar antes de agendar. Nada bloquea el CTA de agenda.
import fs from 'node:fs';
import Loader from '../transitions/Loader.astro';
import '../transitions/transitions.css';
import '../styles/global.css';
import { RUBROS_EJEMPLOS } from '../data/ejemplos-rubros';

const WA = '59892302941';
const waMsg = encodeURIComponent('Hola Andrés, vi tu presentación y quiero coordinar un diagnóstico para mi empresa.');
const waUrl = `https://wa.me/${WA}?text=${waMsg}`;

// Meta Pixel — pegar acá el ID del píxel (~15 dígitos) cuando exista el Business Manager.
// Vacío = no se inyecta nada y la landing funciona igual. Con ID se disparan tres eventos:
//   PageView (al cargar) · ViewContent (cuando termina un video) · Lead (cuando agenda en Calendly).
const FB_PIXEL_ID = '';

// Calendly — llamada de diagnóstico (Google Meet / teléfono, 45 min).
const CALENDLY = 'https://calendly.com/genideiaconsultoraia/llamada-de-diagnostico';
const calendlyEmbed = `${CALENDLY}?hide_gdpr_banner=1&background_color=0b1324&text_color=f2f4f7&primary_color=00c8ff`;

// ───────────────────────────────────────────────────────────────
// VIDEOS — subí los archivos a public/videos/
// Mientras un video no exista, ese bloque muestra un aviso y no rompe nada.
// ───────────────────────────────────────────────────────────────
const publicDir = new URL('../../public', import.meta.url);
const existeArchivo = (ruta: string) => fs.existsSync(new URL(`.${ruta}`, `${publicDir}/`));

const VIDEO_01 = '/videos/andres-01-porque.mp4';
const VIDEO_02 = '/videos/andres-02-metodo.mp4';

// Hasta que exista el video 01 nuevo, el bloque usa el VSL actual.
const src01 = existeArchivo(VIDEO_01) ? VIDEO_01 : '/videos/landing-andres.mp4';

const BLOQUES = [
  {
    id: 'porque',
    eyebrow: 'Antes de agendar',
    titulo: '¿Por qué estoy seguro de que puedo ayudarte?',
    video: src01,
  },
  {
    id: 'metodo',
    eyebrow: 'Método',
    titulo: '¿Cuál es el método?',
    video: VIDEO_02,
  },
  {
    id: 'ejemplos',
    eyebrow: 'Ejemplos',
    titulo: '¿Cuáles son los ejemplos que empresas como vos ya están aplicando?',
  },
].map((b) => ({ ...b, disponible: b.video ? existeArchivo(b.video) : true }));

// Foto de Andrés — retrato real. Si algún día no está, cae a un placeholder identificable.
const FOTO_ANDRES = '/img/andres.jpg';
const tieneFoto = existeArchivo(FOTO_ANDRES);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Andrés Albornoz — Soluciones operativas para tu empresa</title>
  <meta name="description" content="Ayudo a empresas a optimizar sus operaciones diarias con herramientas de Inteligencia Artificial. Andrés Albornoz — GENIDEIA." />
  <meta property="og:title" content="Andrés Albornoz — Soluciones operativas" />
  <meta property="og:description" content="Tu negocio podría estar perdiendo dinero en los procedimientos diarios. Te enseño los indicadores que lo comprueban y cómo recuperás ese dinero." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://genideiacompany.com/og-genideia.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://genideiacompany.com/og-genideia.png" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script>import '../transitions/reveal.js';</script>
  {FB_PIXEL_ID && (
    <script define:vars={{ FB_PIXEL_ID }} is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', FB_PIXEL_ID);
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${FB_PIXEL_ID}&ev=PageView&noscript=1`} /></noscript>
  )}
</head>
<body style="background:#07080D radial-gradient(ellipse 90% 55% at 50% -8%, rgba(0,200,255,0.10), transparent 62%) no-repeat fixed; color:#F2F4F7; font-family:'Poppins',sans-serif; -webkit-font-smoothing:antialiased;">
  <Loader logoSrc="/img/logo-nav.png" />

  <!-- ── HEADER (pill flotante) ─────────────────────────────── -->
  <header class="site-header">
    <a href="/andres" class="brand">
      <span class="brand-mark">A</span>
      <span class="brand-copy">
        <strong>Andrés Albornoz</strong>
        <small>Soluciones operativas · GENIDEIA</small>
      </span>
    </a>
    <nav class="header-nav" aria-label="Navegación de la página">
      <a href="#porque">Por qué</a>
      <a href="#metodo">Método</a>
      <a href="#ejemplos">Ejemplos</a>
    </nav>
    <a href="#agenda" class="header-cta">Hablemos</a>
  </header>

  <!-- ══ 01 · PRESENTACIÓN ═════════════════════════════════════ -->
  <section id="presentacion" class="max-w-5xl mx-auto px-6 pt-36 pb-16">
    <div class="intro-grid">
      <div class="intro-copy">
        <p class="intro-eyebrow" data-reveal>Andrés Albornoz · Soluciones operativas con IA</p>
        <h1 class="intro-titulo" data-reveal data-delay="1">Hola, soy Andrés.</h1>
        <p class="intro-lead" data-reveal data-delay="2">
          Ayudo a empresas a ahorrar tiempo y ordenar sus procesos construyendo soluciones con IA.
        </p>
        <p class="intro-sub" data-reveal data-delay="2">
          Trabajo sobre consultas, seguimientos, ventas, información y otras tareas que hoy
          dependen demasiado del trabajo manual.
        </p>
        <div class="intro-cta-wrap" data-reveal data-delay="3">
          <p class="intro-cta-pregunta">¿Querés ver por qué estoy seguro de que puedo ayudarte?</p>
          <a href="#porque" class="intro-cta-btn">Ver video <span aria-hidden="true">↓</span></a>
          <p class="intro-cta-hint">Mirá esto antes de agendar · 5 min</p>
        </div>
      </div>
      <div class="intro-foto-wrap" data-reveal data-delay="1">
        {tieneFoto ? (
          <img src={FOTO_ANDRES} alt="Andrés Albornoz" class="intro-foto" />
        ) : (
          <div class="intro-foto intro-foto-placeholder" role="img" aria-label="Foto de Andrés Albornoz pendiente">
            <span>Foto de Andrés<br />(reemplazar)</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ══ 02 · VIDEO PRINCIPAL — no bloquea nada, ya se puede agendar ══ -->
  <section id="porque" class="max-w-4xl mx-auto px-6 pt-8 pb-16">
    <div class="text-center mb-9" data-reveal>
      <p class="paso-eyebrow">02 · {BLOQUES[0].eyebrow}</p>
      <h2 class="paso-titulo">{BLOQUES[0].titulo}</h2>
    </div>

    <div class="video-main-wrap" data-video-wrap data-reveal>
      <video id="vid-porque" controls playsinline preload="metadata" style="width:100%; height:100%; object-fit:contain; display:block; background:#0B1324;">
        <source src={BLOQUES[0].video} type="video/mp4" />
        Tu navegador no soporta el video.
      </video>
      <button type="button" class="video-cover" data-video-cover aria-label="Reproducir video">
        <span class="play-btn"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
        <span class="cover-hint">Mirá esto antes<br/>de agendar</span>
      </button>
      <div class="video-end" data-video-end>
        <p class="video-end-title">Ahora sí, ¿charlamos de tu empresa?</p>
        <a href="#agenda" class="video-end-btn">Agendar diagnóstico →</a>
      </div>
    </div>

    <!-- Bloque de conversión inmediato — disponible se haya visto el video o no -->
    <div class="conversion-block" data-reveal>
      <h3 class="conversion-titulo">¿Creés que algo de esto puede aplicarse a tu empresa?</h3>
      <p class="conversion-texto">
        Podemos analizar cómo funciona hoy tu proceso, dónde se está perdiendo tiempo
        y si existe una oportunidad concreta de mejorarlo.
      </p>
      <a href="#agenda" class="conversion-btn">Agendar diagnóstico</a>
      <p class="conversion-microcopy">Sin compromiso · Analizamos primero si realmente tiene sentido ayudarte</p>
    </div>
  </section>

  <!-- ── AGENDÁ (Calendly) — a un paso del video principal ──── -->
  <section id="agenda" style="background:#0B1324; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10" data-reveal>
        <p style="color:#00C8FF; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">El siguiente paso</p>
        <h2 style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.2rem);">Agendá tu diagnóstico inicial.</h2>
      </div>
      <!-- Calendly inline -->
      <div id="calendly-box" class="calendly-inline-widget" data-url={calendlyEmbed} style="min-width:320px; height:700px; border-radius:14px; overflow:hidden; border:1px solid rgba(0,200,255,0.2);" data-reveal></div>
      <p class="text-center mt-6 text-sm" style="color:#B8BEC7; font-weight:300;" data-reveal>
        ¿Preferís escribir? <a href={waUrl} target="_blank" rel="noopener noreferrer" style="color:#00C8FF; text-decoration:underline;">Hablemos por WhatsApp →</a>
      </p>
    </div>
  </section>

  <!-- ══ CONTENIDO OPCIONAL — para quien quiera profundizar antes de agendar ══ -->
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-4 text-center" data-reveal>
    <p class="opcional-eyebrow">Para ir más a fondo</p>
    <h2 class="opcional-titulo">¿Querés conocer un poco más antes de agendar?</h2>
    <p class="opcional-texto">
      Si todavía querés entender mejor cómo trabajo o qué tipo de soluciones construyo,
      podés seguir viendo estos contenidos. Son opcionales — ya podés agendar cuando quieras.
    </p>
  </section>

  <!-- ── MÉTODO (opcional) ───────────────────────────────────── -->
  <section id="metodo" style="background:#0B1324; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-16">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-9" data-reveal>
        <p class="paso-eyebrow">{BLOQUES[1].eyebrow}</p>
        <h2 class="paso-titulo">{BLOQUES[1].titulo}</h2>
      </div>

      {BLOQUES[1].disponible ? (
        <div class="video-main-wrap" data-video-wrap data-reveal>
          <video id="vid-metodo" controls playsinline preload="metadata" style="width:100%; height:100%; object-fit:contain; display:block; background:#0B1324;">
            <source src={BLOQUES[1].video} type="video/mp4" />
            Tu navegador no soporta el video.
          </video>
          <button type="button" class="video-cover" data-video-cover aria-label="Reproducir video">
            <span class="play-btn"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
            <span class="cover-hint">El sistema completo,<br/>paso a paso</span>
          </button>
          <div class="video-end" data-video-end>
            <p class="video-end-title">¿Y qué podrías tener funcionando vos?</p>
            <a href="#ejemplos" class="video-end-btn">Ver ejemplos →</a>
          </div>
        </div>
      ) : (
        <div class="video-pendiente" data-reveal>Video en producción · el bloque queda publicado y no bloquea el resto</div>
      )}

      <div class="text-center mt-8" data-reveal>
        <a href="#agenda" class="cta-secondary">Agendar diagnóstico</a>
      </div>
    </div>
  </section>

  <!-- ── EJEMPLOS por rubro (opcional) ───────────────────────── -->
  <section id="ejemplos" class="max-w-4xl mx-auto px-6 py-16">
    <div class="text-center mb-9" data-reveal>
      <p class="paso-eyebrow">{BLOQUES[2].eyebrow}</p>
      <h2 class="paso-titulo">{BLOQUES[2].titulo}</h2>
    </div>

    <!-- Selector de rubro -->
    <div class="rubro-picker" data-reveal>
      <p class="rubro-pregunta">¿De qué rubro sos?</p>
      <div class="rubro-btns">
        {RUBROS_EJEMPLOS.map((r, i) => (
          <button type="button" class="rubro-btn" data-rubro-btn={r.id} data-default={i === 0 ? 'true' : undefined}>{r.label}</button>
        ))}
      </div>
    </div>

    <!-- Paneles por rubro -->
    {RUBROS_EJEMPLOS.map((r) => (
      <div class="rubro-panel" data-rubro-panel={r.id}>
        {r.video ? (
          <div class="video-main-wrap" data-video-wrap data-rubro-video={r.id}>
            <video id={`vid-ejemplos-${r.id}`} controls playsinline preload="metadata" style="width:100%; height:100%; object-fit:contain; display:block; background:#0B1324;">
              <source src={r.video} type="video/mp4" />
              Tu navegador no soporta el video.
            </video>
            <button type="button" class="video-cover" data-video-cover aria-label="Reproducir video">
              <span class="play-btn"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              <span class="cover-hint">Ejemplos para {r.label.toLowerCase()}</span>
            </button>
            <div class="video-end" data-video-end>
              <p class="video-end-title">¿Querés saber cuál de estos te conviene primero?</p>
              <a href="#agenda" class="video-end-btn">Agendá tu diagnóstico →</a>
            </div>
          </div>
        ) : (
          <div class="video-pendiente">Todavía no tenemos ejemplos armados para este rubro — escribinos y lo vemos juntos en el diagnóstico.</div>
        )}
      </div>
    ))}

    <div class="text-center mt-8" data-reveal>
      <a href="#agenda" class="cta-secondary">Agendar diagnóstico</a>
    </div>
  </section>

  <!-- ── CTA FINAL ────────────────────────────────────────────── -->
  <section class="max-w-3xl mx-auto px-6 py-20 text-center">
    <div data-reveal>
      <h2 class="final-titulo">¿Listo para ordenar tus procesos con IA?</h2>
      <p class="final-texto">Agendá un diagnóstico de 45 minutos y vemos juntos por dónde empezar.</p>
      <div class="final-cta-row">
        <a href="#agenda" class="conversion-btn">Agendar diagnóstico</a>
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="cta-secondary">Hablar por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ────────────────────────────────────────────── -->
  <footer style="border-top:1px solid rgba(255,255,255,0.07);" class="py-10">
    <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm" style="color:#B8BEC7;">
      <div>
        <p style="font-family:'Montserrat',sans-serif; font-size:1.05rem; color:#F2F4F7;">Andrés Albornoz</p>
        <p style="font-weight:300; font-size:0.8rem;">Cofundador de <a href="/" style="color:#00C8FF;">GENIDEIA Company</a> · Soluciones operativas</p>
      </div>
      <div class="flex flex-col sm:items-end gap-1">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" style="font-weight:300;" class="hover:text-[#00C8FF] transition-colors">WhatsApp +598 92 302 941</a>
        <a href="mailto:andres@genideiacompany.com" style="font-weight:300;" class="hover:text-[#00C8FF] transition-colors">andres@genideiacompany.com</a>
      </div>
    </div>
  </footer>

  <!-- Barra fija mobile: siempre visible, manda directo a WhatsApp -->
  <a href={waUrl} target="_blank" rel="noopener noreferrer" class="mobile-cta">
    Hablemos por WhatsApp <span>↗</span>
  </a>

  <!-- Calendly widget script -->
  <script src="https://assets.calendly.com/assets/external/widget.js" async is:inline></script>

  <script define:vars={{ calendlyEmbed }}>
    // ── Meta Pixel: eventos del embudo. No-op si el píxel no está instalado. ──
    const track = (evento) => { if (window.fbq) window.fbq('track', evento); };

    // Agendó la llamada: el widget inline de Calendly lo avisa por postMessage.
    window.addEventListener('message', (e) => {
      if (typeof e.origin !== 'string' || e.origin.indexOf('calendly.com') === -1) return;
      if (e.data && e.data.event === 'calendly.event_scheduled') track('Lead');
    });

    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => obs.observe(el));

    // ── Portada-gancho: el overlay arranca el video y se oculta ──
    document.querySelectorAll('[data-video-wrap]').forEach((wrap) => {
      const v = wrap.querySelector('video');
      const cover = wrap.querySelector('[data-video-cover]');
      if (!v || !cover) return;
      cover.addEventListener('click', () => { v.play(); });
      v.addEventListener('play', () => wrap.classList.add('playing'));
      // la pantalla final aparece cuando el video termina de verdad — no bloquea nada más
      v.addEventListener('ended', () => { wrap.classList.add('ended'); track('ViewContent'); });
    });

    // ── Calendly: nada está oculto, así que se inicializa apenas el widget se acerca ──
    let calendlyReady = false;
    function initCalendly() {
      if (calendlyReady) return;
      const box = document.getElementById('calendly-box');
      if (box && window.Calendly) {
        box.innerHTML = '';
        window.Calendly.initInlineWidget({ url: calendlyEmbed, parentElement: box });
        calendlyReady = true;
      }
    }
    const calendlyBox = document.getElementById('calendly-box');
    if (calendlyBox) {
      const calendlyObs = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { initCalendly(); calendlyObs.disconnect(); }
      }, { rootMargin: '500px 0px' });
      calendlyObs.observe(calendlyBox);
    }

    // ── Selector de rubro (bloque de ejemplos) ──
    const rubroBtns = document.querySelectorAll('[data-rubro-btn]');
    const rubroPanels = document.querySelectorAll('[data-rubro-panel]');
    function activarRubro(id) {
      rubroBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-rubro-btn') === id));
      rubroPanels.forEach((p) => p.classList.toggle('active', p.getAttribute('data-rubro-panel') === id));
    }
    rubroBtns.forEach((b) => b.addEventListener('click', () => activarRubro(b.getAttribute('data-rubro-btn'))));
    const rubroDef = document.querySelector('[data-rubro-btn][data-default="true"]');
    if (rubroDef) activarRubro(rubroDef.getAttribute('data-rubro-btn'));
  </script>

  <style>
    /* ── Header flotante (pill) ─────────────────────────────── */
    .site-header {
      position: fixed; z-index: 50; inset: 16px 16px auto;
      max-width: 900px; margin-inline: auto;
      min-height: 64px; padding: 8px 10px 8px 14px;
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
      border: 1px solid rgba(255,255,255,0.1); border-radius: 16px;
      background: rgba(7,8,13,0.82); backdrop-filter: blur(16px);
      box-shadow: 0 10px 40px rgba(0,0,0,0.28);
    }
    .brand { display: inline-flex; align-items: center; gap: 10px; min-width: 0; flex: 1 1 auto; overflow: hidden; }
    .brand-mark {
      width: 36px; height: 36px; flex: 0 0 36px; display: grid; place-items: center;
      border: 1px solid rgba(0,200,255,0.35); border-radius: 50%;
      font-family: Georgia, serif; font-size: 19px; font-style: italic; color: #00C8FF;
    }
    .brand-copy { display: grid; gap: 1px; min-width: 0; overflow: hidden; }
    .brand-copy strong { display:block; font-family:'Montserrat',sans-serif; font-size: 0.9rem; color: #F2F4F7; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .brand-copy small { display:block; color: #00C8FF; font-size: 0.55rem; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .header-nav { display: flex; align-items: center; gap: 22px; color: #B8BEC7; font-size: 0.8rem; font-weight: 300; flex-shrink: 0; }
    .header-nav a:hover { color: #00C8FF; }
    .header-cta { flex-shrink: 0; background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600; font-size:0.78rem; padding: 0.6rem 1.1rem; border-radius: 10px; transition: opacity .2s; white-space: nowrap; }
    .header-cta:hover { opacity: 0.9; }
    @media (max-width: 720px) { .header-nav { display: none; } }
    @media (max-width: 400px) { .brand-copy small { display: none; } }

    /* ── Barra fija mobile ───────────────────────────────────── */
    .mobile-cta { display: none; }
    @media (max-width: 800px) {
      .mobile-cta {
        display: flex; position: fixed; z-index: 45; right: 12px; bottom: 12px; left: 12px;
        min-height: 54px; padding: 0 18px; align-items: center; justify-content: space-between;
        border: 1px solid rgba(255,255,255,0.14); border-radius: 13px;
        background: linear-gradient(135deg,#00C8FF,#007BFF); color: #0A0F1A;
        font-weight: 700; font-size: 0.9rem; box-shadow: 0 14px 40px rgba(0,0,0,0.35);
      }
    }

    /* ── 01 · Presentación ───────────────────────────────────── */
    .intro-grid { display:grid; gap:2.6rem; align-items:center; }
    @media (min-width: 1024px) { .intro-grid { grid-template-columns: 1fr 380px; gap: 3.5rem; } }
    .intro-copy { text-align:center; }
    @media (min-width: 1024px) { .intro-copy { text-align:left; } }
    .intro-eyebrow { color:#00C8FF; font-size:0.72rem; font-weight:600; letter-spacing:2.5px; text-transform:uppercase; margin-bottom:1.1rem; }
    .intro-titulo { font-family:'Montserrat',sans-serif; font-weight:700; line-height:0.98; letter-spacing:-0.03em; font-size:clamp(2.4rem, 6vw, 4rem); margin-bottom:1.3rem; }
    .intro-lead { color:#F2F4F7; font-weight:400; font-size:clamp(1.05rem, 2vw, 1.25rem); line-height:1.5; max-width:42ch; margin:0 auto 0.9rem; }
    @media (min-width: 1024px) { .intro-lead { margin-left:0; margin-right:0; } }
    .intro-sub { color:#B8BEC7; font-weight:300; font-size:0.98rem; line-height:1.65; max-width:44ch; margin:0 auto; }
    @media (min-width: 1024px) { .intro-sub { margin-left:0; margin-right:0; } }
    .intro-cta-wrap { margin-top:2.2rem; }
    .intro-cta-pregunta { color:#D7DBE1; font-weight:500; font-size:0.98rem; margin-bottom:0.9rem; }
    .intro-cta-btn { display:inline-flex; align-items:center; gap:8px; background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:700; font-size:1rem; padding:0.9rem 1.9rem; border-radius:12px; transition:opacity .2s, transform .2s; }
    .intro-cta-btn:hover { opacity:0.9; transform:translateY(-1px); }
    .intro-cta-hint { color:rgba(184,190,199,0.7); font-size:0.8rem; letter-spacing:0.5px; margin-top:0.8rem; }

    .intro-foto-wrap { display:flex; justify-content:center; }
    @media (min-width: 1024px) { .intro-foto-wrap { justify-content:flex-end; } }
    .intro-foto {
      width:min(320px, 78vw); aspect-ratio:2/3; object-fit:cover; object-position:center 18%;
      border-radius:22px; border:1px solid rgba(0,200,255,0.25);
      box-shadow:0 20px 70px rgba(0,200,255,0.14), 0 8px 30px rgba(0,0,0,0.4);
      display:block;
    }
    .intro-foto-placeholder {
      display:flex; align-items:center; justify-content:center; text-align:center;
      background:repeating-linear-gradient(135deg, rgba(0,200,255,0.06) 0 14px, rgba(255,255,255,0.02) 14px 28px);
      color:rgba(184,190,199,0.7); font-size:0.85rem; font-weight:500; letter-spacing:0.5px; line-height:1.5;
    }

    /* Video principal 16:9 */
    .video-main-wrap { position:relative; width:100%; aspect-ratio:16/9; border-radius:18px; overflow:hidden; border:1px solid rgba(0,200,255,0.25); background:#0B1324; box-shadow:0 12px 60px rgba(0,200,255,0.12); }

    /* Portada-gancho */
    .video-cover { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; cursor:pointer; border:none; background:linear-gradient(180deg, rgba(7,8,13,0.30) 0%, rgba(7,8,13,0.60) 100%); transition:opacity .3s; }
    .video-main-wrap.playing .video-cover { opacity:0; pointer-events:none; }
    .play-btn { width:76px; height:76px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#0A0F1A; background:linear-gradient(135deg,#00C8FF,#007BFF); box-shadow:0 0 0 0 rgba(0,200,255,0.5); animation:playPulse 2.2s ease-in-out infinite; }
    @keyframes playPulse { 0%{ box-shadow:0 0 0 0 rgba(0,200,255,0.45);} 70%{ box-shadow:0 0 0 22px rgba(0,200,255,0);} 100%{ box-shadow:0 0 0 0 rgba(0,200,255,0);} }
    .cover-hint { font-family:'Montserrat',sans-serif; font-weight:600; font-size:1.15rem; line-height:1.25; color:#F2F4F7; text-align:center; text-shadow:0 2px 12px rgba(0,0,0,0.6); }

    /* Pantalla final del video (aparece al terminar) */
    .video-end { position:absolute; inset:0; z-index:5; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; padding:24px; text-align:center; background:linear-gradient(180deg, rgba(7,8,13,0.94), rgba(11,19,36,0.97)); opacity:0; pointer-events:none; transition:opacity .5s ease; }
    .video-main-wrap.ended .video-end { opacity:1; pointer-events:auto; }
    .video-end-title { font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(1.15rem, 2.6vw, 1.7rem); line-height:1.2; color:#F2F4F7; max-width:20ch; }
    .video-end-btn { background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:700; padding:0.95rem 2.2rem; border-radius:12px; font-size:clamp(1rem,2vw,1.15rem); animation:ctaGlow 2s ease-in-out infinite; }
    @keyframes ctaGlow { 0%,100%{ box-shadow:0 0 0 0 rgba(0,200,255,0); } 50%{ box-shadow:0 0 30px 3px rgba(0,200,255,0.5); } }

    /* Encabezado de cada bloque de la secuencia */
    .paso-eyebrow { display:flex; align-items:center; justify-content:center; gap:8px; color:#00C8FF; font-size:0.7rem; letter-spacing:3px; font-weight:600; text-transform:uppercase; margin-bottom:1.1rem; }
    .paso-titulo { font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.045em; line-height:1.05; font-size:clamp(1.9rem, 5vw, 3.4rem); margin-bottom:1rem; }

    /* Aviso cuando el video del bloque todavía no está subido */
    .video-pendiente { border:1px dashed rgba(0,200,255,0.3); border-radius:18px; padding:2.6rem 1.5rem; text-align:center; color:rgba(184,190,199,0.7); font-size:0.85rem; font-weight:300; letter-spacing:0.5px; }

    /* Bloque de conversión inmediato (después del video principal) */
    .conversion-block { max-width:52ch; margin:3.2rem auto 0; text-align:center; }
    .conversion-titulo { font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(1.3rem, 3vw, 1.8rem); line-height:1.25; color:#F2F4F7; margin-bottom:0.9rem; }
    .conversion-texto { color:#B8BEC7; font-weight:300; line-height:1.65; font-size:0.98rem; margin-bottom:1.6rem; }
    .conversion-btn { display:inline-block; background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:700; font-size:1.02rem; padding:1rem 2.4rem; border-radius:12px; transition:opacity .2s, transform .2s; }
    .conversion-btn:hover { opacity:0.9; transform:translateY(-1px); }
    .conversion-microcopy { color:rgba(184,190,199,0.65); font-size:0.8rem; letter-spacing:0.3px; margin-top:1rem; }

    /* CTA secundario (contenido opcional) */
    .cta-secondary { display:inline-block; border:1px solid rgba(0,200,255,0.35); color:#00C8FF; font-weight:600; font-size:0.85rem; padding:0.6rem 1.5rem; border-radius:999px; background:transparent; transition:all .2s; }
    .cta-secondary:hover { border-color:#00C8FF; background:rgba(0,200,255,0.08); }

    /* Transición hacia el contenido opcional */
    .opcional-eyebrow { color:#00C8FF; font-size:0.7rem; letter-spacing:3px; font-weight:600; text-transform:uppercase; margin-bottom:0.9rem; }
    .opcional-titulo { font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(1.4rem, 3.2vw, 2rem); letter-spacing:-0.02em; margin-bottom:0.9rem; }
    .opcional-texto { color:#B8BEC7; font-weight:300; line-height:1.65; font-size:0.95rem; max-width:48ch; margin:0 auto; }

    /* CTA final */
    .final-titulo { font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(1.7rem, 4vw, 2.6rem); letter-spacing:-0.03em; margin-bottom:0.8rem; }
    .final-texto { color:#B8BEC7; font-weight:300; font-size:1rem; line-height:1.6; margin-bottom:2rem; }
    .final-cta-row { display:flex; flex-wrap:wrap; gap:1rem; justify-content:center; align-items:center; }

    /* 03 · Selector de rubro */
    .rubro-picker { text-align:center; margin-bottom: 2.2rem; }
    .rubro-pregunta { font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(1.1rem,2.4vw,1.4rem); margin-bottom:1rem; color:#F2F4F7; }
    .rubro-btns { display:flex; flex-wrap:wrap; gap:0.7rem; justify-content:center; }
    .rubro-btn { border:1px solid rgba(0,200,255,0.3); background:rgba(255,255,255,0.03); color:#B8BEC7; font-weight:600; font-size:0.9rem; padding:0.65rem 1.5rem; border-radius:999px; cursor:pointer; transition:all .2s; }
    .rubro-btn:hover { border-color:#00C8FF; color:#F2F4F7; }
    .rubro-btn.active { background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; border-color:transparent; }
    .rubro-panel { display:none; }
    .rubro-panel.active { display:block; }

    html { scroll-behavior: smooth; }

    @media (prefers-reduced-motion: reduce) { .play-btn, .video-end-btn { animation:none; } }
  </style>

</body>
</html>
