      }
    }

    .hero-glow { animation: heroGlowPulse 5s ease-in-out infinite; }
    @keyframes heroGlowPulse { 0%,100% { opacity:0.55; transform:scale(1); } 50% { opacity:1; transform:scale(1.08); } }

    /* Video principal 16:9 */
    .video-main-wrap { position:relative; width:100%; aspect-ratio:16/9; border-radius:18px; overflow:hidden; border:1px solid rgba(0,200,255,0.25); background:#0B1324; box-shadow:0 12px 60px rgba(0,200,255,0.12); }

    /* Portada-gancho */
    .video-cover { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; cursor:pointer; border:none; background:linear-gradient(180deg, rgba(7,8,13,0.30) 0%, rgba(7,8,13,0.60) 100%); transition:opacity .3s; }
    .video-main-wrap.playing .video-cover { opacity:0; pointer-events:none; }
    .play-btn { width:76px; height:76px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#0A0F1A; background:linear-gradient(135deg,#00C8FF,#007BFF); box-shadow:0 0 0 0 rgba(0,200,255,0.5); animation:playPulse 2.2s ease-in-out infinite; }
    @keyframes playPulse { 0%{ box-shadow:0 0 0 0 rgba(0,200,255,0.45);} 70%{ box-shadow:0 0 0 22px rgba(0,200,255,0);} 100%{ box-shadow:0 0 0 0 rgba(0,200,255,0);} }
    .cover-hint { font-family:'Montserrat',sans-serif; font-weight:600; font-size:1.15rem; line-height:1.25; color:#F2F4F7; text-align:center; text-shadow:0 2px 12px rgba(0,0,0,0.6); }

    /* Hint de bloqueo (se oculta al desbloquear) */
    .lock-hint { transition:opacity .3s; }
    .lock-hint.hide { display:none; }

    /* Pantalla final del video (aparece al terminar) */
    .video-end { position:absolute; inset:0; z-index:5; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; padding:24px; text-align:center; background:linear-gradient(180deg, rgba(7,8,13,0.94), rgba(11,19,36,0.97)); opacity:0; pointer-events:none; transition:opacity .5s ease; }
    .video-main-wrap.ended .video-end { opacity:1; pointer-events:auto; }
    .video-end-title { font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(1.15rem, 2.6vw, 1.7rem); line-height:1.2; color:#F2F4F7; max-width:20ch; }
    .video-end-btn { background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:700; padding:0.95rem 2.2rem; border-radius:12px; font-size:clamp(1rem,2vw,1.15rem); animation:ctaGlow 2s ease-in-out infinite; }
    @keyframes ctaGlow { 0%,100%{ box-shadow:0 0 0 0 rgba(0,200,255,0); } 50%{ box-shadow:0 0 30px 3px rgba(0,200,255,0.5); } }

    /* Encabezado de cada bloque de la secuencia */
