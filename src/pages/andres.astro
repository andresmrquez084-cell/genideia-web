---
import '../styles/global.css';

const WA = '59892302941';
const waUrl = (msg: string) => `https://wa.me/${WA}?text=${encodeURIComponent(msg)}`;
const b2cUrl = waUrl('Hola Andrés, vi tu landing y quiero aprender a usar IA de forma práctica.');
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Andrés — IA aplicada a personas y empresas</title>
    <meta name="description" content="Elegí por dónde querés empezar: aprender a usar IA de forma práctica o aplicarla en tu empresa." />
    <meta property="og:title" content="Andrés — ¿Por dónde querés empezar?" />
    <meta property="og:description" content="Dos caminos: aprender a usar IA o aplicarla en tu empresa." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://genideiacompany.com/og-genideia.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>

  <body>
    <main class="landing-shell">
      <div class="brand-watermark" aria-hidden="true">
        <img src="/img/symbol-gii.png" alt="" />
      </div>

      <header class="topbar">
        <a class="brand" href="/andres" aria-label="Andrés by GENIDEIA">
          <span class="brand-name">Andrés<span class="brand-dot">.</span></span>
          <span class="brand-sub">by GENIDEIA</span>
        </a>

        <nav class="nav" aria-label="Navegación principal">
          <a href="#inicio" class="is-active">Inicio</a>
          <a href="#aprender">Aprender IA</a>
          <a href="#empresas">Empresas</a>
          <a href={b2cUrl} target="_blank" rel="noopener noreferrer">Contacto</a>
        </nav>

        <div class="brand-tag">INNOVACIÓN · IMPACTO</div>
      </header>

      <section class="decision" id="inicio">
        <aside class="side-note side-note-left" aria-hidden="true">
          <span></span>
          <p>IDEAS<br />HERRAMIENTAS<br />SOLUCIONES<br />REALES</p>
          <span></span>
        </aside>

        <aside class="side-note side-note-right" aria-hidden="true">
          <span></span>
          <p>APLICACIÓN<br />IMPACTO</p>
          <span></span>
        </aside>

        <div class="decision-inner">
          <h1>¿Por dónde querés <span>empezar?</span></h1>

          <div class="cards">
            <article class="choice-card choice-card-learn" id="aprender">
              <div class="icon-box" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 18L24 9L42 18L24 27L6 18Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M12 21.5V31C12 34.5 17.4 37 24 37C30.6 37 36 34.5 36 31V21.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                  <path d="M42 18V29" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              </div>

              <p class="eyebrow">APRENDER</p>
              <h2>Quiero aprender <span>a usar IA</span></h2>
              <p class="description">Para aplicarla en mi día a día, trabajo o crear nuevas oportunidades.</p>

              <div class="keywords" aria-label="Qué incluye">
                <span>APLICACIÓN PRÁCTICA</span>
                <i></i>
                <span>RECURSOS</span>
                <i></i>
                <span>CONSTRUCCIÓN</span>
              </div>

              <a class="cta cta-learn" href={b2cUrl} target="_blank" rel="noopener noreferrer">
                <span>Quiero aprender IA</span>
                <span aria-hidden="true">→</span>
              </a>
            </article>

            <article class="choice-card choice-card-business" id="empresas">
              <div class="icon-box" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 39V15H25V39" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M25 22H38V39" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M15 21H19M15 27H19M15 33H19M30 27H34M30 33H34" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                  <path d="M6 39H42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              </div>

              <p class="eyebrow">EMPRESAS</p>
              <h2>Quiero aplicar IA <span>en mi empresa</span></h2>
              <p class="description">Detectamos procesos, pérdidas de tiempo y oportunidades para construir soluciones con impacto real.</p>

              <div class="keywords" aria-label="Qué incluye">
                <span>DIAGNÓSTICO</span>
                <i></i>
                <span>AUTOMATIZACIÓN</span>
                <i></i>
                <span>SISTEMAS</span>
              </div>

              <a class="cta cta-business" href="/empresa">
                <span>Ver cómo puedo ayudarte</span>
                <span aria-hidden="true">→</span>
              </a>
            </article>
          </div>
        </div>
      </section>

      <footer class="footer">
        <div class="footer-brand">
          <strong>Andrés<span>.</span></strong>
          <i></i>
          <small>by GENIDEIA</small>
        </div>
        <div class="footer-place">
          <i></i>
          <span>MONTEVIDEO, UY</span>
        </div>
      </footer>
    </main>

    <style>
      :root {
        --bg: #020711;
        --bg-2: #06111f;
        --text: #f4f7fb;
        --muted: #b9c2d0;
        --blue: #1684ff;
        --cyan: #14d8e8;
        --line: rgba(48, 154, 255, 0.42);
        --panel: rgba(4, 16, 31, 0.74);
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        min-width: 320px;
        color: var(--text);
        font-family: 'Poppins', sans-serif;
        background: #020711;
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; text-decoration: none; }

      .landing-shell {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background:
          radial-gradient(circle at 78% 42%, rgba(7, 118, 170, 0.12), transparent 30%),
          radial-gradient(circle at 18% 70%, rgba(7, 61, 128, 0.12), transparent 32%),
          linear-gradient(rgba(1, 7, 17, 0.78), rgba(1, 7, 17, 0.94)),
          url('/img/bg-circuit.jpg') center / cover no-repeat,
          var(--bg);
      }

      .landing-shell::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(90deg, rgba(0,0,0,.16), transparent 18%, transparent 82%, rgba(0,0,0,.18));
      }

      .brand-watermark {
        position: absolute;
        right: -6vw;
        top: 10vh;
        width: clamp(320px, 34vw, 620px);
        opacity: 0.11;
        filter: saturate(1.2) drop-shadow(0 0 40px rgba(0, 153, 255, 0.14));
        pointer-events: none;
      }

      .brand-watermark img {
        display: block;
        width: 100%;
      }

      .topbar {
        position: relative;
        z-index: 3;
        width: min(1340px, calc(100% - 64px));
        margin: 0 auto;
        padding: 28px 0 14px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: start;
        gap: 24px;
      }

      .brand { display: inline-grid; width: max-content; gap: 1px; }
      .brand-name {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: clamp(1.7rem, 2.2vw, 2.3rem);
        letter-spacing: -0.04em;
        line-height: 1;
      }
      .brand-dot { color: #1cb8ff; }
      .brand-sub {
        margin-top: 7px;
        font-size: 0.68rem;
        letter-spacing: 0.34em;
        color: #c8d2df;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 38px;
        padding-top: 6px;
        font-size: 0.78rem;
        color: #c8d0db;
      }

      .nav a {
        position: relative;
        transition: color .2s ease;
      }
      .nav a:hover { color: #fff; }
      .nav a.is-active::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -10px;
        height: 2px;
        background: linear-gradient(90deg, var(--cyan), var(--blue));
      }

      .brand-tag {
        justify-self: end;
        padding-top: 8px;
        font-size: 0.68rem;
        letter-spacing: 0.36em;
        color: #aab6c7;
        white-space: nowrap;
      }

      .decision {
        position: relative;
        z-index: 2;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 42px 36px 28px;
      }

      .decision-inner {
        width: min(1020px, 100%);
        margin: 0 auto;
      }

      h1 {
        margin: 0 0 42px;
        text-align: center;
        font-family: 'Montserrat', sans-serif;
        font-size: clamp(2.65rem, 5.4vw, 5rem);
        line-height: 0.98;
        letter-spacing: -0.055em;
        font-weight: 800;
      }

      h1 span {
        display: inline-block;
        background: linear-gradient(90deg, #16d8e8, #1684ff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 32px;
      }

      .choice-card {
        position: relative;
        min-height: 480px;
        display: flex;
        flex-direction: column;
        padding: 40px 42px 36px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background:
          linear-gradient(180deg, rgba(5, 19, 36, .88), rgba(2, 11, 23, .92)),
          radial-gradient(circle at 82% 8%, rgba(27, 139, 255, .08), transparent 33%);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.015), 0 24px 80px rgba(0,0,0,.24);
        overflow: hidden;
      }

      .choice-card-business {
        border-color: rgba(20, 216, 232, .62);
        background:
          linear-gradient(180deg, rgba(4, 27, 39, .88), rgba(2, 14, 23, .94)),
          radial-gradient(circle at 82% 8%, rgba(20, 216, 232, .09), transparent 33%);
      }

      .choice-card::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(135deg, rgba(255,255,255,.025), transparent 30%, transparent 70%, rgba(0, 157, 255, .035));
      }

      .icon-box {
        width: 58px;
        height: 58px;
        display: grid;
        place-items: center;
        border: 1px solid currentColor;
        border-radius: 14px;
        color: #178eff;
        background: rgba(5, 31, 61, .62);
        box-shadow: 0 0 28px rgba(23, 142, 255, .08);
      }
      .choice-card-business .icon-box {
        color: var(--cyan);
        background: rgba(2, 49, 53, .42);
      }
      .icon-box svg { width: 34px; height: 34px; }

      .eyebrow {
        margin: 26px 0 8px;
        font-size: 0.68rem;
        letter-spacing: 0.32em;
        color: #d2d9e3;
      }

      h2 {
        margin: 0;
        font-family: 'Montserrat', sans-serif;
        font-size: clamp(1.8rem, 2.7vw, 2.55rem);
        line-height: 1.02;
        letter-spacing: -0.045em;
        font-weight: 800;
      }
      h2 span { display: block; color: #1b9fff; margin-top: 6px; }
      .choice-card-business h2 span { color: var(--cyan); }

      .description {
        margin: 24px 0 0;
        color: #d4d9e2;
        font-size: 0.98rem;
        line-height: 1.58;
        max-width: 95%;
      }

      .keywords {
        margin-top: auto;
        padding: 28px 0 26px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 14px;
        color: #dce2e9;
        font-size: 0.67rem;
      }
      .keywords i {
        width: 1px;
        height: 16px;
        background: linear-gradient(var(--cyan), var(--blue));
        opacity: .7;
      }

      .cta {
        position: relative;
        z-index: 1;
        min-height: 62px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 22px;
        padding: 0 26px;
        font-weight: 600;
        font-size: 0.94rem;
        transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
      }
      .cta:hover {
        transform: translateY(-2px);
        filter: brightness(1.06);
      }
      .cta-learn {
        background: linear-gradient(90deg, #126cff, #19c9ff);
        box-shadow: 0 12px 34px rgba(18, 108, 255, .2);
      }
      .cta-business {
        background: linear-gradient(90deg, #18b9c6, #12d6dd);
        color: white;
        box-shadow: 0 12px 34px rgba(18, 214, 221, .14);
      }

      .side-note {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        color: #8f9db0;
        font-size: 0.65rem;
        letter-spacing: .31em;
        line-height: 2.25;
      }
      .side-note span {
        display: block;
        width: 1px;
        height: 94px;
        margin-left: 14px;
        background: linear-gradient(var(--cyan), rgba(22,132,255,.2));
      }
      .side-note p { margin: 24px 0; }
      .side-note-left { left: max(32px, 4vw); }
      .side-note-right { right: max(32px, 4vw); text-align: right; }
      .side-note-right span { margin-left: auto; margin-right: 14px; }

      .footer {
        position: relative;
        z-index: 2;
        width: min(1440px, calc(100% - 72px));
        margin: 0 auto;
        min-height: 88px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #9ca9ba;
      }

      .footer-brand,
      .footer-place {
        display: flex;
        align-items: center;
        gap: 18px;
      }
      .footer-brand strong {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.15rem;
        color: #f3f6fa;
      }
      .footer-brand strong span { color: var(--cyan); }
      .footer-brand small,
      .footer-place span {
        letter-spacing: .25em;
        font-size: .62rem;
      }
      .footer-brand i,
      .footer-place i {
        width: 54px;
        height: 1px;
        background: linear-gradient(90deg, rgba(20,216,232,.15), var(--blue));
      }

      @media (max-width: 1180px) {
        .side-note { display: none; }
        .topbar { width: min(1120px, calc(100% - 40px)); }
        .decision { padding-left: 20px; padding-right: 20px; }
      }

      @media (max-width: 860px) {
        .topbar {
          grid-template-columns: 1fr auto;
          align-items: center;
          padding-top: 20px;
        }
        .nav { display: none; }
        .brand-tag { font-size: .57rem; letter-spacing: .28em; }
        .decision { padding-top: 46px; align-items: flex-start; }
        h1 { margin-bottom: 30px; }
        .cards { grid-template-columns: 1fr; max-width: 620px; margin: 0 auto; }
        .choice-card { min-height: 0; }
        .brand-watermark { width: 440px; top: 18vh; right: -180px; }
        .footer { width: calc(100% - 40px); }
        .footer-place { display: none; }
      }

      @media (max-width: 560px) {
        .topbar { width: calc(100% - 28px); }
        .brand-name { font-size: 1.55rem; }
        .brand-sub { font-size: .55rem; }
        .brand-tag { display: none; }
        .decision { padding: 38px 14px 22px; }
        h1 { font-size: clamp(2.35rem, 12vw, 3.4rem); margin-bottom: 26px; }
        h1 span { display: block; margin-top: 6px; }
        .cards { gap: 18px; }
        .choice-card { padding: 28px 24px 24px; border-radius: 15px; }
        .icon-box { width: 52px; height: 52px; border-radius: 12px; }
        h2 { font-size: 1.85rem; }
        .description { font-size: .9rem; max-width: 100%; margin-top: 18px; }
        .keywords { padding: 24px 0 20px; gap: 8px 10px; font-size: .58rem; }
        .cta { min-height: 56px; font-size: .88rem; }
        .footer { min-height: 70px; width: calc(100% - 28px); }
        .footer-brand i { width: 28px; }
        .footer-brand small { letter-spacing: .18em; font-size: .54rem; }
      }
    </style>
  </body>
</html>
