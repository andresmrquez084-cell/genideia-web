---
// Landing personal de Andrés Albornoz (co-fundador de GENIDEIA) — foco: automatización de empresas.
// Extensión de la web de la marca: misma identidad visual, página única orientada a conversión.
// Voz en PRIMERA PERSONA (es la marca personal de Andrés, a diferencia de la web de empresa).
import '../styles/global.css';

const WA = '59892302941';
const waMsg = encodeURIComponent('Hola Andrés, me gustaría automatizar algo en mi empresa. Te cuento:');
const waUrl = `https://wa.me/${WA}?text=${waMsg}`;

// Dolores que resuelve la automatización (el "¿te suena?")
const problemas = [
  'Respondés las mismas consultas todo el día, a toda hora, por WhatsApp.',
  'Se te escapan clientes porque no llegás a contestar a tiempo.',
  'Cargás datos, mandás recordatorios y seguís pedidos a mano — horas que no vuelven.',
  'Si vos (o una persona clave) no está, el negocio se frena.',
];

// Ejemplos concretos de lo que puedo automatizar
const ejemplos = [
  { t: 'Bot de WhatsApp', d: 'Atiende consultas, agenda turnos, califica clientes y responde al instante — 24/7, sin que muevas un dedo.' },
  { t: 'Workflows con n8n', d: 'Conecto tus herramientas para que los procesos corran solos: del formulario al CRM, al email, al recordatorio.' },
  { t: 'Seguimiento automático', d: 'Recordatorios, nurturing de leads y avisos de estado de pedido. Ningún cliente queda sin respuesta.' },
  { t: 'Reportería en vivo', d: 'Los números de tu negocio actualizados solos. El dato como subproducto, sin que nadie cargue nada a mano.' },
  { t: 'Integraciones a medida', d: 'Que tu web, tu planilla, MercadoPago y tu agenda se hablen entre sí. Se acabó el copiar y pegar.' },
  { t: 'Procesos internos', d: 'Eso repetitivo que te come el día —facturas, altas, avisos— pasa a correr en automático.' },
];

// Cómo trabajo (proceso simple)
const pasos = [
  { n: '01', t: 'Diagnóstico', d: 'Entiendo tu operación y detecto dónde se te va el tiempo. Gratis, sin compromiso.' },
  { n: '02', t: 'Diseño e implementación', d: 'Armo el sistema a tu medida y lo dejo funcionando, integrado a lo que ya usás.' },
  { n: '03', t: 'Soporte y mejora', d: 'No te entrego y desaparezco: mido, ajusto y lo hago crecer con tu negocio.' },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Andrés Albornoz — Automatización de empresas con IA</title>
  <meta name="description" content="Automatizo empresas con IA: bots de WhatsApp, workflows e integraciones para que tu negocio atienda, venda y opere solo. Andrés Albornoz, co-fundador de GENIDEIA." />
  <meta property="og:title" content="Andrés Albornoz — Automatización de empresas" />
  <meta property="og:description" content="Que tu empresa funcione sola. Bots, workflows e IA a medida." />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body style="background:#0a0a0a; color:#e8e8e8; font-family:'Inter',sans-serif; -webkit-font-smoothing:antialiased;">

  <!-- ── HEADER MINIMAL ────────────────────────────────────── -->
  <header style="background:rgba(10,10,10,0.92); border-bottom:1px solid rgba(255,255,255,0.07);" class="sticky top-0 z-50 backdrop-blur">
    <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
      <a href="/andres" class="flex items-baseline gap-2">
        <span style="font-family:'Cormorant Garamond',serif; font-size:1.15rem; font-weight:600; color:#e8e8e8; letter-spacing:0.5px;">Andrés Albornoz</span>
        <span style="color:#4ab8ff; font-size:0.6rem; letter-spacing:2px;" class="uppercase hidden sm:inline">Automatización</span>
      </a>
      <div class="flex items-center gap-4">
        <a href="/" style="color:#a0a0a0; font-size:0.72rem; letter-spacing:1px;" class="uppercase hover:text-[#4ab8ff] transition-colors hidden sm:inline">GENIDEIA</a>
        <a href={waUrl} target="_blank" rel="noopener noreferrer" style="background:#4ab8ff; color:#0a0a0a; font-weight:600; font-size:0.78rem;" class="px-4 py-2 rounded-lg hover:opacity-90 transition-opacity">Hablemos</a>
      </div>
    </nav>
  </header>

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-6 pt-20 pb-16" style="position:relative; overflow:hidden;">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">
      <div style="position:relative; z-index:2;">
        <p class="hero-animate text-xs font-medium mb-6 uppercase" data-delay="1" style="color:#4ab8ff; letter-spacing:3px;">
          Automatización de empresas con IA
        </p>
        <h1 class="hero-animate mb-6" data-delay="2" style="font-family:'Cormorant Garamond',serif; font-weight:700; line-height:1.0; letter-spacing:-1.5px; font-size:clamp(2.6rem, 6vw, 4.6rem);">
          Que tu empresa<br />
          <span style="color:#a0a0a0; font-weight:300; font-style:italic;">funcione sola.</span>
        </h1>
        <p class="hero-animate mb-9 leading-relaxed max-w-lg text-lg" data-delay="3" style="color:#a0a0a0; font-weight:300;">
          Soy <strong style="color:#e8e8e8; font-weight:500;">Andrés Albornoz</strong>, co-fundador de GENIDEIA. Automatizo
          empresas con IA para que atiendan, vendan y operen sin depender de que estés vos.
        </p>
        <div class="hero-animate flex flex-col sm:flex-row gap-4 mb-8" data-delay="4">
          <a href="#tu-problema" style="background:#4ab8ff; color:#0a0a0a; font-weight:600;" class="px-8 py-3.5 rounded-lg hover:opacity-90 transition-opacity text-center">
            Contame qué automatizar →
          </a>
          <a href={waUrl} target="_blank" rel="noopener noreferrer" style="border:1px solid rgba(255,255,255,0.12); color:#a0a0a0;" class="px-8 py-3.5 rounded-lg hover:border-[#4ab8ff] hover:text-[#4ab8ff] transition-colors text-center">
            Hablemos por WhatsApp
          </a>
        </div>
        <p class="hero-animate text-sm" data-delay="5" style="color:rgba(160,160,160,0.45); font-weight:300; letter-spacing:0.5px;">
          Co-fundador de GENIDEIA · Montevideo, Uruguay
        </p>
      </div>

      <!-- Red neuronal animada -->
      <div class="hero-animate order-first lg:order-last" data-delay="3" style="position:relative;">
        <div class="hero-glow" style="position:absolute; inset:0; background:radial-gradient(ellipse at center, rgba(74,184,255,0.18) 0%, transparent 62%); z-index:0;" aria-hidden="true"></div>
        <div style="position:relative; z-index:1; width:100%; max-width:460px; aspect-ratio:1; margin:0 auto;">
          <canvas id="hero-net" style="width:100%; height:100%; display:block;" aria-hidden="true"></canvas>
        </div>
      </div>
    </div>
  </section>

  <!-- ── EL PROBLEMA ───────────────────────────────────────── -->
  <section style="background:#0d0d0d; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-24">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-14" data-reveal>
        <p style="color:#4ab8ff; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">¿Te suena?</p>
        <h2 style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);" class="mb-4">
          El trabajo que hacés a mano<br />una máquina lo hace mejor
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {problemas.map((p, i) => (
          <div class="rounded-xl p-6 flex items-start gap-4" style="background:#111111; border:1px solid rgba(255,255,255,0.07);" data-reveal data-delay={String((i % 2) + 1)}>
            <span style="color:#4ab8ff; flex-shrink:0; font-family:'Cormorant Garamond',serif; font-size:1.4rem; line-height:1;">✕</span>
            <p style="color:#a0a0a0; font-weight:300;" class="text-sm leading-relaxed">{p}</p>
          </div>
        ))}
      </div>
      <p class="text-center mt-10 text-lg" style="color:#e8e8e8; font-weight:300;" data-reveal>
        No es un problema de esfuerzo. Es un problema de <span style="color:#4ab8ff;">sistema</span>.
      </p>
    </div>
  </section>

  <!-- ── QUÉ HAGO / EJEMPLOS ───────────────────────────────── -->
  <section class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16" data-reveal>
        <p style="color:#4ab8ff; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">Qué puedo automatizar</p>
        <h2 style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);" class="mb-4">
          Ejemplos de lo que resuelvo
        </h2>
        <p style="color:#a0a0a0; font-weight:300;" class="text-lg max-w-xl mx-auto">
          Cada empresa es distinta. Esto es lo que más se repite — tu caso lo definimos juntos.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {ejemplos.map((e, i) => (
          <div class="card-hover rounded-xl p-7 flex flex-col" style="background:#111111; border:1px solid rgba(255,255,255,0.07);" data-reveal data-delay={String((i % 3) + 1)}>
            <div style="width:38px; height:38px; display:flex; align-items:center; justify-content:center; border-radius:8px; background:rgba(74,184,255,0.08); border:1px solid rgba(74,184,255,0.2); color:#4ab8ff;" class="mb-5">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l2.5 2.5M16.5 16.5L19 19M19 5l-2.5 2.5M7.5 16.5L5 19"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3 style="font-family:'Cormorant Garamond',serif; font-weight:600; color:#e8e8e8; font-size:1.4rem;" class="mb-3">{e.t}</h3>
            <p style="color:#a0a0a0; font-weight:300;" class="text-sm leading-relaxed">{e.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CÓMO TRABAJO ──────────────────────────────────────── -->
  <section style="background:#0d0d0d; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16" data-reveal>
        <p style="color:#4ab8ff; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">Cómo trabajo</p>
        <h2 style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);" class="mb-4">
          Simple, a tu medida, con soporte
        </h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-10">
        {pasos.map((p, i) => (
          <div data-reveal data-delay={String(i + 1)}>
            <p style="font-family:'Cormorant Garamond',serif; font-weight:700; color:#4ab8ff; line-height:1;" class="text-7xl mb-5">{p.n}</p>
            <h3 style="color:#e8e8e8; font-weight:500;" class="text-lg mb-3">{p.t}</h3>
            <p style="color:#a0a0a0; font-weight:300;" class="text-sm leading-relaxed">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TU PROBLEMA (FORM) ────────────────────────────────── -->
  <section id="tu-problema" class="py-24">
    <div class="max-w-2xl mx-auto px-6">
      <div class="text-center mb-12" data-reveal>
        <h2 style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);" class="mb-4">
          ¿Qué te gustaría automatizar?
        </h2>
        <p style="color:#a0a0a0; font-weight:300;" class="text-lg leading-relaxed">
          Contámelo en tus palabras. Te respondo con una idea concreta de cómo resolverlo
          — y si hace falta, lo construyo.
        </p>
      </div>

      <form id="auto-form" class="space-y-5" data-reveal>
        <div>
          <label style="color:#a0a0a0; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">Área a automatizar</label>
          <select name="area" required class="form-input">
            <option value="">Elegí una opción</option>
            <option>Atención al cliente / WhatsApp</option>
            <option>Ventas y seguimiento de clientes</option>
            <option>Procesos internos / tareas repetitivas</option>
            <option>Reportes y datos del negocio</option>
            <option>Integrar herramientas que ya uso</option>
            <option>No sé / quiero asesorarme</option>
          </select>
        </div>
        <div>
          <label style="color:#a0a0a0; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">Contame qué pasa hoy</label>
          <textarea name="problema" rows="5" required placeholder="¿Qué tarea te come el día? ¿Dónde se te escapan clientes o tiempo?" class="form-input resize-none"></textarea>
        </div>
        <div>
          <label style="color:#a0a0a0; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">Tu nombre / empresa <span style="color:rgba(160,160,160,0.4);">(opcional)</span></label>
          <input name="nombre" type="text" placeholder="Para personalizar la respuesta" class="form-input" />
        </div>
        <button type="submit" style="background:#4ab8ff; color:#0a0a0a; font-weight:600; width:100%;" class="py-3.5 rounded-lg hover:opacity-90 transition-opacity text-base">
          Enviar y hablar por WhatsApp →
        </button>
        <p style="color:rgba(160,160,160,0.35); font-weight:300;" class="text-xs text-center">
          Se abre WhatsApp con tu mensaje ya armado · Te respondo en menos de 24 horas
        </p>
      </form>

      <div id="auto-success" class="hidden text-center py-8" data-reveal>
        <p style="color:#4ab8ff; font-size:1.5rem; margin-bottom:1rem;">✓</p>
        <p style="color:#e8e8e8; font-weight:500;" class="text-lg mb-2">¡Listo!</p>
        <p style="color:#a0a0a0; font-weight:300;">Se abrió WhatsApp con tu mensaje. Te respondo con una propuesta concreta.</p>
      </div>
    </div>
  </section>

  <!-- ── CTA FINAL ─────────────────────────────────────────── -->
  <section class="max-w-3xl mx-auto px-6 py-28 text-center" style="border-top:1px solid rgba(255,255,255,0.07);" data-reveal>
    <h2 style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);" class="mb-5">
      Dejá de hacer a mano<br />lo que una máquina puede hacer sola
    </h2>
    <p style="color:#a0a0a0; font-weight:300;" class="text-lg mb-10 leading-relaxed">
      Contame en qué punto está tu empresa y vemos juntos qué automatizar primero.
    </p>
    <a href={waUrl} target="_blank" rel="noopener noreferrer" style="background:#4ab8ff; color:#0a0a0a; font-weight:600;" class="px-10 py-4 rounded-lg hover:opacity-90 transition-opacity inline-block text-base">
      Hablar por WhatsApp
    </a>
    <p style="color:rgba(160,160,160,0.35); font-weight:300;" class="text-sm mt-5">Sin compromiso · Respondo en menos de 24 horas</p>
  </section>

  <!-- ── FOOTER ────────────────────────────────────────────── -->
  <footer style="border-top:1px solid rgba(255,255,255,0.07);" class="py-10">
    <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm" style="color:#a0a0a0;">
      <div>
        <p style="font-family:'Cormorant Garamond',serif; font-size:1.05rem; color:#e8e8e8;">Andrés Albornoz</p>
        <p style="font-weight:300; font-size:0.8rem;">Co-fundador de <a href="/" style="color:#4ab8ff;">GENIDEIA</a> · Automatización de empresas</p>
      </div>
      <a href={waUrl} target="_blank" rel="noopener noreferrer" style="font-weight:300;" class="hover:text-[#4ab8ff] transition-colors">WhatsApp +598 92 302 941</a>
    </div>
  </footer>

  <!-- Scroll reveal -->
  <script>
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => obs.observe(el));

    // Form → WhatsApp
    const form = document.getElementById('auto-form');
    const ok = document.getElementById('auto-success');
    form?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const data = new FormData(form);
      const area = (data.get('area') || '').toString();
      const prob = (data.get('problema') || '').toString();
      const nom = (data.get('nombre') || '').toString();
      const hola = nom ? `Hola Andrés, soy ${nom}.` : 'Hola Andrés,';
      const msg = `${hola} me gustaría automatizar: ${area}.\n\n*Lo que pasa hoy:*\n${prob}`;
      window.open(`https://wa.me/59892302941?text=${encodeURIComponent(msg)}`, '_blank');
      form.classList.add('hidden');
      ok?.classList.remove('hidden');
      ok?.classList.add('is-visible');
    });
  </script>

  <!-- Red neuronal animada (se arma, rota y se desarma) -->
  <script>
    (() => {
      const canvas = document.getElementById('hero-net');
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const N = window.innerWidth < 640 ? 64 : 90;
      const golden = Math.PI * (3 - Math.sqrt(5));
      const pts = [];
      for (let i = 0; i < N; i++) {
        const y = 1 - (i / (N - 1)) * 2;
        const r = Math.sqrt(Math.max(0, 1 - y * y));
        const th = golden * i;
        pts.push({ x: Math.cos(th) * r, y, z: Math.sin(th) * r, sx: Math.random() * 2 - 1, sy: Math.random() * 2 - 1, sz: Math.random() * 2 - 1 });
      }
      let W = 0, H = 0, DPR = 1;
      function resize() {
        const rect = canvas.getBoundingClientRect();
        DPR = Math.min(window.devicePixelRatio || 1, 2);
        W = rect.width; H = rect.height;
        canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      }
      resize(); window.addEventListener('resize', resize);
      const T_A = 2200, T_H = 2400, T_D = 2000, T_H2 = 700, CYCLE = T_A + T_H + T_D + T_H2;
      const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      function assembly(ms) { const t = ms % CYCLE; if (t < T_A) return ease(t / T_A); if (t < T_A + T_H) return 1; if (t < T_A + T_H + T_D) return 1 - ease((t - T_A - T_H) / T_D); return 0; }
      let angle = 0; const start = performance.now(); const S = 2.3;
      function frame(now) {
        const ms = now - start; const a = reduced ? 1 : assembly(ms);
        if (!reduced) angle += 0.0018;
        const R = Math.min(W, H) * 0.34, cx = W / 2, cy = H / 2, cos = Math.cos(angle), sin = Math.sin(angle);
        ctx.clearRect(0, 0, W, H);
        const pr = [];
        for (const p of pts) {
          const X = p.sx * S + (p.x - p.sx * S) * a, Y = p.sy * S + (p.y - p.sy * S) * a, Z = p.sz * S + (p.z - p.sz * S) * a;
          const rx = X * cos - Z * sin, rz = X * sin + Z * cos;
          pr.push({ x: cx + rx * R, y: cy + Y * R, depth: Math.max(0, Math.min(1, (rz + 1.5) / 3)) });
        }
        const D = R * 0.6; ctx.lineWidth = 0.7;
        for (let i = 0; i < N; i++) for (let j = i + 1; j < N; j++) {
          const dx = pr[i].x - pr[j].x, dy = pr[i].y - pr[j].y, d = Math.hypot(dx, dy);
          if (d < D) { ctx.strokeStyle = 'rgba(74,184,255,' + ((1 - d / D) * 0.5 * (0.25 + 0.75 * a)).toFixed(3) + ')'; ctx.beginPath(); ctx.moveTo(pr[i].x, pr[i].y); ctx.lineTo(pr[j].x, pr[j].y); ctx.stroke(); }
        }
        ctx.shadowColor = 'rgba(74,184,255,0.9)'; ctx.shadowBlur = 6;
        for (const q of pr) { ctx.fillStyle = 'rgba(150,210,255,' + (0.45 + q.depth * 0.5).toFixed(3) + ')'; ctx.beginPath(); ctx.arc(q.x, q.y, 1.2 + q.depth * 2.2, 0, Math.PI * 2); ctx.fill(); }
        ctx.shadowBlur = 0;
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    })();
  </script>

  <style>
    @keyframes heroGlowPulse { 0%,100% { opacity:0.55; transform:scale(1); } 50% { opacity:1; transform:scale(1.08); } }
    .hero-glow { animation: heroGlowPulse 5s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) { .hero-glow { animation: none; } }
  </style>

</body>
</html>
