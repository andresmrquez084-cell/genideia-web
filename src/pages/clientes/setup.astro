---
import '../../styles/client-hub.css';
---
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Configurar GENIDEIA Client Hub</title><link rel="icon" href="/favicon.png"/></head><body>
<main class="login"><div class="loginbox"><section class="loginart"><img src="/og-genideia.png" alt="GENIDEIA Company"/></section><section class="loginform"><div class="eyebrow">Configuración inicial</div><h1>Creá el acceso administrador</h1><p>Este paso se utiliza una sola vez. Elegí tu usuario y contraseña del panel interno de GENIDEIA. La contraseña se envía directamente a Supabase desde tu navegador y no pasa por el chat.</p><label>Nombre<input id="name" value="GENIDEIA"/></label><label style="margin-top:10px">Usuario<input id="username" value="genideia" autocomplete="username"/></label><label style="margin-top:10px">Contraseña<input id="password" type="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres"/></label><label style="margin-top:10px">Repetir contraseña<input id="confirm" type="password" autocomplete="new-password"/></label><button id="setupBtn" class="btn green" style="margin-top:15px;padding:12px">Crear administrador</button><div id="msg" class="error"></div><div id="success" class="callout hidden" style="margin-top:12px"></div><p style="margin-top:16px"><a href="/clientes" style="color:#65ddff">Volver al acceso</a></p></section></div></main>
<script type="module">
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.57.4';
const URL='https://dbwuubabafzsinaokawe.supabase.co',KEY='sb_publishable_5uIKiEXiz-7FW4guG1Tg_Q_gVVotzih';const sb=createClient(URL,KEY);const $=id=>document.getElementById(id);const normalize=s=>s.trim().toLowerCase().replace(/[^a-z0-9._-]+/g,'');
async function existing(){const{data:{session}}=await sb.auth.getSession();if(session){const{data:p}=await sb.from('gen_hub_profiles').select('role').eq('auth_user_id',session.user.id).maybeSingle();if(p?.role==='admin')location.href='/clientes/admin'}}await existing();
$('setupBtn').onclick=async()=>{const username=normalize($('username').value),password=$('password').value,confirm=$('confirm').value,name=$('name').value.trim()||'GENIDEIA';$('msg').style.display='none';$('success').classList.add('hidden');if(!username||password.length<8||password!==confirm){$('msg').textContent=password!==confirm?'Las contraseñas no coinciden.':'Usá una contraseña de al menos 8 caracteres.';$('msg').style.display='block';return}const b=$('setupBtn');b.disabled=true;b.textContent='Configurando…';try{const res=await fetch(`${URL}/functions/v1/hub-bootstrap-admin`,{method:'POST',headers:{'Content-Type':'application/json','apikey':KEY},body:JSON.stringify({username,password,nombre:name})});const data=await res.json();if(!res.ok){if(data.error==='admin_already_exists'){$('msg').innerHTML='El administrador ya fue creado. <a href="/clientes" style="color:#65ddff">Ingresá desde el login.</a>';}else $('msg').textContent=data.message||'No se pudo completar la configuración.';$('msg').style.display='block';return}const email=`${username}@hub.genideia.local`;const login=await sb.auth.signInWithPassword({email,password});if(login.error)throw login.error;$('success').classList.remove('hidden');$('success').innerHTML='<b>Administrador creado ✓</b><br>Redirigiendo al panel interno…';setTimeout(()=>location.href='/clientes/admin',800)}catch(e){$('msg').textContent=e?.message||String(e);$('msg').style.display='block'}finally{b.disabled=false;b.textContent='Crear administrador'}};
</script></body></html>