---
import '../../styles/client-hub.css';
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>GENIDEIA · Biblioteca de videos</title>
  <link rel="icon" href="/favicon.png" />
  <style>
    .video-shell{max-width:1180px;margin:0 auto;padding:28px}
    .video-top{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:24px}
    .video-top h1{margin:5px 0 5px;font-size:28px}.video-top p{margin:0;color:#718aa5;line-height:1.6;max-width:720px}
    .video-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.video-slot{border:1px solid #173452;border-radius:18px;background:linear-gradient(180deg,#071522,#06111e);padding:18px}
    .video-slot-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}.video-slot h2{font-size:15px;margin:0 0 4px}.video-slot small{color:#607b98;line-height:1.45}
    .video-preview{aspect-ratio:16/9;width:100%;border-radius:13px;background:#020817;border:1px solid #173452;display:grid;place-items:center;overflow:hidden;margin:14px 0}.video-preview video{width:100%;height:100%;object-fit:contain;background:#020817}.video-empty{color:#506b86;text-align:center;font-size:11px;padding:18px}
    .upload-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end}.upload-row input[type=file]{width:100%;font-size:10px}.progress{height:7px;border-radius:999px;background:#06101d;overflow:hidden;margin-top:12px;border:1px solid #122c45}.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,#13bdf0,#2785ff);transition:width .2s}.status{min-height:18px;margin-top:8px;color:#6e89a7;font-size:9px;line-height:1.5}.status.ok{color:#65dca0}.status.err{color:#ff9b9b}.slot-path{margin-top:10px;padding:8px 10px;border:1px solid #102d47;border-radius:9px;background:#04101d;color:#58718c;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:8px;overflow-wrap:anywhere}
    .actions{display:flex;gap:9px;flex-wrap:wrap}.note{margin-top:20px;border:1px solid #173452;border-radius:15px;padding:14px 16px;color:#7089a4;background:#06111e;font-size:10px;line-height:1.65}
    @media(max-width:800px){.video-shell{padding:18px}.video-top{flex-direction:column}.video-grid{grid-template-columns:1fr}.upload-row{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <main class="video-shell">
    <div class="video-top">
      <div><small>Panel interno · almacenamiento en Supabase</small><h1>Biblioteca de videos</h1><p>Subí o reemplazá los videos del portfolio y el video general de onboarding. Los archivos se guardan en rutas fijas para que el sitio siempre sepa dónde encontrarlos.</p></div>
      <div class="actions"><a class="btn secondary" href="/clientes/admin">← Gestión</a><a class="btn" href="/experiencia/" target="_blank">Ver portfolio ↗</a></div>
    </div>
    <div id="videoGrid" class="video-grid"></div>
    <div class="note"><b>Formato:</b> MP4. La carga es reanudable: si la conexión se corta, el navegador puede continuar el archivo. Reemplazar un video conserva el mismo apartado y no requiere volver a desplegar el sitio.</div>
  </main>
  <div id="toast" class="toast"></div>

<script type="module">
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.57.4';
import * as tus from 'https://esm.sh/tus-js-client@4.3.1';

const PROJECT_ID='dbwuubabafzsinaokawe';
const URL=`https://${PROJECT_ID}.supabase.co`;
const KEY='sb_publishable_5uIKiEXiz-7FW4guG1Tg_Q_gVVotzih';
const BUCKET='genideia-videos';
const sb=createClient(URL,KEY);
const $=id=>document.getElementById(id);
let session=null;

const SLOTS=[
  {slot:'portfolio.tms',path:'portfolio/tms.mp4',title:'Portfolio · GENIDEIA TMS',detail:'Recorrido técnico del sistema TMS.'},
  {slot:'portfolio.os',path:'portfolio/os.mp4',title:'Portfolio · GENIDEIA OS',detail:'Recorrido técnico del sistema operativo interno.'},
  {slot:'portfolio.bot',path:'portfolio/bot.mp4',title:'Portfolio · WhatsApp + IA',detail:'Demostración del asistente, agenda y seguimiento.'},
  {slot:'onboarding.default',path:'onboarding/default.mp4',title:'Onboarding · bienvenida Client Hub',detail:'Video general que recibe un cliente al entrar a su espacio por primera vez.',onboarding:true}
];

function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3200)}
function idFor(slot){return slot.replace(/[^a-z0-9]+/gi,'-')}
function publicUrl(path){return sb.storage.from(BUCKET).getPublicUrl(path).data.publicUrl}
function previewMarkup(row,slot){
  if(!row)return '<div class="video-empty">Todavía no hay un video cargado en este apartado.</div>';
  return `<video controls playsinline preload="metadata" src="${row.public_url}?v=${Date.now()}"></video>`;
}
function card(slot,row){const id=idFor(slot.slot);return `<section class="video-slot">
  <div class="video-slot-head"><div><h2>${slot.title}</h2><small>${slot.detail}</small></div><span class="badge ${row?'green':'amber'}">${row?'Cargado':'Pendiente'}</span></div>
  <div class="video-preview" id="preview-${id}">${previewMarkup(row,slot)}</div>
  <div class="upload-row"><label>Archivo MP4<input id="file-${id}" type="file" accept="video/mp4,.mp4" /></label><button class="btn green upload-video" data-slot="${slot.slot}">${row?'Reemplazar':'Subir video'}</button></div>
  <div class="progress"><i id="progress-${id}"></i></div><div class="status" id="status-${id}">${row?'Disponible en la nube.':''}</div>
  <div class="slot-path">${BUCKET}/${slot.path}</div>
</section>`}

async function guard(){
  const {data:{session:s}}=await sb.auth.getSession(); session=s;
  if(!session){location.href='/clientes';return false}
  const {data:profile}=await sb.from('gen_hub_profiles').select('role,activo').eq('auth_user_id',session.user.id).maybeSingle();
  if(!profile||profile.role!=='admin'||profile.activo===false){location.href='/clientes/portal';return false}
  return true;
}

async function load(){
  const {data,error}=await sb.from('gen_site_media').select('*').order('slot');
  if(error){toast(error.message);return}
  const rows=new Map((data||[]).map(x=>[x.slot,x]));
  $('videoGrid').innerHTML=SLOTS.map(slot=>card(slot,rows.get(slot.slot))).join('');
  document.querySelectorAll('.upload-video').forEach(button=>button.onclick=()=>uploadSlot(SLOTS.find(x=>x.slot===button.dataset.slot),button));
}

async function uploadSlot(slot,button){
  const id=idFor(slot.slot),input=$(`file-${id}`),file=input?.files?.[0],status=$(`status-${id}`),bar=$(`progress-${id}`);
  if(!file)return toast('Elegí un archivo MP4');
  if(file.type!=='video/mp4'&&!file.name.toLowerCase().endsWith('.mp4'))return toast('El archivo debe ser MP4');
  const {data:{session:current}}=await sb.auth.getSession();
  if(!current?.access_token)return location.href='/clientes';
  button.disabled=true;input.disabled=true;status.className='status';status.textContent='Preparando carga…';bar.style.width='0%';
  const upload=new tus.Upload(file,{
    endpoint:`https://${PROJECT_ID}.storage.supabase.co/storage/v1/upload/resumable`,
    retryDelays:[0,3000,5000,10000,20000],
    headers:{authorization:`Bearer ${current.access_token}`,'x-upsert':'true'},
    uploadDataDuringCreation:true,
    removeFingerprintOnSuccess:true,
    chunkSize:6*1024*1024,
    metadata:{bucketName:BUCKET,objectName:slot.path,contentType:'video/mp4',cacheControl:'60'},
    onError(error){button.disabled=false;input.disabled=false;status.className='status err';status.textContent=error?.message||'No se pudo subir el video';toast('Error al subir el video')},
    onProgress(bytesUploaded,bytesTotal){const pct=Math.min(100,(bytesUploaded/bytesTotal)*100);bar.style.width=pct.toFixed(1)+'%';status.textContent=`Subiendo… ${pct.toFixed(0)}%`},
    async onSuccess(){
      const url=publicUrl(slot.path);
      const {error:metaError}=await sb.from('gen_site_media').upsert({slot:slot.slot,storage_path:slot.path,public_url:url,updated_at:new Date().toISOString(),updated_by:current.user.id},{onConflict:'slot'});
      if(metaError){button.disabled=false;input.disabled=false;status.className='status err';status.textContent=metaError.message;return}
      if(slot.onboarding){const {error:rpcError}=await sb.rpc('gen_hub_set_default_onboarding_video',{p_url:url});if(rpcError){button.disabled=false;input.disabled=false;status.className='status err';status.textContent=rpcError.message;return}}
      bar.style.width='100%';status.className='status ok';status.textContent='Video cargado y vinculado correctamente.';button.disabled=false;button.textContent='Reemplazar';input.disabled=false;input.value='';
      $(`preview-${id}`).innerHTML=`<video controls playsinline preload="metadata" src="${url}?v=${Date.now()}"></video>`;
      button.closest('.video-slot').querySelector('.badge').className='badge green';button.closest('.video-slot').querySelector('.badge').textContent='Cargado';
      toast('Video actualizado ✓');
    }
  });
  const previous=await upload.findPreviousUploads(); if(previous.length)upload.resumeFromPreviousUpload(previous[0]); upload.start();
}

if(await guard())await load();
</script>
</body>
</html>
