---
import '../../styles/client-hub.css';
---
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Tu espacio · GENIDEIA</title><link rel="icon" href="/favicon.png"/></head><body>
<div id="app" class="shell hidden">
<aside class="side"><div class="brand"><img src="/favicon.png" alt="GENIDEIA"/><div><b>GENIDEIA</b><small>CLIENT HUB</small></div></div><div class="navtitle">Tu espacio</div><nav>
<button class="active" data-page="home">Inicio</button><button data-page="presentations">Presentaciones</button><button data-page="contracts">Contratos</button><button data-page="projects">Proyectos y entregables</button><button data-page="meetings">Reuniones</button>
</nav><div class="who"><div><b id="whoName">Cliente</b><small id="whoCompany">GENIDEIA Client Hub</small></div><button id="logout" class="btn secondary">Salir</button></div></aside>
<main class="main"><div class="top"><div><small id="topCompany">Espacio privado</small><h1 id="topName">Bienvenido</h1></div><span class="badge green">Acceso seguro</span></div>
<section id="home" class="page active"><div class="card welcome"><div class="eyebrow">Bienvenido a GENIDEIA</div><h2 id="welcomeTitle">Tu espacio ya está listo.</h2><p>Desde acá podés revisar tu propuesta, firmar contratos, seguir el avance de cada proyecto y volver a consultar reuniones, acuerdos y entregables.</p><div id="welcomeVideo" class="video-card"><div class="video-screen"><video id="video" controls playsinline preload="metadata" poster="/og-genideia.png"></video></div><div class="video-copy"><div class="eyebrow">Mensaje de bienvenida</div><h3>Cómo usar este espacio</h3><p>Este video explica dónde firmar, cómo seguir los avances y dónde encontrar el historial de reuniones y entregables.</p></div></div></div><div class="grid4" id="clientMetrics" style="margin-top:14px"></div><div class="grid2" style="margin-top:14px"><div class="card"><div class="sectionhead"><h3>Tus proyectos</h3><span class="badge" id="projectCount"></span></div><div id="homeProjects"></div></div><div class="card"><div class="sectionhead"><h3>Últimas actualizaciones</h3><span class="badge">GENIDEIA</span></div><div id="homeUpdates"></div></div></div></section>
<section id="presentations" class="page"><h2 class="title">Presentaciones</h2><p class="sub">Acá encontrás las presentaciones y propuestas que GENIDEIA compartió con vos.</p><div class="card" id="presentationsList"></div></section>
<section id="contracts" class="page"><h2 class="title">Contratos</h2><p class="sub">Cada solución tiene su propio contrato, precio, plazo y garantía. Una vez firmado, queda archivado dentro de tu espacio.</p><div id="contractsList" class="grid3"></div><div id="contractDetail" style="margin-top:14px"></div></section>
<section id="projects" class="page"><h2 class="title">Proyectos y entregables</h2><p class="sub">Seguimiento del estado actual, próximos pasos, avances y archivos entregados.</p><div id="projectsList"></div></section>
<section id="meetings" class="page"><h2 class="title">Reuniones</h2><p class="sub">Cada reunión queda asociada a un objetivo específico. Podés volver a consultar el resumen, acuerdos y enlaces cuando lo necesites.</p><div class="card" id="meetingsList"></div></section>
</main></div>
<button id="assistantFab" class="assistant-fab hidden">✦ ¿Necesitás ayuda?</button><div id="assistant" class="assistant"><div class="assistant-head"><div><b>Asistente GENIDEIA</b><small>Guía del portal · sin IA</small></div><button id="closeAssistant" class="btn secondary">×</button></div><div class="assistant-body"><div id="assistantMsg" class="assistant-msg">Hola. Puedo ayudarte a encontrar rápidamente lo que necesitás dentro de tu espacio.</div><div class="chips"><button data-help="contract">Firmar contrato</button><button data-help="project">Ver avances</button><button data-help="meeting">Buscar reunión</button><button data-help="presentation">Ver propuesta</button><button data-help="team">Contactar al equipo</button></div></div></div><div id="toast" class="toast"></div>
<script type="module">
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.57.4';
const URL='https://dbwuubabafzsinaokawe.supabase.co',KEY='sb_publishable_5uIKiEXiz-7FW4guG1Tg_Q_gVVotzih';const sb=createClient(URL,KEY);const $=id=>document.getElementById(id);let session,profile,projects=[],presentations=[],contracts=[],updates=[],meetings=[],deliverables=[];let activeContract=null,canvas=null,ctx=null,drawing=false;
function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2600)}
function nav(id){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===id));$(id).classList.add('active');if(id==='contracts'&&activeContract)setTimeout(initCanvas,50)}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>nav(b.dataset.page));$('logout').onclick=async()=>{await sb.auth.signOut();location.href='/clientes'};
async function guard(){const r=await sb.auth.getSession();session=r.data.session;if(!session){location.href='/clientes';return false}const{data:p}=await sb.from('gen_hub_profiles').select('*').eq('auth_user_id',session.user.id).maybeSingle();if(!p||p.role!=='client'||!p.activo){location.href='/clientes';return false}profile=p;return true}
async function load(){const [pr,ps,ct,up,mt,de]=await Promise.all([sb.from('gen_hub_proyectos').select('*').order('creado_en',{ascending:false}),sb.from('gen_hub_presentaciones').select('*').order('creado_en',{ascending:false}),sb.from('gen_hub_contratos').select('*').order('creado_en',{ascending:false}),sb.from('gen_hub_actualizaciones').select('*').order('creado_en',{ascending:false}),sb.from('gen_hub_reuniones').select('*').order('fecha',{ascending:false}),sb.from('gen_hub_entregables').select('*').order('creado_en',{ascending:false})]);projects=pr.data||[];presentations=ps.data||[];contracts=ct.data||[];updates=up.data||[];meetings=mt.data||[];deliverables=de.data||[];render()}
function stateLabel(s){return({pendiente_firma:'Pendiente de firma',en_ejecucion:'En ejecución',en_revision:'En revisión',implementado:'Implementado',pausado:'Pausado'})[s]||s}
function badgeClass(s){return s==='en_ejecucion'||s==='implementado'||s==='firmado'?'green':s==='pendiente_firma'?'amber':''}
function render(){const name=profile.nombre||profile.username,company=profile.empresa_nombre||'Tu empresa';$('whoName').textContent=name;$('whoCompany').textContent=company;$('topCompany').textContent=company+' × GENIDEIA';$('topName').textContent='Hola, '+name;$('welcomeTitle').textContent=`Bienvenido, ${name}.`;const v=$('video');if(profile.video_url){v.src=profile.video_url;v.onerror=()=>{$('welcomeVideo').querySelector('.video-screen').innerHTML='<img src="/og-genideia.png" style="width:100%;height:100%;object-fit:contain;padding:22px" alt="GENIDEIA">'}}
 const pending=contracts.filter(x=>x.estado==='pendiente_firma').length;const avg=projects.length?Math.round(projects.reduce((a,b)=>a+(b.progreso||0),0)/projects.length):0;$('clientMetrics').innerHTML=`<div class="metric"><small>Proyectos</small><b>${projects.length}</b></div><div class="metric"><small>Contratos pendientes</small><b>${pending}</b></div><div class="metric"><small>Progreso medio</small><b>${avg}%</b></div><div class="metric"><small>Reuniones registradas</small><b>${meetings.length}</b></div>`;$('projectCount').textContent=projects.length+' proyecto'+(projects.length===1?'':'s');
 $('homeProjects').innerHTML=projects.length?projects.slice(0,4).map(p=>`<div class="row"><div><b>${p.nombre}</b><small>${stateLabel(p.estado)} · próximo: ${p.proximo_paso||'a definir'}</small></div><b>${p.progreso}%</b></div>`).join(''):'<div class="empty">Todavía no hay proyectos.</div>';
 $('homeUpdates').innerHTML=updates.length?updates.slice(0,5).map(u=>`<div class="row"><div><b>${u.titulo}</b><small>${u.detalle||''}</small></div></div>`).join(''):'<div class="empty">Sin actualizaciones todavía.</div>';
 $('presentationsList').innerHTML=presentations.length?presentations.map(p=>`<div class="row"><div><b>${p.titulo}</b><small>${new Date(p.creado_en).toLocaleDateString('es-UY')} · ${p.estado}</small></div><div>${p.pdf_url?`<a class="btn" href="${p.pdf_url}" target="_blank" rel="noopener">Ver PDF</a>`:''} ${p.pptx_url?`<a class="btn secondary" href="${p.pptx_url}" target="_blank" rel="noopener">PPTX</a>`:''}</div></div>`).join(''):'<div class="empty">No hay presentaciones compartidas.</div>';
 $('contractsList').innerHTML=contracts.length?contracts.map(c=>{const p=projects.find(x=>x.id===c.proyecto_id);return`<button class="project contract-card" data-contract="${c.id}" style="text-align:left;color:inherit"><span class="badge ${badgeClass(c.estado)}">${c.estado==='firmado'?'Firmado':'Pendiente de firma'}</span><h3>${p?.nombre||c.numero||'Contrato'}</h3><p>${p?`${p.moneda} ${p.precio??''} · ${p.plazo||''}`:''}</p><footer><span>${c.numero||''}</span><span>Ver →</span></footer></button>`}).join(''):'<div class="empty" style="grid-column:1/-1">No hay contratos.</div>';document.querySelectorAll('[data-contract]').forEach(b=>b.onclick=()=>showContract(b.dataset.contract));
 $('projectsList').innerHTML=projects.length?projects.map(p=>`<div class="card" style="margin-bottom:14px"><div class="sectionhead"><div><span class="badge ${badgeClass(p.estado)}">${stateLabel(p.estado)}</span><h3 style="margin:9px 0 0;font-size:14px">${p.nombre}</h3></div><b>${p.progreso}%</b></div><div class="progress"><i style="width:${p.progreso}%"></i></div><p class="sub" style="margin:8px 0 14px">Próximo paso: <strong style="color:white">${p.proximo_paso||'A definir'}</strong></p><div class="grid2"><div><div class="sectionhead"><h3>Actualizaciones</h3></div>${updates.filter(u=>u.proyecto_id===p.id).map(u=>`<div class="row"><div><b>${u.titulo}</b><small>${u.detalle||''}</small></div><small>${new Date(u.creado_en).toLocaleDateString('es-UY')}</small></div>`).join('')||'<div class="empty">Sin actualizaciones.</div>'}</div><div><div class="sectionhead"><h3>Entregables</h3></div>${deliverables.filter(d=>d.proyecto_id===p.id).map(d=>`<div class="row"><div><b>${d.nombre}</b><small>${d.descripcion||''}</small></div>${d.archivo_url?`<a class="btn secondary" href="${d.archivo_url}" target="_blank">Abrir</a>`:''}</div>`).join('')||'<div class="empty">Todavía no hay entregables.</div>'}</div></div></div>`).join(''):'<div class="empty">No hay proyectos.</div>';
 $('meetingsList').innerHTML=meetings.length?meetings.map(m=>`<div class="row" style="align-items:flex-start"><div><b>${m.titulo}</b><small>${m.fecha?new Date(m.fecha).toLocaleString('es-UY'):''}</small><p style="font-size:9px;color:#91a9c2;line-height:1.6;margin:8px 0"><strong>Objetivo:</strong> ${m.objetivo||'—'}<br><strong>Resumen:</strong> ${m.resumen||'—'}<br><strong>Acuerdos:</strong> ${m.acuerdos||'—'}</p></div>${m.enlace?`<a class="btn secondary" href="${m.enlace}" target="_blank">Enlace</a>`:''}</div>`).join(''):'<div class="empty">No hay reuniones registradas.</div>';
 $('assistantFab').classList.remove('hidden')}
function showContract(id){activeContract=contracts.find(x=>x.id===id);const signed=activeContract.estado==='firmado';$('contractDetail').innerHTML=`<div class="contract-layout"><article class="contractpaper" id="printContract"><div>${activeContract.contenido}</div><div class="signatures"><div class="sigbox"><img src="/hub/andres-albornoz-signature.svg" alt="Firma Andrés Albornoz"><b>Andrés Albornoz</b><small>GENIDEIA COMPANY · Firmado</small></div><div class="sigbox" id="clientSig">${signed&&activeContract.firma_cliente_data?`<img src="${activeContract.firma_cliente_data}" alt="Firma cliente"><b>${activeContract.firmado_cliente_nombre||profile.nombre}</b><small>Firmado digitalmente · ${activeContract.firmado_en?new Date(activeContract.firmado_en).toLocaleString('es-UY'):''}</small>`:'<b>Firma del cliente</b><small>Pendiente</small>'}</div></div></article><aside class="card">${signed?`<div class="callout"><b>Contrato firmado ✓</b><br>Esta versión queda archivada dentro de tu espacio.</div><button class="btn" id="downloadSigned" style="width:100%;margin-top:12px">Descargar contrato firmado</button>`:`<div class="sectionhead"><h3>Firmar contrato</h3><span class="badge amber">Pendiente</span></div><p class="sub">Leé el documento completo y firmá dentro del recuadro.</p><label>Nombre completo<input id="signerName" value="${profile.nombre||''}"></label><label style="margin-top:10px">Documento (opcional)<input id="signerDoc"></label><div class="canvaswrap" style="margin-top:12px"><canvas id="signatureCanvas" width="560" height="220"></canvas></div><button id="clearSig" class="btn secondary" style="margin-top:8px">Limpiar</button><label style="display:flex;gap:8px;align-items:flex-start;margin-top:12px"><input id="accept" type="checkbox" style="width:auto;margin:2px 0 0"><span>Declaro haber leído y aceptado este contrato y la propuesta asociada.</span></label><button id="signContract" class="btn green" style="width:100%;margin-top:12px">Firmar contrato</button>`}</aside></div>`;nav('contracts');if(signed){$('downloadSigned').onclick=()=>window.print()}else setTimeout(initCanvas,30)}
function initCanvas(){canvas=$('signatureCanvas');if(!canvas)return;ctx=canvas.getContext('2d');ctx.lineWidth=3;ctx.lineCap='round';ctx.strokeStyle='#10233d';const pos=e=>{const r=canvas.getBoundingClientRect(),t=e.touches?.[0]||e;return{x:(t.clientX-r.left)*(canvas.width/r.width),y:(t.clientY-r.top)*(canvas.height/r.height)}};const start=e=>{drawing=true;const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y);e.preventDefault()};const move=e=>{if(!drawing)return;const p=pos(e);ctx.lineTo(p.x,p.y);ctx.stroke();e.preventDefault()};const end=()=>drawing=false;canvas.onmousedown=start;canvas.onmousemove=move;canvas.onmouseup=end;canvas.onmouseleave=end;canvas.ontouchstart=start;canvas.ontouchmove=move;canvas.ontouchend=end;$('clearSig').onclick=()=>ctx.clearRect(0,0,canvas.width,canvas.height);$('signContract').onclick=signContract}
async function signContract(){if(!$('accept').checked)return toast('Confirmá que leíste y aceptás el contrato');const data=canvas.toDataURL('image/png');if(data.length<2500)return toast('Ingresá tu firma en el recuadro');const signer=$('signerName').value.trim();if(!signer)return toast('Ingresá tu nombre');const{data:r,error}=await sb.rpc('gen_hub_sign_contract',{p_contract_id:activeContract.id,p_signature:data,p_signer_name:signer,p_signer_document:$('signerDoc').value||null});if(error)return toast(error.message);toast('Contrato firmado y archivado');await load();activeContract=(r&&r.id)?r:contracts.find(x=>x.id===activeContract.id);showContract(activeContract.id)}
$('assistantFab').onclick=()=>$('assistant').classList.toggle('open');$('closeAssistant').onclick=()=>$('assistant').classList.remove('open');document.querySelectorAll('[data-help]').forEach(b=>b.onclick=()=>{const h=b.dataset.help,msg=$('assistantMsg');if(h==='contract'){msg.textContent='Entrá en Contratos. Elegí la solución y, si está pendiente, vas a poder leer y firmar ahí mismo.';nav('contracts')}if(h==='project'){msg.textContent='En Proyectos y entregables vas a ver el porcentaje de avance, estado, próximo paso y archivos compartidos.';nav('projects')}if(h==='meeting'){msg.textContent='En Reuniones queda guardado el objetivo, resumen, acuerdos y enlace de cada encuentro.';nav('meetings')}if(h==='presentation'){msg.textContent='En Presentaciones encontrás la propuesta y los documentos comerciales que compartimos contigo.';nav('presentations')}if(h==='team'){msg.textContent='Si necesitás hablar con el equipo, usá el canal de contacto que acordamos. Más adelante este asistente podrá derivarte directamente a la persona responsable.'}});
if(await guard()){await load();$('app').classList.remove('hidden')}
</script></body></html>
