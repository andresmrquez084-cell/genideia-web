---
import '../../styles/client-hub.css';
---
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Tu espacio · GENIDEIA</title><link rel="icon" href="/favicon.png"/>
<style>
[hidden]{display:none!important}
.video-screen video{object-fit:contain!important;max-height:460px}
.welcome-replay{margin-top:14px;background:none;border:0;color:#6db8e6;font-size:12px;cursor:pointer;padding:0;text-decoration:underline;text-underline-offset:3px}
.welcome-replay:hover{color:#9ed4ff}
#welcomeDismiss{margin-top:12px}
</style>
</head><body>
<div id="app" class="shell hidden">
<aside class="side"><div class="brand"><img src="/favicon.png" alt="GENIDEIA"/><div><b>GENIDEIA</b><small>CLIENT HUB</small></div></div><div class="navtitle">Tu espacio</div><nav>
<button class="active" data-page="home">Inicio</button><button data-page="projects">Mi proyecto</button><button data-page="documents">Documentos</button><button data-page="meetings">Reuniones</button><button data-page="payments">Pagos</button><button data-page="help">Ayuda</button>
</nav><div class="who"><div><b id="whoName">Cliente</b><small id="whoCompany">GENIDEIA Client Hub</small></div><button id="logout" class="btn secondary">Salir</button></div></aside>
<main class="main"><div class="top"><div><small id="topCompany">Espacio privado</small><h1 id="topName">Bienvenido</h1></div><span class="badge green">Acceso seguro</span></div>
<section id="home" class="page active"><div class="card welcome"><div class="eyebrow">Bienvenido a GENIDEIA</div><h2 id="welcomeTitle">Tu espacio ya está listo.</h2><p>Desde acá podés revisar tu propuesta, firmar contratos, seguir el avance de cada proyecto y volver a consultar reuniones, acuerdos y entregables.</p><div id="welcomeVideo" class="video-card"><div class="video-screen"><video id="video" controls playsinline preload="metadata" poster="/og-genideia.png"></video></div><div class="video-copy"><div class="eyebrow">Mensaje de bienvenida</div><h3>Cómo usar este espacio</h3><p>Este video explica dónde firmar, cómo seguir los avances y dónde encontrar el historial de reuniones y entregables.</p><button id="welcomeDismiss" class="btn secondary" type="button">Ya lo vi · ocultar</button></div></div><button id="welcomeReplay" class="welcome-replay" type="button" hidden>▸ Volver a ver el video de bienvenida</button></div><div id="homeAction" style="margin-top:14px"></div><div class="grid4" id="clientMetrics" style="margin-top:14px"></div><div class="grid2" style="margin-top:14px"><div class="card"><div class="sectionhead"><h3>Tus proyectos</h3><span class="badge" id="projectCount"></span></div><div id="homeProjects"></div></div><div class="card"><div class="sectionhead"><h3>Últimas actualizaciones</h3><span class="badge">GENIDEIA</span></div><div id="homeUpdates"></div></div></div></section>
<section id="documents" class="page"><h2 class="title">Documentos</h2><p class="sub">Propuestas, presentaciones y contratos vinculados a tu trabajo con GENIDEIA.</p><div class="grid2"><div class="card"><div class="sectionhead"><h3>Presentaciones</h3><span class="badge">Propuestas</span></div><div id="presentationsList"></div></div><div class="card"><div class="sectionhead"><h3>Contratos</h3><span class="badge">Acuerdos</span></div><div id="contractsList"></div></div></div><div id="contractDetail" style="margin-top:14px"></div></section>
<section id="projects" class="page"><h2 class="title">Mi proyecto</h2><p class="sub">Seguimiento de la etapa actual, próximos pasos, avances y entregables.</p><div id="projectsList"></div></section>
<section id="meetings" class="page"><h2 class="title">Reuniones</h2><p class="sub">Cada reunión queda asociada a un objetivo específico. Podés volver a consultar el resumen, acuerdos y enlaces cuando lo necesites.</p><div id="meetingsList"></div></section>
<section id="payments" class="page"><h2 class="title">Pagos</h2><p class="sub">Importes, vencimientos, estado y métodos vinculados a tu proyecto.</p><div id="paymentsList"></div></section>
<section id="help" class="page"><h2 class="title">Ayuda</h2><p class="sub">Accesos rápidos para encontrar lo que necesitás dentro de tu espacio.</p><div class="help-grid"><button data-help="contract">Firmar contrato</button><button data-help="project">Ver avances</button><button data-help="meeting">Buscar reunión</button><button data-help="presentation">Ver propuesta</button><button data-help="payment">Revisar pagos</button><button data-help="team">Contactar al equipo</button></div><div id="helpMessage" class="card" style="margin-top:14px">Elegí una opción y te llevo al apartado correspondiente.</div></section>
</main></div>
<button id="assistantFab" class="assistant-fab hidden">✦ ¿Necesitás ayuda?</button><div id="assistant" class="assistant"><div class="assistant-head"><div><b>Asistente GENIDEIA</b><small>Guía del portal · sin IA</small></div><button id="closeAssistant" class="btn secondary">×</button></div><div class="assistant-body"><div id="assistantMsg" class="assistant-msg">Hola. Puedo ayudarte a encontrar rápidamente lo que necesitás dentro de tu espacio.</div><div class="chips"><button data-help="contract">Firmar contrato</button><button data-help="project">Ver avances</button><button data-help="meeting">Buscar reunión</button><button data-help="presentation">Ver propuesta</button><button data-help="team">Contactar al equipo</button></div></div></div><div id="toast" class="toast"></div>
<script type="module">
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.57.4';
const URL='https://dbwuubabafzsinaokawe.supabase.co',KEY='sb_publishable_5uIKiEXiz-7FW4guG1Tg_Q_gVVotzih';const sb=createClient(URL,KEY);const $=id=>document.getElementById(id);let session,profile,projects=[],presentations=[],contracts=[],updates=[],meetings=[],deliverables=[],payments=[],paymentMethods=[];let activeContract=null,canvas=null,ctx=null,drawing=false;
function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2600)}
function nav(id){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===id));$(id).classList.add('active');if(id==='documents'&&activeContract)setTimeout(initCanvas,50)}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>nav(b.dataset.page));$('logout').onclick=async()=>{await sb.auth.signOut();location.href='/clientes'};
async function guard(){const r=await sb.auth.getSession();session=r.data.session;if(!session){location.href='/clientes';return false}const{data:p}=await sb.from('gen_hub_profiles').select('*').eq('auth_user_id',session.user.id).maybeSingle();if(!p||p.role!=='client'||!p.activo){location.href='/clientes';return false}profile=p;return true}
async function load(){const safe=async q=>{try{const r=await q;return r.error?[]:(r.data||[])}catch{return []}};const [pr,ps,ct,up,mt,de,py,pm]=await Promise.all([safe(sb.from('gen_hub_proyectos').select('*').order('creado_en',{ascending:false})),safe(sb.from('gen_hub_presentaciones').select('*').order('creado_en',{ascending:false})),safe(sb.from('gen_hub_contratos').select('*').order('creado_en',{ascending:false})),safe(sb.from('gen_hub_actualizaciones').select('*').order('creado_en',{ascending:false})),safe(sb.from('gen_hub_reuniones').select('*').order('fecha',{ascending:false})),safe(sb.from('gen_hub_entregables').select('*').order('creado_en',{ascending:false})),safe(sb.from('gen_hub_pagos').select('*').order('creado_en',{ascending:false})),safe(sb.from('gen_hub_metodos_pago').select('*').order('orden',{ascending:true}))]);projects=pr;presentations=ps;contracts=ct;updates=up;meetings=mt;deliverables=de;payments=py;paymentMethods=pm;render()}
function stateLabel(s){return({pendiente_firma:'Pendiente de firma',en_ejecucion:'En ejecución',en_revision:'En revisión',implementado:'Implementado',pausado:'Pausado'})[s]||s}
function badgeClass(s){return s==='en_ejecucion'||s==='implementado'||s==='firmado'?'green':s==='pendiente_firma'?'amber':''}
function emptyState(title,detail){return `<div class="empty"><strong>${title}</strong><span>${detail}</span></div>`}
function renderHomeAction(){const pendingPayment=payments.find(x=>x.estado==='pendiente'||x.estado==='informado');if(pendingPayment){const project=projects.find(x=>String(x.id)===String(pendingPayment.proyecto_id));const currency=pendingPayment.moneda||'USD';const amount=Number(pendingPayment.monto||0).toLocaleString('es-UY');const due=pendingPayment.vencimiento?`Vence ${new Date(pendingPayment.vencimiento+'T12:00:00').toLocaleDateString('es-UY')}`:'Sin vencimiento definido';$('homeAction').innerHTML=`<div class="next-action urgent payment-home-card"><div class="next-action-copy"><span class="eyebrow">Pago pendiente</span><b>Tenés un pago pendiente</b><strong>${currency} ${amount}</strong><small>${pendingPayment.concepto||project?.nombre||'Pago asociado a tu proyecto'} · ${due}</small></div><button id="homePrimaryAction" class="btn green">Ver formas de pago →</button></div>`;$('homePrimaryAction').onclick=()=>nav('payments');return}const pending=contracts.find(x=>x.estado==='pendiente_firma');if(pending){const p=projects.find(x=>x.id===pending.proyecto_id);$('homeAction').innerHTML=`<div class="next-action urgent"><div class="next-action-copy"><span class="eyebrow">Acción pendiente</span><b>Tenés un contrato pendiente de firma</b><small>${p?.nombre||'Revisá el contrato para continuar con el proyecto.'}</small></div><button id="homePrimaryAction" class="btn green">Revisar y firmar →</button></div>`;$('homePrimaryAction').onclick=()=>{showContract(pending.id)};return}
 const active=projects.find(x=>x.estado==='en_ejecucion'||x.estado==='en_revision')||projects[0];if(active){$('homeAction').innerHTML=`<div class="next-action"><div class="next-action-copy"><span class="eyebrow">Estado actual</span><b>${active.nombre}</b><small>${stateLabel(active.estado)} · Próximo paso: ${active.proximo_paso||'A definir'}</small></div><button id="homePrimaryAction" class="btn">Ver avances →</button></div>`;$('homePrimaryAction').onclick=()=>nav('projects');return}
 if(presentations.length){$('homeAction').innerHTML=`<div class="next-action"><div class="next-action-copy"><span class="eyebrow">Disponible</span><b>Tu propuesta ya está en el portal</b><small>Podés volver a consultarla cuando quieras.</small></div><button id="homePrimaryAction" class="btn">Ver propuesta →</button></div>`;$('homePrimaryAction').onclick=()=>nav('documents');return}
 $('homeAction').innerHTML=`<div class="next-action quiet"><div class="next-action-copy"><span class="eyebrow">Todo al día</span><b>Tu espacio está listo</b><small>Cuando haya una acción que requiera tu atención, la vas a ver destacada acá.</small></div></div>`}

function projectStage(p){const progress=Number(p?.progreso||0);if(p?.estado==='implementado'||progress>=90)return 4;if(p?.estado==='en_revision'||progress>=70)return 3;if(p?.estado==='en_ejecucion'||progress>=35)return 2;if(progress>=10)return 1;return 0}
function stageTracker(p){const stages=['Diagnóstico','Diseño','Implementación','Pruebas','Entrega'],current=projectStage(p);return `<div class="stage-tracker">${stages.map((s,i)=>`<div class="stage ${i<current?'done':''} ${i===current?'current':''}"><span>${i<current?'✓':i+1}</span><div><b>${s}</b><small>${i<current?'Completado':i===current?'Etapa actual':'Próximamente'}</small></div></div>`).join('')}</div>`}
function paymentStatusLabel(s){return({pendiente:'Pendiente de pago',informado:'Pago informado',confirmado:'Pago confirmado',rechazado:'Pago rechazado',vencido:'Vencido',cancelado:'Cancelado'})[s]||stateLabel(s)||'Pendiente'}
function paymentBadgeClass(s){return s==='confirmado'?'green':s==='pendiente'||s==='informado'||s==='vencido'?'amber':''}
function copyPaymentValue(value,label){navigator.clipboard?.writeText(value).then(()=>toast(label+' copiada')).catch(()=>toast('No se pudo copiar. Copiala manualmente: '+value))}
function paymentMethodsMarkup(payment){const project=projects.find(x=>String(x.id)===String(payment.proyecto_id));const projectName=project?.nombre||payment.concepto||'tu proyecto';const currency=payment.moneda||'USD';const amount=Number(payment.monto||0).toLocaleString('es-UY');const payoneerMessage=`Hola Andrés, quiero pagar por Payoneer el proyecto ${projectName} por ${amount} ${currency}. ¿Me podés enviar el link de pago?`;const payoneerUrl='https://wa.me/59892302941?text='+encodeURIComponent(payoneerMessage);return `<div class="payment-methods-v2"><p class="payment-methods-label">Elegí cómo realizar este pago</p><section class="payment-method"><div class="payment-method-heading"><span>Transferencia local · Itaú</span><small>Uruguay</small></div><p class="payment-holder">Titular: Carlos Andrés Albornoz</p><div class="payment-currency-grid"><div class="payment-currency"><span>USD</span><b>0297709</b><button class="copy-btn" type="button" data-copy="0297709" data-copy-label="Cuenta USD">Copiar cuenta</button></div><div class="payment-currency"><span>UYU</span><b>0297715</b><button class="copy-btn" type="button" data-copy="0297715" data-copy-label="Cuenta UYU">Copiar cuenta</button></div></div></section><section class="payment-method"><div class="payment-method-heading"><span>Transferencia internacional · USD</span><small>Banco Itaú Uruguay S.A.</small></div><div class="payment-details"><div><span>Titular</span><b>Andrés Albornoz</b></div><div><span>Cuenta · Caja de ahorro en dólares</span><b>0297709</b><button class="copy-btn" type="button" data-copy="0297709" data-copy-label="Cuenta">Copiar cuenta</button></div><div><span>SWIFT/BIC · Banco Itaú Uruguay S.A.</span><b>ITAUUYMM</b><button class="copy-btn" type="button" data-copy="ITAUUYMM" data-copy-label="SWIFT/BIC">Copiar SWIFT</button></div><div><span>Dirección</span><b>Luis Bonavita 1266, piso 10, Montevideo, Uruguay</b></div><div><span>RUT banco</span><b>215393460011</b></div><div><span>Banco intermediario</span><b>JPMorgan Chase Bank N.A. · New York, United States</b></div><div><span>SWIFT intermediario</span><b>CHASUS33</b></div><div><span>ABA/Routing</span><b>021000021</b><button class="copy-btn" type="button" data-copy="021000021" data-copy-label="ABA/Routing">Copiar ABA</button></div></div><p class="payment-reference">Referencia sugerida: <strong>GENIDEIA - ${projectName}</strong></p></section><section class="payment-method payoneer-card"><div class="payment-method-heading"><span>Pago con tarjeta · Payoneer</span><small>Link a solicitud</small></div><p>Solicitá el link para este cobro y te lo enviamos por WhatsApp.</p><a class="btn green payoneer-link" href="${payoneerUrl}" target="_blank" rel="noopener">Solicitar link de pago</a></section></div>`}
function renderPayments(){const el=$('paymentsList');if(!payments.length){el.innerHTML=`<div class="card payment-empty"><span class="eyebrow">Pagos</span><h3>No tenés pagos pendientes</h3><p>Cuando haya un cobro asociado a tu proyecto, vas a ver acá el importe, vencimiento y estado.</p></div>`;return}el.innerHTML=payments.map(p=>{const currency=p.moneda||'USD';const amount=Number(p.monto||0).toLocaleString('es-UY');const canPay=p.estado==='pendiente'||p.estado==='informado';return `<article class="card payment-card"><div class="payment-summary"><div><span class="eyebrow">${canPay?'Cobro pendiente':'Cobro registrado'}</span><h3>${p.concepto||'Pago de proyecto'}</h3><small>${p.vencimiento?'Vence '+new Date(p.vencimiento+'T12:00:00').toLocaleDateString('es-UY'):'Sin vencimiento definido'}</small></div><div class="payment-amount"><b>${currency} ${amount}</b><span class="badge ${paymentBadgeClass(p.estado)}">${paymentStatusLabel(p.estado)}</span></div></div>${canPay?paymentMethodsMarkup(p):''}</article>`}).join('');el.querySelectorAll('[data-copy]').forEach(button=>button.onclick=()=>copyPaymentValue(button.dataset.copy,button.dataset.copyLabel||'Dato'))}
function setupWelcomeVideo(){
 if(setupWelcomeVideo.done)return;setupWelcomeVideo.done=true;
 const v=$('video'),wrap=$('welcomeVideo'),replay=$('welcomeReplay'),dismiss=$('welcomeDismiss');
 if(!profile.video_url){wrap.hidden=true;if(replay)replay.hidden=true;return}
 v.muted=true;v.setAttribute('muted','');
 v.src=profile.video_url;
 v.onerror=()=>{wrap.querySelector('.video-screen').innerHTML='<img src="/og-genideia.png" style="width:100%;height:100%;object-fit:contain;padding:22px" alt="GENIDEIA">'};
 const key='gii_welcome_seen_v1_'+(profile.auth_user_id||profile.username||'x');
 let seen=false;try{seen=localStorage.getItem(key)==='1'}catch(e){}
 const collapse=()=>{try{v.pause()}catch(e){}wrap.hidden=true;if(replay)replay.hidden=false};
 const markSeen=()=>{try{localStorage.setItem(key,'1')}catch(e){}collapse()};
 const play=()=>{const p=v.play();if(p&&p.catch)p.catch(()=>{})};
 const expand=()=>{wrap.hidden=false;if(replay)replay.hidden=true;v.muted=false;v.removeAttribute('muted');play()};
 v.addEventListener('ended',markSeen);
 if(dismiss)dismiss.onclick=markSeen;
 if(replay)replay.onclick=expand;
 if(seen){collapse();return}
 if(v.readyState>=3)play();else v.addEventListener('canplay',play,{once:true})
}
function render(){const name=profile.nombre||profile.username,company=profile.empresa_nombre||'Tu empresa';$('whoName').textContent=name;$('whoCompany').textContent=company;$('topCompany').textContent=company+' × GENIDEIA';$('topName').textContent='Hola, '+name;$('welcomeTitle').textContent=`Bienvenido, ${name}.`;setupWelcomeVideo();
 const pending=contracts.filter(x=>x.estado==='pendiente_firma').length;const avg=projects.length?Math.round(projects.reduce((a,b)=>a+(b.progreso||0),0)/projects.length):0;$('clientMetrics').innerHTML=`<div class="metric"><small>Proyectos</small><b>${projects.length}</b></div><div class="metric"><small>Contratos pendientes</small><b>${pending}</b></div><div class="metric"><small>Progreso medio</small><b>${avg}%</b></div><div class="metric"><small>Reuniones registradas</small><b>${meetings.length}</b></div>`;$('projectCount').textContent=projects.length+' proyecto'+(projects.length===1?'':'s');renderHomeAction();
 $('homeProjects').innerHTML=projects.length?projects.slice(0,4).map(p=>`<div class="row"><div><b>${p.nombre}</b><small>${stateLabel(p.estado)} · próximo: ${p.proximo_paso||'a definir'}</small></div><b>${p.progreso}%</b></div>`).join(''):emptyState('Todavía no hay proyectos','Cuando iniciemos una solución, su estado y próximos pasos aparecerán acá.');
 $('homeUpdates').innerHTML=updates.length?updates.slice(0,5).map(u=>`<div class="row"><div><b>${u.titulo}</b><small>${u.detalle||''}</small></div></div>`).join(''):emptyState('Todavía no hay actualizaciones','Cuando publiquemos un avance importante de tu proyecto, lo vas a ver acá.');
 $('presentationsList').innerHTML=presentations.length?presentations.map(p=>`<div class="row"><div><b>${p.titulo}</b><small>${new Date(p.creado_en).toLocaleDateString('es-UY')} · ${p.estado}</small></div><div>${p.pdf_url?`<a class="btn" href="${p.pdf_url}" target="_blank" rel="noopener">Ver PDF</a>`:''} ${p.pptx_url?`<a class="btn secondary" href="${p.pptx_url}" target="_blank" rel="noopener">PPTX</a>`:''}</div></div>`).join(''):emptyState('Todavía no hay presentaciones compartidas','Cuando GENIDEIA comparta una propuesta o presentación con vos, quedará guardada en este apartado.');
 $('contractsList').innerHTML=contracts.length?contracts.map(c=>{const p=projects.find(x=>x.id===c.proyecto_id);return`<button class="project contract-card" data-contract="${c.id}" style="text-align:left;color:inherit;width:100%;margin-bottom:8px"><span class="badge ${badgeClass(c.estado)}">${c.estado==='firmado'?'Firmado':'Pendiente de firma'}</span><h3>${p?.nombre||c.numero||'Contrato'}</h3><p>${p?`${p.moneda} ${p.precio??''} · ${p.plazo||''}`:''}</p><footer><span>${c.numero||''}</span><span>Ver →</span></footer></button>`}).join(''):emptyState('Todavía no hay contratos','Cuando una solución esté lista para formalizarse, vas a poder revisarla y firmarla desde acá.');document.querySelectorAll('[data-contract]').forEach(b=>b.onclick=()=>showContract(b.dataset.contract));
 $('projectsList').innerHTML=projects.length?projects.map(p=>`<div class="card project-v2" style="margin-bottom:14px"><div class="sectionhead"><div><span class="badge ${badgeClass(p.estado)}">${stateLabel(p.estado)}</span><h3 style="margin:9px 0 0;font-size:18px">${p.nombre}</h3></div><b>${p.progreso}%</b></div>${stageTracker(p)}<div class="progress"><i style="width:${p.progreso}%"></i></div><p class="sub" style="margin:8px 0 14px">Próximo paso: <strong style="color:white">${p.proximo_paso||'A definir'}</strong></p><div class="grid2"><div><div class="sectionhead"><h3>Actualizaciones</h3></div>${updates.filter(u=>u.proyecto_id===p.id).map(u=>`<div class="row"><div><b>${u.titulo}</b><small>${u.detalle||''}</small></div><small>${new Date(u.creado_en).toLocaleDateString('es-UY')}</small></div>`).join('')||emptyState('Sin actualizaciones por ahora','Los avances que publiquemos sobre este proyecto aparecerán en este espacio.')}</div><div><div class="sectionhead"><h3>Entregables</h3></div>${deliverables.filter(d=>d.proyecto_id===p.id).map(d=>`<div class="row"><div><b>${d.nombre}</b><small>${d.descripcion||''}</small></div>${d.archivo_url?`<a class="btn secondary" href="${d.archivo_url}" target="_blank">Abrir</a>`:''}</div>`).join('')||emptyState('Todavía no hay entregables','Cuando haya un archivo, versión o recurso disponible para vos, aparecerá acá.')}</div></div></div>`).join(''):emptyState('Todavía no hay proyectos activos','Cuando iniciemos una solución, vas a poder seguir acá su estado, próximos pasos y entregables.');
 $('meetingsList').innerHTML=meetings.length?meetings.map(m=>{const p=projects.find(x=>x.id===m.proyecto_id);return`<article class="meeting-card"><div class="meeting-head"><div><span class="eyebrow">${p?.nombre||'Reunión GENIDEIA'}</span><h3>${m.titulo}</h3><small>${m.fecha?new Date(m.fecha).toLocaleString('es-UY',{dateStyle:'medium',timeStyle:'short'}):'Fecha a definir'}</small></div>${m.enlace?`<a class="btn secondary" href="${m.enlace}" target="_blank" rel="noopener">Abrir enlace →</a>`:''}</div><div class="meeting-grid"><div class="meeting-block"><b>Objetivo</b><p>${m.objetivo||'No se registró un objetivo específico para esta reunión.'}</p></div><div class="meeting-block"><b>Resumen</b><p>${m.resumen||'Todavía no hay un resumen registrado.'}</p></div><div class="meeting-block"><b>Acuerdos y próximos pasos</b><p>${m.acuerdos||'Todavía no hay acuerdos registrados.'}</p></div></div></article>`}).join(''):emptyState('Todavía no registramos reuniones','Cuando tengamos una reunión, acá vas a encontrar su objetivo, resumen, acuerdos y el enlace correspondiente.');
 renderPayments();$('assistantFab').classList.remove('hidden')}
function showContract(id){activeContract=contracts.find(x=>x.id===id);const signed=activeContract.estado==='firmado';$('contractDetail').innerHTML=`<div class="contract-layout"><article class="contractpaper" id="printContract"><div>${activeContract.contenido}</div><div class="signatures"><div class="sigbox"><img src="/hub/andres-albornoz-signature.svg" alt="Firma Andrés Albornoz"><b>Andrés Albornoz</b><small>GENIDEIA COMPANY · Firmado</small></div><div class="sigbox" id="clientSig">${signed&&activeContract.firma_cliente_data?`<img src="${activeContract.firma_cliente_data}" alt="Firma cliente"><b>${activeContract.firmado_cliente_nombre||profile.nombre}</b><small>Firmado digitalmente · ${activeContract.firmado_en?new Date(activeContract.firmado_en).toLocaleString('es-UY'):''}</small>`:'<b>Firma del cliente</b><small>Pendiente</small>'}</div></div></article><aside class="card">${signed?`<div class="callout"><b>Contrato firmado ✓</b><br>Esta versión queda archivada dentro de tu espacio.</div><button class="btn" id="downloadSigned" style="width:100%;margin-top:12px">Descargar contrato firmado</button>`:`<div class="sectionhead"><h3>Firmar contrato</h3><span class="badge amber">Pendiente</span></div><p class="sub">Leé el documento completo y firmá dentro del recuadro.</p><label>Nombre completo<input id="signerName" value="${profile.nombre||''}"></label><label style="margin-top:10px">Documento (opcional)<input id="signerDoc"></label><div class="canvaswrap" style="margin-top:12px"><canvas id="signatureCanvas" width="560" height="220"></canvas></div><button id="clearSig" class="btn secondary" style="margin-top:8px">Limpiar</button><label style="display:flex;gap:8px;align-items:flex-start;margin-top:12px"><input id="accept" type="checkbox" style="width:auto;margin:2px 0 0"><span>Declaro haber leído y aceptado este contrato y la propuesta asociada.</span></label><button id="signContract" class="btn green" style="width:100%;margin-top:12px">Firmar contrato</button>`}</aside></div>`;nav('documents');if(signed){$('downloadSigned').onclick=()=>window.print()}else setTimeout(initCanvas,30)}
function initCanvas(){canvas=$('signatureCanvas');if(!canvas)return;ctx=canvas.getContext('2d');ctx.lineWidth=3;ctx.lineCap='round';ctx.strokeStyle='#10233d';const pos=e=>{const r=canvas.getBoundingClientRect(),t=e.touches?.[0]||e;return{x:(t.clientX-r.left)*(canvas.width/r.width),y:(t.clientY-r.top)*(canvas.height/r.height)}};const start=e=>{drawing=true;const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y);e.preventDefault()};const move=e=>{if(!drawing)return;const p=pos(e);ctx.lineTo(p.x,p.y);ctx.stroke();e.preventDefault()};const end=()=>drawing=false;canvas.onmousedown=start;canvas.onmousemove=move;canvas.onmouseup=end;canvas.onmouseleave=end;canvas.ontouchstart=start;canvas.ontouchmove=move;canvas.ontouchend=end;$('clearSig').onclick=()=>ctx.clearRect(0,0,canvas.width,canvas.height);$('signContract').onclick=signContract}
async function signContract(){if(!$('accept').checked)return toast('Confirmá que leíste y aceptás el contrato');const data=canvas.toDataURL('image/png');if(data.length<2500)return toast('Ingresá tu firma en el recuadro');const signer=$('signerName').value.trim();if(!signer)return toast('Ingresá tu nombre');const{data:r,error}=await sb.rpc('gen_hub_sign_contract',{p_contract_id:activeContract.id,p_signature:data,p_signer_name:signer,p_signer_document:$('signerDoc').value||null});if(error)return toast(error.message);toast('Contrato firmado y archivado');await load();activeContract=(r&&r.id)?r:contracts.find(x=>x.id===activeContract.id);showContract(activeContract.id)}
$('assistantFab').onclick=()=>$('assistant').classList.toggle('open');$('closeAssistant').onclick=()=>$('assistant').classList.remove('open');document.querySelectorAll('[data-help]').forEach(b=>b.onclick=()=>{const h=b.dataset.help,msg=$('assistantMsg');if(h==='contract'){msg.textContent='Entrá en Documentos. Elegí el contrato y, si está pendiente, vas a poder leer y firmar ahí mismo.';nav('documents')}if(h==='project'){msg.textContent='En Proyectos y entregables vas a ver el porcentaje de avance, estado, próximo paso y archivos compartidos.';nav('projects')}if(h==='meeting'){msg.textContent='En Reuniones queda guardado el objetivo, resumen, acuerdos y enlace de cada encuentro.';nav('meetings')}if(h==='presentation'){msg.textContent='En Documentos encontrás la propuesta, presentaciones y contratos compartidos contigo.';nav('documents')}if(h==='payment'){msg.textContent='En Pagos vas a ver importes, vencimientos y estados asociados a tu proyecto.';nav('payments')}if(h==='team'){msg.textContent='Si necesitás hablar con el equipo, usá el canal de contacto que acordamos. Más adelante este asistente podrá derivarte directamente a la persona responsable.'}});
if(await guard()){await load();$('app').classList.remove('hidden')}
</script></body></html>
