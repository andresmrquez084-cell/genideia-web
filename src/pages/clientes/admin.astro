---
import '../../styles/client-hub.css';
---
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>GENIDEIA · Gestión de clientes</title><link rel="icon" href="/favicon.png"/></head><body>
<div class="shell">
<aside class="side">
  <div class="brand"><img src="/favicon.png" alt="GENIDEIA"/><div><b>GENIDEIA</b><small>COMPANY HUB</small></div></div>
  <div class="navtitle">Gestión</div><nav>
    <button class="active" data-page="overview">Resumen</button>
    <button data-page="new-client">+ Nuevo cliente</button>
    <button data-page="new-project">+ Nuevo proyecto</button>
    <button data-page="presentations">Presentaciones</button>
    <button data-page="projects">Proyectos</button>
    <button data-page="activity">Actualizaciones y reuniones</button>
  </nav>
  <div class="who"><div><b id="adminName">GENIDEIA</b><small>Administrador</small></div><button id="logout" class="btn secondary">Salir</button></div>
</aside>
<main class="main">
  <div class="top"><div><small>Panel interno · información privada</small><h1>Gestión de clientes</h1></div><span class="badge green">Conectado a Supabase</span></div>

  <section id="overview" class="page active"><h2 class="title">Resumen</h2><p class="sub">Desde acá se crean clientes y proyectos. Usuario, portal, contrato y estructura se generan automáticamente.</p><div class="grid4" id="metrics"></div><div class="card" style="margin-top:14px"><div class="sectionhead"><h3>Clientes recientes</h3><button class="btn" data-goto="new-client">+ Nuevo cliente</button></div><div id="clientsList"></div></div></section>

  <section id="new-client" class="page"><h2 class="title">Nuevo cliente</h2><p class="sub">Completá una sola vez los datos del cliente y de la primera solución. El sistema crea usuario, panel, proyecto y contrato automáticamente.</p>
    <div class="grid2"><div class="card"><div class="sectionhead"><h3>Cliente y acceso</h3><span class="badge">Paso único</span></div><div class="formgrid">
      <label>Empresa<input id="nc_nombre" placeholder="Ej. AVL"/></label><label>Razón social<input id="nc_razon"/></label>
      <label>RUT<input id="nc_rut"/></label><label>Contacto<input id="nc_contacto"/></label>
      <label>Email<input id="nc_email" type="email"/></label><label>WhatsApp<input id="nc_whatsapp"/></label>
      <label>Usuario<input id="nc_usuario" placeholder="ej. juan.avl"/></label><label>Contraseña temporal<input id="nc_password" type="password" placeholder="mínimo 8 caracteres"/></label>
    </div></div>
    <div class="card"><div class="sectionhead"><h3>Primera solución</h3><span class="badge amber">Genera contrato</span></div>
      <label>Solución<input id="nc_solucion" placeholder="Gestión inteligente de correo"/></label><label style="margin-top:10px">Alcance<textarea id="nc_alcance" placeholder="Qué incluye exactamente esta solución..."></textarea></label><div class="formgrid" style="margin-top:10px"><label>Precio<input id="nc_precio" type="number" step="0.01"/></label><label>Moneda<select id="nc_moneda"><option>USD</option><option>UYU</option></select></label><label>Plazo<input id="nc_plazo" placeholder="4–6 semanas"/></label><label>Forma de pago<input id="nc_pago" placeholder="50% inicio / 50% entrega"/></label></div><label style="margin-top:10px">Garantía<textarea id="nc_garantia" placeholder="Garantía funcional acordada..."></textarea></label><label>Presentación / propuesta PDF (URL)<input id="nc_presentacion_pdf" placeholder="https://..."/></label><label>Presentación PPTX (URL, opcional)<input id="nc_presentacion_pptx" placeholder="https://..."/></label><button id="createClient" class="btn green" style="margin-top:13px;width:100%">Crear cliente y habilitar proyecto</button></div></div>
    <div id="newClientResult" class="callout hidden" style="margin-top:14px"></div>
  </section>

  <section id="new-project" class="page"><h2 class="title">Nuevo proyecto</h2><p class="sub">Agregá una solución nueva a un cliente existente. Mantiene el mismo usuario y portal, y genera un contrato independiente para esa solución.</p><div class="grid2"><div class="card"><label>Cliente<select id="np_cliente"></select></label><label style="margin-top:10px">Solución<input id="np_solucion"/></label><label style="margin-top:10px">Alcance<textarea id="np_alcance"></textarea></label><div class="formgrid" style="margin-top:10px"><label>Precio<input id="np_precio" type="number"/></label><label>Moneda<select id="np_moneda"><option>USD</option><option>UYU</option></select></label><label>Plazo<input id="np_plazo"/></label><label>Forma de pago<input id="np_pago"/></label></div><label style="margin-top:10px">Garantía<textarea id="np_garantia"></textarea></label></div><div class="card"><label>Presentación PDF (URL)<input id="np_presentacion_pdf"/></label><label style="margin-top:10px">Presentación PPTX (URL)<input id="np_presentacion_pptx"/></label><button id="createProject" class="btn green" style="margin-top:14px;width:100%">Crear proyecto</button><div id="newProjectResult" class="callout hidden" style="margin-top:12px"></div></div></div></section>

  <section id="presentations" class="page"><h2 class="title">Presentaciones</h2><p class="sub">La propuesta parte de una transcripción, pasa por análisis y revisión humana, y recién después queda aprobada para generar la presentación GENIDEIA con la misma estructura y diseño usados en AVL.</p>
    <div class="grid2">
      <div class="card">
        <div class="sectionhead"><h3>Nueva propuesta desde transcripción</h3><span class="badge green">Plantilla AVL</span></div>
        <label>Cliente existente (opcional)<select id="pp_cliente"><option value="">Prospecto / todavía no es cliente</option></select></label>
        <label style="margin-top:10px">Empresa<input id="pp_empresa" placeholder="Nombre de la empresa"/></label>
        <label style="margin-top:10px">Título<input id="pp_titulo" placeholder="Diagnóstico y propuesta de transformación operativa"/></label>
        <label style="margin-top:10px">Transcripción<textarea id="pp_transcripcion" style="min-height:280px" placeholder="Pegá acá la transcripción completa de la llamada..."></textarea></label>
        <button id="analyzeTranscript" class="btn green" style="margin-top:12px;width:100%">Analizar transcripción</button>
        <div id="analysisStatus" class="callout hidden" style="margin-top:12px"></div>
      </div>
      <div class="card">
        <div class="sectionhead"><h3>Estructura fija de la presentación</h3><span class="badge">No se modifica</span></div>
        <div class="row"><div><b>01 · Portada</b><small>Empresa + diagnóstico GENIDEIA</small></div></div>
        <div class="row"><div><b>02 · Índice</b><small>Recorrido de la propuesta</small></div></div>
        <div class="row"><div><b>03 · Situación actual</b><small>Cómo opera hoy la empresa</small></div></div>
        <div class="row"><div><b>04 · Pérdidas actuales</b><small>Tiempo, errores, capacidad o dinero respaldados por datos</small></div></div>
        <div class="row"><div><b>05 · Situación futura</b><small>Qué cambia después de intervenir</small></div></div>
        <div class="row"><div><b>06 · Intervención recomendada</b><small>Solución revisada por GENIDEIA</small></div></div>
        <div class="row"><div><b>07 · Inversión · plazo · garantía</b><small>Condiciones comerciales</small></div></div>
        <div class="row"><div><b>08+ · Impacto, ROI y oportunidades</b><small>Solo cuando existan datos suficientes; nunca se inventan números</small></div></div>
      </div>
    </div>

    <div id="analysisReview" class="hidden" style="margin-top:14px">
      <div class="card"><div class="sectionhead"><h3>1. Revisión del diagnóstico extraído</h3><span class="badge amber">Editable antes de aprobar</span></div><div id="analysisFields"></div></div>
      <div class="grid2" style="margin-top:14px">
        <div class="card"><div class="sectionhead"><h3>2. Solución propuesta</h3><span class="badge amber">Decisión GENIDEIA</span></div><p class="sub" style="margin-bottom:12px">La IA detecta oportunidades, pero este bloque se completa después de evaluar qué solución conviene ofrecer.</p><label>Solución<input id="pp_solucion" placeholder="Ej. Gestión inteligente de correo"/></label><label>Alcance<textarea id="pp_alcance" placeholder="Qué incluye y qué no incluye..."></textarea></label></div>
        <div class="card"><div class="sectionhead"><h3>3. Condiciones de propuesta</h3><span class="badge">Antes de generar</span></div><label>Inversión<input id="pp_inversion" placeholder="Ej. USD 6.500"/></label><label>Plazo<input id="pp_plazo" placeholder="Ej. 4–6 semanas"/></label><label>Garantía<textarea id="pp_garantia"></textarea></label><button id="approveProposal" class="btn green" style="margin-top:12px;width:100%">Aprobar contenido para presentación AVL</button></div>
      </div>
    </div>

    <div class="card" style="margin-top:14px"><div class="sectionhead"><h3>Presentaciones registradas</h3><span class="badge">Visible solo si se comparte</span></div><div id="presentationsList"></div></div>
  </section>

  <section id="projects" class="page"><h2 class="title">Proyectos</h2><p class="sub">Actualizá estado, progreso y próximo paso. El cliente ve estos cambios en su portal.</p><div class="card"><div id="projectsList"></div></div></section>

  <section id="activity" class="page"><h2 class="title">Actualizaciones y reuniones</h2><p class="sub">Publicá avances o registrá reuniones con objetivo, resumen y acuerdos para que queden disponibles en el portal del cliente.</p><div class="grid2"><div class="card"><h3 style="margin-top:0;font-size:12px">Nueva actualización</h3><label>Proyecto<select id="up_project"></select></label><label style="margin-top:10px">Título<input id="up_title"/></label><label>Detalle<textarea id="up_detail"></textarea></label><button id="addUpdate" class="btn" style="margin-top:10px">Publicar actualización</button></div><div class="card"><h3 style="margin-top:0;font-size:12px">Registrar reunión</h3><label>Proyecto<select id="mt_project"></select></label><label style="margin-top:10px">Título<input id="mt_title"/></label><label>Objetivo<input id="mt_objective"/></label><label>Fecha<input id="mt_date" type="datetime-local"/></label><label>Enlace<input id="mt_link" placeholder="https://meet.google.com/..."/></label><label>Resumen<textarea id="mt_summary"></textarea></label><label>Acuerdos<textarea id="mt_agreements"></textarea></label><button id="addMeeting" class="btn" style="margin-top:10px">Guardar reunión</button></div></div></section>
</main></div><div id="toast" class="toast"></div>
<script type="module">
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.57.4';
const URL='https://dbwuubabafzsinaokawe.supabase.co',KEY='sb_publishable_5uIKiEXiz-7FW4guG1Tg_Q_gVVotzih';const sb=createClient(URL,KEY);const $=id=>document.getElementById(id);let session,clients=[],projects=[],currentDraftId=null,currentAnalysis=null;
function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3000)}
async function guard(){const r=await sb.auth.getSession();session=r.data.session;if(!session){location.href='/clientes';return false}const{data:p}=await sb.from('gen_hub_profiles').select('*').eq('auth_user_id',session.user.id).maybeSingle();if(!p||p.role!=='admin'){location.href='/clientes/portal';return false}$('adminName').textContent=p.nombre||p.username;return true}
function nav(id){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===id));$(id).classList.add('active')}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>nav(b.dataset.page));document.querySelectorAll('[data-goto]').forEach(b=>b.onclick=()=>nav(b.dataset.goto));$('logout').onclick=async()=>{await sb.auth.signOut();location.href='/clientes'};
async function load(){const[c,p,pr]=await Promise.all([sb.from('gen_clientes').select('id,nombre,email,rep_nombre,estado,creado_en').order('creado_en',{ascending:false}),sb.from('gen_hub_proyectos').select('*').order('creado_en',{ascending:false}),sb.from('gen_hub_presentaciones').select('*').order('creado_en',{ascending:false})]);clients=c.data||[];projects=p.data||[];renderClients();renderProjects();renderPresentations(pr.data||[]);fillSelects();$('metrics').innerHTML=`<div class="metric"><small>Clientes</small><b>${clients.length}</b></div><div class="metric"><small>Proyectos</small><b>${projects.length}</b></div><div class="metric"><small>Pendientes de firma</small><b>${projects.filter(x=>x.estado==='pendiente_firma').length}</b></div><div class="metric"><small>En ejecución</small><b>${projects.filter(x=>x.estado==='en_ejecucion').length}</b></div>`}
function renderClients(){$('clientsList').innerHTML=clients.length?clients.slice(0,12).map(c=>`<div class="row"><div><b>${c.nombre}</b><small>${c.rep_nombre||''} · ${c.email||'sin email'}</small></div><span class="badge green">${c.estado}</span></div>`).join(''):'<div class="empty">Todavía no hay clientes del Client Hub.</div>'}
function fillSelects(){const co=clients.map(c=>`<option value="${c.id}">${c.nombre}</option>`).join('');$('np_cliente').innerHTML=co;$('pp_cliente').innerHTML='<option value="">Prospecto / todavía no es cliente</option>'+co;const po=projects.map(p=>`<option value="${p.id}" data-client="${p.cliente_id}">${p.nombre}</option>`).join('');$('up_project').innerHTML=po;$('mt_project').innerHTML=po}
function renderPresentations(list){$('presentationsList').innerHTML=list.length?list.map(p=>`<div class="row"><div><b>${p.titulo}</b><small>${p.estado} · ${p.visible_cliente?'visible para cliente':'interno'}</small></div><div>${p.pdf_url?`<a class="btn secondary" href="${p.pdf_url}" target="_blank">PDF</a>`:''} ${p.pptx_url?`<a class="btn secondary" href="${p.pptx_url}" target="_blank">PPTX</a>`:''}</div></div>`).join(''):'<div class="empty">No hay presentaciones registradas.</div>'}
function renderProjects(){$('projectsList').innerHTML=projects.length?projects.map(p=>`<div class="project" style="margin-bottom:10px"><div class="sectionhead"><div><span class="badge ${p.estado==='en_ejecucion'?'green':p.estado==='pendiente_firma'?'amber':''}">${p.estado}</span><h3>${p.nombre}</h3></div><b>${p.progreso}%</b></div><div class="progress"><i style="width:${p.progreso}%"></i></div><div class="formgrid"><label>Estado<select data-field="estado" data-id="${p.id}"><option ${p.estado==='pendiente_firma'?'selected':''}>pendiente_firma</option><option ${p.estado==='en_ejecucion'?'selected':''}>en_ejecucion</option><option ${p.estado==='en_revision'?'selected':''}>en_revision</option><option ${p.estado==='implementado'?'selected':''}>implementado</option><option ${p.estado==='pausado'?'selected':''}>pausado</option></select></label><label>Progreso<input data-field="progreso" data-id="${p.id}" type="number" min="0" max="100" value="${p.progreso}"/></label><label style="grid-column:1/-1">Próximo paso<input data-field="proximo_paso" data-id="${p.id}" value="${(p.proximo_paso||'').replaceAll('"','&quot;')}"/></label></div><button class="btn secondary save-project" data-id="${p.id}" style="margin-top:10px">Guardar cambios</button></div>`).join(''):'<div class="empty">No hay proyectos todavía.</div>';document.querySelectorAll('.save-project').forEach(b=>b.onclick=()=>saveProject(b.dataset.id))}
async function saveProject(id){const fields=[...document.querySelectorAll(`[data-id="${id}"][data-field]`)];const obj={};fields.forEach(x=>obj[x.dataset.field]=x.dataset.field==='progreso'?Number(x.value):x.value);obj.actualizado_en=new Date().toISOString();const{error}=await sb.from('gen_hub_proyectos').update(obj).eq('id',id);if(error)return toast(error.message);toast('Proyecto actualizado');await load()}

function cleanList(v){return Array.isArray(v)?v.map(x=>typeof x==='string'?x:JSON.stringify(x,null,2)).join('\n• '):String(v||'')}
function field(title,value,id){return `<label style="margin-top:10px">${title}<textarea id="${id}" style="min-height:110px">${String(value||'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')}</textarea></label>`}
function renderAnalysis(a){currentAnalysis=a;$('analysisReview').classList.remove('hidden');$('analysisFields').innerHTML=field('Resumen ejecutivo',a.resumen_ejecutivo,'ar_resumen')+field('Situación actual','• '+cleanList(a.situacion_actual),'ar_actual')+field('Pérdidas actuales','• '+cleanList(a.perdidas_actuales),'ar_perdidas')+field('Situación futura','• '+cleanList(a.situacion_futura),'ar_futura')+field('Oportunidades detectadas','• '+cleanList(a.oportunidades_detectadas),'ar_oportunidades')+field('Datos económicos','• '+cleanList(a.datos_economicos),'ar_economicos')+field('Datos operativos','• '+cleanList(a.datos_operativos),'ar_operativos')+field('Faltantes para la propuesta','• '+cleanList(a.faltantes_para_propuesta),'ar_faltantes')+field('Preguntas de confirmación','• '+cleanList(a.preguntas_de_confirmacion),'ar_preguntas');}
$('analyzeTranscript').onclick=async()=>{const empresa=$('pp_empresa').value.trim(),titulo=$('pp_titulo').value.trim()||`Propuesta · ${empresa}`,transcripcion=$('pp_transcripcion').value.trim();if(!empresa)return toast('Ingresá la empresa');if(transcripcion.length<100)return toast('Pegá una transcripción completa');const b=$('analyzeTranscript');b.disabled=true;b.textContent='Analizando…';$('analysisStatus').classList.remove('hidden');$('analysisStatus').textContent='Analizando la llamada y separando hechos, pérdidas, datos y faltantes…';const{data,error}=await sb.functions.invoke('hub-analyze-transcript',{body:{id:currentDraftId,cliente_id:$('pp_cliente').value?Number($('pp_cliente').value):null,empresa,titulo,transcripcion}});b.disabled=false;b.textContent='Analizar transcripción';if(error||data?.error){$('analysisStatus').textContent=data?.error||error?.message||'No se pudo analizar';return toast('No se pudo analizar la transcripción')}currentDraftId=data.id;renderAnalysis(data.analisis);$('analysisStatus').innerHTML='<b>Análisis listo ✓</b><br>Revisá y corregí los datos. Después definimos la solución de forma separada.';toast('Transcripción analizada')}
$('approveProposal').onclick=async()=>{if(!currentDraftId)return toast('Primero analizá la transcripción');const solution=$('pp_solucion').value.trim(),scope=$('pp_alcance').value.trim();if(!solution||!scope)return toast('Definí solución y alcance antes de aprobar');const reviewed={resumen_ejecutivo:$('ar_resumen')?.value||'',situacion_actual:$('ar_actual')?.value||'',perdidas_actuales:$('ar_perdidas')?.value||'',situacion_futura:$('ar_futura')?.value||'',oportunidades_detectadas:$('ar_oportunidades')?.value||'',datos_economicos:$('ar_economicos')?.value||'',datos_operativos:$('ar_operativos')?.value||'',faltantes_para_propuesta:$('ar_faltantes')?.value||'',preguntas_de_confirmacion:$('ar_preguntas')?.value||''};const update={analisis:{...currentAnalysis,revision_humana:reviewed},solucion_propuesta:solution,alcance_propuesto:scope,inversion:$('pp_inversion').value.trim(),plazo:$('pp_plazo').value.trim(),garantia:$('pp_garantia').value.trim(),estado:'contenido_aprobado',actualizado_en:new Date().toISOString()};const{error:uerr}=await sb.from('gen_hub_propuesta_borradores').update(update).eq('id',currentDraftId);if(uerr)return toast(uerr.message);const metadata={origen:'transcripcion',plantilla:'AVL',estructura_fija:true,borrador_id:currentDraftId,empresa:$('pp_empresa').value.trim(),solucion:solution,alcance:scope,inversion:update.inversion,plazo:update.plazo,garantia:update.garantia,analisis:update.analisis};const{error:perr}=await sb.from('gen_hub_presentaciones').insert({cliente_id:$('pp_cliente').value?Number($('pp_cliente').value):null,titulo:$('pp_titulo').value.trim()||`Propuesta · ${$('pp_empresa').value.trim()}`,estado:'lista_para_generar',visible_cliente:false,metadata});if(perr)return toast(perr.message);toast('Contenido aprobado y listo para generar con plantilla AVL');await load()}

$('createClient').onclick=async()=>{const payload={nombre_cliente:$('nc_nombre').value,razon_social:$('nc_razon').value,rut:$('nc_rut').value,nombre_contacto:$('nc_contacto').value,email:$('nc_email').value,whatsapp:$('nc_whatsapp').value,username:$('nc_usuario').value,password:$('nc_password').value,solucion:$('nc_solucion').value,alcance:$('nc_alcance').value,precio:Number($('nc_precio').value)||null,moneda:$('nc_moneda').value,plazo:$('nc_plazo').value,forma_pago:$('nc_pago').value,garantia:$('nc_garantia').value,presentacion_titulo:$('nc_solucion').value?`Propuesta · ${$('nc_solucion').value}`:null,presentacion_pdf_url:$('nc_presentacion_pdf').value||null,presentacion_pptx_url:$('nc_presentacion_pptx').value||null};const b=$('createClient');b.disabled=true;b.textContent='Creando…';const{data,error}=await sb.functions.invoke('hub-create-client',{body:payload});b.disabled=false;b.textContent='Crear cliente y habilitar proyecto';if(error||data?.error)return toast(data?.message||error?.message||'Error al crear');$('newClientResult').classList.remove('hidden');$('newClientResult').innerHTML=`<b>Cliente creado ✓</b><br>Usuario: ${data.username}<br>Portal: <strong>${location.origin}/clientes</strong><br>Proyecto y contrato generados automáticamente.`;toast('Cliente creado');await load()}
$('createProject').onclick=async()=>{const payload={cliente_id:Number($('np_cliente').value),solucion:$('np_solucion').value,alcance:$('np_alcance').value,precio:Number($('np_precio').value)||null,moneda:$('np_moneda').value,plazo:$('np_plazo').value,forma_pago:$('np_pago').value,garantia:$('np_garantia').value,presentacion_titulo:$('np_solucion').value?`Propuesta · ${$('np_solucion').value}`:null,presentacion_pdf_url:$('np_presentacion_pdf').value||null,presentacion_pptx_url:$('np_presentacion_pptx').value||null};const{data,error}=await sb.functions.invoke('hub-create-project',{body:payload});if(error||data?.error)return toast(data?.message||error?.message||'Error');$('newProjectResult').classList.remove('hidden');$('newProjectResult').innerHTML='<b>Proyecto creado ✓</b><br>Contrato independiente generado y visible en el portal.';toast('Proyecto creado');await load()}
$('addUpdate').onclick=async()=>{const p=projects.find(x=>x.id===$('up_project').value);if(!p)return;const{error}=await sb.from('gen_hub_actualizaciones').insert({proyecto_id:p.id,cliente_id:p.cliente_id,titulo:$('up_title').value,detalle:$('up_detail').value,visible_cliente:true,creado_por:session.user.id});if(error)return toast(error.message);$('up_title').value='';$('up_detail').value='';toast('Actualización publicada')}
$('addMeeting').onclick=async()=>{const p=projects.find(x=>x.id===$('mt_project').value);if(!p)return;const{error}=await sb.from('gen_hub_reuniones').insert({proyecto_id:p.id,cliente_id:p.cliente_id,titulo:$('mt_title').value,objetivo:$('mt_objective').value,fecha:$('mt_date').value?new Date($('mt_date').value).toISOString():null,enlace:$('mt_link').value,resumen:$('mt_summary').value,acuerdos:$('mt_agreements').value,visible_cliente:true});if(error)return toast(error.message);toast('Reunión guardada')}
if(await guard())await load();
</script></body></html>