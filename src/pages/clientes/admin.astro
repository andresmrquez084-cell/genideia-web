---
import '../../styles/client-hub.css';
---
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>GENIDEIA · Gestión de clientes</title><link rel="icon" href="/favicon.png"/></head><body>
<div class="shell">
<aside class="side">
  <div class="brand"><img src="/favicon.png" alt="GENIDEIA"/><div><b>GENIDEIA</b><small>COMPANY HUB</small></div></div>
  <div class="navtitle">Gestión</div><nav>
    <button class="active" data-page="overview">Resumen</button>
    <button data-page="new-client">+ Nuevo cliente</button>
    <button data-page="new-project">+ Nuevo proyecto</button>
    <button data-page="presentations">Presentaciones</button>
    <button data-page="projects">Proyectos</button>
    <button data-page="activity">Actualizaciones y reuniones</button>
  </nav>
  <div class="who"><div><b id="adminName">GENIDEIA</b><small>Administrador</small></div><button id="logout" class="btn secondary">Salir</button></div>
</aside>
<main class="main">
  <div class="top"><div><small>Panel interno · información privada</small><h1>Gestión de clientes</h1></div><span class="badge green">Conectado a Supabase</span></div>

  <section id="overview" class="page active"><h2 class="title">Resumen</h2><p class="sub">Desde acá se crean clientes y proyectos. Usuario, portal, contrato y estructura se generan automáticamente.</p><div class="grid4" id="metrics"></div><div class="card" style="margin-top:14px"><div class="sectionhead"><h3>Clientes recientes</h3><button class="btn" data-goto="new-client">+ Nuevo cliente</button></div><div id="clientsList"></div></div></section>

  <section id="new-client" class="page"><h2 class="title">Nuevo cliente</h2><p class="sub">Completá una sola vez los datos del cliente y de la primera solución. El sistema crea usuario, panel, proyecto y contrato automáticamente.</p>
    <div class="grid2"><div class="card"><div class="sectionhead"><h3>Cliente y acceso</h3><span class="badge">Paso único</span></div><div class="formgrid">
      <label>Empresa<input id="nc_nombre" placeholder="Ej. AVL"/></label><label>Razón social<input id="nc_razon"/></label>
      <label>RUT<input id="nc_rut"/></label><label>Contacto<input id="nc_contacto"/></label>
      <label>Email<input id="nc_email" type="email"/></label><label>WhatsApp<input id="nc_whatsapp"/></label>
      <label>Usuario<input id="nc_usuario" placeholder="ej. juan.avl"/></label><label>Contraseña temporal<input id="nc_password" type="password" placeholder="mínimo 8 caracteres"/></label>
    </div></div>
    <div class="card"><div class="sectionhead"><h3>Primera solución</h3><span class="badge amber">Genera contrato</span></div>
      <label>Solución<input id="nc_solucion" placeholder="Gestión inteligente de correo"/></label><div class="formgrid" style="margin-top:10px"><label>Precio<input id="nc_precio" type="number" step="0.01"/></label><label>Moneda<select id="nc_moneda"><option>USD</option><option>UYU</option></select></label><label>Plazo<input id="nc_plazo" placeholder="4–6 semanas"/></label><label>Forma de pago<input id="nc_pago" placeholder="50% inicio / 50% entrega"/></label></div><label style="margin-top:10px">Garantía<textarea id="nc_garantia" placeholder="Garantía funcional acordada..."></textarea></label><label>Presentación / propuesta PDF (URL)<input id="nc_presentacion_pdf" placeholder="https://..."/></label><label>Presentación PPTX (URL, opcional)<input id="nc_presentacion_pptx" placeholder="https://..."/></label><button id="createClient" class="btn green" style="margin-top:13px;width:100%">Crear cliente y habilitar proyecto</button></div></div>
    <div id="newClientResult" class="callout hidden" style="margin-top:14px"></div>
  </section>

  <section id="new-project" class="page"><h2 class="title">Nuevo proyecto</h2><p class="sub">Agregá una solución nueva a un cliente existente. Mantiene el mismo usuario y portal, y genera un contrato independiente para esa solución.</p><div class="grid2"><div class="card"><label>Cliente<select id="np_cliente"></select></label><label style="margin-top:10px">Solución<input id="np_solucion"/></label><div class="formgrid" style="margin-top:10px"><label>Precio<input id="np_precio" type="number"/></label><label>Moneda<select id="np_moneda"><option>USD</option><option>UYU</option></select></label><label>Plazo<input id="np_plazo"/></label><label>Forma de pago<input id="np_pago"/></label></div><label style="margin-top:10px">Garantía<textarea id="np_garantia"></textarea></label></div><div class="card"><label>Presentación PDF (URL)<input id="np_presentacion_pdf"/></label><label style="margin-top:10px">Presentación PPTX (URL)<input id="np_presentacion_pptx"/></label><button id="createProject" class="btn green" style="margin-top:14px;width:100%">Crear proyecto</button><div id="newProjectResult" class="callout hidden" style="margin-top:12px"></div></div></div></section>

  <section id="presentations" class="page"><h2 class="title">Presentaciones</h2><p class="sub">Las presentaciones quedan como etapa previa. Hoy podés asociar el PPTX/PDF final; el generador automático desde transcripción se conectará aquí.</p><div class="card"><div class="sectionhead"><h3>Presentaciones registradas</h3><span class="badge">Visible solo si se comparte</span></div><div id="presentationsList"></div></div></section>

  <section id="projects" class="page"><h2 class="title">Proyectos</h2><p class="sub">Actualizá estado, progreso y próximo paso. El cliente ve estos cambios en su portal.</p><div class="card"><div id="projectsList"></div></div></section>

  <section id="activity" class="page"><h2 class="title">Actualizaciones y reuniones</h2><p class="sub">Publicá avances o registrá reuniones con objetivo, resumen y acuerdos para que queden disponibles en el portal del cliente.</p><div class="grid2"><div class="card"><h3 style="margin-top:0;font-size:12px">Nueva actualización</h3><label>Proyecto<select id="up_project"></select></label><label style="margin-top:10px">Título<input id="up_title"/></label><label>Detalle<textarea id="up_detail"></textarea></label><button id="addUpdate" class="btn" style="margin-top:10px">Publicar actualización</button></div><div class="card"><h3 style="margin-top:0;font-size:12px">Registrar reunión</h3><label>Proyecto<select id="mt_project"></select></label><label style="margin-top:10px">Título<input id="mt_title"/></label><label>Objetivo<input id="mt_objective"/></label><label>Fecha<input id="mt_date" type="datetime-local"/></label><label>Enlace<input id="mt_link" placeholder="https://meet.google.com/..."/></label><label>Resumen<textarea id="mt_summary"></textarea></label><label>Acuerdos<textarea id="mt_agreements"></textarea></label><button id="addMeeting" class="btn" style="margin-top:10px">Guardar reunión</button></div></div></section>
</main></div><div id="toast" class="toast"></div>
<script type="module">
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.57.4';
const URL='https://dbwuubabafzsinaokawe.supabase.co',KEY='sb_publishable_5uIKiEXiz-7FW4guG1Tg_Q_gVVotzih';const sb=createClient(URL,KEY);const $=id=>document.getElementById(id);let session,clients=[],projects=[];
function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2600)}
async function guard(){const r=await sb.auth.getSession();session=r.data.session;if(!session){location.href='/clientes';return false}const{data:p}=await sb.from('gen_hub_profiles').select('*').eq('auth_user_id',session.user.id).maybeSingle();if(!p||p.role!=='admin'){location.href='/clientes/portal';return false}$('adminName').textContent=p.nombre||p.username;return true}
function nav(id){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===id));$(id).classList.add('active')}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>nav(b.dataset.page));document.querySelectorAll('[data-goto]').forEach(b=>b.onclick=()=>nav(b.dataset.goto));$('logout').onclick=async()=>{await sb.auth.signOut();location.href='/clientes'};
async function load(){const[c,p,pr]=await Promise.all([sb.from('gen_clientes').select('id,nombre,email,rep_nombre,estado,creado_en').order('creado_en',{ascending:false}),sb.from('gen_hub_proyectos').select('*').order('creado_en',{ascending:false}),sb.from('gen_hub_presentaciones').select('*').order('creado_en',{ascending:false})]);clients=c.data||[];projects=p.data||[];renderClients();renderProjects();renderPresentations(pr.data||[]);fillSelects();$('metrics').innerHTML=`<div class="metric"><small>Clientes</small><b>${clients.length}</b></div><div class="metric"><small>Proyectos</small><b>${projects.length}</b></div><div class="metric"><small>Pendientes de firma</small><b>${projects.filter(x=>x.estado==='pendiente_firma').length}</b></div><div class="metric"><small>En ejecución</small><b>${projects.filter(x=>x.estado==='en_ejecucion').length}</b></div>`}
function renderClients(){$('clientsList').innerHTML=clients.length?clients.slice(0,12).map(c=>`<div class="row"><div><b>${c.nombre}</b><small>${c.rep_nombre||''} · ${c.email||'sin email'}</small></div><span class="badge green">${c.estado}</span></div>`).join(''):'<div class="empty">Todavía no hay clientes del Client Hub.</div>'}
function fillSelects(){const co=clients.map(c=>`<option value="${c.id}">${c.nombre}</option>`).join('');$('np_cliente').innerHTML=co;const po=projects.map(p=>`<option value="${p.id}" data-client="${p.cliente_id}">${p.nombre}</option>`).join('');$('up_project').innerHTML=po;$('mt_project').innerHTML=po}
function renderPresentations(list){$('presentationsList').innerHTML=list.length?list.map(p=>`<div class="row"><div><b>${p.titulo}</b><small>${p.estado} · ${p.visible_cliente?'visible para cliente':'interno'}</small></div><div>${p.pdf_url?`<a class="btn secondary" href="${p.pdf_url}" target="_blank">PDF</a>`:''} ${p.pptx_url?`<a class="btn secondary" href="${p.pptx_url}" target="_blank">PPTX</a>`:''}</div></div>`).join(''):'<div class="empty">No hay presentaciones registradas.</div>'}
function renderProjects(){$('projectsList').innerHTML=projects.length?projects.map(p=>`<div class="project" style="margin-bottom:10px"><div class="sectionhead"><div><span class="badge ${p.estado==='en_ejecucion'?'green':p.estado==='pendiente_firma'?'amber':''}">${p.estado}</span><h3>${p.nombre}</h3></div><b>${p.progreso}%</b></div><div class="progress"><i style="width:${p.progreso}%"></i></div><div class="formgrid"><label>Estado<select data-field="estado" data-id="${p.id}"><option ${p.estado==='pendiente_firma'?'selected':''}>pendiente_firma</option><option ${p.estado==='en_ejecucion'?'selected':''}>en_ejecucion</option><option ${p.estado==='en_revision'?'selected':''}>en_revision</option><option ${p.estado==='implementado'?'selected':''}>implementado</option><option ${p.estado==='pausado'?'selected':''}>pausado</option></select></label><label>Progreso<input data-field="progreso" data-id="${p.id}" type="number" min="0" max="100" value="${p.progreso}"/></label><label style="grid-column:1/-1">Próximo paso<input data-field="proximo_paso" data-id="${p.id}" value="${(p.proximo_paso||'').replaceAll('"','&quot;')}"/></label></div><button class="btn secondary save-project" data-id="${p.id}" style="margin-top:10px">Guardar cambios</button></div>`).join(''):'<div class="empty">No hay proyectos todavía.</div>';document.querySelectorAll('.save-project').forEach(b=>b.onclick=()=>saveProject(b.dataset.id))}
async function saveProject(id){const fields=[...document.querySelectorAll(`[data-id="${id}"][data-field]`)];const obj={};fields.forEach(x=>obj[x.dataset.field]=x.dataset.field==='progreso'?Number(x.value):x.value);obj.actualizado_en=new Date().toISOString();const{error}=await sb.from('gen_hub_proyectos').update(obj).eq('id',id);if(error)return toast(error.message);toast('Proyecto actualizado');await load()}
$('createClient').onclick=async()=>{const payload={nombre_cliente:$('nc_nombre').value,razon_social:$('nc_razon').value,rut:$('nc_rut').value,nombre_contacto:$('nc_contacto').value,email:$('nc_email').value,whatsapp:$('nc_whatsapp').value,username:$('nc_usuario').value,password:$('nc_password').value,solucion:$('nc_solucion').value,precio:Number($('nc_precio').value)||null,moneda:$('nc_moneda').value,plazo:$('nc_plazo').value,forma_pago:$('nc_pago').value,garantia:$('nc_garantia').value,presentacion_titulo:$('nc_solucion').value?`Propuesta · ${$('nc_solucion').value}`:null,presentacion_pdf_url:$('nc_presentacion_pdf').value||null,presentacion_pptx_url:$('nc_presentacion_pptx').value||null};const b=$('createClient');b.disabled=true;b.textContent='Creando…';const{data,error}=await sb.functions.invoke('hub-create-client',{body:payload});b.disabled=false;b.textContent='Crear cliente y habilitar proyecto';if(error||data?.error)return toast(data?.message||error?.message||'Error al crear');$('newClientResult').classList.remove('hidden');$('newClientResult').innerHTML=`<b>Cliente creado ✓</b><br>Usuario: ${data.username}<br>Portal: <strong>${location.origin}/clientes</strong><br>Proyecto y contrato generados automáticamente.`;toast('Cliente creado');await load()}
$('createProject').onclick=async()=>{const payload={cliente_id:Number($('np_cliente').value),solucion:$('np_solucion').value,precio:Number($('np_precio').value)||null,moneda:$('np_moneda').value,plazo:$('np_plazo').value,forma_pago:$('np_pago').value,garantia:$('np_garantia').value,presentacion_titulo:$('np_solucion').value?`Propuesta · ${$('np_solucion').value}`:null,presentacion_pdf_url:$('np_presentacion_pdf').value||null,presentacion_pptx_url:$('np_presentacion_pptx').value||null};const{data,error}=await sb.functions.invoke('hub-create-project',{body:payload});if(error||data?.error)return toast(data?.message||error?.message||'Error');$('newProjectResult').classList.remove('hidden');$('newProjectResult').innerHTML='<b>Proyecto creado ✓</b><br>Contrato independiente generado y visible en el portal.';toast('Proyecto creado');await load()}
$('addUpdate').onclick=async()=>{const p=projects.find(x=>x.id===$('up_project').value);if(!p)return;const{error}=await sb.from('gen_hub_actualizaciones').insert({proyecto_id:p.id,cliente_id:p.cliente_id,titulo:$('up_title').value,detalle:$('up_detail').value,visible_cliente:true,creado_por:session.user.id});if(error)return toast(error.message);$('up_title').value='';$('up_detail').value='';toast('Actualización publicada')}
$('addMeeting').onclick=async()=>{const p=projects.find(x=>x.id===$('mt_project').value);if(!p)return;const{error}=await sb.from('gen_hub_reuniones').insert({proyecto_id:p.id,cliente_id:p.cliente_id,titulo:$('mt_title').value,objetivo:$('mt_objective').value,fecha:$('mt_date').value?new Date($('mt_date').value).toISOString():null,enlace:$('mt_link').value,resumen:$('mt_summary').value,acuerdos:$('mt_agreements').value,visible_cliente:true});if(error)return toast(error.message);toast('Reunión guardada')}
if(await guard())await load();
</script></body></html>
