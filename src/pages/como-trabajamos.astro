---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import { PASOS_TRABAJO } from '../data/soluciones';
---

<BaseLayout
  title="Cómo trabajamos — GENIDEIA Company"
  description="Diagnóstico, diseño, construcción, implementación y mejora. No entregamos software suelto: una solución que funciona dentro del proceso que ya existe en tu empresa."
  path="/como-trabajamos"
>

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <section class="max-w-4xl mx-auto px-6 pt-24 pb-16 text-center">
    <p class="hero-animate text-xs font-medium mb-6 uppercase" data-delay="1" style="color:#00C8FF; letter-spacing:3px;">
      Cómo trabajamos
    </p>
    <h1 class="hero-animate mb-6" data-delay="2" style="font-family:'Montserrat',sans-serif; font-weight:700; line-height:1.05; letter-spacing:-1px; font-size:clamp(2.4rem, 5.5vw, 3.8rem);">
      No entregamos software. Entregamos una solución que funciona dentro de tu proceso.
    </h1>
    <p class="hero-animate mx-auto mb-9 leading-relaxed max-w-2xl text-lg" data-delay="3" style="color:#B8BEC7; font-weight:300;">
      Cinco etapas, de punta a punta. Cada una existe porque una solución que no se conecta
      con la operación real de tu empresa no sirve, por más sofisticada que sea.
    </p>
  </section>

  <!-- ── LAS 5 ETAPAS ──────────────────────────────────────── -->
  <Section maxWidth="max-w-5xl">
    <div class="space-y-6" data-reveal>
      {PASOS_TRABAJO.map((p, i) => (
        <div
          class="card-hover rounded-xl p-7 sm:p-8 flex flex-col sm:flex-row gap-6 sm:items-start"
          style="background:#111111; border:1px solid rgba(255,255,255,0.07);"
          data-reveal
          data-delay={String(i + 1)}
        >
          <p style="font-family:'Montserrat',sans-serif; font-weight:700; color:#00C8FF; line-height:1;" class="text-5xl flex-shrink-0">
            {p.num}
          </p>
          <div>
            <h2 style="font-family:'Montserrat',sans-serif; font-weight:600; color:#F2F4F7; font-size:1.5rem;" class="mb-2">
              {p.nombre}
            </h2>
            <p style="color:#B8BEC7; font-weight:300;" class="text-base leading-relaxed max-w-2xl">
              {p.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <CtaBand
    title="Contanos cómo funciona hoy tu proceso"
    subtitle="Empezamos siempre por el diagnóstico. Es el primer paso, y es gratis."
    waMessage="Hola, vi cómo trabaja GENIDEIA y quiero empezar por el diagnóstico."
  />

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
