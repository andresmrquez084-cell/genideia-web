---
// Link-in-bio de Hecho con el Alma (cliente). Destino del link del perfil de Instagram:
// la persona elige qué quiere hacer y la mandamos al lugar correcto.
// Orden: marca → [lanzamiento, oculto hasta activarlo] → piezas → artistas → historias → registro → redes.
// ⚠️ TODO EL TEXTO Y LOS LINKS viven en src/data/hechoconelalma.json — editar ese archivo, NO este.
// Autocontenida a propósito (su propio <html>, sin global.css): usa la marca del cliente, no la de GENIDEIA.
// Imágenes en public/hechoconelalma/ (escena de fondo, logo y fotos de las tarjetas).
import d from '../data/hechoconelalma.json';

const waUrl = (msg: string) => `https://wa.me/${d.redes.whatsapp}?text=${encodeURIComponent(msg)}`;

const iconos: Record<string, string> = {
  vasija: '<path d="M9.2 2.8h5.6M10 2.8v2.6c0 .7-.4 1.3-1 1.7C6.8 8.5 5.4 10.9 5.4 13.9c0 4 2.9 7.3 6.6 7.3s6.6-3.3 6.6-7.3c0-3-1.4-5.4-3.6-6.8-.6-.4-1-1-1-1.7V2.8"/>',
  personas: '<circle cx="12" cy="6.6" r="2.7"/><circle cx="5.2" cy="8.4" r="2.1"/><circle cx="18.8" cy="8.4" r="2.1"/><path d="M6.6 19.6v-.8a5.4 5.4 0 0 1 10.8 0v.8M1.6 19v-.4a3.9 3.9 0 0 1 5.3-3.6M22.4 19v-.4a3.9 3.9 0 0 0-5.3-3.6"/>',
  libro: '<path d="M12 6.4C10.2 4.9 7.6 4.3 2.6 4.3v14.2c5 0 7.6.6 9.4 2.1 1.8-1.5 4.4-2.1 9.4-2.1V4.3c-5 0-7.6.6-9.4 2.1Zm0 0v14.2"/>',
  sobre: '<rect x="2.8" y="5.2" width="18.4" height="13.6" rx="1.2"/><path d="m3.4 6 8.6 6.7L20.6 6"/>',
};
const flecha = '<path d="m9.5 6 6 6-6 6"/>';
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{d.seo.titulo}</title>
  <meta name="description" content={d.seo.descripcion} />
  <meta name="theme-color" content="#EFE5D6" />
  <meta property="og:title" content={d.seo.titulo} />
  <meta property="og:description" content={d.seo.descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={d.seo.imagen} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/hechoconelalma/icono.png" />
  <link rel="apple-touch-icon" href="/hechoconelalma/icono.png" />
  <link rel="preload" as="image" href="/hechoconelalma/escena.webp" />
  <link rel="preload" as="image" href="/hechoconelalma/logo.webp" />
  <link rel="preload" as="font" type="font/woff2" href="/hechoconelalma/fuentes/cinzel.woff2" crossorigin />
  <style>
    /* Fuentes alojadas en el sitio (Google Fonts, subset latin; Cormorant y Jost son variables). */
    @font-face { font-family: 'Cinzel'; font-weight: 500; font-display: swap; src: url('/hechoconelalma/fuentes/cinzel.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'Cormorant Garamond'; font-weight: 500 600; font-display: swap; src: url('/hechoconelalma/fuentes/cormorant-garamond.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'Ephesis'; font-weight: 400; font-display: swap; src: url('/hechoconelalma/fuentes/ephesis.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'Jost'; font-weight: 300 500; font-display: swap; src: url('/hechoconelalma/fuentes/jost.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    :root {
      --revoque: #EFE5D6;
      --tinta: #2B2416;
      --tinta-suave: #5F5A48;
      --crema: #F6EFE3;
      --oliva: #4A4625;
      --titulo: 'Cinzel', 'Trajan Pro', Georgia, serif;
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans: 'Jost', system-ui, sans-serif;
      --script: 'Ephesis', 'Snell Roundhand', cursive;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { background: var(--revoque); }
    body {
      min-height: 100svh; color: var(--tinta); font-family: var(--sans); font-weight: 300;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }

    /* ── Escena de fondo (vasija, olivo, pared de revoque, paisaje) ── */
    .escena {
      position: fixed; inset: 0; z-index: -2;
      background: var(--revoque) url('/hechoconelalma/escena.webp') 0% 0% / cover no-repeat;
    }
    /* velo suave para que el texto siempre se lea sobre la foto */
    .escena::after {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 62% 70% at 50% 34%, rgba(246,239,227,0.55), rgba(246,239,227,0) 72%);
    }
    @media (min-width: 720px) {
      .escena { background-position: 50% 22%; }
      .escena::after { background: radial-gradient(ellipse 34% 80% at 50% 40%, rgba(246,239,227,0.5), rgba(246,239,227,0) 75%); }
    }

    .wrap { width: min(100% - 32px, 500px); margin: 0 auto; padding: max(28px, env(safe-area-inset-top)) 0 40px; }

    /* ── Marca ─────────────────────────────── */
    .marca { text-align: center; margin-bottom: 26px; }
    .logo { width: clamp(132px, 38vw, 176px); height: auto; aspect-ratio: 1; display: block; margin: 0 auto 14px; filter: drop-shadow(0 6px 14px rgba(120,84,24,0.18)); }
    .marca h1 {
      font-family: var(--titulo); font-weight: 500; color: var(--tinta);
      font-size: clamp(1.72rem, 8.1vw, 2.75rem); line-height: 1; letter-spacing: 0.01em; white-space: nowrap;
    }
    .marca h1 .chico { font-size: 0.8em; }
    .bajada {
      display: flex; align-items: center; justify-content: center; gap: 12px;
      margin: 12px auto 18px; font-size: clamp(0.62rem, 2.7vw, 0.74rem); font-weight: 400;
      letter-spacing: 0.34em; text-transform: uppercase; color: var(--tinta-suave);
    }
    .bajada::before, .bajada::after { content: ''; flex: 0 0 clamp(18px, 6vw, 36px); height: 1px; background: currentColor; opacity: 0.55; }
    .texto { font-family: var(--serif); font-weight: 500; font-size: clamp(1.16rem, 4.9vw, 1.36rem); line-height: 1.25; white-space: pre-line; }

    /* ── Lanzamiento (oculto hasta activarlo) ── */
    .lanzamiento {
      position: relative; text-align: center; padding: 20px 20px 22px; margin-bottom: 12px; border-radius: 18px;
      background: rgba(250,245,236,0.78); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      border: 1px solid rgba(179,126,44,0.55); box-shadow: 0 14px 30px -18px rgba(43,36,22,0.5);
    }
    .lanzamiento small { display: block; font-size: 0.64rem; letter-spacing: 0.3em; text-transform: uppercase; color: #9A6B22; font-weight: 500; margin-bottom: 8px; }
    .lanzamiento h2 { font-family: var(--serif); font-weight: 600; font-size: 1.7rem; line-height: 1.05; }
    .lanzamiento p { font-size: 0.9rem; color: var(--tinta-suave); margin-top: 8px; }
    .lanzamiento a { display: inline-block; margin-top: 16px; padding: 12px 30px; border-radius: 999px; background: var(--oliva); color: var(--crema); font-weight: 400; letter-spacing: 0.08em; font-size: 0.9rem; }

    /* ── Accesos ───────────────────────────── */
    .accesos { display: grid; gap: 11px; }
    .acceso {
      position: relative; isolation: isolate; overflow: hidden;
      display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: 10px;
      min-height: clamp(124px, 34vw, 148px); padding: 14px clamp(12px, 3.5vw, 20px) 14px 47%;
      border-radius: 16px; color: var(--crema); background: var(--fondo);
      box-shadow: 0 14px 26px -18px rgba(43,36,22,0.75), 0 2px 5px -2px rgba(43,36,22,0.25);
      transition: transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s;
      width: 100%; border: 0; font: inherit; text-align: left; cursor: pointer;
    }
    .acceso:hover { transform: translateY(-2px); box-shadow: 0 20px 32px -18px rgba(43,36,22,0.8), 0 2px 5px -2px rgba(43,36,22,0.25); }
    .acceso:focus-visible { outline: 2px solid #B37E2C; outline-offset: 3px; }
    .acceso .foto {
      position: absolute; inset: 0 auto 0 0; z-index: -1; width: 47%; height: 100%; object-fit: cover; object-position: center;
      -webkit-mask-image: linear-gradient(90deg, #000 52%, transparent 100%); mask-image: linear-gradient(90deg, #000 52%, transparent 100%);
      transition: transform .6s cubic-bezier(.2,.7,.2,1);
    }
    .acceso:hover .foto { transform: scale(1.04); }
    .acceso .icono {
      position: absolute; left: 37%; top: 50%; translate: -50% -50%;
      width: clamp(30px, 9vw, 40px); height: auto; aspect-ratio: 1;
      filter: drop-shadow(0 1px 3px rgba(0,0,0,0.25));
    }
    .acceso .t { display: block; font-family: var(--serif); font-weight: 500; font-size: clamp(1.2rem, 5.3vw, 1.62rem); line-height: 1.02; white-space: pre-line; }
    .acceso .d { display: block; font-size: clamp(0.7rem, 2.95vw, 0.84rem); line-height: 1.35; margin-top: 7px; opacity: 0.92; }
    .acceso .flecha {
      width: clamp(34px, 9.6vw, 42px); aspect-ratio: 1; border-radius: 50%;
      display: grid; place-items: center; background: #F5EFE4; color: var(--tinta);
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
    .acceso .flecha svg { width: 42%; height: 42%; transition: transform .3s; }
    .acceso:hover .flecha svg { transform: translateX(2px); }

    .acceso.piezas    { --fondo: linear-gradient(100deg, #37331F 30%, #45412A 70%, #57522F); }
    .acceso.artistas  { --fondo: linear-gradient(100deg, #452E1B 30%, #573C26 70%, #64482E); }
    .acceso.historias { --fondo: linear-gradient(100deg, #7F5E3A 30%, #8F6B44 70%, #98754D); }
    .acceso.registro  { --fondo: linear-gradient(100deg, #DCCBB4 30%, #E4D5C1 70%, #E9DCC9); color: var(--tinta); }
    .acceso.registro .icono { filter: none; }
    .acceso.registro .d { opacity: 1; color: #3A3324; }
    .acceso.registro .flecha { background: #FBF7F0; box-shadow: 0 0 0 1px rgba(43,36,22,0.12); }
    .acceso.registro[aria-expanded="true"] { border-radius: 16px 16px 0 0; }
    .acceso.registro[aria-expanded="true"] .flecha svg { transform: rotate(90deg); }

    /* ── Registro ──────────────────────────── */
    .form {
      display: grid; gap: 12px; padding: 18px clamp(14px, 4vw, 22px) 20px; border-radius: 0 0 16px 16px;
      background: rgba(250,245,236,0.92); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      box-shadow: 0 14px 26px -18px rgba(43,36,22,0.75);
    }
    .form[hidden] { display: none; }
    .form label { display: grid; gap: 6px; font-size: 0.68rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--tinta-suave); }
    .form input {
      font: inherit; font-size: 1rem; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--tinta);
      padding: 13px 14px; border-radius: 10px; border: 1px solid rgba(43,36,22,0.2); background: #FFFDF9;
    }
    .form input:focus { outline: none; border-color: #B37E2C; box-shadow: 0 0 0 3px rgba(179,126,44,0.18); }
    .form button {
      margin-top: 4px; padding: 15px; border: 0; border-radius: 999px; cursor: pointer;
      background: var(--oliva); color: var(--crema); font: inherit; font-weight: 400; font-size: 0.95rem; letter-spacing: 0.08em;
      transition: background .2s;
    }
    .form button:hover { background: #3A371C; }
    .form button:disabled { opacity: 0.6; cursor: wait; }
    .form .error { font-size: 0.82rem; color: #8A3B2A; }
    .form .exito { text-align: center; font-family: var(--serif); font-weight: 500; font-size: 1.3rem; padding: 6px 0; }

    /* ── Pie ───────────────────────────────── */
    .pie { text-align: center; margin-top: 30px; padding-bottom: 8px; background: radial-gradient(ellipse 70% 60% at 50% 62%, rgba(246,239,227,0.8), rgba(246,239,227,0) 75%); }
    .linea { width: 72%; height: 1px; margin: 0 auto; background: rgba(43,36,22,0.35); }
    .linea.corta { width: 26%; }
    .redes { display: flex; justify-content: center; gap: 18px; margin: 22px 0; }
    .redes a {
      width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
      background: var(--oliva); color: var(--crema); box-shadow: 0 4px 10px -4px rgba(43,36,22,0.5);
      transition: transform .2s, background .2s;
    }
    .redes a:hover { transform: translateY(-2px); background: #3A371C; }
    .redes svg { width: 20px; height: 20px; }
    .cierre { font-family: var(--script); font-weight: 400; font-size: clamp(1.9rem, 8.4vw, 2.4rem); line-height: 1.05; color: #3A3222; white-space: pre-line; margin-top: 22px; }
    .ramita { width: 44px; height: auto; margin: 10px auto 0; display: block; color: #4A4625; }

    /* ── Entrada ───────────────────────────── */
    @media (prefers-reduced-motion: no-preference) {
      .entra { animation: entra .9s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i, 0) * 90ms); }
      @keyframes entra { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    }
    @media (prefers-reduced-motion: reduce) { .acceso, .acceso .foto, .acceso .flecha svg { transition: none; } }
  </style>
</head>
<body>
  <div class="escena" aria-hidden="true"></div>

  <main class="wrap">
    <header class="marca">
      <img class="logo entra" src="/hechoconelalma/logo.webp" alt="" width="400" height="400" />
      <h1 class="entra" style="--i:1">HECHO <span class="chico">CON EL</span> ALMA</h1>
      <p class="bajada entra" style="--i:2">{d.marca.bajada}</p>
      <p class="texto entra" style="--i:3">{d.marca.texto}</p>
    </header>

    {d.lanzamiento.activo && (
      <section class="lanzamiento entra" style="--i:4" aria-label="Lanzamiento">
        <small>{d.lanzamiento.etiqueta}</small>
        <h2>{d.lanzamiento.titulo}</h2>
        {d.lanzamiento.texto && <p>{d.lanzamiento.texto}</p>}
        <a href={d.lanzamiento.url} target="_blank" rel="noopener">{d.lanzamiento.boton}</a>
      </section>
    )}

    <nav class="accesos" aria-label="¿Qué querés hacer?">
      {d.accesos.map((a, i) => (
        <a class={`acceso ${a.id} entra`} style={`--i:${i + 4}`} href={a.url} target="_blank" rel="noopener">
          <img class="foto" src={a.imagen} alt="" loading="eager" />
          <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos[a.icono]} />
          <span>
            <span class="t">{a.titulo}</span>
            <span class="d">{a.texto}</span>
          </span>
          <span class="flecha" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={flecha} /></span>
        </a>
      ))}

      <div class="entra" style={`--i:${d.accesos.length + 4}`}>
        <button class="acceso registro" type="button" aria-expanded="false" aria-controls="registro-form" id="registro-btn">
          <img class="foto" src={d.registro.imagen} alt="" loading="eager" />
          <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos.sobre} />
          <span>
            <span class="t">{d.registro.titulo}</span>
            <span class="d">{d.registro.texto}</span>
          </span>
          <span class="flecha" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={flecha} /></span>
        </button>
        <form class="form" id="registro-form" hidden
          data-endpoint={d.registro.endpoint}
          data-wa={d.redes.whatsapp}
          data-wa-msg={d.registro.whatsappMensaje}
          data-exito={d.registro.exito}>
          <label>{d.registro.campoNombre}
            <input name="nombre" type="text" autocomplete="name" required />
          </label>
          <label>{d.registro.campoContacto}
            <input name="contacto" type="text" autocomplete="email" required />
          </label>
          <p class="error" hidden></p>
          <button type="submit">{d.registro.boton}</button>
        </form>
      </div>
    </nav>

    <footer class="pie entra" style={`--i:${d.accesos.length + 5}`}>
      <div class="linea"></div>
      <div class="redes">
        {d.redes.instagram && (
          <a href={d.redes.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="4.8"/><circle cx="12" cy="12" r="3.9"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
        )}
        {d.redes.facebook && (
          <a href={d.redes.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.4 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.7v3h2.6V21h3.1Z"/></svg>
          </a>
        )}
        {d.redes.youtube && (
          <a href={d.redes.youtube} target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z"/></svg>
          </a>
        )}
        {d.redes.whatsapp && (
          <a href={waUrl('Hola, me interesa saber más sobre Hecho con el Alma')} target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z"/></svg>
          </a>
        )}
      </div>
      <div class="linea corta"></div>
      <p class="cierre">{d.cierre}</p>
      <svg class="ramita" viewBox="0 0 48 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" aria-hidden="true">
        <path d="M4 16c10-2 22-6 38-13"/>
        <path d="M14 13.4c-.6-3 1-5.6 3.8-6.6.4 3-1.2 5.5-3.8 6.6ZM22 10.6c-.4-3 1.4-5.4 4.2-6.2.2 3-1.6 5.3-4.2 6.2ZM30 7.3c-.2-2.8 1.6-5 4.3-5.6 0 2.9-1.8 5-4.3 5.6Z" fill="currentColor" stroke="none"/>
        <path d="M17 14.6c2.7-1.3 5.6-.8 7.4 1.2-2.7 1.3-5.6.8-7.4-1.2ZM25.4 11.4c2.7-1.2 5.5-.6 7.2 1.4-2.7 1.2-5.5.6-7.2-1.4Z" fill="currentColor" stroke="none"/>
      </svg>
    </footer>
  </main>

  <script>
    const btn = document.getElementById('registro-btn')!;
    const form = document.getElementById('registro-form') as HTMLFormElement;
    btn.addEventListener('click', () => {
      const abrir = form.hidden;
      form.hidden = !abrir;
      btn.setAttribute('aria-expanded', String(abrir));
      if (abrir) form.querySelector('input')?.focus();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nombre = (form.elements.namedItem('nombre') as HTMLInputElement).value.trim();
      const contacto = (form.elements.namedItem('contacto') as HTMLInputElement).value.trim();
      const error = form.querySelector<HTMLElement>('.error')!;
      const enviar = form.querySelector<HTMLButtonElement>('button')!;
      const { endpoint, wa, waMsg, exito } = form.dataset;
      error.hidden = true;

      const listo = () => {
        const p = document.createElement('p');
        p.className = 'exito';
        p.textContent = exito ?? '';
        form.replaceChildren(p);
      };

      // Sin endpoint configurado: el registro llega por WhatsApp a Hecho con el Alma.
      if (!endpoint) {
        const texto = `${waMsg}\nNombre: ${nombre}\nContacto: ${contacto}`;
        window.open(`https://wa.me/${wa}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
        listo();
        return;
      }

      enviar.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, contacto, origen: 'link-in-bio', fecha: new Date().toISOString() }),
        });
        if (!res.ok) throw new Error(String(res.status));
        listo();
      } catch {
        error.textContent = 'No pudimos registrarte. Probá de nuevo en un momento.';
        error.hidden = false;
        enviar.disabled = false;
      }
    });
  </script>
</body>
</html>
