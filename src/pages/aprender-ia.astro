---
// VSL — Genideia Academy: aprender a usar IA de forma práctica.
// Hero → video de ventas → CTA WhatsApp.
import Loader from '../transitions/Loader.astro';
import AcademyBloque from '../components/premium/AcademyBloque.astro';
import '../transitions/transitions.css';
import '../styles/global.css';

const WA = '59892302941';
const waUrl = (msg: string) => `https://wa.me/${WA}?text=${encodeURIComponent(msg)}`;
const waDefault = waUrl('Hola Andrés, vi el video de Genideia Academy y quiero aprender a usar IA de forma práctica.');

const VIDEO = 'https://tsktonjqpwdkfmxgknnq.supabase.co/storage/v1/object/public/genideia-videos/vsl-academy.mp4';

// Testimonio real (Marcelo, terminó la formación 1 a 1 en octubre 2026). La cita es textual del video.
const TESTIMONIO = {
  nombre: 'Marcelo',
  programa: 'Formación 1 a 1',
  video: '/videos/testimonio-marcelo.mp4',
  poster: '/videos/testimonio-marcelo-poster.jpg',
  cita: 'Empecé prácticamente desde cero con Claude. Desde el día uno ya lancé mi propia app.',
  logros: [
    { titulo: 'De cero a su propia app', desc: 'Desde el primer encuentro construyó una app que hoy usa en su día a día.' },
    { titulo: '8 encuentros personalizados', desc: 'Cada sesión armada sobre su caso, sin apuro si había que extenderla.' },
    { titulo: 'Acompañamiento diario', desc: 'Comunicación por WhatsApp todos los días entre encuentro y encuentro.' },
  ],
};
const waTestimonio = waUrl('Hola Andrés, vi el testimonio de Marcelo y quiero aprender a usar IA como él.');
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Genideia Academy — Aprendé IA y aplicala a casos reales en 4 semanas</title>
  <meta name="description" content="Voy a ayudarte a aprender IA y saber aplicarla a casos reales en 4 semanas. Formación 1 a 1, diagnóstico personalizado y un programa de 8 módulos adaptado a tu situación real." />
  <meta property="og:title" content="Voy a ayudarte a aprender IA y saber aplicarla a casos reales en 4 semanas" />
  <meta property="og:description" content="Formación 1 a 1 en IA aplicada, armada alrededor de tu situación real." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://genideiacompany.com/og-genideia.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://genideiacompany.com/og-genideia.png" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Poppins:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <meta name="theme-color" content="#0A0F1A" />
  <script>import '../transitions/reveal.js';</script>
  <script is:inline src="/academy-gate.js"></script>
</head>
<body>
  <div class="vp-amb" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
  <div class="vp-grain" aria-hidden="true"></div>
  <Loader logoSrc="/img/logo-nav.png" />
  <div class="progress" id="progress"></div>

  <!-- ── HEADER (pill flotante) ─────────────────────────────── -->
  <header class="site-header">
    <a href="/andres" class="brand">
      <span class="brand-mark"><img src="/img/symbol-gii.png" alt="GENIDEIA" /></span>
      <span class="brand-copy">
        <strong>GENIDEIA</strong>
        <small>Academy</small>
      </span>
    </a>
    <a href={waDefault} target="_blank" rel="noopener noreferrer" class="btn-primary" data-track-lead>Hablemos →</a>
  </header>

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <section class="hero" id="inicio">
    <div class="wrap">
      <h1 class="hero-title" data-reveal>
        <span>Voy a ayudarte a aprender IA</span>
        <span>y saber aplicarla a casos reales en 4 semanas.</span>
      </h1>
    </div>
  </section>

  <!-- ── VIDEO PRINCIPAL ──────────────────────────────────────── -->
  <section class="vsl-section">
    <div class="wrap">
      <div class="video-shell" data-reveal id="video">
        <div class="video-frame">
          <video id="vid-principal" controls playsinline preload="metadata">
            <source src={VIDEO} type="video/mp4" />
            Tu navegador no soporta el video.
          </video>
        </div>
        <div class="vsl-gate" id="vsl-gate" data-estado="bloqueado">
          <p class="vg-t" id="vg-t"><b>Mirá el video completo</b> para elegir tu programa. Después vas a ver el testimonio de Marcelo y se habilitan las inscripciones.</p>
          <div class="vg-bar" aria-hidden="true"><i id="vg-fill"></i></div>
          <a class="btn-primary vg-go" id="vg-go" href="#programas" hidden>Elegir mi programa →</a>
        </div>
        <div class="video-cta">
          <a href={waDefault} target="_blank" rel="noopener noreferrer" class="btn-primary" data-track-lead>Quiero agendar mi diagnóstico →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TESTIMONIO: prueba social después de la VSL ─────────── -->
  <section class="testimonio-section" id="testimonio">
    <div class="wrap">
      <div class="testimonio-head" data-reveal>
        <p class="eyebrow">Quién ya lo hizo</p>
        <h2 class="section-title">Así le fue a Marcelo</h2>
      </div>
      <div class="testimonio-card" data-reveal>
        <div class="testimonio-video">
          <video controls playsinline preload="metadata" poster={TESTIMONIO.poster}>
            <source src={TESTIMONIO.video} type="video/mp4" />
            Tu navegador no soporta el video.
          </video>
        </div>
        <div class="testimonio-body">
          <blockquote class="testimonio-cita">“{TESTIMONIO.cita}”</blockquote>
          <p class="testimonio-autor"><strong>{TESTIMONIO.nombre}</strong> · {TESTIMONIO.programa}</p>
          <ul class="testimonio-logros">
            {TESTIMONIO.logros.map((l) => (
              <li><span class="check" aria-hidden="true">✓</span><div><strong>{l.titulo}</strong><p>{l.desc}</p></div></li>
            ))}
          </ul>
          <a href={waTestimonio} target="_blank" rel="noopener noreferrer" class="btn-primary" data-track-lead>Quiero empezar mi formación →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── RECORRIDO Y PROGRAMAS (mismo formato que /academy) ──────── -->
  <div class="wrap" id="programas"><AcademyBloque /></div>

  <!-- ── FOOTER ────────────────────────────────────────────── -->
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div>
        <p class="footer-nombre">Genideia Academy</p>
        <p class="footer-sub">Un programa de <a href="/">GENIDEIA Company</a> · Formación 1 a 1</p>
      </div>
      <div class="footer-contact">
        <a href={waDefault} target="_blank" rel="noopener noreferrer" data-track-lead>WhatsApp +598 92 302 941</a>
      </div>
    </div>
  </footer>

  <!-- Barra fija mobile: siempre visible, manda directo a WhatsApp -->
  <a href={waDefault} target="_blank" rel="noopener noreferrer" class="mobile-cta" data-track-lead>
    Agendar diagnóstico <span>↗</span>
  </a>

  <style>
    :root {
      --bg:#030405; --text:#f5f7fb; --muted:#9aa3af; --line:rgba(255,255,255,.10);
      --cyan:#18cfff; --blue:#1677ff;
    }
    body {
      margin:0; color:var(--text); font-family:'Poppins',sans-serif; -webkit-font-smoothing:antialiased;
      background:
        linear-gradient(rgba(2,5,12,.80),rgba(2,5,12,.92)),
        url('/img/bg-circuit.jpg') center top / cover fixed no-repeat,
        #02050c;
    }
    @media (max-width: 620px) { body { background-attachment: scroll; } }
    .wrap { width:min(1180px, calc(100% - 28px)); margin:auto; }

    .progress { position:fixed; top:0; left:0; z-index:80; height:2px; width:0; background:linear-gradient(90deg,#15d6ff,#1677ff); box-shadow:0 0 14px rgba(24,207,255,.45); }

    /* ── Header flotante (pill) ─────────────────────────────── */
    .site-header {
      position:fixed; top:16px; left:50%; transform:translateX(-50%); z-index:50;
      width:min(1180px, calc(100% - 26px)); min-height:64px;
      display:flex; align-items:center; justify-content:space-between; gap:20px;
      padding:8px 10px 8px 14px; border-radius:999px;
      background:rgba(3,8,18,.76); backdrop-filter:blur(16px);
      border:1px solid rgba(24,207,255,.16);
      box-shadow:0 14px 60px rgba(0,0,0,.28), 0 0 35px rgba(24,207,255,.035);
    }
    .brand { display:inline-flex; align-items:center; gap:10px; min-width:0; flex:1 1 auto; overflow:hidden; }
    .brand-mark {
      width:38px; height:38px; flex:0 0 38px; border-radius:50%; overflow:hidden;
      border:1px solid rgba(24,207,255,.30); box-shadow:0 0 22px rgba(24,207,255,.10);
    }
    .brand-mark img { width:100%; height:100%; object-fit:cover; display:block; }
    .brand-copy { display:grid; gap:1px; min-width:0; overflow:hidden; }
    .brand-copy strong { display:block; font-family:'Montserrat',sans-serif; font-size:0.85rem; color:#F2F4F7; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .brand-copy small { display:block; color:var(--cyan); font-size:0.6rem; letter-spacing:0.1em; text-transform:uppercase; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    @media (max-width: 400px) { .brand-copy small { display:none; } }

    .btn-primary {
      position:relative; display:inline-flex; align-items:center; justify-content:center; gap:8px;
      border-radius:999px; padding:16px 28px; font-size:0.9rem; font-weight:700; letter-spacing:0.01em;
      color:#fff; white-space:nowrap; border:1.5px solid transparent;
      background:
        linear-gradient(#0a1420,#0a1420) padding-box,
        linear-gradient(135deg,#18cfff,#7c5cff 55%,#18cfff) border-box;
      box-shadow:0 16px 44px rgba(0,0,0,.4);
      transition:transform .25s, box-shadow .25s;
      animation:ctaPulse 2.6s ease-in-out infinite;
    }
    .btn-primary:hover { transform:translateY(-2px); box-shadow:0 20px 54px rgba(0,0,0,.5), 0 0 34px rgba(24,207,255,.4); }
    @keyframes ctaPulse {
      0%, 100% { box-shadow:0 16px 44px rgba(0,0,0,.4), 0 0 0 rgba(24,207,255,0); }
      50% { box-shadow:0 16px 44px rgba(0,0,0,.4), 0 0 26px rgba(24,207,255,.38); }
    }
    .site-header .btn-primary { padding:12px 20px; font-size:0.78rem; animation:none; }
    @media (prefers-reduced-motion: reduce) { .btn-primary { animation:none; } }

    /* ── Hero ─────────────────────────────────────────────────── */
    .hero { position:relative; padding:150px 0 46px; text-align:center; }
    .hero:before {
      content:""; position:absolute; inset:0; pointer-events:none;
      background:radial-gradient(700px 260px at 50% 42%, rgba(24,207,255,.08), transparent 70%);
    }
    .hero .wrap { position:relative; z-index:1; }
    .hero-title {
      margin:0 auto; width:min(1180px,100%);
      font-family:'Montserrat',sans-serif; font-weight:800; line-height:.97; letter-spacing:-.055em;
      font-size:clamp(2rem, 3.6vw, 3.6rem);
      text-shadow:0 0 42px rgba(24,207,255,.055);
    }
    .hero-title span { display:block; white-space:nowrap; }
    @media (max-width:1180px) and (min-width:621px) { .hero-title { font-size:clamp(1.85rem, 3vw, 2.8rem); } }
    @media (max-width:620px) {
      .hero { padding:100px 0 30px; }
      .hero-title { width:100%; font-size:clamp(1.55rem, 7vw, 2.15rem); line-height:1.22; letter-spacing:-.02em; }
      .hero-title span { display:inline; white-space:normal; }
      .hero-title span:first-child::after { content:" "; }
    }

    /* ── Video shell ──────────────────────────────────────────── */
    .vsl-section { padding:0 0 74px; }
    .video-shell {
      max-width:980px; margin:0 auto; border-radius:26px; overflow:hidden;
      border:1px solid rgba(24,207,255,.22);
      background:linear-gradient(180deg, rgba(6,15,29,.94), rgba(5,9,17,.96));
      box-shadow:0 35px 120px rgba(0,0,0,.48), 0 0 48px rgba(24,207,255,.07);
    }
    .video-frame { padding:18px; background:linear-gradient(180deg, rgba(24,207,255,.035), rgba(255,255,255,.01)); }
    .video-frame video { display:block; width:100%; aspect-ratio:16/9; background:#000; border-radius:16px; border:1px solid rgba(24,207,255,.08); }
    .vsl-gate { padding:16px 18px 4px; border-top:1px solid rgba(255,255,255,.08); display:grid; gap:10px; justify-items:center; text-align:center; }
    .vg-t { margin:0; color:#B8BEC7; font-size:.95rem; }
    .vg-t b { color:#F2F4F7; }
    .vg-bar { width:min(420px,100%); height:6px; border-radius:99px; background:rgba(255,255,255,.08); overflow:hidden; }
    .vg-bar i { display:block; height:100%; width:0; background:linear-gradient(90deg,var(--blue),var(--cyan)); transition:width .4s; }
    .vsl-gate[data-estado="listo"] .vg-bar { display:none; }
    .vg-go[hidden] { display:none; }
    :global(html.vsl-locked) :global(.ab-prog) { opacity:.55; }
    .video-cta { padding:18px; border-top:1px solid rgba(255,255,255,.08); display:flex; justify-content:center; }
    @media (max-width:620px) { .video-frame { padding:10px; } }

    /* ── Testimonio ───────────────────────────────────────────── */
    .testimonio-section { padding:0 0 90px; }
    .testimonio-head { text-align:center; margin-bottom:26px; }
    .eyebrow { margin:0 0 8px; color:var(--cyan); font-size:0.7rem; font-weight:600; letter-spacing:0.22em; text-transform:uppercase; }
    .section-title { margin:0; font-family:'Montserrat',sans-serif; font-weight:800; letter-spacing:-.03em; font-size:clamp(1.6rem, 3vw, 2.4rem); }
    .testimonio-card {
      max-width:980px; margin:0 auto; display:grid; grid-template-columns:minmax(0,320px) 1fr; gap:40px; align-items:center;
      padding:26px; border-radius:26px; border:1px solid rgba(24,207,255,.22);
      background:linear-gradient(180deg, rgba(6,15,29,.94), rgba(5,9,17,.96));
      box-shadow:0 35px 120px rgba(0,0,0,.48), 0 0 48px rgba(24,207,255,.07);
    }
    .testimonio-video { aspect-ratio:9/16; border-radius:18px; overflow:hidden; border:1px solid rgba(24,207,255,.12); background:#000; }
    .testimonio-video video { width:100%; height:100%; display:block; object-fit:cover; }
    .testimonio-cita { margin:0 0 14px; font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(1.25rem, 2.2vw, 1.75rem); line-height:1.3; letter-spacing:-.01em; }
    .testimonio-autor { margin:0 0 24px; color:var(--muted); font-size:0.85rem; }
    .testimonio-autor strong { color:var(--cyan); font-weight:600; }
    .testimonio-logros { list-style:none; margin:0 0 28px; padding:0; display:grid; gap:14px; }
    .testimonio-logros li { display:flex; gap:14px; align-items:flex-start; padding:14px 16px; border:1px solid var(--line); border-radius:14px; background:rgba(255,255,255,.02); }
    .testimonio-logros .check { flex:0 0 26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.8rem; color:#0A0F1A; background:linear-gradient(135deg,#15d6ff,#1787ff); }
    .testimonio-logros strong { font-family:'Montserrat',sans-serif; font-size:0.95rem; }
    .testimonio-logros p { margin:3px 0 0; color:var(--muted); font-size:0.85rem; line-height:1.5; }
    @media (max-width:800px) {
      .testimonio-card { grid-template-columns:1fr; gap:26px; padding:16px; }
      .testimonio-video { max-width:320px; width:100%; margin:0 auto; }
      .testimonio-body .btn-primary { width:100%; white-space:normal; text-align:center; }
      .testimonio-section { padding-bottom:110px; }
    }

    /* ── Footer ───────────────────────────────────────────────── */
    .site-footer {
      position:relative; overflow:hidden; background:#020610;
      border-top:1px solid rgba(24,207,255,.10);
    }
    .site-footer:before {
      content:""; position:absolute; inset:0;
      background:
        linear-gradient(rgba(2,6,16,.90), rgba(2,6,16,.94)),
        url('/img/banner-genideia.jpg') center / cover no-repeat;
      opacity:.34;
    }
    .footer-inner {
      position:relative; z-index:1; padding:28px 0 34px;
      display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px;
    }
    .footer-nombre { font-family:'Montserrat',sans-serif; font-size:1.05rem; color:#F2F4F7; margin:0; }
    .footer-sub { font-weight:300; font-size:0.8rem; color:var(--muted); margin:2px 0 0; }
    .footer-sub a { color:var(--cyan); }
    .footer-contact { display:flex; flex-direction:column; align-items:flex-end; gap:4px; font-size:0.85rem; color:var(--muted); }
    .footer-contact a:hover { color:var(--cyan); }

    /* ── Barra fija mobile ───────────────────────────────────── */
    .mobile-cta { display:none; }
    @media (max-width:800px) {
      .mobile-cta {
        display:flex; position:fixed; z-index:45; right:12px; bottom:12px; left:12px;
        min-height:54px; padding:0 18px; align-items:center; justify-content:space-between;
        border:1px solid rgba(255,255,255,.14); border-radius:13px;
        background:linear-gradient(135deg,#15d6ff,#1787ff); color:#0A0F1A;
        font-weight:700; font-size:0.9rem; box-shadow:0 14px 40px rgba(0,0,0,.35);
      }
    }

    html { scroll-behavior:smooth; }
    /* ── Formato premium (mismo sistema que la Academy y las propuestas) ── */
    :root { --bg:#0A0F1A; --text:#F2F4F7; --muted:#7E8796; --line:rgba(255,255,255,.08); --cyan:#00C8FF; --blue:#007BFF; --sl:#BFEFFF; --glass:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.015)); --ease:cubic-bezier(.2,.7,.2,1); }
    body { background:var(--bg); }
    .vp-amb { position:fixed; inset:0; z-index:-2; overflow:hidden; pointer-events:none; }
    .vp-amb i { position:absolute; border-radius:50%; filter:blur(90px); opacity:.55; }
    .vp-amb .b1 { width:640px; height:640px; left:-160px; top:-200px; background:radial-gradient(circle,rgba(0,123,255,.55),transparent 68%); animation:vpd1 26s ease-in-out infinite alternate; }
    .vp-amb .b2 { width:560px; height:560px; right:-180px; top:12%; background:radial-gradient(circle,rgba(0,200,255,.33),transparent 70%); animation:vpd2 30s ease-in-out infinite alternate; }
    .vp-amb .b3 { width:720px; height:720px; left:28%; bottom:-400px; background:radial-gradient(circle,rgba(56,80,255,.26),transparent 70%); animation:vpd1 34s ease-in-out infinite alternate-reverse; }
    @keyframes vpd1 { to { transform:translate(140px,120px) scale(1.12); } } @keyframes vpd2 { to { transform:translate(-120px,160px) scale(.92); } }
    .vp-grain { position:fixed; inset:0; z-index:-1; pointer-events:none; opacity:.06; background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
    .progress { background:linear-gradient(90deg,var(--blue),var(--cyan)); }
    .site-header { top:12px; background:rgba(10,15,26,.74); backdrop-filter:blur(18px) saturate(1.4); -webkit-backdrop-filter:blur(18px) saturate(1.4); border-color:rgba(0,200,255,.14); box-shadow:0 18px 55px rgba(0,0,0,.35); }
    .brand-mark { border-color:rgba(0,200,255,.35); box-shadow:0 0 22px -4px rgba(0,140,255,.75); }
    .brand-copy strong { font-weight:600; letter-spacing:.18em; font-size:13px; }
    .brand-copy small { font-family:'JetBrains Mono',monospace; text-transform:none; letter-spacing:0; font-size:10.5px; color:var(--muted); }
    .btn-primary { overflow:hidden; border:0; font-weight:600; background:linear-gradient(135deg,var(--blue),var(--cyan)); box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 10px 30px -10px rgba(0,123,255,.8); animation:none; transition:transform .2s var(--ease),box-shadow .3s; }
    .btn-primary::after { content:""; position:absolute; top:0; left:0; width:45%; height:100%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.45),transparent); transform:translateX(-130%) skewX(-20deg); }
    .btn-primary:hover { transform:translateY(-2px); box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 18px 40px -12px rgba(0,123,255,.9); }
    .btn-primary:hover::after { transition:transform .8s; transform:translateX(320%) skewX(-20deg); }
    .hero:before { background:none; }
    .hero-title { font-weight:700; letter-spacing:-.045em; text-shadow:none; }
    .hero-title span:last-child { background:linear-gradient(90deg,#5FB4FF,var(--cyan) 60%,#9FF0FF); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .eyebrow { display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace; font-weight:400; font-size:12px; letter-spacing:.06em; text-transform:none; color:var(--sl); }
    .eyebrow::before { content:""; width:6px; height:6px; border-radius:50%; background:var(--cyan); box-shadow:0 0 10px var(--cyan); }
    .section-title, .section-head h2 { font-weight:700; letter-spacing:-.035em; text-shadow:none; }
    .video-shell, .examples-video-shell, .other-sector-shell, .testimonio-card { position:relative; border-color:rgba(255,255,255,.1); background:var(--glass),rgba(11,19,32,.72); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 50px 120px -40px rgba(0,90,255,.6); }
