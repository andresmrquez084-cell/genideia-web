---
import BaseLayout from '../layouts/BaseLayout.astro';
import SistemaCard from '../components/SistemaCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { SISTEMAS } from '../data/soluciones';
---

<BaseLayout
  title="Casos — GENIDEIA Company"
  description="El tipo de sistema que diseñamos para cada problema operativo: seguimiento comercial, gestión de personal, logística, administración y paneles internos."
  path="/casos"
>

  <section class="max-w-4xl mx-auto px-6 pt-24 pb-14 text-center">
    <p class="hero-animate text-xs font-medium mb-6 uppercase" data-delay="1" style="color:#00C8FF; letter-spacing:3px;">
      Casos
    </p>
    <h1 class="hero-animate mb-6" data-delay="2" style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-1px; font-size:clamp(2.2rem, 5.5vw, 3.8rem);">
      El tipo de sistema que diseñamos para cada problema.
    </h1>
    <p class="hero-animate mx-auto leading-relaxed max-w-xl text-lg" data-delay="3" style="color:#B8BEC7; font-weight:300;">
      Problema → sistema → resultado. Así encaramos cada proyecto, sea cual sea el rubro de tu empresa.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-24">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {SISTEMAS.map((s) => <SistemaCard sistema={s} />)}
    </div>
  </section>

  <CtaBand
    title="¿Tu empresa tiene un problema parecido?"
    subtitle="Contanos cómo funciona hoy y vemos qué sistema tendría sentido construir."
    waMessage="Hola, vi los casos de GENIDEIA y quiero contarles sobre mi negocio."
  />

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
