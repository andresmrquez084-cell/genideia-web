---
import BaseLayout from '../layouts/BaseLayout.astro';

const servicios = [
  {
    tag: 'Servicio I',
    nombre: 'Marketing Digital',
    desc: 'Posicionamiento, contenido y estructura para que los clientes te encuentren y te elijan antes de que vos les hables.',
    items: [
      'Estrategia y calendario de contenido',
      'Optimización de perfil y presencia web',
      'Estructura de comunicación orientada a conversión',
    ],
    para: 'Para negocios que quieren construir demanda real antes de escalar.',
  },
  {
    tag: 'Servicio II',
    nombre: 'Automatización',
    desc: 'Bots, workflows y sistemas IA para que tu negocio atienda, agende y opere — sin que vos estés presente.',
    items: [
      'Bot de WhatsApp a medida',
      'Workflows y automatizaciones con n8n',
      'Integración con las herramientas que ya usás',
    ],
    para: 'Para negocios con demanda que quieren crecer sin contratar más gente.',
  },
];

const herramientas = [
  {
    nombre: 'Bot de WhatsApp para negocios',
    desc: 'Atiende consultas, agenda turnos y confirma reservas en automático — las 24 horas, sin intervención humana.',
    videoId: 'JLFq5mAblxc',
  },
  {
    nombre: 'Sistema de contenido para inmobiliarias',
    desc: 'Genera y publica contenido de propiedades de forma automatizada. Presencia constante con mínimo esfuerzo manual.',
    videoId: 'jPMODHsfLlA',
  },
];

const clientes = [
  {
    nombre: 'Hecho con el Alma',
    rubro: 'Curaduría de arte',
    ubicacion: 'Uruguay',
    trabajo: ['Plataforma web', 'Sistema de contenido'],
    url: 'https://hechoconelalma.shop',
  },
  {
    nombre: "Donher's",
    rubro: 'Relojes y accesorios',
    ubicacion: 'Uruguay',
    trabajo: ['E-commerce', 'MercadoPago'],
    url: 'https://donhers-web.vercel.app',
  },
  {
    nombre: 'TBO Express',
    rubro: 'Cadetería y delivery',
    ubicacion: 'Tacuarembó, Uruguay',
    trabajo: ['Web a medida', 'Captación'],
    url: 'https://cadete-web.vercel.app',
  },
  {
    nombre: 'LOPA',
    rubro: 'Tienda online',
    ubicacion: 'Uruguay',
    trabajo: ['E-commerce', 'Branding'],
    url: 'https://lopa-store.vercel.app',
  },
  {
    nombre: 'Sara Centro Estético',
    rubro: 'Estética y bienestar',
    ubicacion: 'Montevideo, Uruguay',
    trabajo: ['Web a medida', 'Marketing digital'],
    url: 'https://centroesteticosara.netlify.app',
  },
  {
    nombre: 'Lorena Da Silva',
    rubro: 'Inmobiliaria · Imperium',
    ubicacion: 'Montevideo, Uruguay',
    trabajo: ['Marca personal', 'Landing'],
    url: 'https://landing-tau-ruddy.vercel.app',
  },
  {
    nombre: 'Allison Hernández',
    rubro: 'Inmobiliaria · Imperium',
    ubicacion: 'Montevideo, Uruguay',
    trabajo: ['Marca personal', 'Landing'],
    url: 'https://allison-imperium.vercel.app',
  },
];

// Las fases del socio de crecimiento (metodologia/07-fases-cliente).
// Versión pública: el camino + que cada fase se desbloquea con evidencia. Sin pricing ni datos internos.
const fases = [
  {
    num: '00',
    nombre: 'Diagnóstico y estrategia',
    desc: 'Entendemos tu negocio, tu cliente y contra quién competís de verdad. Salís con un norte claro: tu dolor real y el mensaje que te diferencia.',
    puerta: 'Avanzás cuando tenés tu posicionamiento definido y te ves reflejado.',
  },
  {
    num: '01',
    nombre: 'Fundación',
    desc: 'Tu presencia profesional, lista para recibir clientes: web, marca, perfiles y canales — y tu punto de partida medido.',
    puerta: 'Avanzás cuando estás LIVE y con tu baseline documentado.',
  },
  {
    num: '02',
    nombre: 'Tracción',
    desc: 'Generamos flujo: contenido que atrae a tu cliente ideal, lo conversa y lo convierte en venta.',
    puerta: 'Avanzás cuando hay demanda comprobada: leads y ventas que demuestran que el sistema funciona.',
  },
  {
    num: '03',
    nombre: 'Consolidación',
    desc: 'Con demanda probada, elevamos el ticket y afinamos la conversión. Empezás a capturar el valor que creaste.',
    puerta: 'Avanzás cuando facturás notoriamente más que en tu punto de partida.',
  },
  {
    num: '04',
    nombre: 'Automatización',
    desc: 'Cuando ya hay volumen, la IA atiende y vende sola. Bots, flujos y reportes que te devuelven el tiempo.',
    puerta: 'Avanzás cuando lo que antes era manual corre solo.',
  },
  {
    num: '05',
    nombre: 'Expansión',
    desc: 'Nuevos frentes sobre un negocio que ya es una máquina: más líneas, más zonas, más productos.',
    puerta: 'Cada frente nuevo arranca apalancado en todo lo construido.',
  },
];

// Barra de logos — clientes reales en producción
const logos = [
  { nombre: "Donher's", rubro: 'E-commerce', url: 'https://donhers-web.vercel.app' },
  { nombre: 'LOPA', rubro: 'Tienda online', url: 'https://lopa-store.vercel.app' },
  { nombre: 'Hecho con el Alma', rubro: 'Curaduría de arte', url: 'https://hechoconelalma.shop' },
  { nombre: 'TBO Express', rubro: 'Cadetería y delivery', url: 'https://cadete-web.vercel.app' },
  { nombre: 'Sara', rubro: 'Centro estético', url: 'https://centroesteticosara.netlify.app' },
  { nombre: 'Imperium', rubro: 'Inmobiliaria', url: 'https://landing-tau-ruddy.vercel.app' },
];

// Chips flotantes del hero
const chips = [
  { label: 'Estrategia', sub: 'Inteligente', pos: 'top:6%; left:-4%;' },
  { label: 'Automatización', sub: 'Operativa', pos: 'top:6%; right:-4%;' },
  { label: 'IA a medida', sub: 'Sistemas que trabajan por vos', pos: 'bottom:8%; left:-6%;' },
  { label: 'Resultados', sub: 'Medibles y sostenibles', pos: 'bottom:8%; right:-4%;' },
];
---

<BaseLayout title="GENIDEIA IA — Marketing y Automatización para PyMEs">

  <!-- ── HERO ───────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-6 pt-24 pb-16" style="position:relative; overflow:hidden;">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">

      <!-- Izquierda: texto -->
      <div style="position:relative; z-index:2;">
        <p class="hero-animate text-xs font-medium mb-6 uppercase" data-delay="1" style="color:#4ab8ff; letter-spacing:3px;">
          Marketing · Automatización · IA a medida
        </p>
        <h1 class="hero-animate mb-6" data-delay="2" style="font-family:'Cormorant Garamond',serif; font-weight:700; line-height:1.0; letter-spacing:-1.5px; font-size:clamp(2.6rem, 6vw, 4.6rem);">
          Describí el problema.<br />
          <span style="color:#a0a0a0; font-weight:300; font-style:italic;">Construimos la solución.</span>
        </h1>
        <p class="hero-animate mb-9 leading-relaxed max-w-lg text-lg" data-delay="3" style="color:#a0a0a0; font-weight:300;">
          Marketing, automatización e IA a la medida de lo que tu negocio necesita. Sin soluciones predefinidas.
        </p>
        <div class="hero-animate flex flex-col sm:flex-row gap-4 mb-8" data-delay="4">
          <a href="https://wa.me/59892302941" target="_blank" rel="noopener noreferrer" style="background:#4ab8ff; color:#0a0a0a; font-weight:600;" class="px-8 py-3.5 rounded-lg hover:opacity-90 transition-opacity text-center">
            Hablemos por WhatsApp
          </a>
          <a href="#diagnostico" style="border:1px solid rgba(255,255,255,0.12); color:#a0a0a0;" class="px-8 py-3.5 rounded-lg hover:border-[#4ab8ff] hover:text-[#4ab8ff] transition-colors text-center">
            Diagnóstico gratis →
          </a>
        </div>
        <p class="hero-animate text-sm" data-delay="5" style="color:rgba(160,160,160,0.45); font-weight:300; letter-spacing:0.5px;">
          7 proyectos en producción · Montevideo, Uruguay
        </p>
      </div>

      <!-- Derecha: brain-globe + chips flotantes -->
      <div class="hero-animate order-first lg:order-last" data-delay="3" style="position:relative;">
        <div style="position:absolute; inset:0; background:radial-gradient(ellipse at center, rgba(74,184,255,0.18) 0%, transparent 62%); z-index:0;" aria-hidden="true"></div>
        <img src="/img/hero-brain.png" alt="Red neuronal · IA a medida" width="640" height="640" loading="eager"
          style="position:relative; z-index:1; width:100%; max-width:480px; margin:0 auto; display:block; mix-blend-mode:screen;" />
        <div class="hidden lg:block">
          {chips.map((c) => (
            <div style={`position:absolute; z-index:2; ${c.pos} background:rgba(17,17,17,0.72); backdrop-filter:blur(8px); border:1px solid rgba(74,184,255,0.22); border-radius:10px; padding:10px 14px; max-width:200px;`}>
              <p style="color:#4ab8ff; font-size:0.6rem; letter-spacing:1.5px; font-weight:600;" class="uppercase">{c.label}</p>
              <p style="color:#a0a0a0; font-size:0.72rem; font-weight:300; line-height:1.3; margin-top:2px;">{c.sub}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ── LOGOS / CLIENTES REALES ───────────────────────────── -->
  <section style="border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-10">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-center mb-8" style="color:rgba(160,160,160,0.5); font-size:0.65rem; letter-spacing:3px; font-weight:500;" data-reveal>
        NEGOCIOS REALES · SISTEMAS REALES · RESULTADOS REALES
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6" data-reveal data-delay="1">
        {logos.map((l) => (
          <a href={l.url} target="_blank" rel="noopener noreferrer" class="text-center" style="opacity:0.65;">
            <span style="font-family:'Cormorant Garamond',serif; font-size:1.25rem; font-weight:600; color:#e8e8e8; letter-spacing:0.5px; display:block; line-height:1.1;">{l.nombre}</span>
            <span style="color:#a0a0a0; font-size:0.58rem; letter-spacing:1.5px; font-weight:400;" class="uppercase">{l.rubro}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SERVICIOS ─────────────────────────────────────────── -->
  <section
    id="servicios"
    style="border-top:1px solid rgba(255,255,255,0.07);"
    class="py-24"
  >
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16" data-reveal>
        <h2
          style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
          class="mb-4"
        >
          Dos servicios. Un sistema.
        </h2>
        <p style="color:#a0a0a0; font-weight:300;" class="text-lg max-w-lg mx-auto">
          Podés entrar por cualquiera según tu momento. Si no sabés cuál es tu caso,
          te ayudamos a identificarlo.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {servicios.map((s, i) => (
          <div
            class="card-hover rounded-xl p-8 flex flex-col"
            style="background:#111111; border:1px solid rgba(255,255,255,0.07);"
            data-reveal
            data-delay={String(i + 1)}
          >
            <span
              style="color:#4ab8ff; font-size:0.65rem; letter-spacing:2.5px; font-weight:500;"
              class="uppercase mb-5 block"
            >
              {s.tag}
            </span>
            <h3
              style="font-family:'Cormorant Garamond',serif; font-weight:700; color:#e8e8e8; font-size:clamp(1.5rem, 3vw, 2rem);"
              class="mb-3"
            >
              {s.nombre}
            </h3>
            <p style="color:#a0a0a0; font-weight:300;" class="text-sm leading-relaxed mb-7">
              {s.desc}
            </p>
            <ul class="space-y-3 mb-7 flex-1">
              {s.items.map(item => (
                <li style="color:#a0a0a0; font-weight:300;" class="text-sm flex items-start gap-3">
                  <span style="color:#4ab8ff; flex-shrink:0; margin-top:1px;">→</span>
                  {item}
                </li>
              ))}
            </ul>
            <p
              style="color:rgba(160,160,160,0.45); border-top:1px solid rgba(255,255,255,0.07); font-weight:300;"
              class="text-xs pt-5 mb-5 leading-relaxed"
            >
              {s.para}
            </p>
            <a
              href="https://wa.me/59892302941"
              target="_blank"
              rel="noopener noreferrer"
              style="color:#4ab8ff; font-weight:400;"
              class="text-sm hover:opacity-70 transition-opacity"
            >
              Consultar por este servicio →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── HERRAMIENTAS ──────────────────────────────────────── -->
  <section
    id="herramientas"
    style="background:#0d0d0d; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);"
    class="py-24"
  >
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16" data-reveal>
        <h2
          style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
          class="mb-4"
        >
          Herramientas
        </h2>
        <p style="color:#a0a0a0; font-weight:300;" class="text-lg max-w-lg mx-auto">
          Productos desarrollados que podés contratar de forma independiente
          — o como parte de un proceso mayor.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {herramientas.map((h, i) => (
          <div
            class="card-hover rounded-xl p-8 flex flex-col"
            style="background:#111111; border:1px solid rgba(255,255,255,0.07);"
            data-reveal
            data-delay={String(i + 1)}
          >
            <div class="flex items-center gap-3 mb-5">
              <span
                style="color:#4ab8ff; background:rgba(74,184,255,0.08); border:1px solid rgba(74,184,255,0.2); font-size:0.65rem; letter-spacing:2px;"
                class="uppercase px-2.5 py-1 rounded font-medium"
              >
                Producto independiente
              </span>
              <span
                style="color:rgba(160,160,160,0.35); font-size:0.65rem; letter-spacing:1.5px;"
                class="uppercase"
              >
                Demo disponible
              </span>
            </div>
            <h3 style="color:#e8e8e8; font-weight:500;" class="text-lg mb-3 flex-1">
              {h.nombre}
            </h3>
            <p style="color:#a0a0a0; font-weight:300;" class="text-sm leading-relaxed mb-7">
              {h.desc}
            </p>
            {h.videoId && (
              <div style="border-radius:0.5rem; overflow:hidden; margin-bottom:1.75rem;" class="aspect-video">
                <iframe
                  src={`https://www.youtube.com/embed/${h.videoId}`}
                  title={`Demo — ${h.nombre}`}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  style="width:100%; height:100%; border:none;"
                ></iframe>
              </div>
            )}
            <a
              href="https://wa.me/59892302941"
              target="_blank"
              rel="noopener noreferrer"
              style="color:#4ab8ff; font-weight:400;"
              class="text-sm hover:opacity-70 transition-opacity"
            >
              {h.videoId ? 'Implementar esta herramienta →' : 'Pedir demo →'}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CLIENTES ──────────────────────────────────────────── -->
  <section id="clientes" class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16" data-reveal>
        <h2
          style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
          class="mb-4"
        >
          Clientes
        </h2>
        <p style="color:#a0a0a0; font-weight:300;" class="text-lg">
          Negocios reales, ya en producción. Entrá a cada uno.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {clientes.map((c, i) => (
          <a
            href={c.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card-hover rounded-xl p-8 block"
            style="background:#111111; border:1px solid rgba(255,255,255,0.07);"
            data-reveal
            data-delay={String((i % 3) + 1)}
          >
            <p
              style="color:#4ab8ff; font-size:0.65rem; letter-spacing:2.5px; font-weight:500;"
              class="uppercase mb-4"
            >
              {c.rubro} · {c.ubicacion}
            </p>
            <h3 style="color:#e8e8e8; font-weight:500;" class="text-xl mb-5">
              {c.nombre}
            </h3>
            <div class="flex flex-wrap gap-2 mb-6">
              {c.trabajo.map(t => (
                <span
                  style="color:#a0a0a0; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);"
                  class="text-xs px-3 py-1 rounded-full font-light"
                >
                  {t}
                </span>
              ))}
            </div>
            <p
              style="color:#4ab8ff; border-top:1px solid rgba(255,255,255,0.07); font-weight:400;"
              class="text-xs pt-4"
            >
              Ver sitio →
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FASES · SOCIO DE CRECIMIENTO ──────────────────────── -->
  <section
    id="fases"
    style="background:#0d0d0d; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);"
    class="py-24"
  >
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16" data-reveal>
        <p style="color:#4ab8ff; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">Socio de crecimiento</p>
        <h2
          style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
          class="mb-4"
        >
          Te acompañamos fase por fase
        </h2>
        <p style="color:#a0a0a0; font-weight:300;" class="text-lg max-w-2xl mx-auto leading-relaxed">
          No te vendemos todo de una. Cada fase se desbloquea cuando los números muestran
          que estás listo para la próxima. Solo avanzás si funciona.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {fases.map((f, i) => (
          <div
            class="card-hover rounded-xl p-7 flex flex-col"
            style="background:#111111; border:1px solid rgba(255,255,255,0.07);"
            data-reveal
            data-delay={String((i % 3) + 1)}
          >
            <p
              style="font-family:'Cormorant Garamond',serif; font-weight:700; color:#4ab8ff; line-height:1;"
              class="text-5xl mb-4"
            >
              {f.num}
            </p>
            <h3 style="font-family:'Cormorant Garamond',serif; font-weight:600; color:#e8e8e8; font-size:1.5rem;" class="mb-3">
              {f.nombre}
            </h3>
            <p style="color:#a0a0a0; font-weight:300;" class="text-sm leading-relaxed mb-5 flex-1">
              {f.desc}
            </p>
            <p
              style="color:rgba(160,160,160,0.7); border-top:1px solid rgba(255,255,255,0.07); font-weight:300;"
              class="text-xs pt-4 leading-relaxed"
            >
              <span style="color:#4ab8ff; font-weight:500;">→ </span>{f.puerta}
            </p>
          </div>
        ))}
      </div>

      <p class="text-center mt-12" data-reveal>
        <a href="#diagnostico" style="color:#4ab8ff; font-weight:400;" class="text-sm hover:opacity-70 transition-opacity">
          ¿En qué fase está tu negocio? Empecemos por el diagnóstico →
        </a>
      </p>
    </div>
  </section>

  <!-- ── DIAGNÓSTICO ──────────────────────────────────────── -->
  <section
    id="diagnostico"
    style="border-top:1px solid rgba(255,255,255,0.07);"
    class="py-24"
  >
    <div class="max-w-2xl mx-auto px-6">
      <div class="text-center mb-12" data-reveal>
        <h2
          style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
          class="mb-4"
        >
          ¿Cuál es el desafío de tu negocio?
        </h2>
        <p style="color:#a0a0a0; font-weight:300;" class="text-lg leading-relaxed">
          Describilo en tus palabras. En base a eso te presentamos cómo podemos ayudarte
          — y si no existe la solución, la construimos.
        </p>
      </div>

      <form
        id="diagnostico-form"
        name="diagnostico"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-5"
        data-reveal
      >
        <input type="hidden" name="form-name" value="diagnostico" />
        <p class="hidden"><input name="bot-field" /></p>

        <!-- Área -->
        <div>
          <label style="color:#a0a0a0; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">
            Área del problema
          </label>
          <select name="area" required class="form-input">
            <option value="">Seleccioná una categoría</option>
            <option>Ventas y captación de clientes</option>
            <option>Atención al cliente</option>
            <option>Operaciones y procesos internos</option>
            <option>Contenido y marketing digital</option>
            <option>Administración y organización</option>
            <option>Otro / No sé cómo clasificarlo</option>
          </select>
        </div>

        <!-- Problema -->
        <div>
          <label style="color:#a0a0a0; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">
            Describí el problema
          </label>
          <textarea
            name="problema"
            rows="5"
            required
            placeholder="¿Qué está pasando en tu negocio? ¿Qué te gustaría resolver o mejorar?"
            class="form-input resize-none"
          ></textarea>
        </div>

        <!-- Nombre -->
        <div>
          <label style="color:#a0a0a0; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">
            Tu nombre <span style="color:rgba(160,160,160,0.4);">(opcional)</span>
          </label>
          <input
            name="nombre"
            type="text"
            placeholder="Para personalizar la respuesta"
            class="form-input"
          />
        </div>

        <!-- Submit -->
        <button
          type="submit"
          style="background:#4ab8ff; color:#0a0a0a; font-weight:600; width:100%;"
          class="py-3.5 rounded-lg hover:opacity-90 transition-opacity text-base"
        >
          Analizar mi caso →
        </button>
        <p style="color:rgba(160,160,160,0.35); font-weight:300;" class="text-xs text-center">
          Se abre WhatsApp con tu mensaje ya armado · Respondemos en menos de 24 horas
        </p>
      </form>

      <!-- Success state -->
      <div id="diagnostico-success" class="hidden text-center py-8" data-reveal>
        <p style="color:#4ab8ff; font-size:1.5rem; margin-bottom:1rem;">✓</p>
        <p style="color:#e8e8e8; font-weight:500;" class="text-lg mb-2">¡Perfecto!</p>
        <p style="color:#a0a0a0; font-weight:300;">
          Se abrió WhatsApp con tu mensaje. En menos de 24 horas te respondemos con una propuesta.
        </p>
      </div>
    </div>
  </section>

  <!-- ── CTA FINAL ─────────────────────────────────────────── -->
  <section id="contactar" class="max-w-3xl mx-auto px-6 py-28 text-center" data-reveal>
    <h2
      style="font-family:'Cormorant Garamond',serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
      class="mb-5"
    >
      ¿Dónde está tu negocio hoy?
    </h2>
    <p style="color:#a0a0a0; font-weight:300;" class="text-lg mb-10 leading-relaxed">
      Contame en qué punto estás y vemos juntos cuál es el siguiente paso.
    </p>
    <a
      href="https://wa.me/59892302941"
      target="_blank"
      rel="noopener noreferrer"
      style="background:#4ab8ff; color:#0a0a0a; font-weight:600;"
      class="px-10 py-4 rounded-lg hover:opacity-90 transition-opacity inline-block text-base"
    >
      Hablar por WhatsApp
    </a>
    <p style="color:rgba(160,160,160,0.35); font-weight:300;" class="text-sm mt-5">
      Sin compromiso · Respondemos en menos de 24 horas
    </p>
  </section>

</BaseLayout>

<script>
  // ── Scroll reveal ──────────────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

  // ── Diagnóstico form ───────────────────────────────────────
  const form = document.getElementById('diagnostico-form') as HTMLFormElement | null;
  const successDiv = document.getElementById('diagnostico-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const area     = (data.get('area')     as string) || '';
    const problema = (data.get('problema') as string) || '';
    const nombre   = (data.get('nombre')   as string) || '';

    // Construir mensaje de WhatsApp
    const nombreTexto = nombre ? `Hola, soy ${nombre}.` : 'Hola,';
    const areaTexto   = area   ? `\n\n*Área:* ${area}` : '';
    const msg = `${nombreTexto} me gustaría un diagnóstico para mi negocio.${areaTexto}\n\n*Problema:*\n${problema}`;
    const waUrl = `https://wa.me/59892302941?text=${encodeURIComponent(msg)}`;
    window.open(waUrl, '_blank');

    // Enviar a Netlify Forms en segundo plano
    try {
      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      });
    } catch (_) {
      // Si falla el envío a Netlify no interrumpimos el flujo
    }

    // Mostrar éxito
    form.classList.add('hidden');
    if (successDiv) {
      successDiv.classList.remove('hidden');
      successDiv.classList.add('is-visible');
    }
  });
</script>
