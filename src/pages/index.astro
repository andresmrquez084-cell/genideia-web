---
import BaseLayout from '../layouts/BaseLayout.astro';

// Home = presentación breve + 4 tarjetas que llevan DIRECTO a la página real
// correspondiente (nada de contenido copiado/recreado acá — pedido explícito
// de Andrés, 17/09). Mismos destinos que Nav.astro.
const destinos = [
  {
    eyebrow: 'Quiénes somos',
    titulo: 'Nosotros',
    desc: 'Cómo pensamos GENIDEIA, quién está detrás y qué nos diferencia.',
    href: '/nosotros',
    cta: 'Conocer al equipo',
    color: '#00C8FF',
    glow: 'rgba(0,200,255,.16)',
    primary: false,
    icon: 'M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM4.5 20.5a7.5 7.5 0 0 1 15 0',
  },
  {
    eyebrow: 'El siguiente paso',
    titulo: 'Agendá tu diagnóstico',
    desc: 'Mirá el video, los ejemplos por rubro, y coordiná tu diagnóstico con Andrés.',
    href: 'https://andres.genideiacompany.com/empresa',
    cta: 'Ver el video y agendar',
    color: '#007BFF',
    glow: 'rgba(0,123,255,.22)',
    primary: true,
    icon: 'M8 2v4M16 2v4M3.5 9h17M5 4.5h14A1.5 1.5 0 0 1 20.5 6v14a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 20V6A1.5 1.5 0 0 1 5 4.5Z M9 13.5l2 2 4-4.5',
  },
  {
    eyebrow: 'Lo que ya construimos',
    titulo: 'Nuestra experiencia',
    desc: 'Sistemas reales, diagnósticos y proyectos — el portfolio completo.',
    href: 'https://genideiacompany.com/experiencia/',
    cta: 'Ver el portfolio',
    color: '#34D399',
    glow: 'rgba(52,211,153,.16)',
    primary: false,
    icon: 'M4 19.5V6a1.5 1.5 0 0 1 1.5-1.5H15l5 5v9.5A1.5 1.5 0 0 1 18.5 20.5h-13A1.5 1.5 0 0 1 4 19.5ZM14.5 4.5V9a1 1 0 0 0 1 1h4.5',
  },
  {
    eyebrow: 'Formación 1 a 1',
    titulo: 'Genideia Academy',
    desc: 'Aprendé a usar IA de forma práctica, aplicada a tu trabajo o tu proyecto real.',
    href: '/aprender-ia',
    cta: 'Conocer la Academy',
    color: '#A78BFA',
    glow: 'rgba(167,139,250,.16)',
    primary: false,
    icon: 'M4 10 12 6 20 10 12 14 4 10Z M6 11.5V16.5C6 16.5 8.5 18.5 12 18.5C15.5 18.5 18 16.5 18 16.5V11.5 M20 10V15',
  },
];
---

<BaseLayout
  title="GENIDEIA Company — Sistemas y automatización para empresas"
  description="Diseñamos automatizaciones y sistemas a medida para reducir tareas manuales, ordenar procesos y mejorar el seguimiento operativo de tu empresa."
  path="/"
>

  <!-- ── INTRO BREVE ────────────────────────────────────────── -->
  <section class="max-w-3xl mx-auto px-6 pt-24 pb-14 text-center">
    <p class="hero-animate text-xs font-medium mb-5 uppercase" data-delay="1" style="color:#00C8FF; letter-spacing:3px;">
      Automatización · Sistemas · Procesos
    </p>
    <h1 class="hero-animate mb-5" data-delay="2" style="font-family:'Montserrat',sans-serif; font-weight:700; line-height:1.05; letter-spacing:-1.3px; font-size:clamp(2.3rem, 5.2vw, 3.6rem);">
      Convertimos procesos <span style="color:#B8BEC7; font-weight:300; font-style:italic;">en sistemas.</span>
    </h1>
    <p class="hero-animate mx-auto leading-relaxed max-w-xl text-lg" data-delay="3" style="color:#B8BEC7; font-weight:300;">
      Diseñamos automatizaciones y soluciones a medida para reducir tareas manuales, ordenar operaciones y mejorar el seguimiento dentro de tu empresa.
    </p>
  </section>

  <!-- ── 3 DESTINOS ─────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 pb-24">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {destinos.map((d, i) => (
        <a
          href={d.href}
          target={d.href.startsWith('http') ? '_blank' : undefined}
          rel={d.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class:list={["dest-card card-hover rounded-xl p-7 flex flex-col", d.primary && "dest-card-primary"]}
          style={`--dest-color:${d.color}; --dest-glow:${d.glow};`}
          data-reveal
          data-delay={String(i + 1)}
        >
          <div class="dest-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d={d.icon} />
            </svg>
          </div>
          <p style={`color:${d.color}; letter-spacing:2px;`} class="text-xs font-medium uppercase mb-3">{d.eyebrow}</p>
          <h2 style="font-family:'Montserrat',sans-serif; font-weight:700; color:#F2F4F7; font-size:1.4rem;" class="mb-3">
            {d.titulo}
          </h2>
          <p style="color:#B8BEC7; font-weight:300;" class="text-sm leading-relaxed mb-6 flex-1">
            {d.desc}
          </p>
          <span style={`color:${d.color};`} class="text-sm font-medium">
            {d.cta} →
          </span>
        </a>
      ))}
    </div>
  </section>

  <style>
    .dest-card {
      position: relative;
      overflow: hidden;
      background: #111111;
      border: 1px solid rgba(255,255,255,0.08);
      border-top: 2px solid var(--dest-color);
    }
    .dest-card::before {
      content: '';
      position: absolute;
      inset: -40% -40% auto auto;
      width: 220px;
      height: 220px;
      border-radius: 999px;
      background: radial-gradient(circle, var(--dest-glow), transparent 70%);
      pointer-events: none;
    }
    .dest-card-primary {
      background: linear-gradient(160deg, rgba(0,123,255,0.14), #111111 55%);
      border-color: rgba(0,123,255,0.35);
      box-shadow: 0 0 0 1px rgba(0,123,255,0.12), 0 20px 60px rgba(0,123,255,0.08);
    }
    .dest-icon {
      position: relative;
      z-index: 1;
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      color: var(--dest-color);
      background: color-mix(in srgb, var(--dest-color) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--dest-color) 35%, transparent);
      margin-bottom: 22px;
    }
    .dest-icon svg { width: 22px; height: 22px; }
  </style>

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
