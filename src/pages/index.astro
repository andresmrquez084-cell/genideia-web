---
import BaseLayout from '../layouts/BaseLayout.astro';

// Qué hacemos: una base (la arma el equipo) + dos frentes (cada socio) que convergen en hacer crecer al cliente.
const servicios = [
  {
    tag: 'Punto de partida · Equipo GENIDEIA',
    nombre: 'Creación, contenido & optimización',
    desc: 'El punto de partida que arma todo el equipo: dejamos tu negocio existiendo de forma profesional, posicionándote con contenido y listo para recibir clientes. La base sobre la que después se escala.',
    items: [
      'Branding aplicado: logo, paleta, tipografías y sistema visual',
      'Perfiles optimizados según tu nicho (Instagram, WhatsApp Business, Google Business)',
      'Web o landing mobile-first, llave en mano',
      'Medio de pago si vendés online (Mercado Pago)',
      'Sistema de contenido y posicionamiento orgánico: pilares, cadencia y métricas',
      'Embudo de captación: posicionar → captar → interactuar → convertir',
    ],
    para: 'Para empresas que necesitan una presencia profesional sólida antes de escalar con ads o automatización.',
  },
  {
    tag: 'Frente · Tadeo Granada',
    nombre: 'Publicidad / Ads',
    desc: 'Cualquiera puede “hacer anuncios”. Lo que cambia tu negocio es la pauta hecha con método: entender a quién le hablás, dónde está y qué lo mueve a comprar. Diseñamos la estrategia, segmentamos, producimos las creatividades y medimos todo —costo por contacto, costo por cliente, retorno de la inversión— para que las campañas dejen de ser un gasto y se vuelvan un canal que trae clientes todos los meses. No es suerte: es trabajo, prueba y optimización constante.',
    items: [
      'Campañas en Meta / Instagram',
      'Google Ads y búsqueda',
      'TikTok y LinkedIn Ads',
      'Contenido y creatividades para anuncios',
    ],
    para: 'Para empresas que ya tienen su operación estable y están listas para instalar anuncios y escalar la demanda.',
  },
  {
    tag: 'Frente · Andrés Albornoz',
    nombre: 'Automatización & soluciones',
    desc: 'Detrás de cada tarea repetitiva hay horas de tu tiempo, trabajo y carga mental. Automatizar no es “un bot y listo”: es mapear cómo opera tu negocio, detectar dónde se pierde tiempo y construir la solución a medida —bots, workflows, integraciones— que se haga cargo de eso por vos. El impacto real: dejás de apagar incendios, bajás los errores y recuperás horas para enfocarte en hacer crecer la empresa, no en sostenerla.',
    items: [
      'Bot de WhatsApp a medida',
      'Workflows y automatizaciones con n8n',
      'Webs, e-commerce y sistemas internos con IA',
      'Integración con las herramientas que ya usás',
    ],
    para: 'Para empresas que necesitan automatizar sus procesos internos y dejar de depender de hacer todo a mano.',
  },
];

const herramientas = [
  {
    nombre: 'Bot de WhatsApp para negocios',
    desc: 'Atiende consultas, agenda turnos y confirma reservas en automático — las 24 horas, sin intervención humana.',
    videoId: 'JLFq5mAblxc',
  },
  {
    nombre: 'Sistema de contenido para inmobiliarias',
    desc: 'Genera y publica contenido de propiedades de forma automatizada. Presencia constante con mínimo esfuerzo manual.',
    videoId: 'jPMODHsfLlA',
  },
];

// Cómo trabajamos — el ciclo de 3 pasos (las 3 etapas de la metodología, doc 00).
const pasos = [
  {
    num: '01',
    nombre: 'Diagnóstico',
    desc: 'Analizamos la posición actual de tu empresa y detectamos las oportunidades: qué procesos automatizar, qué resolver con IA y dónde escalar con publicidad. Salís con un diagnóstico claro. Es gratuito.',
  },
  {
    num: '02',
    nombre: 'Construcción',
    desc: 'Trazamos el camino hacia donde querés llegar y lo ejecutamos con procedimientos concretos: implementamos los sistemas, soluciones o campañas que tu negocio necesita. De punta a punta, lo armamos nosotros.',
  },
  {
    num: '03',
    nombre: 'Seguimiento',
    desc: 'Medimos las estadísticas en cada etapa para confirmar que vamos por el camino correcto. Si los números no acompañan, ajustamos. No te dejamos solo después de entregar.',
  },
];

// Barra de logos — clientes reales en producción
const logos = [
  { nombre: "Donher's", rubro: 'E-commerce', url: 'https://donhers.com' },
  { nombre: 'LOPA', rubro: 'Tienda online', url: 'https://lopa-store.vercel.app' },
  { nombre: 'Hecho con el Alma', rubro: 'Curaduría de arte', url: 'https://hechoconelalma.shop' },
  { nombre: 'TBO Express', rubro: 'Cadetería y delivery', url: 'https://cadete-web.vercel.app' },
  { nombre: 'Sara', rubro: 'Centro estético', url: 'https://centroesteticosara.netlify.app' },
  { nombre: 'Asesores de Imperium', rubro: 'Inmobiliaria', url: 'https://lorena-imperium-landing.genideiaconsultoraia.workers.dev' },
];

// Los dos socios / cofundadores — la cara de la empresa.
// Arrancan en frentes distintos pero CONVERGEN en hacer crecer el negocio del cliente.
const socios = [
  {
    nombre: 'Andrés Albornoz',
    rol: 'Cofundador · Soluciones con automatización',
    desc: 'Automatiza los procesos de las PyMEs y construye la solución a medida: bots de WhatsApp, n8n, webs y sistemas con IA. Domina las herramientas y arma la solución en sí.',
    ig: 'https://instagram.com/andresalbornozia',
    handle: '@andresalbornozia',
    linkedin: 'https://www.linkedin.com/in/andres-albornoz-b498823a4',
    wsp: 'https://wa.me/59892302941',
    foto: '/img/andres.jpg',
  },
  {
    nombre: 'Tadeo Granada',
    rol: 'Cofundador · Ads / Publicidad',
    desc: 'Lleva los anuncios: Meta, Instagram, Google, TikTok y LinkedIn. Estudia el mercado, contacta y produce el contenido de las campañas que traen clientes.',
    ig: 'https://instagram.com/tadeogranadaa',
    handle: '@tadeogranadaa',
    linkedin: '',
    wsp: 'https://wa.me/59892267601',
    foto: '/img/tadeo.jpg',
  },
];

// Testimonios — Andrés pasa frases reales. NO inventar: placeholders maquetados.
const testimonios = [
  { cliente: '[Cliente — pendiente]', rubro: 'Rubro · Uruguay', frase: '[Testimonio de cliente — pendiente]' },
  { cliente: '[Cliente — pendiente]', rubro: 'Rubro · Uruguay', frase: '[Testimonio de cliente — pendiente]' },
  { cliente: '[Cliente — pendiente]', rubro: 'Rubro · Uruguay', frase: '[Testimonio de cliente — pendiente]' },
];

// Quiénes ya confiaron — clientes REALES (sin inventar logos: nombre estilizado).
const confiaron = [
  { nombre: 'Sara', rubro: 'Centro estético', url: 'https://centroesteticosara.netlify.app' },
  { nombre: 'Hecho con el Alma', rubro: 'Galería de arte', url: 'https://hechoconelalma.shop' },
  { nombre: "Donher's", rubro: 'Relojes y accesorios', url: 'https://donhers.com' },
  { nombre: 'Lorena Da Silva', rubro: 'Marca personal', url: 'https://lorena-imperium-landing.genideiaconsultoraia.workers.dev' },
  { nombre: 'LOPA', rubro: 'E-commerce', url: 'https://lopa-store.vercel.app' },
];

// Cómo trabajar con nosotros — los pasos concretos para arrancar.
const arranque = [
  {
    num: '01',
    nombre: 'Diagnóstico gratis',
    desc: 'Nos contás dónde está tu negocio. Detectamos qué automatizar y dónde conviene invertir en ads. Salís con un norte claro, sin compromiso.',
  },
  {
    num: '02',
    nombre: 'Propuesta a medida',
    desc: 'Te armamos un plan concreto: qué se construye, qué se publicita, en qué orden y con qué resultado esperado.',
  },
  {
    num: '03',
    nombre: 'Implementación',
    desc: 'Lo ejecutamos nosotros. Construimos los sistemas, lanzamos las campañas y te acompañamos midiendo el resultado.',
  },
];

// Micro-indicadores del hero (fila chica, no recuadros flotantes)
const indicadores = ['Estrategia inteligente', 'Automatización operativa', 'IA a medida', 'Resultados medibles'];
---

<BaseLayout title="GENIDEIA Company — Automatización, soluciones con IA y ads para PyMEs">

  <!-- ── HERO ───────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-6 pt-24 pb-16" style="position:relative; overflow:hidden;">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">

      <!-- Izquierda: texto -->
      <div style="position:relative; z-index:2;">
        <p class="hero-animate text-xs font-medium mb-6 uppercase" data-delay="1" style="color:#00C8FF; letter-spacing:3px;">
          Automatización & soluciones · Ads
        </p>
        <h1 class="hero-animate mb-6" data-delay="2" style="font-family:'Montserrat',sans-serif; font-weight:700; line-height:1.0; letter-spacing:-1.5px; font-size:clamp(2.6rem, 6vw, 4.6rem);">
          Tu negocio, un sistema que crece<br />
          <span style="color:#B8BEC7; font-weight:300; font-style:italic;">sin depender de vos.</span>
        </h1>
        <p class="hero-animate mb-9 leading-relaxed max-w-lg text-lg" data-delay="3" style="color:#B8BEC7; font-weight:300;">
          Automatización, contenido y ads que trabajan juntos: te ordenan la operación por dentro y te traen clientes por fuera. A medida.
        </p>
        <div class="hero-animate flex flex-col sm:flex-row gap-4 mb-8" data-delay="4">
          <a href="https://wa.me/59892302941" target="_blank" rel="noopener noreferrer" style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600;" class="px-8 py-3.5 rounded-lg hover:opacity-90 transition-opacity text-center">
            Hablemos por WhatsApp
          </a>
          <a href="#diagnostico" style="border:1px solid rgba(255,255,255,0.12); color:#B8BEC7;" class="px-8 py-3.5 rounded-lg hover:border-[#00C8FF] hover:text-[#00C8FF] transition-colors text-center">
            Diagnóstico gratis →
          </a>
        </div>
        <div class="hero-animate flex flex-wrap gap-x-5 gap-y-2 mb-6" data-delay="5" style="font-family:'Inter',sans-serif;">
          {indicadores.map((m) => (
            <span class="flex items-center gap-2" style="color:#B8BEC7; font-size:0.78rem; font-weight:400;">
              <span style="width:6px; height:6px; border-radius:9999px; background:#00C8FF; box-shadow:0 0 8px rgba(0,200,255,0.6); flex-shrink:0; display:inline-block;"></span>
              {m}
            </span>
          ))}
        </div>
        <p class="hero-animate text-sm" data-delay="5" style="color:rgba(160,160,160,0.45); font-weight:300; letter-spacing:0.5px;">
          7 proyectos en producción · Montevideo, Uruguay
        </p>
      </div>

      <!-- Derecha: el isotipo GII se arma y desarma con partículas (canvas) -->
      <div class="hero-animate order-first lg:order-last" data-delay="3" style="position:relative;">
        <div class="hero-glow" style="position:absolute; inset:0; background:radial-gradient(ellipse at center, rgba(0,200,255,0.30) 0%, transparent 66%); z-index:0;" aria-hidden="true"></div>
        <div style="position:relative; z-index:1; width:100%; max-width:720px; aspect-ratio:1; margin:0 auto;">
          <canvas id="hero-logo" style="width:100%; height:100%; display:block;" aria-hidden="true"></canvas>
          <img src="/img/symbol-gii.png" alt="GENIDEIA Company" width="700" height="700" style="position:absolute; width:1px; height:1px; opacity:0; pointer-events:none;" />
        </div>
      </div>

    </div>
  </section>

  <!-- ── LOGOS / CLIENTES REALES ───────────────────────────── -->
  <section style="border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-10">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-center mb-8" style="color:rgba(160,160,160,0.5); font-size:0.65rem; letter-spacing:3px; font-weight:500;" data-reveal>
        NEGOCIOS REALES · SISTEMAS REALES · RESULTADOS REALES
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6" data-reveal data-delay="1">
        {logos.map((l) => (
          <a href={l.url} target="_blank" rel="noopener noreferrer" class="text-center" style="opacity:0.65;">
            <span style="font-family:'Montserrat',sans-serif; font-size:1.25rem; font-weight:600; color:#F2F4F7; letter-spacing:0.5px; display:block; line-height:1.1;">{l.nombre}</span>
            <span style="color:#B8BEC7; font-size:0.58rem; letter-spacing:1.5px; font-weight:400;" class="uppercase">{l.rubro}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PILAR: CERO DEMOS ─────────────────────────────────── -->
  <section style="background:linear-gradient(135deg, rgba(0,200,255,0.08), rgba(0,123,255,0.05));" class="py-14">
    <div class="max-w-5xl mx-auto px-6 text-center" data-reveal>
      <h2 style="font-family:'Montserrat',sans-serif; font-weight:800; letter-spacing:-0.5px; font-size:clamp(1.8rem, 4.5vw, 2.8rem);" class="mb-3">
        Cero demos. <span style="color:#00C8FF;">100% producción.</span>
      </h2>
      <p style="color:#B8BEC7; font-weight:300;" class="text-lg max-w-2xl mx-auto leading-relaxed">
        No entregamos pruebas de concepto: implementamos sistemas listos para operar y facturar desde el primer día.
      </p>
    </div>
  </section>

  <!-- ── QUIÉNES ESTÁN DETRÁS ──────────────────────────────── -->
  <section id="quienes" style="border-top:1px solid rgba(255,255,255,0.07);" class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12" data-reveal>
        <p style="color:#00C8FF; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">Quiénes están detrás</p>
        <h2 style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);" class="mb-4">
          Los socios que responden por tu negocio.
        </h2>
        <p style="color:#B8BEC7; font-weight:300;" class="text-lg max-w-xl mx-auto">
          Dos socios que entran por frentes distintos —automatización y ads— y convergen
          en un solo objetivo: hacer crecer tu negocio.
        </p>
      </div>

      <!-- Video representativo de los socios -->
      <div class="mb-12" data-reveal>
        <div style="border-radius:0.75rem; overflow:hidden; border:1px solid rgba(255,255,255,0.08); background:#0B1324;" class="aspect-video max-w-3xl mx-auto flex items-center justify-center">
          <div class="text-center" style="color:rgba(160,160,160,0.45);">
            <p style="font-size:2rem;" class="mb-2">▶</p>
            <p style="font-size:0.7rem; letter-spacing:2px;" class="uppercase">Video · Próximamente</p>
          </div>
        </div>
      </div>

      <!-- Los dos socios -->
      <div class="grid sm:grid-cols-2 gap-6" data-reveal data-delay="1">
        {socios.map((s) => (
          <div class="card-hover rounded-xl p-6 flex items-center gap-5" style="background:#111111; border:1px solid rgba(255,255,255,0.07);">
            <div style="flex-shrink:0; width:88px; height:110px; border-radius:0.5rem; overflow:hidden; background:#0B1324; border:1px solid rgba(255,255,255,0.08);" class="flex items-center justify-center">
              {s.foto
                ? <img src={s.foto} alt={s.nombre} style="width:100%; height:100%; object-fit:cover;" />
                : <span style="color:rgba(160,160,160,0.4); font-size:0.55rem; letter-spacing:1.5px;" class="uppercase">Foto</span>}
            </div>
            <div class="min-w-0">
              <h3 style="font-family:'Montserrat',sans-serif; font-weight:600; color:#F2F4F7; font-size:1.4rem;" class="leading-tight">{s.nombre}</h3>
              <p style="color:#00C8FF; font-size:0.7rem; letter-spacing:1px; font-weight:500;" class="uppercase mt-1 mb-3">{s.rol}</p>
              <p style="color:#B8BEC7; font-weight:300;" class="text-sm leading-relaxed mb-3">{s.desc}</p>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
                <a href={s.ig} target="_blank" rel="noopener noreferrer" style="color:#00C8FF;" class="font-light hover:opacity-70 transition-opacity">{s.handle}</a>
                {s.linkedin && <a href={s.linkedin} target="_blank" rel="noopener noreferrer" style="color:#00C8FF;" class="font-light hover:opacity-70 transition-opacity">LinkedIn</a>}
                {s.wsp && <a href={s.wsp} target="_blank" rel="noopener noreferrer" style="color:#00C8FF;" class="font-light hover:opacity-70 transition-opacity">WhatsApp</a>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SERVICIOS ─────────────────────────────────────────── -->
  <section
    id="servicios"
    style="border-top:1px solid rgba(255,255,255,0.07);"
    class="py-24"
  >
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16" data-reveal>
        <p style="color:#00C8FF; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">Qué hacemos</p>
        <h2
          style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
          class="mb-4"
        >
          Una base y dos frentes que convergen.
        </h2>
        <p style="color:#B8BEC7; font-weight:300;" class="text-lg max-w-lg mx-auto">
          Primero dejamos tu base profesional lista. Sobre eso, cada socio suma su frente
          —anuncios y automatización— y convergen en hacer crecer tu negocio.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicios.map((s, i) => (
          <div
            class="card-hover rounded-xl p-8 flex flex-col"
            style="background:#111111; border:1px solid rgba(255,255,255,0.07);"
            data-reveal
            data-delay={String(i + 1)}
          >
            <span
              style="color:#00C8FF; font-size:0.65rem; letter-spacing:2.5px; font-weight:500;"
              class="uppercase mb-5 block"
            >
              {s.tag}
            </span>
            <h3
              style="font-family:'Montserrat',sans-serif; font-weight:700; color:#F2F4F7; font-size:clamp(1.5rem, 3vw, 2rem);"
              class="mb-3"
            >
              {s.nombre}
            </h3>
            <p style="color:#B8BEC7; font-weight:300;" class="text-sm leading-relaxed mb-7">
              {s.desc}
            </p>
            <ul class="space-y-3 mb-7 flex-1">
              {s.items.map(item => (
                <li style="color:#B8BEC7; font-weight:300;" class="text-sm flex items-start gap-3">
                  <span style="color:#00C8FF; flex-shrink:0; margin-top:1px;">→</span>
                  {item}
                </li>
              ))}
            </ul>
            <p
              style="color:rgba(160,160,160,0.45); border-top:1px solid rgba(255,255,255,0.07); font-weight:300;"
              class="text-xs pt-5 mb-5 leading-relaxed"
            >
              {s.para}
            </p>
            <a
              href="https://wa.me/59892302941"
              target="_blank"
              rel="noopener noreferrer"
              style="color:#00C8FF; font-weight:400;"
              class="text-sm hover:opacity-70 transition-opacity"
            >
              Consultar por este servicio →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── HERRAMIENTAS ──────────────────────────────────────── -->
  <section
    id="herramientas"
    style="background:#0B1324; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);"
    class="py-24"
  >
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16" data-reveal>
        <h2
          style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
          class="mb-4"
        >
          Sistemas con IA, ya funcionando.
        </h2>
        <p style="color:#B8BEC7; font-weight:300;" class="text-lg max-w-lg mx-auto">
          Productos con IA que podés contratar de forma independiente
          — o como parte de un proceso mayor.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {herramientas.map((h, i) => (
          <div
            class="card-hover rounded-xl p-8 flex flex-col"
            style="background:#111111; border:1px solid rgba(255,255,255,0.07);"
            data-reveal
            data-delay={String(i + 1)}
          >
            <div class="flex items-center gap-3 mb-5">
              <span
                style="color:#00C8FF; background:rgba(0,200,255,0.08); border:1px solid rgba(0,200,255,0.2); font-size:0.65rem; letter-spacing:2px;"
                class="uppercase px-2.5 py-1 rounded font-medium"
              >
                Producto independiente
              </span>
              <span
                style="color:rgba(160,160,160,0.35); font-size:0.65rem; letter-spacing:1.5px;"
                class="uppercase"
              >
                Demo disponible
              </span>
            </div>
            <h3 style="color:#F2F4F7; font-weight:500;" class="text-lg mb-3 flex-1">
              {h.nombre}
            </h3>
            <p style="color:#B8BEC7; font-weight:300;" class="text-sm leading-relaxed mb-7">
              {h.desc}
            </p>
            {h.videoId && (
              <div style="border-radius:0.5rem; overflow:hidden; margin-bottom:1.75rem;" class="aspect-video">
                <iframe
                  src={`https://www.youtube.com/embed/${h.videoId}`}
                  title={`Demo — ${h.nombre}`}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  style="width:100%; height:100%; border:none;"
                ></iframe>
              </div>
            )}
            <a
              href="https://wa.me/59892302941"
              target="_blank"
              rel="noopener noreferrer"
              style="color:#00C8FF; font-weight:400;"
              class="text-sm hover:opacity-70 transition-opacity"
            >
              {h.videoId ? 'Implementar esta herramienta →' : 'Pedir demo →'}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CÓMO LO HACEMOS (proceso / método) ────────────────── -->
  <section
    id="como-lo-hacemos"
    style="background:#0B1324; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);"
    class="py-24"
  >
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16" data-reveal>
