<script>
  // ── Scroll reveal ──────────────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

  // ── Diagnóstico form ───────────────────────────────────────
  const form = document.getElementById('diagnostico-form') as HTMLFormElement | null;
  const successDiv = document.getElementById('diagnostico-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const area     = (data.get('area')     as string) || '';
    const problema = (data.get('problema') as string) || '';
    const nombre   = (data.get('nombre')   as string) || '';

    // Construir mensaje de WhatsApp
    const nombreTexto = nombre ? `Hola, soy ${nombre}.` : 'Hola,';
    const areaTexto   = area   ? `\n\n*Área:* ${area}` : '';
    const msg = `${nombreTexto} me gustaría un diagnóstico para mi negocio.${areaTexto}\n\n*Problema:*\n${problema}`;
    const waUrl = `https://wa.me/59892302941?text=${encodeURIComponent(msg)}`;
    window.open(waUrl, '_blank');

    // Enviar a Netlify Forms en segundo plano
    try {
      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      });
    } catch (_) {
      // Si falla el envío a Netlify no interrumpimos el flujo
    }

    // Mostrar éxito
    form.classList.add('hidden');
    if (successDiv) {
      successDiv.classList.remove('hidden');
      successDiv.classList.add('is-visible');
    }
  });
</script>

<style>
  /* El centro es la red animada en canvas. El glow respira y los chips derivan apenas. */
  @keyframes heroGlowPulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.08); }
  }
  @keyframes heroChipFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }
  .hero-glow { animation: heroGlowPulse 5s ease-in-out infinite; }
  .hero-chip { animation: heroChipFloat 5s ease-in-out infinite; will-change: transform; }
  .hero-chip:nth-child(1) { animation-delay: 0s; }
  .hero-chip:nth-child(2) { animation-delay: 0.8s; }
  .hero-chip:nth-child(3) { animation-delay: 1.6s; }
  .hero-chip:nth-child(4) { animation-delay: 2.4s; }
  @media (prefers-reduced-motion: reduce) {
    .hero-glow, .hero-chip { animation: none; }
  }
</style>

<script>
  // El isotipo GII se ARMA y DESARMA: partículas que convergen en la silueta del logo
  // (muestreada de la imagen) y se dispersan — en loop infinito.
  (() => {
    const canvas = document.getElementById('hero-logo');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0, H = 0, DPR = 1;
    function resize() {
      const rect = canvas.getBoundingClientRect();
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * DPR);
      canvas.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize);

    const MAX = window.innerWidth < 640 ? 440 : 860;
    let pts = [];

    function buildTargets(img) {
      const S = 150;
      const off = document.createElement('canvas');
      off.width = S; off.height = S;
      const octx = off.getContext('2d');
      if (!octx) return;
      octx.drawImage(img, 0, 0, S, S);
      let data;
      try { data = octx.getImageData(0, 0, S, S).data; } catch (e) { return; }
      const raw = [];
      for (let y = 0; y < S; y += 2) {
        for (let x = 0; x < S; x += 2) {
          const i = (y * S + x) * 4;
          const a = data[i + 3];
          const bright = (data[i] + data[i + 1] + data[i + 2]) / 3;
          const nx = (x / S) * 2 - 1, ny = (y / S) * 2 - 1;
          if (nx * nx + ny * ny > 1) continue;          // recorte circular
          if (a > 40 && bright > 95) raw.push([nx, ny]); // sólo anillo + GII + glow
        }
      }
      const stride = Math.max(1, Math.floor(raw.length / MAX));
      pts = [];
      for (let i = 0; i < raw.length; i += stride) {
        pts.push({
          x: raw[i][0], y: raw[i][1],
          sx: (Math.random() * 2 - 1) * 1.9,
          sy: (Math.random() * 2 - 1) * 1.9,
          r: 0.95 + Math.random() * 1.3,
          a0: 0.5 + Math.random() * 0.45,
        });
      }
    }

    const T_A = 2400, T_H = 2000, T_D = 2000, T_H2 = 650;
    const CYCLE = T_A + T_H + T_D + T_H2;
    const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    function assembly(ms) {
      const t = ms % CYCLE;
      if (t < T_A) return ease(t / T_A);
      if (t < T_A + T_H) return 1;
      if (t < T_A + T_H + T_D) return 1 - ease((t - T_A - T_H) / T_D);
      return 0;
    }

    let started = 0;
    function frame(now) {
      if (!started) started = now;
      const a = reduced ? 1 : assembly(now - started);
      const R = Math.min(W, H) * 0.54;
      const cx = W / 2, cy = H / 2;
      ctx.clearRect(0, 0, W, H);
      for (const p of pts) {
        const X = p.sx + (p.x - p.sx) * a;
        const Y = p.sy + (p.y - p.sy) * a;
        ctx.fillStyle = 'rgba(130,215,255,' + (p.a0 * (0.3 + 0.7 * a)).toFixed(3) + ')';
        ctx.beginPath();
        ctx.arc(cx + X * R, cy + Y * R, p.r * (0.7 + 0.3 * a), 0, Math.PI * 2);
        ctx.fill();
      }
      requestAnimationFrame(frame);
    }

    const img = new Image();
    img.onload = () => { buildTargets(img); if (pts.length) requestAnimationFrame(frame); };
    img.src = '/img/symbol-gii.png';
  })();
</script>
