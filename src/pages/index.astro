---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import ProblemaCard from '../components/ProblemaCard.astro';
import SistemaCard from '../components/SistemaCard.astro';
import { PROBLEMAS, SISTEMAS, PASOS_TRABAJO, DIFERENCIALES } from '../data/soluciones';

// Home = versión condensada del posicionamiento. El detalle completo vive en /soluciones,
// /casos y /como-trabajamos (ver nav). Objetivo: que se entienda en 10 segundos.
const sistemasDestacados = SISTEMAS.slice(0, 3);

// Micro-indicadores del hero — concretos, sin "IA"/"innovación" sueltos.
const indicadores = ['Automatización de procesos', 'Sistemas a medida', 'Seguimiento y control', 'Implementación real'];
---

<BaseLayout
  title="GENIDEIA Company — Sistemas y automatización para empresas"
  description="Diseñamos automatizaciones y sistemas a medida para reducir tareas manuales, ordenar procesos y mejorar el seguimiento operativo de tu empresa."
  path="/"
>

  <!-- ── HERO ───────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-6 pt-24 pb-16" style="position:relative; overflow:hidden;">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">

      <!-- Izquierda: texto -->
      <div style="position:relative; z-index:2;">
        <p class="hero-animate text-xs font-medium mb-6 uppercase" data-delay="1" style="color:#00C8FF; letter-spacing:3px;">
          Automatización · Sistemas · Procesos
        </p>
        <h1 class="hero-animate mb-6" data-delay="2" style="font-family:'Montserrat',sans-serif; font-weight:700; line-height:1.0; letter-spacing:-1.5px; font-size:clamp(2.6rem, 6vw, 4.6rem);">
          Convertimos procesos<br />
          <span style="color:#B8BEC7; font-weight:300; font-style:italic;">en sistemas.</span>
        </h1>
        <p class="hero-animate mb-9 leading-relaxed max-w-lg text-lg" data-delay="3" style="color:#B8BEC7; font-weight:300;">
          Diseñamos automatizaciones y soluciones a medida para reducir tareas manuales, ordenar operaciones y mejorar el seguimiento dentro de tu empresa.
        </p>
        <div class="hero-animate flex flex-col sm:flex-row gap-4 mb-8" data-delay="4">
          <a href="#diagnostico" style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600;" class="px-8 py-3.5 rounded-lg hover:opacity-90 transition-opacity text-center">
            Contanos qué querés mejorar
          </a>
          <a href="/como-trabajamos" style="border:1px solid rgba(255,255,255,0.12); color:#B8BEC7;" class="px-8 py-3.5 rounded-lg hover:border-[#00C8FF] hover:text-[#00C8FF] transition-colors text-center">
            Ver cómo trabajamos
          </a>
        </div>
        <div class="hero-animate flex flex-wrap gap-x-5 gap-y-2 mb-6" data-delay="5" style="font-family:'Inter',sans-serif;">
          {indicadores.map((m) => (
            <span class="flex items-center gap-2" style="color:#B8BEC7; font-size:0.78rem; font-weight:400;">
              <span style="width:6px; height:6px; border-radius:9999px; background:#00C8FF; box-shadow:0 0 8px rgba(0,200,255,0.6); flex-shrink:0; display:inline-block;"></span>
              {m}
            </span>
          ))}
        </div>
        <p class="hero-animate text-sm" data-delay="5" style="color:rgba(160,160,160,0.45); font-weight:300; letter-spacing:0.5px;">
          7 proyectos en producción · Montevideo, Uruguay
        </p>
      </div>

      <!-- Derecha: el isotipo GII se arma y desarma con partículas (canvas) -->
      <div class="hero-animate order-first lg:order-last" data-delay="3" style="position:relative;">
        <div class="hero-glow" style="position:absolute; inset:0; background:radial-gradient(ellipse at center, rgba(0,200,255,0.30) 0%, transparent 66%); z-index:0;" aria-hidden="true"></div>
        <div style="position:relative; z-index:1; width:100%; max-width:720px; aspect-ratio:1; margin:0 auto;">
          <canvas id="hero-logo" style="width:100%; height:100%; display:block;" aria-hidden="true"></canvas>
          <img src="/img/symbol-gii.png" alt="GENIDEIA Company" width="700" height="700" style="position:absolute; width:1px; height:1px; opacity:0; pointer-events:none;" />
        </div>
      </div>

    </div>
  </section>

  <!-- ── PROBLEMAS QUE RESOLVEMOS ──────────────────────────── -->
  <Section
    id="problemas"
    border="both"
    kicker="Problemas que resolvemos"
    title="¿Con cuál de esto te encontrás en tu empresa?"
    maxWidth="max-w-6xl"
  >
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {PROBLEMAS.map((p) => <ProblemaCard problema={p} />)}
    </div>
    <p class="text-center mt-12 max-w-2xl mx-auto" style="color:#B8BEC7; font-weight:300;" data-reveal>
      No partimos de una herramienta. Partimos del problema y construimos el sistema alrededor de tu operación.
    </p>
  </Section>

  <!-- ── CÓMO TRABAJAMOS (condensado) ──────────────────────── -->
  <Section
    id="metodo"
    bg="soft"
    border="both"
    kicker="Cómo trabajamos"
    title="Diagnóstico, diseño, construcción, implementación y mejora."
    subtitle="No entregamos software suelto: una solución que tiene que funcionar dentro del proceso que ya existe en tu empresa."
  >
    <StepList pasos={PASOS_TRABAJO} />
    <p class="text-center mt-12" data-reveal>
      <a href="/como-trabajamos" style="color:#00C8FF; font-weight:400;" class="text-sm hover:opacity-70 transition-opacity">
        Ver el método completo →
      </a>
    </p>
  </Section>

  <!-- ── TIPO DE SISTEMAS QUE DISEÑAMOS ────────────────────── -->
  <Section
    id="soluciones"
    kicker="Soluciones"
    title="El tipo de sistema que diseñamos para cada problema"
    maxWidth="max-w-6xl"
  >
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sistemasDestacados.map((s) => <SistemaCard sistema={s} />)}
    </div>
    <p class="text-center mt-12" data-reveal>
      <a href="/casos" style="color:#00C8FF; font-weight:400;" class="text-sm hover:opacity-70 transition-opacity">
        Ver más ejemplos →
      </a>
    </p>
  </Section>

  <!-- ── QUÉ NOS DIFERENCIA ─────────────────────────────────── -->
  <Section
    bg="soft"
    border="both"
    kicker="Qué nos diferencia"
    title="No empezamos por la tecnología. Empezamos por entender el proceso."
    maxWidth="max-w-4xl"
  >
    <div class="grid sm:grid-cols-2 gap-8 max-w-3xl mx-auto">
      <div data-reveal>
        <p style="color:rgba(160,160,160,0.5); font-size:0.65rem; letter-spacing:2px; font-weight:500;" class="uppercase mb-4">Lo que no hacemos</p>
        <ul class="space-y-3">
          {DIFERENCIALES.no.map((item) => (
            <li style="color:#B8BEC7; font-weight:300;" class="text-sm flex items-start gap-2.5">
              <span style="color:rgba(160,160,160,0.6); flex-shrink:0;">—</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div data-reveal data-delay="1">
        <p style="color:#00C8FF; font-size:0.65rem; letter-spacing:2px; font-weight:500;" class="uppercase mb-4">Cómo trabajamos</p>
        <ul class="space-y-3">
          {DIFERENCIALES.si.map((item) => (
            <li style="color:#B8BEC7; font-weight:300;" class="text-sm flex items-start gap-2.5">
              <span style="color:#00C8FF; flex-shrink:0;">→</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- ── DIAGNÓSTICO ──────────────────────────────────────── -->
  <section id="diagnostico" class="py-24">
    <div class="max-w-2xl mx-auto px-6">
      <div class="text-center mb-12" data-reveal>
        <h2
          style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
          class="mb-4"
        >
          ¿Cuál es el proceso que querés mejorar?
        </h2>
        <p style="color:#B8BEC7; font-weight:300;" class="text-lg leading-relaxed">
          Contanos qué está pasando hoy en tu empresa. Analizamos si tiene sentido automatizarlo
          y qué sistema tendría que construirse alrededor.
        </p>
      </div>

      <form id="diagnostico-form" class="space-y-5" data-reveal>
        <!-- Área -->
        <div>
          <label style="color:#B8BEC7; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">
            Área del proceso
          </label>
          <select name="area" id="diagnostico-area" required class="form-input">
            <option value="">Seleccioná una categoría</option>
            <option value="Ventas y seguimiento">Ventas y seguimiento</option>
            <option value="Operaciones">Operaciones</option>
            <option value="Administración">Administración</option>
            <option value="Personal">Personal</option>
            <option value="Logística">Logística</option>
            <option value="Otro / No sé cómo clasificarlo">Otro / No sé cómo clasificarlo</option>
          </select>
        </div>

        <!-- Problema -->
        <div>
          <label style="color:#B8BEC7; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">
            Describí el proceso
          </label>
          <textarea
            name="problema"
            rows="5"
            required
            placeholder="¿Cómo funciona hoy? ¿Qué tarea te consume más tiempo o dónde aparecen más errores?"
            class="form-input resize-none"
          ></textarea>
        </div>

        <!-- Nombre -->
        <div>
          <label style="color:#B8BEC7; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">
            Tu nombre <span style="color:rgba(160,160,160,0.4);">(opcional)</span>
          </label>
          <input
            name="nombre"
            type="text"
            placeholder="Para personalizar la respuesta"
            class="form-input"
          />
        </div>

        <!-- Submit -->
        <button
          type="submit"
          style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600; width:100%;"
          class="py-3.5 rounded-lg hover:opacity-90 transition-opacity text-base"
        >
          Analizar mi caso →
        </button>
        <p style="color:rgba(160,160,160,0.35); font-weight:300;" class="text-xs text-center">
          Se abre WhatsApp con tu mensaje ya armado · Respondemos en menos de 24 horas
        </p>
      </form>

      <!-- Success state -->
      <div id="diagnostico-success" class="hidden text-center py-8" data-reveal>
        <p style="color:#00C8FF; font-size:1.5rem; margin-bottom:1rem;">✓</p>
        <p style="color:#F2F4F7; font-weight:500;" class="text-lg mb-2">¡Perfecto!</p>
        <p style="color:#B8BEC7; font-weight:300;">
          Se abrió WhatsApp con tu mensaje. En menos de 24 horas te respondemos con una propuesta.
        </p>
      </div>
    </div>
  </section>

  <!-- ── CTA FINAL ─────────────────────────────────────────── -->
  <section id="contactar" class="max-w-3xl mx-auto px-6 py-28 text-center" data-reveal>
    <h2
      style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
      class="mb-5"
    >
      Contanos cómo funciona hoy tu proceso.
    </h2>
    <p style="color:#B8BEC7; font-weight:300;" class="text-lg mb-10 leading-relaxed">
      Analizamos dónde se pierde tiempo, dónde aparecen errores y qué partes tiene sentido automatizar.
    </p>
    <a
      href="https://wa.me/59892302941"
      target="_blank"
      rel="noopener noreferrer"
      style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600;"
      class="px-10 py-4 rounded-lg hover:opacity-90 transition-opacity inline-block text-base"
    >
      Hablar con Genideia
    </a>
    <p style="color:rgba(160,160,160,0.35); font-weight:300;" class="text-sm mt-5">
      Respondemos en menos de 24 horas
    </p>
  </section>

</BaseLayout>

<script>
  // ── Scroll reveal ──────────────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

  // ── Diagnóstico form ───────────────────────────────────────
  const form = document.getElementById('diagnostico-form') as HTMLFormElement | null;
  const successDiv = document.getElementById('diagnostico-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const area     = (data.get('area')     as string) || '';
    const problema = (data.get('problema') as string) || '';
    const nombre   = (data.get('nombre')   as string) || '';

    const nombreTexto = nombre ? `Hola, soy ${nombre}.` : 'Hola,';
    const areaTexto   = area   ? `\n\n*Área:* ${area}` : '';
    const msg = `${nombreTexto} quiero contarles sobre un proceso de mi empresa.${areaTexto}\n\n*Proceso:*\n${problema}`;
    const waUrl = `https://wa.me/59892302941?text=${encodeURIComponent(msg)}`;
    window.open(waUrl, '_blank');

    form.classList.add('hidden');
    if (successDiv) {
      successDiv.classList.remove('hidden');
      successDiv.classList.add('is-visible');
    }
  });
</script>

<style>
  @keyframes heroGlowPulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.08); }
  }
  .hero-glow { animation: heroGlowPulse 5s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    .hero-glow { animation: none; }
  }
</style>

<script>
  // El isotipo GII se ARMA y DESARMA: partículas que convergen en la silueta del logo
  // (muestreada de la imagen) y se dispersan — en loop infinito.
  (() => {
    const canvas = document.getElementById('hero-logo');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0, H = 0, DPR = 1;
    function resize() {
      const rect = canvas.getBoundingClientRect();
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * DPR);
      canvas.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize);

    const MAX = window.innerWidth < 640 ? 440 : 860;
    let pts = [];

    function buildTargets(img) {
      const S = 150;
      const off = document.createElement('canvas');
      off.width = S; off.height = S;
      const octx = off.getContext('2d');
      if (!octx) return;
      octx.drawImage(img, 0, 0, S, S);
      let data;
      try { data = octx.getImageData(0, 0, S, S).data; } catch (e) { return; }
      const raw = [];
      for (let y = 0; y < S; y += 2) {
        for (let x = 0; x < S; x += 2) {
          const i = (y * S + x) * 4;
          const a = data[i + 3];
          const bright = (data[i] + data[i + 1] + data[i + 2]) / 3;
          const nx = (x / S) * 2 - 1, ny = (y / S) * 2 - 1;
          if (nx * nx + ny * ny > 1) continue;          // recorte circular
          if (a > 40 && bright > 95) raw.push([nx, ny]); // sólo anillo + GII + glow
        }
      }
      const stride = Math.max(1, Math.floor(raw.length / MAX));
      pts = [];
      for (let i = 0; i < raw.length; i += stride) {
        pts.push({
          x: raw[i][0], y: raw[i][1],
          sx: (Math.random() * 2 - 1) * 1.9,
          sy: (Math.random() * 2 - 1) * 1.9,
          r: 0.95 + Math.random() * 1.3,
          a0: 0.5 + Math.random() * 0.45,
        });
      }
    }

    const T_A = 2400, T_H = 2000, T_D = 2000, T_H2 = 650;
    const CYCLE = T_A + T_H + T_D + T_H2;
    const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    function assembly(ms) {
      const t = ms % CYCLE;
      if (t < T_A) return ease(t / T_A);
      if (t < T_A + T_H) return 1;
      if (t < T_A + T_H + T_D) return 1 - ease((t - T_A - T_H) / T_D);
      return 0;
    }

    let started = 0;
    function frame(now) {
      if (!started) started = now;
      const a = reduced ? 1 : assembly(now - started);
      const R = Math.min(W, H) * 0.54;
      const cx = W / 2, cy = H / 2;
      ctx.clearRect(0, 0, W, H);
      for (const p of pts) {
        const X = p.sx + (p.x - p.sx) * a;
        const Y = p.sy + (p.y - p.sy) * a;
        ctx.fillStyle = 'rgba(130,215,255,' + (p.a0 * (0.3 + 0.7 * a)).toFixed(3) + ')';
        ctx.beginPath();
        ctx.arc(cx + X * R, cy + Y * R, p.r * (0.7 + 0.3 * a), 0, Math.PI * 2);
        ctx.fill();
      }
      requestAnimationFrame(frame);
    }

    const img = new Image();
    img.onload = () => { buildTargets(img); if (pts.length) requestAnimationFrame(frame); };
    img.src = '/img/symbol-gii.png';
  })();
</script>
