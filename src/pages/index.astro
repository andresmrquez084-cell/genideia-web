    rubro: 'Inmobiliaria · Imperium',
    ubicacion: 'Montevideo, Uruguay',
    trabajo: ['Marca personal', 'Landing'],
    url: 'https://allison-imperium.vercel.app',
  },
];

// Cómo trabajamos — el ciclo de 3 pasos (las 3 etapas de la metodología, doc 00).
const pasos = [
  {
    num: '01',
    nombre: 'Diagnóstico',
    desc: 'Entendemos tu negocio y detectamos qué se puede automatizar o resolver con IA. Salís con un norte claro — gratis, sin compromiso.',
  },
  {
    num: '02',
    nombre: 'Construcción',
    desc: 'Montamos el sistema a medida: web, e-commerce, bot de WhatsApp o automatización con IA. Lo que tu negocio necesita, hecho de verdad.',
  },
  {
    num: '03',
    nombre: 'Seguimiento',
    desc: 'Medimos el resultado y ajustamos. Si no funciona, se corrige. No te dejamos solo después de entregar.',
  },
];

// Barra de logos — clientes reales en producción
const logos = [
  { nombre: "Donher's", rubro: 'E-commerce', url: 'https://donhers.com' },
  { nombre: 'LOPA', rubro: 'Tienda online', url: 'https://lopa-store.vercel.app' },
  { nombre: 'Hecho con el Alma', rubro: 'Curaduría de arte', url: 'https://hechoconelalma.shop' },
  { nombre: 'TBO Express', rubro: 'Cadetería y delivery', url: 'https://cadete-web.vercel.app' },
  { nombre: 'Sara', rubro: 'Centro estético', url: 'https://centroesteticosara.netlify.app' },
