---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import ProblemaCard from '../components/ProblemaCard.astro';
import PortfolioStrip from '../components/PortfolioStrip.astro';
import { PROBLEMAS, PASOS_TRABAJO, DIFERENCIALES } from '../data/soluciones';

// Home = breve presentación + portfolio integrado + video → agendar llamada directo.
// No es la "web de presentación completa" (eso vive en /soluciones, /casos, /como-trabajamos
// vía nav) — el objetivo acá es que entienda el ecosistema en 10 segundos y agende.
// Andrés (17/09) pidió "agendar la auditoría", pero el Calendly real del funnel personal
// (calendly.com/genideiaconsultoraia/llamada-de-diagnostico) es la "Llamada de exploración"
// gratis de 30 min — la auditoría paga es un paso posterior (ver [[project-albornoz-embudo]]).
// Usamos acá "llamada de exploración" para no prometer algo distinto de lo que agenda.
// Confirmar con Andrés si quiere crear un evento de Calendly propio para la empresa.
const WA = '59892302941';
const waMsg = encodeURIComponent('Hola, quiero agendar una llamada con GENIDEIA.');
const waUrl = `https://wa.me/${WA}?text=${waMsg}`;
const CALENDLY = 'https://calendly.com/genideiaconsultoraia/llamada-de-diagnostico';
const calendlyEmbed = `${CALENDLY}?hide_gdpr_banner=1&background_color=0b1324&text_color=f2f4f7&primary_color=00c8ff`;

// Micro-indicadores del hero — concretos, sin "IA"/"innovación" sueltos.
const indicadores = ['Automatización de procesos', 'Sistemas a medida', 'Seguimiento y control', 'Implementación real'];
---

<BaseLayout
  title="GENIDEIA Company — Sistemas y automatización para empresas"
  description="Diseñamos automatizaciones y sistemas a medida para reducir tareas manuales, ordenar procesos y mejorar el seguimiento operativo de tu empresa."
  path="/"
>

  <!-- ── HERO ───────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-6 pt-24 pb-16" style="position:relative; overflow:hidden;">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">

      <!-- Izquierda: texto -->
      <div style="position:relative; z-index:2;">
        <p class="hero-animate text-xs font-medium mb-6 uppercase" data-delay="1" style="color:#00C8FF; letter-spacing:3px;">
          Automatización · Sistemas · Procesos
        </p>
        <h1 class="hero-animate mb-6" data-delay="2" style="font-family:'Montserrat',sans-serif; font-weight:700; line-height:1.0; letter-spacing:-1.5px; font-size:clamp(2.6rem, 6vw, 4.6rem);">
          Convertimos procesos<br />
          <span style="color:#B8BEC7; font-weight:300; font-style:italic;">en sistemas.</span>
        </h1>
        <p class="hero-animate mb-9 leading-relaxed max-w-lg text-lg" data-delay="3" style="color:#B8BEC7; font-weight:300;">
          Diseñamos automatizaciones y soluciones a medida para reducir tareas manuales, ordenar operaciones y mejorar el seguimiento dentro de tu empresa.
        </p>
        <div class="hero-animate flex flex-col sm:flex-row gap-4 mb-8" data-delay="4">
          <a href="#agenda" style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600;" class="px-8 py-3.5 rounded-lg hover:opacity-90 transition-opacity text-center">
            Contanos qué querés mejorar
          </a>
          <a href="/como-trabajamos" style="border:1px solid rgba(255,255,255,0.12); color:#B8BEC7;" class="px-8 py-3.5 rounded-lg hover:border-[#00C8FF] hover:text-[#00C8FF] transition-colors text-center">
            Ver cómo trabajamos
          </a>
        </div>
        <div class="hero-animate flex flex-wrap gap-x-5 gap-y-2 mb-6" data-delay="5" style="font-family:'Inter',sans-serif;">
          {indicadores.map((m) => (
            <span class="flex items-center gap-2" style="color:#B8BEC7; font-size:0.78rem; font-weight:400;">
              <span style="width:6px; height:6px; border-radius:9999px; background:#00C8FF; box-shadow:0 0 8px rgba(0,200,255,0.6); flex-shrink:0; display:inline-block;"></span>
              {m}
            </span>
          ))}
        </div>
        <p class="hero-animate text-sm" data-delay="5" style="color:rgba(160,160,160,0.45); font-weight:300; letter-spacing:0.5px;">
          7 proyectos en producción · Montevideo, Uruguay
        </p>
      </div>

      <!-- Derecha: el isotipo GII se arma y desarma con partículas (canvas) -->
      <div class="hero-animate order-first lg:order-last" data-delay="3" style="position:relative;">
        <div class="hero-glow" style="position:absolute; inset:0; background:radial-gradient(ellipse at center, rgba(0,200,255,0.30) 0%, transparent 66%); z-index:0;" aria-hidden="true"></div>
        <div style="position:relative; z-index:1; width:100%; max-width:720px; aspect-ratio:1; margin:0 auto;">
          <canvas id="hero-logo" style="width:100%; height:100%; display:block;" aria-hidden="true"></canvas>
          <img src="/img/symbol-gii.png" alt="GENIDEIA Company" width="700" height="700" style="position:absolute; width:1px; height:1px; opacity:0; pointer-events:none;" />
        </div>
      </div>

    </div>
  </section>

  <!-- ── PORTFOLIO (integrado, no es un destino aparte) ─────── -->
  <section style="border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-10">
    <div class="max-w-6xl mx-auto px-6">
      <PortfolioStrip />
    </div>
  </section>

  <!-- ── PROBLEMAS QUE RESOLVEMOS ──────────────────────────── -->
  <Section
    id="problemas"
    border="both"
    kicker="Problemas que resolvemos"
    title="¿Con cuál de esto te encontrás en tu empresa?"
    maxWidth="max-w-6xl"
  >
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {PROBLEMAS.map((p) => <ProblemaCard problema={p} />)}
    </div>
    <p class="text-center mt-12 max-w-2xl mx-auto" style="color:#B8BEC7; font-weight:300;" data-reveal>
      No partimos de una herramienta. Partimos del problema y construimos el sistema alrededor de tu operación.
    </p>
  </Section>

  <!-- ── CÓMO TRABAJAMOS (condensado) ──────────────────────── -->
  <Section
    id="metodo"
    bg="soft"
    border="both"
    kicker="Cómo trabajamos"
    title="Diagnóstico, diseño, construcción, implementación y mejora."
    subtitle="No entregamos software suelto: una solución que tiene que funcionar dentro del proceso que ya existe en tu empresa."
  >
    <StepList pasos={PASOS_TRABAJO} />
    <p class="text-center mt-12" data-reveal>
      <a href="/como-trabajamos" style="color:#00C8FF; font-weight:400;" class="text-sm hover:opacity-70 transition-opacity">
        Ver el método completo →
      </a>
    </p>
  </Section>

  <!-- ── QUÉ NOS DIFERENCIA ─────────────────────────────────── -->
  <Section
    bg="soft"
    border="both"
    kicker="Qué nos diferencia"
    title="No empezamos por la tecnología. Empezamos por entender el proceso."
    maxWidth="max-w-4xl"
  >
    <div class="grid sm:grid-cols-2 gap-8 max-w-3xl mx-auto">
      <div data-reveal>
        <p style="color:rgba(160,160,160,0.5); font-size:0.65rem; letter-spacing:2px; font-weight:500;" class="uppercase mb-4">Lo que no hacemos</p>
        <ul class="space-y-3">
          {DIFERENCIALES.no.map((item) => (
            <li style="color:#B8BEC7; font-weight:300;" class="text-sm flex items-start gap-2.5">
              <span style="color:rgba(160,160,160,0.6); flex-shrink:0;">—</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div data-reveal data-delay="1">
        <p style="color:#00C8FF; font-size:0.65rem; letter-spacing:2px; font-weight:500;" class="uppercase mb-4">Cómo trabajamos</p>
        <ul class="space-y-3">
          {DIFERENCIALES.si.map((item) => (
            <li style="color:#B8BEC7; font-weight:300;" class="text-sm flex items-start gap-2.5">
              <span style="color:#00C8FF; flex-shrink:0;">→</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- ── VIDEO (VSL) ───────────────────────────────────────── -->
  <Section
    id="video"
    bg="soft"
    border="both"
    kicker="Antes de agendar"
    title="Un video corto sobre cómo pensamos esto"
    maxWidth="max-w-3xl"
  >
    <div class="video-main-wrap" data-video-wrap data-reveal>
      <video id="vid-home" controls playsinline preload="metadata" style="width:100%; height:100%; object-fit:contain; display:block; background:#0B1324;">
        <source src="/videos/andres-01-porque.mp4" type="video/mp4" />
        Tu navegador no soporta el video.
      </video>
      <button type="button" class="video-cover" data-video-cover aria-label="Reproducir video">
        <span class="play-btn"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
        <span class="cover-hint">Voy a ayudarte a ahorrar tiempo y dinero en tu empresa automatizando tareas manuales.</span>
      </button>
    </div>
  </Section>

  <!-- ── AGENDÁ TU AUDITORÍA (Calendly) ─────────────────────── -->
  <section id="agenda" class="py-24">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10" data-reveal>
        <p style="color:#00C8FF; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">El siguiente paso</p>
        <h2 style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);" class="mb-4">
          Agendá tu llamada de exploración.
        </h2>
        <p style="color:#B8BEC7; font-weight:300;" class="text-lg leading-relaxed">
          Analizamos dónde se pierde tiempo, dónde aparecen errores y qué partes tiene sentido automatizar.
        </p>
      </div>
      <div id="calendly-box" class="calendly-inline-widget" data-url={calendlyEmbed} style="min-width:320px; height:700px; border-radius:14px; overflow:hidden; border:1px solid rgba(0,200,255,0.2);" data-reveal></div>
      <p class="text-center mt-6 text-sm" style="color:#B8BEC7; font-weight:300;" data-reveal>
        ¿Preferís escribir? <a href={waUrl} target="_blank" rel="noopener noreferrer" style="color:#00C8FF; text-decoration:underline;">Hablemos por WhatsApp →</a>
      </p>
    </div>
  </section>

</BaseLayout>

<script src="https://assets.calendly.com/assets/external/widget.js" async is:inline></script>

<script define:vars={{ calendlyEmbed }}>
  function initCalendly() {
    const box = document.getElementById('calendly-box');
    if (box && window.Calendly && !box.dataset.ready) {
      box.dataset.ready = '1';
      box.innerHTML = '';
      window.Calendly.initInlineWidget({ url: calendlyEmbed, parentElement: box });
    }
  }
  window.addEventListener('load', () => setTimeout(initCalendly, 300));
</script>

<style>
  .video-main-wrap { position:relative; width:100%; aspect-ratio:16/9; border-radius:18px; overflow:hidden; border:1px solid rgba(0,200,255,0.25); background:#0B1324; box-shadow:0 12px 60px rgba(0,200,255,0.12); }
  .video-cover { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; cursor:pointer; border:none; padding:24px; background:linear-gradient(180deg, rgba(7,8,13,0.30) 0%, rgba(7,8,13,0.60) 100%); transition:opacity .3s; }
  .video-main-wrap.playing .video-cover { opacity:0; pointer-events:none; }
  .play-btn { width:76px; height:76px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#0A0F1A; background:linear-gradient(135deg,#00C8FF,#007BFF); box-shadow:0 0 0 0 rgba(0,200,255,0.5); animation:playPulse 2.2s ease-in-out infinite; flex-shrink:0; }
  @keyframes playPulse { 0%{ box-shadow:0 0 0 0 rgba(0,200,255,0.45);} 70%{ box-shadow:0 0 0 22px rgba(0,200,255,0);} 100%{ box-shadow:0 0 0 0 rgba(0,200,255,0);} }
  .cover-hint { font-family:'Montserrat',sans-serif; font-weight:600; font-size:1.05rem; line-height:1.35; color:#F2F4F7; text-align:center; text-shadow:0 2px 12px rgba(0,0,0,0.6); max-width:36ch; }
  @media (prefers-reduced-motion: reduce) { .play-btn { animation:none; } }
</style>

<script>
  // ── Scroll reveal ──────────────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

  // ── Video-cover (VSL) ────────────────────────────────────────
  document.querySelectorAll('[data-video-wrap]').forEach((wrap) => {
    const v = wrap.querySelector('video');
    const cover = wrap.querySelector('[data-video-cover]');
    if (!v || !cover) return;
    cover.addEventListener('click', () => { (v as HTMLVideoElement).play(); });
    v.addEventListener('play', () => wrap.classList.add('playing'));
  });
</script>

<style>
  @keyframes heroGlowPulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.08); }
  }
  .hero-glow { animation: heroGlowPulse 5s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    .hero-glow { animation: none; }
  }
</style>

<script>
  // El isotipo GII se ARMA y DESARMA: partículas que convergen en la silueta del logo
  // (muestreada de la imagen) y se dispersan — en loop infinito.
  (() => {
    const canvas = document.getElementById('hero-logo');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0, H = 0, DPR = 1;
    function resize() {
      const rect = canvas.getBoundingClientRect();
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * DPR);
      canvas.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize);

    const MAX = window.innerWidth < 640 ? 440 : 860;
    let pts = [];

    function buildTargets(img) {
      const S = 150;
      const off = document.createElement('canvas');
      off.width = S; off.height = S;
      const octx = off.getContext('2d');
      if (!octx) return;
      octx.drawImage(img, 0, 0, S, S);
      let data;
      try { data = octx.getImageData(0, 0, S, S).data; } catch (e) { return; }
      const raw = [];
      for (let y = 0; y < S; y += 2) {
        for (let x = 0; x < S; x += 2) {
          const i = (y * S + x) * 4;
          const a = data[i + 3];
          const bright = (data[i] + data[i + 1] + data[i + 2]) / 3;
          const nx = (x / S) * 2 - 1, ny = (y / S) * 2 - 1;
          if (nx * nx + ny * ny > 1) continue;          // recorte circular
          if (a > 40 && bright > 95) raw.push([nx, ny]); // sólo anillo + GII + glow
        }
      }
      const stride = Math.max(1, Math.floor(raw.length / MAX));
      pts = [];
      for (let i = 0; i < raw.length; i += stride) {
        pts.push({
          x: raw[i][0], y: raw[i][1],
          sx: (Math.random() * 2 - 1) * 1.9,
          sy: (Math.random() * 2 - 1) * 1.9,
          r: 0.95 + Math.random() * 1.3,
          a0: 0.5 + Math.random() * 0.45,
        });
      }
    }

    const T_A = 2400, T_H = 2000, T_D = 2000, T_H2 = 650;
    const CYCLE = T_A + T_H + T_D + T_H2;
    const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    function assembly(ms) {
      const t = ms % CYCLE;
      if (t < T_A) return ease(t / T_A);
      if (t < T_A + T_H) return 1;
      if (t < T_A + T_H + T_D) return 1 - ease((t - T_A - T_H) / T_D);
      return 0;
    }

    let started = 0;
    function frame(now) {
      if (!started) started = now;
      const a = reduced ? 1 : assembly(now - started);
      const R = Math.min(W, H) * 0.54;
      const cx = W / 2, cy = H / 2;
      ctx.clearRect(0, 0, W, H);
      for (const p of pts) {
        const X = p.sx + (p.x - p.sx) * a;
        const Y = p.sy + (p.y - p.sy) * a;
        ctx.fillStyle = 'rgba(130,215,255,' + (p.a0 * (0.3 + 0.7 * a)).toFixed(3) + ')';
        ctx.beginPath();
        ctx.arc(cx + X * R, cy + Y * R, p.r * (0.7 + 0.3 * a), 0, Math.PI * 2);
        ctx.fill();
      }
      requestAnimationFrame(frame);
    }

    const img = new Image();
    img.onload = () => { buildTargets(img); if (pts.length) requestAnimationFrame(frame); };
    img.src = '/img/symbol-gii.png';
  })();
</script>
