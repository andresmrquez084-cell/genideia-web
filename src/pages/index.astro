---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StepList from '../components/StepList.astro';
import { clientes, serviciosInfo } from '../data/clientes';

// Selector de servicios — la puerta de entrada a cada solución (home ya no explica todo, solo orienta).
const serviciosSelector = [
  {
    slug: 'contenido-marketing',
    nombre: serviciosInfo['contenido-marketing'].nombre,
    desc: 'Construimos una marca que las personas reconozcan y entiendan: identidad, contenido y posicionamiento.',
    beneficio: 'La categoría con más proyectos reales y evidencia comprobable hoy.',
    cta: 'Ver contenido y marketing',
  },
  {
    slug: 'anuncios',
    nombre: serviciosInfo.anuncios.nombre,
    desc: 'Llegá a personas que ya pueden estar buscando una solución como la tuya.',
    beneficio: 'Campañas con método, no solo "hacer anuncios".',
    cta: 'Ver anuncios',
  },
  {
    slug: 'presencia-digital',
    nombre: serviciosInfo['presencia-digital'].nombre,
    desc: 'Reuní tu página web, perfiles y canales de contacto en una presencia profesional.',
    beneficio: 'Todo conectado. Una sola presencia digital.',
    cta: 'Ver presencia digital',
  },
  {
    slug: 'automatizaciones',
    nombre: serviciosInfo.automatizaciones.nombre,
    desc: 'Reducí tareas manuales y ordená procesos que hoy dependen de personas, mensajes o memoria.',
    beneficio: 'Sistemas con IA ya funcionando, no promesas abstractas.',
    cta: 'Ver automatizaciones',
  },
] as const;

// Método unificado — antes existían dos bloques de "3 pasos" casi idénticos en esta misma página.
const pasos = [
  {
    num: '01',
    nombre: 'Diagnóstico',
    desc: 'Analizamos la posición actual de tu empresa y detectamos las oportunidades: qué procesos automatizar, qué resolver con IA y dónde escalar con publicidad. Salís con un diagnóstico claro. Es gratuito.',
  },
  {
    num: '02',
    nombre: 'Construcción',
    desc: 'Trazamos el camino hacia donde querés llegar y lo ejecutamos con procedimientos concretos: implementamos los sistemas, soluciones o campañas que tu negocio necesita. De punta a punta, lo armamos nosotros.',
  },
  {
    num: '03',
    nombre: 'Seguimiento',
    desc: 'Medimos las estadísticas en cada etapa para confirmar que vamos por el camino correcto. Si los números no acompañan, ajustamos. No te dejamos solo después de entregar.',
  },
];

// Micro-indicadores del hero
const indicadores = ['Estrategia inteligente', 'Automatización operativa', 'IA a medida', 'Resultados medibles'];
---

<BaseLayout
  title="GENIDEIA Company — Automatización, marketing y ads para PyMEs"
  description="Presentamos tu negocio, conseguimos oportunidades y automatizamos procesos con IA aplicada. Contenido y marketing, anuncios, presencia digital y automatizaciones para PyMEs de Uruguay."
  path="/"
>

  <!-- ── HERO ───────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-6 pt-24 pb-16" style="position:relative; overflow:hidden;">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">

      <!-- Izquierda: texto -->
      <div style="position:relative; z-index:2;">
        <p class="hero-animate text-xs font-medium mb-6 uppercase" data-delay="1" style="color:#00C8FF; letter-spacing:3px;">
          Marketing · Ads · Automatización · IA
        </p>
        <h1 class="hero-animate mb-6" data-delay="2" style="font-family:'Montserrat',sans-serif; font-weight:700; line-height:1.0; letter-spacing:-1.5px; font-size:clamp(2.6rem, 6vw, 4.6rem);">
          Tu negocio, un sistema que crece<br />
          <span style="color:#B8BEC7; font-weight:300; font-style:italic;">sin depender de vos.</span>
        </h1>
        <p class="hero-animate mb-9 leading-relaxed max-w-lg text-lg" data-delay="3" style="color:#B8BEC7; font-weight:300;">
          Ayudamos a tu empresa a presentarse profesionalmente, conseguir oportunidades y ordenar sus procesos con tecnología aplicada — no genérica.
        </p>
        <div class="hero-animate flex flex-col sm:flex-row gap-4 mb-8" data-delay="4">
          <a href="https://wa.me/59892302941" target="_blank" rel="noopener noreferrer" style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600;" class="px-8 py-3.5 rounded-lg hover:opacity-90 transition-opacity text-center">
            Hablemos por WhatsApp
          </a>
          <a href="#diagnostico" style="border:1px solid rgba(255,255,255,0.12); color:#B8BEC7;" class="px-8 py-3.5 rounded-lg hover:border-[#00C8FF] hover:text-[#00C8FF] transition-colors text-center">
            Diagnóstico gratis →
          </a>
        </div>
        <div class="hero-animate flex flex-wrap gap-x-5 gap-y-2 mb-6" data-delay="5" style="font-family:'Inter',sans-serif;">
          {indicadores.map((m) => (
            <span class="flex items-center gap-2" style="color:#B8BEC7; font-size:0.78rem; font-weight:400;">
              <span style="width:6px; height:6px; border-radius:9999px; background:#00C8FF; box-shadow:0 0 8px rgba(0,200,255,0.6); flex-shrink:0; display:inline-block;"></span>
              {m}
            </span>
          ))}
        </div>
        <p class="hero-animate text-sm" data-delay="5" style="color:rgba(160,160,160,0.45); font-weight:300; letter-spacing:0.5px;">
          7 proyectos en producción · Montevideo, Uruguay
        </p>
      </div>

      <!-- Derecha: el isotipo GII se arma y desarma con partículas (canvas) -->
      <div class="hero-animate order-first lg:order-last" data-delay="3" style="position:relative;">
        <div class="hero-glow" style="position:absolute; inset:0; background:radial-gradient(ellipse at center, rgba(0,200,255,0.30) 0%, transparent 66%); z-index:0;" aria-hidden="true"></div>
        <div style="position:relative; z-index:1; width:100%; max-width:720px; aspect-ratio:1; margin:0 auto;">
          <canvas id="hero-logo" style="width:100%; height:100%; display:block;" aria-hidden="true"></canvas>
          <img src="/img/symbol-gii.png" alt="GENIDEIA Company" width="700" height="700" style="position:absolute; width:1px; height:1px; opacity:0; pointer-events:none;" />
        </div>
      </div>

    </div>
  </section>

  <!-- ── LOGOS / CLIENTES REALES (compacto, el detalle vive en /casos) ── -->
  <section style="border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-10">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-center mb-8" style="color:rgba(160,160,160,0.5); font-size:0.65rem; letter-spacing:3px; font-weight:500;" data-reveal>
        NEGOCIOS REALES · SISTEMAS REALES · RESULTADOS REALES
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6" data-reveal data-delay="1">
        {clientes.map((c) => (
          <a href={c.url} target="_blank" rel="noopener noreferrer" class="text-center" style="opacity:0.65;">
            <span style="font-family:'Montserrat',sans-serif; font-size:1.25rem; font-weight:600; color:#F2F4F7; letter-spacing:0.5px; display:block; line-height:1.1;">{c.nombre}</span>
            <span style="color:#B8BEC7; font-size:0.58rem; letter-spacing:1.5px; font-weight:400;" class="uppercase">{c.rubro}</span>
          </a>
        ))}
      </div>
      <p class="text-center mt-8" data-reveal>
        <a href="/casos" style="color:#00C8FF; font-weight:400;" class="text-sm hover:opacity-70 transition-opacity">Ver todos los casos →</a>
      </p>
    </div>
  </section>

  <!-- ── PILAR: CERO DEMOS ─────────────────────────────────── -->
  <section style="background:linear-gradient(135deg, rgba(0,200,255,0.08), rgba(0,123,255,0.05));" class="py-14">
    <div class="max-w-5xl mx-auto px-6 text-center" data-reveal>
      <h2 style="font-family:'Montserrat',sans-serif; font-weight:800; letter-spacing:-0.5px; font-size:clamp(1.8rem, 4.5vw, 2.8rem);" class="mb-3">
        Cero demos. <span style="color:#00C8FF;">100% producción.</span>
      </h2>
      <p style="color:#B8BEC7; font-weight:300;" class="text-lg max-w-2xl mx-auto leading-relaxed">
        No entregamos pruebas de concepto: implementamos sistemas listos para operar y facturar desde el primer día.
      </p>
    </div>
  </section>

  <!-- ── SELECTOR DE SERVICIOS ─────────────────────────────── -->
  <Section
    id="servicios"
    kicker="Qué hacemos"
    title="¿Qué necesitás mejorar?"
    subtitle="Elegí el área que te interesa y profundizá solo en eso — sin tener que leer todo lo demás."
    maxWidth="max-w-6xl"
  >
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {serviciosSelector.map((s, i) => (
        <div data-delay={String(i + 1)}>
          <ServiceCard
            nombre={s.nombre}
            desc={s.desc}
            beneficio={s.beneficio}
            href={serviciosInfo[s.slug].ruta}
            color={serviciosInfo[s.slug].color}
            cta={s.cta}
          />
        </div>
      ))}
    </div>
  </Section>

  <!-- ── MÉTODO (único, sin duplicar) ──────────────────────── -->
  <Section
    id="metodo"
    bg="soft"
    border="both"
    kicker="Cómo lo hacemos"
    title="Diagnóstico, construcción y seguimiento."
    subtitle="Sabemos en qué posición está hoy tu empresa, trazamos el camino hacia donde querés llegar y medimos en cada etapa para confirmar que vamos por el rumbo correcto."
  >
    <StepList pasos={pasos} />
    <p class="text-center mt-12" data-reveal>
      <a href="#diagnostico" style="color:#00C8FF; font-weight:400;" class="text-sm hover:opacity-70 transition-opacity">
        Empecemos por el diagnóstico gratis →
      </a>
    </p>
  </Section>

  <!-- ── DIAGNÓSTICO ──────────────────────────────────────── -->
  <section id="diagnostico" class="py-24">
    <div class="max-w-2xl mx-auto px-6">
      <div class="text-center mb-12" data-reveal>
        <h2
          style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
          class="mb-4"
        >
          ¿Cuál es el desafío de tu negocio?
        </h2>
        <p style="color:#B8BEC7; font-weight:300;" class="text-lg leading-relaxed">
          Describilo en tus palabras. En base a eso te presentamos cómo podemos ayudarte
          — y si no existe la solución, la construimos.
        </p>
      </div>

      <form id="diagnostico-form" class="space-y-5" data-reveal>
        <!-- Área -->
        <div>
          <label style="color:#B8BEC7; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">
            Área del problema
          </label>
          <select name="area" id="diagnostico-area" required class="form-input">
            <option value="">Seleccioná una categoría</option>
            <option value="Contenido y marketing digital">Contenido y marketing digital</option>
            <option value="Anuncios / publicidad">Anuncios / publicidad</option>
            <option value="Presencia digital (web, perfiles, WhatsApp)">Presencia digital (web, perfiles, WhatsApp)</option>
            <option value="Automatización y procesos internos">Automatización y procesos internos</option>
            <option value="Otro / No sé cómo clasificarlo">Otro / No sé cómo clasificarlo</option>
          </select>
        </div>

        <!-- Problema -->
        <div>
          <label style="color:#B8BEC7; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">
            Describí el problema
          </label>
          <textarea
            name="problema"
            rows="5"
            required
            placeholder="¿Qué está pasando en tu negocio? ¿Qué te gustaría resolver o mejorar?"
            class="form-input resize-none"
          ></textarea>
        </div>

        <!-- Nombre -->
        <div>
          <label style="color:#B8BEC7; font-size:0.8rem; font-weight:400; letter-spacing:0.5px;" class="block mb-2 uppercase">
            Tu nombre <span style="color:rgba(160,160,160,0.4);">(opcional)</span>
          </label>
          <input
            name="nombre"
            type="text"
            placeholder="Para personalizar la respuesta"
            class="form-input"
          />
        </div>

        <!-- Submit -->
        <button
          type="submit"
          style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600; width:100%;"
          class="py-3.5 rounded-lg hover:opacity-90 transition-opacity text-base"
        >
          Analizar mi caso →
        </button>
        <p style="color:rgba(160,160,160,0.35); font-weight:300;" class="text-xs text-center">
          Se abre WhatsApp con tu mensaje ya armado · Respondemos en menos de 24 horas
        </p>
      </form>

      <!-- Success state -->
      <div id="diagnostico-success" class="hidden text-center py-8" data-reveal>
        <p style="color:#00C8FF; font-size:1.5rem; margin-bottom:1rem;">✓</p>
        <p style="color:#F2F4F7; font-weight:500;" class="text-lg mb-2">¡Perfecto!</p>
        <p style="color:#B8BEC7; font-weight:300;">
          Se abrió WhatsApp con tu mensaje. En menos de 24 horas te respondemos con una propuesta.
        </p>
      </div>
    </div>
  </section>

  <!-- ── CTA FINAL ─────────────────────────────────────────── -->
  <section id="contactar" class="max-w-3xl mx-auto px-6 py-28 text-center" data-reveal>
    <h2
      style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.5rem);"
      class="mb-5"
    >
      ¿Dónde está tu negocio hoy?
    </h2>
    <p style="color:#B8BEC7; font-weight:300;" class="text-lg mb-10 leading-relaxed">
      Contanos en qué punto estás y definimos juntos el siguiente paso.
    </p>
    <a
      href="https://wa.me/59892302941"
      target="_blank"
      rel="noopener noreferrer"
      style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600;"
      class="px-10 py-4 rounded-lg hover:opacity-90 transition-opacity inline-block text-base"
    >
      Hablar por WhatsApp
    </a>
    <p style="color:rgba(160,160,160,0.35); font-weight:300;" class="text-sm mt-5">
      Respondemos en menos de 24 horas
    </p>
  </section>

</BaseLayout>

<script>
  // ── Scroll reveal ──────────────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

  // ── Preselección de servicio vía ?servicio=slug (viene de una página de servicio) ──
  const AREA_POR_SERVICIO: Record<string, string> = {
    'contenido-marketing': 'Contenido y marketing digital',
    anuncios: 'Anuncios / publicidad',
    'presencia-digital': 'Presencia digital (web, perfiles, WhatsApp)',
    automatizaciones: 'Automatización y procesos internos',
  };
  const params = new URLSearchParams(window.location.search);
  const servicioParam = params.get('servicio');
  const areaSelect = document.getElementById('diagnostico-area') as HTMLSelectElement | null;
  if (servicioParam && areaSelect && AREA_POR_SERVICIO[servicioParam]) {
    areaSelect.value = AREA_POR_SERVICIO[servicioParam];
  }

  // ── Diagnóstico form ───────────────────────────────────────
  const form = document.getElementById('diagnostico-form') as HTMLFormElement | null;
  const successDiv = document.getElementById('diagnostico-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const area     = (data.get('area')     as string) || '';
    const problema = (data.get('problema') as string) || '';
    const nombre   = (data.get('nombre')   as string) || '';

    const nombreTexto = nombre ? `Hola, soy ${nombre}.` : 'Hola,';
    const areaTexto   = area   ? `\n\n*Área:* ${area}` : '';
    const msg = `${nombreTexto} me gustaría un diagnóstico para mi negocio.${areaTexto}\n\n*Problema:*\n${problema}`;
    const waUrl = `https://wa.me/59892302941?text=${encodeURIComponent(msg)}`;
    window.open(waUrl, '_blank');

    form.classList.add('hidden');
    if (successDiv) {
      successDiv.classList.remove('hidden');
      successDiv.classList.add('is-visible');
    }
  });
</script>

<style>
  @keyframes heroGlowPulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.08); }
  }
  .hero-glow { animation: heroGlowPulse 5s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    .hero-glow { animation: none; }
  }
</style>

<script>
  // El isotipo GII se ARMA y DESARMA: partículas que convergen en la silueta del logo
  // (muestreada de la imagen) y se dispersan — en loop infinito.
  (() => {
    const canvas = document.getElementById('hero-logo');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0, H = 0, DPR = 1;
    function resize() {
      const rect = canvas.getBoundingClientRect();
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * DPR);
      canvas.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize);

    const MAX = window.innerWidth < 640 ? 440 : 860;
    let pts = [];

    function buildTargets(img) {
      const S = 150;
      const off = document.createElement('canvas');
      off.width = S; off.height = S;
      const octx = off.getContext('2d');
      if (!octx) return;
      octx.drawImage(img, 0, 0, S, S);
      let data;
      try { data = octx.getImageData(0, 0, S, S).data; } catch (e) { return; }
      const raw = [];
      for (let y = 0; y < S; y += 2) {
        for (let x = 0; x < S; x += 2) {
          const i = (y * S + x) * 4;
          const a = data[i + 3];
          const bright = (data[i] + data[i + 1] + data[i + 2]) / 3;
          const nx = (x / S) * 2 - 1, ny = (y / S) * 2 - 1;
          if (nx * nx + ny * ny > 1) continue;          // recorte circular
          if (a > 40 && bright > 95) raw.push([nx, ny]); // sólo anillo + GII + glow
        }
      }
      const stride = Math.max(1, Math.floor(raw.length / MAX));
      pts = [];
      for (let i = 0; i < raw.length; i += stride) {
        pts.push({
          x: raw[i][0], y: raw[i][1],
          sx: (Math.random() * 2 - 1) * 1.9,
          sy: (Math.random() * 2 - 1) * 1.9,
          r: 0.95 + Math.random() * 1.3,
          a0: 0.5 + Math.random() * 0.45,
        });
      }
    }

    const T_A = 2400, T_H = 2000, T_D = 2000, T_H2 = 650;
    const CYCLE = T_A + T_H + T_D + T_H2;
    const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    function assembly(ms) {
      const t = ms % CYCLE;
      if (t < T_A) return ease(t / T_A);
      if (t < T_A + T_H) return 1;
      if (t < T_A + T_H + T_D) return 1 - ease((t - T_A - T_H) / T_D);
      return 0;
    }

    let started = 0;
    function frame(now) {
      if (!started) started = now;
      const a = reduced ? 1 : assembly(now - started);
      const R = Math.min(W, H) * 0.54;
      const cx = W / 2, cy = H / 2;
      ctx.clearRect(0, 0, W, H);
      for (const p of pts) {
        const X = p.sx + (p.x - p.sx) * a;
        const Y = p.sy + (p.y - p.sy) * a;
        ctx.fillStyle = 'rgba(130,215,255,' + (p.a0 * (0.3 + 0.7 * a)).toFixed(3) + ')';
        ctx.beginPath();
        ctx.arc(cx + X * R, cy + Y * R, p.r * (0.7 + 0.3 * a), 0, Math.PI * 2);
        ctx.fill();
      }
      requestAnimationFrame(frame);
    }

    const img = new Image();
    img.onload = () => { buildTargets(img); if (pts.length) requestAnimationFrame(frame); };
    img.src = '/img/symbol-gii.png';
  })();
</script>
