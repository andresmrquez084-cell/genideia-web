---
import BaseLayout from '../layouts/BaseLayout.astro';

// Home = presentación breve + 3 tarjetas que llevan DIRECTO a la página real
// correspondiente (nada de contenido copiado/recreado acá — pedido explícito
// de Andrés, 17/09). Mismos 3 destinos que Nav.astro.
const destinos = [
  {
    eyebrow: 'Quiénes somos',
    titulo: 'Nosotros',
    desc: 'Cómo pensamos GENIDEIA, quién está detrás y qué nos diferencia.',
    href: '/nosotros',
    cta: 'Conocer al equipo',
  },
  {
    eyebrow: 'El siguiente paso',
    titulo: 'Agendá tu diagnóstico',
    desc: 'Mirá el video, los ejemplos por rubro, y coordiná tu diagnóstico con Andrés.',
    href: 'https://andres.genideiacompany.com/empresa',
    cta: 'Ver el video y agendar',
  },
  {
    eyebrow: 'Lo que ya construimos',
    titulo: 'Nuestra experiencia',
    desc: 'Sistemas reales, diagnósticos y proyectos — el portfolio completo.',
    href: 'https://genideiacompany.com/experiencia/',
    cta: 'Ver el portfolio',
  },
];
---

<BaseLayout
  title="GENIDEIA Company — Sistemas y automatización para empresas"
  description="Diseñamos automatizaciones y sistemas a medida para reducir tareas manuales, ordenar procesos y mejorar el seguimiento operativo de tu empresa."
  path="/"
>

  <!-- ── INTRO BREVE ────────────────────────────────────────── -->
  <section class="max-w-3xl mx-auto px-6 pt-24 pb-14 text-center">
    <p class="hero-animate text-xs font-medium mb-5 uppercase" data-delay="1" style="color:#00C8FF; letter-spacing:3px;">
      Automatización · Sistemas · Procesos
    </p>
    <h1 class="hero-animate mb-5" data-delay="2" style="font-family:'Montserrat',sans-serif; font-weight:700; line-height:1.05; letter-spacing:-1.3px; font-size:clamp(2.3rem, 5.2vw, 3.6rem);">
      Convertimos procesos <span style="color:#B8BEC7; font-weight:300; font-style:italic;">en sistemas.</span>
    </h1>
    <p class="hero-animate mx-auto leading-relaxed max-w-xl text-lg" data-delay="3" style="color:#B8BEC7; font-weight:300;">
      Diseñamos automatizaciones y soluciones a medida para reducir tareas manuales, ordenar operaciones y mejorar el seguimiento dentro de tu empresa.
    </p>
  </section>

  <!-- ── 3 DESTINOS ─────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 pb-24">
    <div class="grid sm:grid-cols-3 gap-6">
      {destinos.map((d, i) => (
        <a
          href={d.href}
          target={d.href.startsWith('http') ? '_blank' : undefined}
          rel={d.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="card-hover rounded-xl p-7 flex flex-col"
          style="background:#111111; border:1px solid rgba(255,255,255,0.07); border-top:2px solid #00C8FF;"
          data-reveal
          data-delay={String(i + 1)}
        >
          <p style="color:#00C8FF; font-size:0.65rem; letter-spacing:2px; font-weight:500;" class="uppercase mb-3">{d.eyebrow}</p>
          <h2 style="font-family:'Montserrat',sans-serif; font-weight:700; color:#F2F4F7; font-size:1.4rem;" class="mb-3">
            {d.titulo}
          </h2>
          <p style="color:#B8BEC7; font-weight:300;" class="text-sm leading-relaxed mb-6 flex-1">
            {d.desc}
          </p>
          <span style="color:#00C8FF; font-weight:500;" class="text-sm">
            {d.cta} →
          </span>
        </a>
      ))}
    </div>
  </section>

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
