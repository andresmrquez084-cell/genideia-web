import RecursoLayout from '../../layouts/RecursoLayout.astro';

const grupo = 'https://chat.whatsapp.com/CWcuWdngHQ1FcrkQijYK1A?mode=gi_t';

const diagnostico = `Quiero bajar cuánto de mi límite de Claude gasto sin necesidad. Hacé una auditoría de este proyecto y de mi forma de trabajar.
Revisá: mi CLAUDE.md (cuántas líneas tiene y qué parte solo sirve para tareas puntuales), las skills que tengo, los servidores MCP conectados y los subagentes.
Buscá estas fugas: instrucciones que repito en cada conversación, reglas del CLAUDE.md que deberían ser una skill, tareas con mucha salida (tests, logs, documentación) que hago en la conversación principal y MCP que no uso.
Resultado: una tabla con cada fuga, dónde está, cuánto pesa (alto, medio o bajo) y la corrección concreta. Ordenala de mayor a menor impacto.
No cambies nada todavía: primero mostrame la tabla.`;

const convertirSkill = `Hay una tarea que te explico siempre igual: [DESCRIBÍ LA TAREA, POR EJEMPLO: ANALIZAR UN DOCUMENTO Y SACAR RESUMEN, RIESGOS Y PRÓXIMOS PASOS].
Convertila en una skill para que no tenga que explicártela de nuevo.
Creá la carpeta ~/.claude/skills/[nombre-de-la-skill]/ con un SKILL.md que tenga: un frontmatter con name y una description que diga cuándo usarla, y abajo los pasos exactos, el formato del resultado y los errores que no tenés que cometer.
Antes de guardarla, preguntame lo que te falte saber del proceso.`;

const skillEjemplo = `---
name: analizar-docs
description: Analiza un documento y devuelve resumen, riesgos y próximos pasos. Usala cuando te pase un contrato, propuesta o informe para revisar.
---
1. Resumen en 5 líneas, sin adjetivos.
2. Riesgos: plazos, montos y cláusulas que me comprometen.
3. Próximos pasos: qué tengo que hacer yo y para cuándo.
Formato: tres títulos cortos y listas. Si falta un dato, escribí FALTA en vez de inventarlo.`;

const subagente = `---
name: investigador
description: Lee documentación, logs o resultados de tests largos y devuelve solo un resumen con lo importante. Usalo para cualquier tarea que genere mucha salida.
model: haiku
---
Sos el INVESTIGADOR del proyecto.
Función: leer todo lo que te pidan (documentación, logs, salida de tests) sin llenar la conversación principal.
Resultado: un resumen de máximo 10 líneas con lo que importa para la tarea, los errores exactos si los hay y dónde están (archivo y línea).
No propongas cambios de código: solo informá.`;

const revision = `## Antes de dar una tarea por terminada
- Releé lo que te pedí y marcá cada punto como cumplido o no.
- Si hay tests, correlos. Si hay una web, abrila y probala.
- Buscá los errores que ya te corregí antes en este proyecto y confirmá que no se repiten.
- Recién ahí decime que terminaste, con la lista de lo que verificaste.`;

const revisor = `---
name: revisor
description: Revisa un cambio antes de darlo por terminado. Usalo siempre al final de una tarea, antes de avisarme que está listo.
---
Sos el REVISOR.
Función: encontrar lo que está mal antes de que yo lo vea.
Analizá: si el cambio cumple lo que se pidió, si rompe algo que ya andaba y si repite errores ya corregidos.
Criterios: probá, no supongas. Cada problema con archivo, línea y cómo reproducirlo.
Resultado: APROBADO o una lista de problemas ordenada por gravedad.`;
