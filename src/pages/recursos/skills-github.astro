cd ~/.claude/skills/agent-caption
python setup.py   # una sola vez: crea el entorno y baja el modelo (~4 GB)

# Claude Code la detecta sola. Reiniciá la sesión.`;

const audioSkillMd = `---
name: audio-transcribe
description: Transcribe audios y notas de voz (ogg, opus, mp3, m4a, wav, mp4) a texto de forma local con faster-whisper, sin API key. Usar cuando el usuario pase un audio y pida "transcribilo", "pasalo a texto", "qué dice este audio".
---

# Audio Transcription Skill
Transcripción local con faster-whisper (sin API key, sin costo).

## Uso
python3 ~/.claude/skills/audio-transcribe/scripts/transcribe.py /ruta/al/audio.ogg`;

const audioScript = `#!/usr/bin/env python3
import argparse, sys
from faster_whisper import WhisperModel

parser = argparse.ArgumentParser()
parser.add_argument("audio")
parser.add_argument("--model", default="small")
parser.add_argument("--lang", default=None)
args = parser.parse_args()

model = WhisperModel(args.model, device="cpu", compute_type="int8")
segments, info = model.transcribe(args.audio, language=args.lang, vad_filter=True)
print(f"[idioma: {info.language} ({info.language_probability:.0%})]", file=sys.stderr)
print(" ".join(s.text.strip() for s in segments))`;
