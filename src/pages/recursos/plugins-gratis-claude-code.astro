// OJO: la palabra PLUGINS ya apuntaba a /recursos/plugins-claude-code (reel del 28/9). Hay que repuntarla en ManyChat.
import RecursoLayout from '../../layouts/RecursoLayout.astro';

const grupo = 'https://chat.whatsapp.com/CWcuWdngHQ1FcrkQijYK1A?mode=gi_t';

const plugins = [
