import RecursoLayout from '../../layouts/RecursoLayout.astro';

const grupo = 'https://chat.whatsapp.com/CWcuWdngHQ1FcrkQijYK1A?mode=gi_t';

const instalar = `Quiero que me instales dos archivos para ahorrar límite usando Haiku en las tareas simples.
1) Creá ~/.claude/agents/rapido.md con exactamente este contenido:
[PEGÁ ACÁ EL ARCHIVO 1]
2) Creá ~/.claude/skills/clasificar-tarea/SKILL.md con exactamente este contenido:
[PEGÁ ACÁ EL ARCHIVO 2]
3) Agregá esta línea al final de ~/.claude/CLAUDE.md (si no existe, crealo): "Al empezar cada tarea, usá la skill clasificar-tarea."
Cuando termines, mostrame los 3 archivos y no cambies nada más.`;

const agente = `---
name: rapido
description: Tareas simples y bien definidas, como buscar archivos, renombrarlos, leer logs o hacer cambios pequeños. Usalo de forma proactiva para todo lo rutinario.
model: haiku
tools: Read, Grep, Glob, Edit, Write, Bash
---

Sos el ayudante rápido. Hacés tareas chicas y bien definidas, sin rediseñar nada.

- Hacé exactamente lo que te pidieron, nada más.
- No cambies la estructura del proyecto ni toques archivos que no te nombraron.
- Si la tarea resulta más compleja de lo que parecía (hay que elegir un enfoque, tocar muchos archivos o no encontrás la causa de un error), frená y respondé: "ESCALAR A OPUS: <motivo en una línea>".
- Al terminar, devolvé un resumen corto: qué hiciste, qué archivos tocaste y cualquier cosa rara que viste.`;

const skill = `---
name: clasificar-tarea
description: Usala al empezar cualquier tarea en Claude Code. Clasifica la tarea en SIMPLE o PESADA y deriva las simples al sub-agente rapido (Haiku 5.5) para no gastar límite del modelo pesado.
---

# Clasificar antes de hacer

1. Leé el pedido y clasificalo:
   - SIMPLE: buscar archivos o texto, listar, renombrar o mover archivos, leer un log y resumir el error, cambios pequeños y ya definidos (un texto, un valor, una línea), correr un comando y contar qué pasó.
   - PESADA: diseñar o cambiar cómo está armado un proyecto, errores que no se sabe de dónde vienen, cambios en muchos archivos, decisiones que piden criterio, y cualquier cosa con pagos, seguridad o datos de clientes.
   - Si dudás, es PESADA.
2. Avisá en una línea: "SIMPLE → Haiku" o "PESADA → Opus", y por qué.
3. Si es SIMPLE: delegala al sub-agente rapido con un pedido completo y corto (qué hacer, en qué archivos y qué devolver). No le pases toda la conversación.
4. Si es PESADA: hacela vos.
5. Si mezcla las dos: separala. Lo simple va a rapido y lo pesado lo hacés vos.
6. Si rapido responde "ESCALAR A OPUS", seguí vos con esa parte.
7. Cuando rapido termine, revisá su resultado en una línea antes de seguir.`;

const probar = `Buscá en este proyecto todos los archivos que mencionan "precio" y decime en qué línea está cada uno.`;

const tareas = [
  { tarea: 'Buscar archivos o una palabra en el proyecto', modelo: 'Haiku' },
  { tarea: 'Renombrar o mover archivos', modelo: 'Haiku' },
  { tarea: 'Leer un log y decirte cuál es el error', modelo: 'Haiku' },
  { tarea: 'Cambiar un texto, un color o un valor', modelo: 'Haiku' },
  { tarea: 'Corregir un error que no sabés de dónde viene', modelo: 'Opus' },
  { tarea: 'Diseñar una función nueva o cómo se arma el proyecto', modelo: 'Opus' },
  { tarea: 'Cambios en muchos archivos a la vez', modelo: 'Opus' },
  { tarea: 'Pagos, seguridad o datos de clientes', modelo: 'Opus' },
];
---
<RecursoLayout
  titulo="La Skill que reparte tus tareas entre Haiku y Opus"
