<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>GENIDEIA Content OS</title>
  <meta name="theme-color" content="#020714"/>
  <link rel="stylesheet" href="/content-os-v4-1.css"/>
  <link rel="stylesheet" href="/content-os-v4-2.css"/>
  <link rel="stylesheet" href="/content-os-v4-3.css"/>
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand-lockup">
        <img src="/img/logo-nav.png" class="brand-mark" alt="GENIDEIA"/>
        <div>
          <div class="brand-name">GENIDEIA</div>
          <div class="brand-sub">COMPANY</div>
        </div>
      </div>
      <nav class="nav" id="nav"></nav>
      <div class="sidebar-bottom">
        <img src="/img/symbol-gii.png" class="sidebar-logo" alt=""/>
        <div class="tagline">Sistemas que transforman ideas en <span>crecimiento.</span></div>
        <div class="micro">INNOVACIÓN · IMPACTO</div>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div class="title-block">
          <div class="eyebrow">GENIDEIA COMPANY</div>
          <h1>CONTENT OS</h1>
          <p>Tu sistema de aprendizaje para crear, medir y replicar contenido.</p>
        </div>
        <div class="top-actions">
          <div class="workspace-switch" id="workspaceSwitch">
            <button class="workspace-btn" id="workspaceBtn" aria-expanded="false">
              <span class="workspace-main"><span class="workspace-dot"></span><span class="workspace-copy"><strong id="workspaceName">Andrés</strong><small id="workspaceType">Marca personal</small></span></span>
              <span class="workspace-chevron">⌄</span>
            </button>
            <div class="workspace-menu hidden" id="workspaceMenu"></div>
          </div>
          <div class="search-wrap"><span>⌕</span><input id="globalSearch" placeholder="Buscar contenido, tema o métrica..."/></div>
          <button class="btn secondary" id="syncBtn">↻ Sincronizar</button>
          <button class="icon-btn" title="Notificaciones">◔<span class="badge">3</span></button>
          <div class="profile"><div class="avatar">AM</div><div><strong>Andrés</strong><small>Admin</small></div></div>
        </div>
      </header>

      <section id="page" class="page"></section>
    </main>
  </div>

  <div id="toast" class="toast"></div>
  <div id="modalRoot"></div>
  <script is:inline src="/content-os-v4-1.js"></script>
  <script is:inline src="/content-os-v4-2.js"></script>
  <script is:inline src="/content-os-intelligence-v1.js"></script>
  <script is:inline src="/content-os-v4-pages-1.js"></script>
  <script is:inline src="/content-os-v4-pages-2.js"></script>
  <script is:inline src="/content-os-v4-pages-3.js"></script>
  <script is:inline src="/content-os-v4-pages-4.js"></script>
  <script is:inline src="/content-os-v4-pages-5.js"></script>
  <script is:inline src="/content-os-v4-4.js"></script>
  <script is:inline src="/content-os-v4-5.js"></script>
  <script is:inline src="/content-os-stories-v1.js"></script>
  <script is:inline src="/content-os-live-data.js"></script>
</body>
</html>
