---
const title = 'GENIDEIA Content OS';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#04101d" />
  <title>{title}</title>
  <style is:global>
    :root{--bg:#030b14;--bg2:#071322;--card:#071624;--card2:#091b2c;--line:#153552;--line2:#1a4f78;--text:#f3f8ff;--muted:#7f97b1;--blue:#16bdf7;--blue2:#0c82df;--green:#56e18d;--amber:#ffc86a;--red:#ff7285;--radius:16px;--shadow:0 18px 55px rgba(0,0,0,.26)}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:radial-gradient(circle at 78% -5%,rgba(22,189,247,.09),transparent 27%),linear-gradient(180deg,#04101d 0,#020810 100%);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select{font:inherit}.app{min-height:100vh;display:grid;grid-template-columns:236px minmax(0,1fr)}
    aside{position:sticky;top:0;height:100vh;border-right:1px solid #12324b;background:linear-gradient(180deg,rgba(6,20,34,.98),rgba(3,12,21,.98));padding:20px 14px;display:flex;flex-direction:column;z-index:10}.brand{display:flex;align-items:center;gap:10px;padding:4px 7px 22px}.mark{width:38px;height:38px;border:1px solid #27b8ee;border-radius:50%;display:grid;place-items:center;color:#8de6ff;font-weight:800;box-shadow:0 0 22px rgba(22,189,247,.16),inset 0 0 16px rgba(22,189,247,.08)}.brand strong{display:block;font-size:12px;letter-spacing:.13em}.brand small{display:block;margin-top:2px;color:#4fcffa;font-size:8px;letter-spacing:.17em}.nav-group{margin-bottom:11px}.nav-label{padding:0 10px 7px;color:#48647e;font-size:8px;text-transform:uppercase;letter-spacing:.16em}.nav-btn{width:100%;border:1px solid transparent;background:transparent;color:#8ea4ba;border-radius:11px;padding:10px 11px;display:flex;align-items:center;gap:10px;cursor:pointer;text-align:left;font-size:11px;margin-bottom:3px}.nav-btn:hover{color:#d9edff;background:#081a2a}.nav-btn.active{color:#dff7ff;background:linear-gradient(90deg,rgba(13,134,211,.19),rgba(13,134,211,.06));border-color:#15517b;box-shadow:inset 3px 0 #19c3fa}.nav-icon{width:20px;text-align:center;color:#49cffa}.sidebar-foot{margin-top:auto;border:1px solid #113550;border-radius:14px;padding:12px;background:radial-gradient(circle at 20% 10%,rgba(22,189,247,.1),transparent 50%),#06131f}.sidebar-foot strong{font-size:10px}.sidebar-foot p{font-size:8px;color:#6f879f;line-height:1.55;margin:5px 0 0}
    main{min-width:0;padding:23px 24px 42px}.topbar{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:18px}.eyebrow{font-size:8px;letter-spacing:.18em;color:#39c9f8;text-transform:uppercase}.topbar h1{font-size:24px;margin:5px 0 5px;letter-spacing:-.03em}.topbar p{margin:0;color:var(--muted);font-size:10px;line-height:1.55}.actions{display:flex;align-items:center;gap:8px}.btn,.select,.input{border:1px solid #17415f;background:#071827;color:#dcecff;border-radius:10px;padding:9px 11px;font-size:10px;outline:none}.btn{cursor:pointer}.btn.primary{background:linear-gradient(135deg,#087fcb,#11bcec);border-color:#28c8f6;color:white;font-weight:700}.btn:hover{border-color:#2a7baa}.live-pill{display:flex;gap:7px;align-items:center;border:1px solid #1d5949;background:#071d18;color:#8cedae;padding:8px 10px;border-radius:999px;font-size:9px}.live-dot{width:7px;height:7px;border-radius:50%;background:#54e48f;box-shadow:0 0 10px #54e48f}
    .page{display:none}.page.active{display:block}.grid{display:grid;gap:12px}.kpis{grid-template-columns:repeat(6,minmax(0,1fr))}.card{border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(180deg,rgba(8,25,41,.95),rgba(5,17,29,.96));box-shadow:var(--shadow)}.kpi{padding:15px;min-height:92px;position:relative;overflow:hidden}.kpi:after{content:"";position:absolute;width:80px;height:80px;right:-35px;top:-30px;border-radius:50%;background:rgba(22,189,247,.06)}.kpi span{display:block;font-size:8px;color:#8199b3;text-transform:uppercase;letter-spacing:.08em}.kpi strong{display:block;font-size:22px;margin:7px 0 3px}.delta{font-size:8px;color:#66e493}.delta.down{color:#ff8495}.section-grid{grid-template-columns:1.55fr .75fr;margin-top:12px}.panel{padding:17px}.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:13px}.panel-head h3{margin:0;font-size:13px}.panel-head p,.panel-head small{display:block;margin:4px 0 0;color:var(--muted);font-size:8px;line-height:1.45}.chip{display:inline-flex;padding:5px 7px;border:1px solid #1d4b6c;background:#071827;border-radius:999px;font-size:8px;color:#91dfff}.chip.green{border-color:#235f48;color:#7ce6a2;background:#082017}.chip.amber{border-color:#644e25;color:#ffd280;background:#201a0b}
    .funnel{display:flex;gap:6px;overflow:auto;padding:4px 2px 5px}.funnel-step{min-width:105px;flex:1;border:1px solid #173b59;border-radius:12px;padding:11px;background:#061522;position:relative}.funnel-step:not(:last-child):after{content:"›";position:absolute;right:-7px;top:50%;transform:translateY(-50%);color:#30b5eb;background:#07131f}.funnel-step span{font-size:7px;color:#728ba5;text-transform:uppercase;letter-spacing:.07em}.funnel-step strong{font-size:17px;display:block;margin:5px 0 2px}.funnel-step small{font-size:7px;color:#7791aa}.funnel-step.business{border-color:#266143;background:#071b15}.money{font-size:29px;font-weight:800;letter-spacing:-.04em;margin:4px 0 0}.money-label{font-size:8px;color:#61e39a}.biz-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:14px}.mini-box{border:1px solid #143b55;border-radius:10px;padding:9px;background:#06131f}.mini-box span{display:block;color:#778fa6;font-size:7px}.mini-box strong{display:block;font-size:13px;margin-top:4px}.insight{border-top:1px solid #153b55;margin-top:13px;padding-top:11px;color:#9cb0c4;font-size:8px;line-height:1.55}
    .two{grid-template-columns:1.2fr .8fr;margin-top:12px}.followups{display:flex;flex-direction:column;gap:7px}.follow{display:grid;grid-template-columns:34px 1fr auto;gap:9px;align-items:center;border:1px solid #153853;border-radius:11px;padding:9px;background:#061421;cursor:pointer}.follow:hover{border-color:#2379ab}.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;border:1px solid #235d84;background:#0a263e;color:#9be8ff;font-weight:700;font-size:9px}.follow strong{font-size:9px;display:block}.follow small{font-size:7px;color:#7f95aa;display:block;margin-top:2px}.due{color:#ffc36b!important}.due.hot{color:#ff7e8d!important}.right{text-align:right}.source{margin-bottom:10px}.source-line{display:flex;justify-content:space-between;gap:10px;font-size:9px}.bar{height:5px;background:#0c2940;border-radius:99px;overflow:hidden;margin-top:5px}.bar i{display:block;height:100%;background:linear-gradient(90deg,#0a84d8,#24d9ff);border-radius:99px}
    table{width:100%;border-collapse:collapse}.table-wrap{overflow:auto}.data-table{min-width:900px}.data-table th{text-align:left;padding:9px;border-bottom:1px solid #17364f;color:#68839c;font-size:7px;text-transform:uppercase;letter-spacing:.06em}.data-table td{padding:10px 9px;border-bottom:1px solid #10283b;font-size:8px;color:#b8c9d8}.data-table tr:hover td{background:#071827}.content-name strong{display:block;font-size:9px;color:#f0f7ff}.content-name small{font-size:7px;color:#6f879d}.score{display:inline-grid;place-items:center;width:29px;height:29px;border-radius:50%;border:1px solid #2581ad;color:#8fe5ff;font-weight:700}.outcome{color:#75e49c}.warning{color:#ffd07a}
    .cards3{grid-template-columns:repeat(3,1fr);margin-top:12px}.pattern-card,.story-card,.competitor-card,.brand-card{padding:14px}.pattern-card h4,.story-card h4,.competitor-card h4,.brand-card h4{font-size:10px;margin:0 0 5px}.pattern-card p,.story-card p,.competitor-card p,.brand-card p{font-size:8px;color:#8198ae;line-height:1.55;margin:0}.pattern-stat{display:flex;justify-content:space-between;border-top:1px solid #15364f;margin-top:11px;padding-top:9px;font-size:8px}.pattern-stat strong{color:#66defd}.viral{font-size:23px;font-weight:800;color:#4ed9ff;margin-top:8px}.story-flow{display:flex;align-items:stretch;gap:5px;overflow:auto;margin-top:10px}.story-node{min-width:88px;border:1px solid #173b57;background:#061522;border-radius:10px;padding:9px}.story-node span{font-size:7px;color:#6f879c;display:block}.story-node strong{font-size:8px;display:block;margin-top:4px}.arrow{align-self:center;color:#33bce9}.brand-scores{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:12px}.brand-score{border:1px solid #17374f;background:#061421;border-radius:10px;padding:10px}.brand-score span{font-size:7px;color:#738da5}.brand-score strong{font-size:16px;display:block;margin-top:3px}.pill-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.brand-rule{display:flex;gap:8px;margin-top:8px;align-items:flex-start}.brand-rule b{font-size:9px;color:#41cdf8}.brand-rule div{font-size:8px;color:#8aa1b5;line-height:1.45}.idea-list{display:grid;gap:8px}.idea{border:1px solid #153a55;background:#061522;border-radius:11px;padding:11px;display:grid;grid-template-columns:1fr auto;gap:10px}.idea h4{font-size:9px;margin:0 0 4px}.idea p{font-size:7px;color:#768fa7;margin:0}.priority{font-size:9px;color:#68e69c}.settings-row{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:12px 0;border-bottom:1px solid #123047}.settings-row strong{font-size:9px}.settings-row small{display:block;font-size:7px;color:#758da4;margin-top:2px}.modal-backdrop{position:fixed;inset:0;background:rgba(0,4,10,.76);backdrop-filter:blur(9px);display:grid;place-items:center;padding:20px;z-index:40}.modal{width:min(560px,100%);border:1px solid #205c80;border-radius:18px;background:#061421;box-shadow:0 25px 80px rgba(0,0,0,.45);padding:19px}.modal h3{margin:0 0 5px}.modal p{font-size:9px;line-height:1.6;color:#8ca2b7}.modal .actions{justify-content:flex-end;margin-top:17px}.hidden{display:none!important}
    @media(max-width:1200px){.kpis{grid-template-columns:repeat(3,1fr)}.section-grid,.two{grid-template-columns:1fr}.cards3{grid-template-columns:1fr 1fr}}
    @media(max-width:820px){.app{grid-template-columns:1fr}aside{height:auto;position:relative;border-right:0;border-bottom:1px solid #12324b}.nav-group{display:flex;overflow:auto;margin:0}.nav-label,.sidebar-foot{display:none}.nav-btn{white-space:nowrap;width:auto}.brand{padding-bottom:10px}main{padding:17px 13px 35px}.topbar{flex-direction:column}.actions{flex-wrap:wrap}.kpis{grid-template-columns:1fr 1fr}.cards3,.brand-scores{grid-template-columns:1fr 1fr}}
  </style>
</head>
<body>
<div class="app">
  <aside>
    <div class="brand"><div class="mark">GII</div><div><strong>GENIDEIA</strong><small>CONTENT OS</small></div></div>
    <div class="nav-group"><div class="nav-label">Sistema</div>
      <button class="nav-btn active" data-page="resumen"><span class="nav-icon">⌂</span>Resumen</button>
      <button class="nav-btn" data-page="contenido"><span class="nav-icon">▤</span>Contenido</button>
    </div>
    <div class="nav-group"><div class="nav-label">Inteligencia</div>
      <button class="nav-btn" data-page="inteligencia"><span class="nav-icon">✦</span>Inteligencia</button>
      <button class="nav-btn" data-page="competencia"><span class="nav-icon">◎</span>Competencia</button>
    </div>
    <div class="nav-group"><div class="nav-label">Estrategia</div>
      <button class="nav-btn" data-page="stories"><span class="nav-icon">▥</span>Stories</button>
      <button class="nav-btn" data-page="estrategia"><span class="nav-icon">◇</span>Estrategia</button>
    </div>
    <div class="nav-group"><div class="nav-label">Identidad</div>
      <button class="nav-btn" data-page="marca"><span class="nav-icon">◈</span>Personaje</button>
      <button class="nav-btn" data-page="config"><span class="nav-icon">⚙</span>Configuración</button>
    </div>
    <div class="sidebar-foot"><strong>Sistema de aprendizaje</strong><p>Intención → reacción → relación → negocio → aprendizaje → replicación.</p></div>
  </aside>
  <main>
    <section class="page active" id="resumen">
      <div class="topbar"><div><div class="eyebrow">CONTENT OPERATING SYSTEM</div><h1>Qué está pasando ahora</h1><p>No solo mide contenido: conecta cada pieza con la reacción que provoca y el resultado que genera.</p></div><div class="actions"><div class="live-pill"><span class="live-dot"></span><span id="sourceStatus">Datos demo</span></div><select class="select"><option>Últimos 30 días</option><option>7 días</option><option>90 días</option></select><button class="btn primary" id="connectTop">Conectar Instagram</button></div></div>
      <div class="grid kpis">
        <div class="card kpi"><span>Alcance</span><strong>186.4K</strong><div class="delta">↑ 22.4%</div></div>
        <div class="card kpi"><span>Interacciones</span><strong>12.4K</strong><div class="delta">↑ 31.8%</div></div>
        <div class="card kpi"><span>Conversaciones</span><strong>97</strong><div class="delta">↑ 26.0%</div></div>
        <div class="card kpi"><span>Leads</span><strong>31</strong><div class="delta">↑ 19.2%</div></div>
        <div class="card kpi"><span>Ventas</span><strong>5</strong><div class="delta">↑ 25.0%</div></div>
        <div class="card kpi"><span>Seguidores</span><strong>+600</strong><div class="delta">últimas 24 h</div></div>
      </div>
      <div class="grid section-grid">
        <div class="card panel"><div class="panel-head"><div><h3>Embudo del sistema</h3><p>La intención de cada acción y la reacción en cadena.</p></div><span class="chip">Todo el contenido</span></div>
          <div class="funnel"><div class="funnel-step"><span>Alcance</span><strong>186K</strong><small>atención</small></div><div class="funnel-step"><span>Perfil</span><strong>4.8K</strong><small>2.6%</small></div><div class="funnel-step"><span>Acción</span><strong>614</strong><small>guardar / click</small></div><div class="funnel-step"><span>Conversación</span><strong>97</strong><small>DM / WhatsApp</small></div><div class="funnel-step"><span>Lead</span><strong>31</strong><small>calificado</small></div><div class="funnel-step"><span>Reunión</span><strong>12</strong><small>diagnóstico</small></div><div class="funnel-step business"><span>Venta</span><strong>5</strong><small>cliente</small></div></div>
        </div>
        <div class="card panel"><div class="eyebrow">IMPACTO COMERCIAL</div><div class="money">USD 4.850</div><div class="money-label">revenue atribuido</div><div class="biz-grid"><div class="mini-box"><span>Pipeline</span><strong>USD 9.2K</strong></div><div class="mini-box"><span>Ticket medio</span><strong>USD 970</strong></div><div class="mini-box"><span>Lead → venta</span><strong>16.1%</strong></div><div class="mini-box"><span>Ventas</span><strong>5</strong></div></div><div class="insight">El contenido B2B tiene menos alcance, pero concentra la mayoría de conversaciones calificadas y revenue.</div></div>
      </div>
      <div class="grid two">
        <div class="card panel"><div class="panel-head"><div><h3>Seguimientos que necesitan atención</h3><p>El contenido no termina cuando alguien responde.</p></div><span class="chip amber">4 pendientes</span></div><div class="followups" id="followups"></div></div>
        <div class="card panel"><div class="panel-head"><div><h3>Origen de oportunidades</h3><p>Qué contenido inicia relaciones comerciales.</p></div></div><div class="source"><div class="source-line"><span>Reels B2B</span><strong>58%</strong></div><div class="bar"><i style="width:78%"></i></div></div><div class="source"><div class="source-line"><span>Stories de venta</span><strong>32%</strong></div><div class="bar"><i style="width:57%"></i></div></div><div class="source"><div class="source-line"><span>Perfil / orgánico</span><strong>10%</strong></div><div class="bar"><i style="width:28%"></i></div></div></div>
      </div>
    </section>

    <section class="page" id="contenido">
      <div class="topbar"><div><div class="eyebrow">BIBLIOTECA</div><h1>Contenido como experimento</h1><p>Cada pieza tiene objetivo, variables, métricas y resultado.</p></div><div class="actions"><input class="input" id="searchContent" placeholder="Buscar contenido..."/><select class="select"><option>Todos</option><option>B2B</option><option>B2C</option></select><button class="btn primary">+ Nuevo</button></div></div>
      <div class="card panel table-wrap"><table class="data-table"><thead><tr><th>Contenido</th><th>Formato</th><th>Intención</th><th>Views</th><th>Save rate</th><th>Resultado</th><th>A / E / R / B</th></tr></thead><tbody id="contentRows"></tbody></table></div>
    </section>

    <section class="page" id="inteligencia">
      <div class="topbar"><div><div class="eyebrow">LEARNING ENGINE</div><h1>Patrones y replicación</h1><p>El sistema separa coincidencias de patrones suficientemente fuertes como para actuar.</p></div><button class="btn primary">Generar recomendaciones</button></div>
      <div class="grid cards3"><div class="card pattern-card"><span class="chip green">Alta confianza</span><div class="viral">2.3×</div><h4>Lista + número + utilidad inmediata</h4><p>Las listas de herramientas generan más guardados que tu mediana, especialmente entre 25 y 38 segundos.</p><div class="pattern-stat"><span>Muestra</span><strong>18 videos</strong></div></div><div class="card pattern-card"><span class="chip green">Prometedor</span><div class="viral">1.8×</div><h4>Antes vs. ahora</h4><p>Los contrastes operativos muestran share rate alto. Hace falta aumentar la muestra antes de escalar.</p><div class="pattern-stat"><span>Muestra</span><strong>6 videos</strong></div></div><div class="card pattern-card"><span class="chip amber">Comercial</span><div class="viral">3.1×</div><h4>Demo B2B + CTA por palabra</h4><p>Menos views, más conversaciones calificadas. Es uno de los patrones con mayor Business Score.</p><div class="pattern-stat"><span>Revenue</span><strong>USD 2.3K</strong></div></div></div>
      <div class="grid two"><div class="card panel"><div class="panel-head"><h3>Qué replicar ahora</h3></div><div class="idea-list"><div class="idea"><div><h4>5 tareas que una PYME no debería seguir haciendo a mano — Parte 2</h4><p>Mantener formato, ritmo e intención. Cambiar problemas y ejemplos.</p></div><div class="priority">92/100</div></div><div class="idea"><div><h4>Probé herramientas virales de IA: estas 3 sí me ahorraron tiempo</h4><p>Adapta un mecanismo viral externo a tu personaje de constructor/experimentador.</p></div><div class="priority">89/100</div></div><div class="idea"><div><h4>Cómo se pierde una venta cuando nadie hace seguimiento</h4><p>Menor alcance esperado, alta probabilidad de conversación B2B.</p></div><div class="priority">87/100</div></div></div></div><div class="card panel"><div class="panel-head"><h3>Regla de decisión</h3></div><div class="brand-rule"><b>01</b><div>No repetir un tema solo porque tuvo views; identificar qué variable explicó el resultado.</div></div><div class="brand-rule"><b>02</b><div>Separar Attention, Engagement, Relationship y Business Score.</div></div><div class="brand-rule"><b>03</b><div>Replicar estructura y mecanismo; cambiar el contenido para evitar saturación.</div></div><div class="brand-rule"><b>04</b><div>Priorizar tests con suficiente señal y baja muestra para aprender rápido.</div></div></div></div>
    </section>

    <section class="page" id="competencia">
      <div class="topbar"><div><div class="eyebrow">MARKET RADAR</div><h1>Competencia</h1><p>Videos virales como señales externas, no como contenido para copiar.</p></div><div class="actions"><input class="input" placeholder="Creator o tema..."/><button class="btn primary">+ Analizar Reel</button></div></div>
      <div class="grid cards3"><div class="card competitor-card"><span class="chip">IA / Productividad</span><div class="viral">8.7×</div><h4>“5 funciones de ChatGPT que probablemente no usás”</h4><p>Hook: número + gap de conocimiento. Formato: lista rápida. Publicado hace 2 días.</p><div class="pattern-stat"><span>Views públicas</span><strong>1.2M</strong></div></div><div class="card competitor-card"><span class="chip">Automatización</span><div class="viral">6.1×</div><h4>“Dejá de responder esto manualmente”</h4><p>Hook de dolor + demo inmediata. Mecánica aplicable a contenido B2B.</p><div class="pattern-stat"><span>Views públicas</span><strong>684K</strong></div></div><div class="card competitor-card"><span class="chip">Herramientas</span><div class="viral">4.4×</div><h4>“Probé 20 apps y estas son las únicas 4 que pagaría”</h4><p>Curación + experiencia propia + descarte. Brand Fit potencial alto.</p><div class="pattern-stat"><span>Views públicas</span><strong>391K</strong></div></div></div>
    </section>

    <section class="page" id="stories">
      <div class="topbar"><div><div class="eyebrow">STORY SYSTEM</div><h1>Secuencias con intención</h1><p>Medimos la progresión completa, no cada Story de forma aislada.</p></div><button class="btn primary">+ Nueva secuencia</button></div>
      <div class="card panel"><div class="panel-head"><div><h3>Venta — Diagnóstico de sistemas</h3><p>Objetivo: llevar de identificación del problema a conversación.</p></div><span class="chip green">Venta</span></div><div class="story-flow"><div class="story-node"><span>Story 1</span><strong>Problema</strong></div><div class="arrow">→</div><div class="story-node"><span>Story 2</span><strong>Identificación</strong></div><div class="arrow">→</div><div class="story-node"><span>Story 3</span><strong>Demo</strong></div><div class="arrow">→</div><div class="story-node"><span>Story 4</span><strong>Solución</strong></div><div class="arrow">→</div><div class="story-node"><span>Story 5</span><strong>CTA: SISTEMA</strong></div></div></div>
      <div class="grid section-grid"><div class="card panel"><div class="panel-head"><h3>Reacción en cadena</h3></div><div class="funnel"><div class="funnel-step"><span>Reach</span><strong>8.4K</strong><small>secuencia</small></div><div class="funnel-step"><span>Respuestas</span><strong>184</strong><small>acción</small></div><div class="funnel-step"><span>Conversaciones</span><strong>34</strong><small>DM</small></div><div class="funnel-step"><span>Leads</span><strong>13</strong><small>calificados</small></div><div class="funnel-step"><span>Reuniones</span><strong>5</strong><small>agendadas</small></div><div class="funnel-step business"><span>Ventas</span><strong>2</strong><small>USD 1.650</small></div></div></div><div class="card panel"><div class="panel-head"><h3>Aprendizaje</h3></div><div class="insight" style="border:0;margin:0;padding:0">Cuando la oferta aparece recién después de problema → identificación → demo, la secuencia genera más conversaciones que cuando se vende demasiado temprano. Necesitamos más secuencias para validar la magnitud.</div></div></div>
    </section>

    <section class="page" id="estrategia">
      <div class="topbar"><div><div class="eyebrow">PLANNING</div><h1>Estrategia</h1><p>Qué queremos provocar antes de decidir qué publicar.</p></div><button class="btn primary">+ Nueva idea</button></div>
      <div class="grid cards3"><div class="card pattern-card"><span class="chip">ALCANCE</span><h4>Descubrimiento B2C</h4><p>Videos simples y compartibles para aumentar superficie de entrada.</p><div class="pattern-stat"><span>Peso semanal</span><strong>45%</strong></div></div><div class="card pattern-card"><span class="chip">RELACIÓN</span><h4>Autoridad / confianza</h4><p>Experiencias propias, procesos y construcción real.</p><div class="pattern-stat"><span>Peso semanal</span><strong>30%</strong></div></div><div class="card pattern-card"><span class="chip">NEGOCIO</span><h4>Problema → sistema → CTA</h4><p>Casos B2B capaces de generar conversación, diagnóstico o venta.</p><div class="pattern-stat"><span>Peso semanal</span><strong>25%</strong></div></div></div>
    </section>

    <section class="page" id="marca">
      <div class="topbar"><div><div class="eyebrow">BRAND PERSONA</div><h1>Personaje de marca</h1><p>La percepción acumulada que construís con todo lo que compartís.</p></div><button class="btn">Editar personaje</button></div>
      <div class="grid section-grid"><div class="card brand-card"><span class="chip green">NÚCLEO</span><h4 style="font-size:16px;margin-top:10px">Constructor / Experimentador</h4><p>No habla desde teoría abstracta. Prueba herramientas, construye sistemas, mide qué ocurre y comparte lo que aprende de forma simple.</p><div class="pill-list"><span class="chip">Curioso</span><span class="chip">Práctico</span><span class="chip">Transparente</span><span class="chip">Constructor</span><span class="chip">Simple</span></div><div class="brand-scores"><div class="brand-score"><span>Claridad</span><strong>92</strong></div><div class="brand-score"><span>Consistencia</span><strong>86</strong></div><div class="brand-score"><span>Diferenciación</span><strong>81</strong></div><div class="brand-score"><span>Brand Fit</span><strong>89</strong></div></div></div><div class="card panel"><div class="panel-head"><h3>Filtro antes de publicar</h3></div><div class="brand-rule"><b>01</b><div>¿Refuerza que construís y probás, o solo repetís información?</div></div><div class="brand-rule"><b>02</b><div>¿La persona entiende qué valor obtiene de seguirte?</div></div><div class="brand-rule"><b>03</b><div>¿Es coherente con la percepción que querés acumular?</div></div><div class="brand-rule"><b>04</b><div>¿La tendencia externa se adapta a tu voz en vez de reemplazarla?</div></div></div></div>
    </section>

    <section class="page" id="config">
      <div class="topbar"><div><div class="eyebrow">CONEXIONES</div><h1>Configuración</h1><p>Las credenciales privadas nunca deben quedar dentro del frontend.</p></div></div>
      <div class="card panel"><div class="settings-row"><div><strong>Instagram Professional</strong><small>Posts, Reels, Stories e insights propios.</small></div><button class="btn primary connectBtn">Conectar</button></div><div class="settings-row"><div><strong>Supabase</strong><small>Contenido, snapshots, patrones, leads y memoria histórica.</small></div><span class="chip amber" id="dbState">Pendiente</span></div><div class="settings-row"><div><strong>TikTok</strong><small>Fase siguiente: rendimiento cruzado por plataforma.</small></div><button class="btn">Preparar</button></div><div class="settings-row"><div><strong>Mensajería / Leads</strong><small>DM, WhatsApp y atribución de conversación.</small></div><button class="btn">Preparar</button></div><div class="settings-row"><div><strong>Ventas / CRM</strong><small>Seguimientos, propuestas, cierres y revenue atribuido.</small></div><button class="btn">Preparar</button></div></div>
    </section>
  </main>
</div>
<div id="modalRoot"></div>
<script>
const content=[
 {title:'5 herramientas de IA para 5 tareas',format:'Lista',intent:'Guardados',views:38200,save:'10.8%',result:'4.1K guardados',scores:'91 / 94 / 62 / 18'},
 {title:'5 tareas que una PYME no debería hacer a mano',format:'Lista B2B',intent:'Leads',views:18400,save:'5.3%',result:'14 leads · 1 venta',scores:'63 / 72 / 91 / 96'},
 {title:'Este seguimiento recupera ventas que hoy perdés',format:'Demo',intent:'Conversación',views:12900,save:'4.1%',result:'22 DMs · USD 1.2K',scores:'56 / 69 / 95 / 97'},
 {title:'7 cosas de ChatGPT que probablemente no conocés',format:'Lista',intent:'Seguidores',views:44700,save:'8.9%',result:'+238 seguidores',scores:'95 / 91 / 86 / 16'},
 {title:'Antes vs ahora: responder consultas con IA',format:'Antes/Después',intent:'Compartidos',views:22100,save:'3.7%',result:'1.6K shares · 5 leads',scores:'79 / 92 / 73 / 54'},
 {title:'Cómo construimos un sistema para una empresa',format:'Caso',intent:'Autoridad',views:9400,save:'4.8%',result:'2 reuniones',scores:'49 / 64 / 82 / 67'}
];
const leads=[
 {name:'Carlos R.',company:'Transporte',stage:'Propuesta enviada',next:'Retomar propuesta y resolver objeciones',due:'Hoy',value:'USD 1.200',hot:true},
 {name:'Lucía M.',company:'Centro estético',stage:'Conversación',next:'Preguntar por volumen de consultas',due:'Hoy',value:'USD 650',hot:true},
 {name:'Martín S.',company:'Gimnasio',stage:'Reunión realizada',next:'Preparar propuesta',due:'Mañana',value:'USD 900'},
 {name:'Federico P.',company:'Inmobiliaria',stage:'Seguimiento',next:'Enviar caso similar + CTA a reunión',due:'2 días',value:'USD 750'}
];
const rows=document.getElementById('contentRows');
rows.innerHTML=content.map(v=>`<tr><td class="content-name"><strong>${v.title}</strong><small>Instagram · Reel</small></td><td><span class="chip">${v.format}</span></td><td>${v.intent}</td><td>${v.views.toLocaleString('es-UY')}</td><td>${v.save}</td><td class="outcome">${v.result}</td><td><span class="chip">${v.scores}</span></td></tr>`).join('');
document.getElementById('followups').innerHTML=leads.map((l,i)=>`<div class="follow" data-lead="${i}"><div class="avatar">${l.name.split(' ').map(x=>x[0]).join('').slice(0,2)}</div><div><strong>${l.name} · ${l.company}</strong><small>${l.stage}</small><small>${l.next}</small></div><div class="right"><strong>${l.value}</strong><small class="due ${l.hot?'hot':''}">${l.due}</small></div></div>`).join('');
function showPage(id){document.querySelectorAll('.page').forEach(x=>x.classList.toggle('active',x.id===id));document.querySelectorAll('.nav-btn').forEach(x=>x.classList.toggle('active',x.dataset.page===id));window.scrollTo({top:0,behavior:'smooth'});}
document.querySelectorAll('.nav-btn').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
const search=document.getElementById('searchContent');if(search)search.addEventListener('input',()=>{const q=search.value.toLowerCase();[...rows.children].forEach((tr,i)=>tr.style.display=content[i].title.toLowerCase().includes(q)?'':'none')});
function modal(title,body,primary='Entendido'){document.getElementById('modalRoot').innerHTML=`<div class="modal-backdrop"><div class="modal"><div class="eyebrow">CONTENT OS</div><h3>${title}</h3><p>${body}</p><div class="actions"><button class="btn" id="modalClose">Cerrar</button><button class="btn primary" id="modalOk">${primary}</button></div></div></div>`;document.getElementById('modalClose').onclick=closeModal;document.getElementById('modalOk').onclick=closeModal;}
function closeModal(){document.getElementById('modalRoot').innerHTML=''}
function connectInstagram(){modal('Conexión de Instagram preparada','La interfaz ya tiene reservado el flujo de conexión. La implementación real va a usar el backend para guardar credenciales y sincronizar tus medios e insights sin exponer tokens en el navegador.','Continuar configuración')}
document.querySelectorAll('.connectBtn').forEach(b=>b.onclick=connectInstagram);document.getElementById('connectTop').onclick=connectInstagram;
document.querySelectorAll('[data-lead]').forEach(el=>el.onclick=()=>{const l=leads[+el.dataset.lead];modal(`${l.name} · ${l.company}`,`Etapa: ${l.stage}. Próxima acción: ${l.next}. Valor estimado: ${l.value}. Vencimiento: ${l.due}. En la versión conectada este panel conservará el contenido de origen y toda la cronología de interacción.`,'Registrar seguimiento')});
</script>
</body>
</html>
