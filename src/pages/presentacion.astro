---
// Landing de presentación para personas que ya conocen a Andrés.
// Reutiliza una landing personal que ya no se usaba.
// Pregunta arriba, video de presentación y accesos directos: Instagram y WhatsApp.
import Loader from '../transitions/Loader.astro';
import '../transitions/transitions.css';
import '../styles/global.css';

const waUrl = 'https://wa.me/59892302941?text=' + encodeURIComponent('Hola Andrés, vi tu presentación y quiero contarte:');
const perfiles = [
  {
    nombre: 'Andrés Albornoz',
    rol: 'Fundador',
    handle: '@andresalbornoz.ai',
    url: 'https://instagram.com/andresalbornoz.ai',
    foto: '/img/andres.jpg',
  },
  {
    nombre: 'GENIDEIA Company',
    rol: 'Sistemas y automatización',
    handle: '@genideiacompany',
    url: 'https://www.instagram.com/genideiacompany',
    foto: '/img/logo-genideia.png',
  },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Cómo puedo ayudarte — GENIDEIA Company</title>
  <meta name="description" content="Te cuento en un minuto qué hace GENIDEIA y cómo puede ayudar a tu empresa." />
  <meta name="robots" content="noindex, nofollow" />
  <meta property="og:title" content="Cómo puedo ayudarte — GENIDEIA Company" />
  <meta property="og:description" content="Te cuento en un minuto qué hace GENIDEIA y cómo puede ayudar a tu empresa." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://genideiacompany.com/og-genideia.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script>import '../transitions/reveal.js';</script>
</head>
<body style="background:#07080D radial-gradient(ellipse 90% 55% at 50% -8%, rgba(0,200,255,0.10), transparent 62%) no-repeat fixed; color:#F2F4F7; font-family:'Poppins',sans-serif; -webkit-font-smoothing:antialiased;">
  <Loader logoSrc="/img/logo-nav.png" />

  <header style="background:rgba(10,10,10,0.92); border-bottom:1px solid rgba(255,255,255,0.07);" class="sticky top-0 z-50 backdrop-blur">
    <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
      <a href="/" style="font-family:'Montserrat',sans-serif; font-size:1.05rem; font-weight:600; color:#F2F4F7; letter-spacing:0.5px;">
        GENIDEIA <span style="font-weight:500; color:#B8BEC7;">Company</span>
      </a>
      <a href={waUrl} target="_blank" rel="noopener noreferrer" style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600; font-size:0.78rem;" class="px-4 py-2 rounded-lg hover:opacity-90 transition-opacity">WhatsApp</a>
    </nav>
  </header>

  <main class="max-w-3xl mx-auto px-6 pt-16 pb-20 text-center">
    <p class="text-xs font-medium mb-6 uppercase" style="color:#00C8FF; letter-spacing:3px;">Presentación</p>
    <h1 style="font-family:'Montserrat',sans-serif; font-weight:700; line-height:1.05; letter-spacing:-1.2px; font-size:clamp(2.2rem, 6vw, 3.8rem);" class="mb-10">
      ¿Cómo puedo ayudarte?
    </h1>

    <!-- Video de presentación (animación 3D con la voz de Andrés, 16:9) -->
    <div data-reveal style="aspect-ratio:16/9; border-radius:14px; overflow:hidden; border:1px solid rgba(0,200,255,0.2); background:#121314;">
      <video controls playsinline preload="metadata" poster="/videos/presentacion-genideia-poster.jpg" style="width:100%; height:100%; display:block; object-fit:cover;">
        <source src="/videos/presentacion-genideia.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="grid sm:grid-cols-2 gap-5 mt-14 text-left" data-reveal>
      {perfiles.map((p) => (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class="card-hover rounded-xl p-6 flex items-center gap-5" style="background:#111111; border:1px solid rgba(255,255,255,0.07);">
          <div style="flex-shrink:0; width:64px; height:64px; border-radius:50%; overflow:hidden; background:#0B1324; border:1px solid rgba(255,255,255,0.08);" class="flex items-center justify-center">
            <img src={p.foto} alt={p.nombre} style="width:100%; height:100%; object-fit:cover;" />
          </div>
          <div class="min-w-0">
            <p style="font-family:'Montserrat',sans-serif; font-weight:600; color:#F2F4F7;" class="leading-tight">{p.nombre}</p>
            <p style="color:#B8BEC7; font-size:0.7rem; font-weight:300;" class="mt-1">{p.rol}</p>
            <p style="color:#00C8FF; font-size:0.85rem; font-weight:300;" class="mt-1">Instagram {p.handle}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12" data-reveal>
      <p style="color:#B8BEC7; font-weight:300;" class="mb-5">Si querés hablar, escribime:</p>
      <a href={waUrl} target="_blank" rel="noopener noreferrer" style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600;" class="px-9 py-3.5 rounded-lg hover:opacity-90 transition-opacity inline-block">
        WhatsApp · +598 92 302 941
      </a>
    </div>
  </main>
</body>
</html>
