    .ex-grid{grid-template-columns:1fr}.ex-card.w{grid-column:auto}.ex-card.t{grid-row:auto}.ex-card.w .ex-cover{aspect-ratio:16/10}.ex-card.t .ex-cover{aspect-ratio:4/5;flex:none;min-height:0}
