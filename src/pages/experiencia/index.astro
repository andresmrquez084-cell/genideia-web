  }
  @media (max-width:640px){
    .ex-stats{grid-template-columns:1fr 1fr 1fr;gap:8px}.ex-stats div{padding:10px}.ex-stats b{font-size:22px}.ex-stats span{font-size:10.5px}
    .ex-deck{height:270px}.ex-dk{inset:20px 14px 46px}.ex-deck-bar{left:14px;right:14px}
    .pxj .ex-ev{height:auto}.pxj .ex-ev-stick{position:relative;min-height:0;padding:50px 0}
    .pxj .ex-layer{opacity:1;transform:none;filter:none}
