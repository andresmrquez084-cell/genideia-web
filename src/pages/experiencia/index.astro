<script is:inline>
(function () {
  var P = JSON.parse(document.getElementById('exData').textContent);
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  var esc = function (s) { return String(s || '').replace(/[&<>"']/g, function (m) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]; }); };
  var full = function (u) { return u ? u.replace('-card.webp', '-full.webp') : ''; };
  function visible(el) { var r = el.getBoundingClientRect(); return r.bottom > 0 && r.top < innerHeight; }

  /* contadores */
  var cio = new IntersectionObserver(function (es) {
    es.forEach(function (e) {
      if (!e.isIntersecting) return; cio.unobserve(e.target);
      var el = e.target, to = +el.dataset.count, pre = el.dataset.pre || '', suf = el.dataset.suf || '', t0 = null;
      if (reduce) { el.textContent = pre + to + suf; return; }
      (function f(t) { if (!t0) t0 = t; var p = Math.min(1, (t - t0) / 1400); el.textContent = pre + Math.round(to * (1 - Math.pow(1 - p, 3))) + suf; if (p < 1) requestAnimationFrame(f); })(performance.now());
    });
  }, { threshold: .5 });
  document.querySelectorAll('[data-count]').forEach(function (el) { cio.observe(el); });

  /* mazo del hero */
  var cards = [].slice.call(document.querySelectorAll('.ex-dk')), top = 0, bar = document.getElementById('exDeckP'), num = document.getElementById('exDeckN'), deckT;
  function layout() { cards.forEach(function (c, i) { var p = (i - top + cards.length) % cards.length; c.style.setProperty('--p', Math.min(p, 4)); c.style.visibility = p > 4 ? 'hidden' : ''; }); num.textContent = String(top + 1).padStart(2, '0'); bar.classList.remove('run'); void bar.offsetWidth; if (!reduce) bar.classList.add('run'); }
  function nextDeck() { var c = cards[top]; if (reduce) { top = (top + 1) % cards.length; layout(); return; } c.classList.add('out'); setTimeout(function () { c.classList.remove('out'); top = (top + 1) % cards.length; layout(); }, 450); }
  layout();
  deckT = setInterval(function () { if (!document.hidden && visible(cards[0].parentNode)) nextDeck(); }, 3400);

  /* evolución por scroll */
  var ev = document.getElementById('evolucion'), layers = ev.querySelectorAll('.ex-layer'), btns = ev.querySelectorAll('[data-ev]'), fill = document.getElementById('exEvFill'), n = layers.length, sticky = function () { return innerWidth > 640 && !reduce; };
  ev.classList.add('js');
  function setStage(k, f) {
    layers.forEach(function (l, i) { l.classList.toggle('on', i <= k); l.classList.toggle('cur', i === k); });
    btns.forEach(function (b, i) { b.classList.toggle('on', i <= k); });
    fill.parentNode.style.setProperty('--f', f);
  }
  function onScroll() {
    if (!sticky()) { setStage(n - 1, 1); layers.forEach(function (l) { l.classList.remove('cur'); }); return; }
    var r = ev.getBoundingClientRect(), total = ev.offsetHeight - innerHeight, p = Math.max(0, Math.min(1, -r.top / total));
    var k = Math.min(n - 1, Math.floor(p * n * 1.02));
    setStage(k, k / (n - 1));
  }
  addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll); onScroll();
  btns.forEach(function (b, i) { b.addEventListener('click', function () { var total = ev.offsetHeight - innerHeight; scrollTo({ top: ev.offsetTop + total * (i + .5) / n, behavior: 'smooth' }); }); });

  /* filtros */
  var grid = document.getElementById('exGrid'), items = grid.querySelectorAll('.ex-card'), fbtn = document.querySelectorAll('.ex-filters button'), order = P.map(function (p) { return p.id; });
  fbtn.forEach(function (b) {
    b.addEventListener('click', function () {
      var c = b.dataset.cat;
      var run = function () { fbtn.forEach(function (x) { x.classList.toggle('on', x === b); }); items.forEach(function (it) { it.classList.toggle('hide', c !== 'Todos' && it.dataset.cat !== c); }); };
      if (document.startViewTransition && !reduce) document.startViewTransition(run); else run();
    });
  });
  items.forEach(function (it, i) { it.style.viewTransitionName = 'exc' + i; });

  /* inclinación de tarjetas */
  if (fine && !reduce) items.forEach(function (it) {
    it.addEventListener('pointermove', function (e) { var r = it.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5; it.style.setProperty('--ry', (x * 6) + 'deg'); it.style.setProperty('--rx', (-y * 6) + 'deg'); });
    it.addEventListener('pointerleave', function () { it.style.setProperty('--ry', '0deg'); it.style.setProperty('--rx', '0deg'); });
    it.addEventListener('pointerenter', function () { var p = P.find(function (x) { return x.id === it.dataset.open; }); if (p && p.image) new Image().src = full(p.image); }, { once: true });
  });

  /* ficha */
  var modal = document.getElementById('exModal'), mc = document.getElementById('exMC'), mi = document.getElementById('exMI'), cur = -1, lastFocus;
  function list() { var vis = [].filter.call(items, function (it) { return !it.classList.contains('hide'); }).map(function (it) { return it.dataset.open; }); return vis.length ? vis : order; }
  function render(id) {
    var p = P.find(function (x) { return x.id === id; }); if (!p) return;
    var L = list(); cur = L.indexOf(id); if (cur < 0) { L = order; cur = order.indexOf(id); }
    mi.textContent = String(cur + 1).padStart(2, '0') + ' / ' + String(L.length).padStart(2, '0');
    var src = document.querySelector('.ex-card[data-open="' + id + '"] .ex-mock');
    var img = p.image ? '<div class="ex-m-img"><img src="' + full(p.image) + '" alt="' + esc(p.title) + '"></div>' : (src ? '<div class="ex-m-img">' + src.outerHTML + '</div>' : '');
    var how = p.cat === 'Diagnósticos' ? 'Es un diagnóstico / diseño de solución. No se presenta como implantación productiva ni como resultado económico ya obtenido.' : 'El estado indicado arriba describe el alcance real del proyecto.';
    var act = p.access === 'public' && p.url ? '<a class="px-btn p sm" href="' + esc(p.url) + '" target="_blank" rel="noopener noreferrer">' + esc(p.actionLabel || 'Abrir ↗') + '</a>' : '<small>Acceso privado: se muestra con capturas o explicación del alcance.</small>';
    mc.innerHTML = img + '<div class="ex-m-b"><div class="ex-m-meta"><span>' + esc(p.cat) + '</span><span><i class="ex-dot ' + esc(p.stateClass) + '"></i>' + esc(p.state) + '</span></div>' +
      '<h2 id="exMT">' + esc(p.title) + '</h2><p class="ex-m-sub">' + esc(p.subtitle) + '</p><p class="ex-m-sum">' + esc(p.summary) + '</p>' +
      '<div class="ex-m-cols"><div class="ex-m-box"><h4>Problema / contexto</h4><p>' + esc(p.problem) + '</p></div>' +
      '<div class="ex-m-box"><h4>Qué desarrollamos o propusimos</h4><ul>' + (p.built || []).map(function (b, i) { return '<li style="animation-delay:' + (i * .06) + 's">' + esc(b) + '</li>'; }).join('') + '</ul></div>' +
      '<div class="ex-m-box"><h4>Evidencia disponible</h4><p>' + esc(p.proof) + '</p></div>' +
      '<div class="ex-m-box"><h4>Cómo leer este caso</h4><p>' + how + '</p></div></div>' +
      '<div class="ex-m-act">' + act + '</div></div>';
    modal.querySelector('.ex-sheet').scrollTop = 0;
  }
  function open(id) { lastFocus = document.activeElement; render(id); modal.classList.add('open'); modal.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; modal.querySelector('.ex-x').focus(); history.replaceState(null, '', '#p-' + id); }
  function close() { modal.classList.remove('open'); modal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; history.replaceState(null, '', location.pathname); if (lastFocus) lastFocus.focus(); }
  function step(d) { var L = list(); var id = L[(cur + d + L.length) % L.length]; render(id); history.replaceState(null, '', '#p-' + id); }
  document.addEventListener('click', function (e) {
    var o = e.target.closest('[data-open]'); if (o) { e.preventDefault(); open(o.dataset.open); return; }
    if (e.target.closest('[data-close]')) close();
    var s = e.target.closest('[data-step]'); if (s) step(+s.dataset.step);
  });
  document.addEventListener('keydown', function (e) {
    if (modal.classList.contains('open')) { if (e.key === 'Escape') close(); if (e.key === 'ArrowRight') step(1); if (e.key === 'ArrowLeft') step(-1); return; }
    if ((e.key === 'Enter' || e.key === ' ') && e.target.classList && e.target.classList.contains('ex-card')) { e.preventDefault(); open(e.target.dataset.open); }
  });
  if (location.hash.indexOf('#p-') === 0) open(location.hash.slice(3));

  /* Klüver: cadena de custodia (ejemplo ilustrativo) */
  var K = [['Remito', 'Qué se recibió y de quién'], ['Lote / bulto', 'Cada pieza con su identificador'], ['Manifiesto', 'Qué sale en cada vehículo'], ['Transferencias', 'Quién entrega y quién confirma'], ['Incidencias', 'Faltantes, daños o demoras'], ['Historial', 'Último punto comprobado']];
  var LOG = ['Remito R-2207 recibido en base Montevideo', 'Lote L-14 · 6 bultos etiquetados', 'Manifiesto M-88 asignado a unidad 03', 'Transferencia confirmada por base Paysandú', 'Incidencia: 1 bulto con demora', 'Último punto comprobado: base Salto'];
  var chain = document.getElementById('exChain'), kb = chain.querySelectorAll('button'), kt = document.getElementById('exKlT'), kd = document.getElementById('exKlD'), log = document.getElementById('exLog'), ki = 0, kAuto = true, hh = 9, mm = 2;
  function kSet(i, write) {
    ki = i; kb.forEach(function (b, j) { b.classList.toggle('done', j <= i); b.classList.toggle('cur', j === i); });
    chain.style.setProperty('--c', i); kt.textContent = K[i][0]; kd.textContent = K[i][1];
    if (write) { mm += 7 + i * 3; if (mm >= 60) { hh++; mm -= 60; } var li = document.createElement('li'); if (i === 4) li.className = 'bad'; li.innerHTML = '<em>' + String(hh).padStart(2, '0') + ':' + String(mm).padStart(2, '0') + '</em>' + LOG[i]; log.prepend(li); while (log.children.length > 4) log.lastChild.remove(); }
  }
  kb.forEach(function (b, i) { b.addEventListener('click', function () { kAuto = false; kSet(i, false); }); });
  kSet(0, true);
  setInterval(function () { if (!kAuto || reduce || !visible(chain)) return; if (ki === K.length - 1) { log.innerHTML = ''; hh = 9; mm = 2; kSet(0, true); } else kSet(ki + 1, true); }, 1800);

  /* Acesur: eventos de ejemplo */
  var AL = [['ok', 'Pedido #A-102 despachado'], ['ok', 'WhatsApp → pedido #A-117 confirmado'], ['bad', 'Excepción: devolución sin motivo cargado'], ['ok', 'Email → pedido #A-121 en depósito'], ['bad', 'Excepción: pedido #A-109 sin despacho hace 48 h'], ['ok', 'Teléfono → pedido #A-124 ingresado']], ai = 1, al = document.getElementById('exAlerts');
  setInterval(function () { if (reduce || !visible(al)) return; var a = AL[ai++ % AL.length], s = document.createElement('span'); s.className = a[0]; s.textContent = a[1]; al.prepend(s); while (al.children.length > 3) al.lastChild.remove(); }, 2100);
})();
</script>
