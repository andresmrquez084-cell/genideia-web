---
// Demo de un sistema funcionando, en laptop y celular, que se completa solo.
// Pestañas por rubro (clicables). Todos los datos son de ejemplo y se marcan como tales.
// Autocontenido: trae sus propios tokens para usarse en cualquier página del sitio.
interface Props { titulo?: string; bajada?: string; eyebrow?: string }
const {
  eyebrow = 'Así se ve funcionando',
  titulo = 'Un sistema que trabaja mientras vos atendés el negocio.',
  bajada = 'Elegí un rubro y mirá cómo se cargan solos los pedidos, los turnos y los avisos. En la laptop ves el panel; en el celular, lo que te llega.',
} = Astro.props;

const RUBROS = [
  { id: 'dist', label: 'Distribuidora', app: 'Pedidos', kpis: ['pedidos hoy', 'entregas', 'facturado'], unit: ['', '', 'k'],
    ev: [['Pedido #1042 por WhatsApp', 'Almacén Rivera', 'ok', 'confirmado'], ['Ruta armada para 14 entregas', 'Zona Este', 'run', 'en ruta'], ['Factura enviada', 'Super Centro', 'ok', 'enviada'], ['Stock bajo: yerba 1 kg', 'Depósito', 'wait', 'reponer'], ['Pedido #1043 por WhatsApp', 'Kiosco Prado', 'ok', 'confirmado'], ['Cobro registrado', 'Almacén Rivera', 'ok', 'cobrado']],
    push: ['Pedido nuevo', 'Kiosco Prado pidió 24 unidades'] },
  { id: 'clin', label: 'Clínica', app: 'Agenda', kpis: ['turnos hoy', 'confirmados', 'ausencias'], unit: ['', '', ''],
    ev: [['Turno agendado por WhatsApp', 'Paciente · 10:30', 'ok', 'agendado'], ['Recordatorio enviado', 'Paciente · 11:00', 'run', 'enviado'], ['Turno reprogramado', 'Paciente · 15:00', 'wait', 'cambio'], ['Ficha actualizada', 'Odontología', 'ok', 'listo'], ['Turno confirmado', 'Paciente · 16:30', 'ok', 'confirmado'], ['Encuesta de atención', 'Paciente · ayer', 'run', 'enviada']],
    push: ['Turno confirmado', 'Mañana 10:30 · consultorio 2'] },
  { id: 'taller', label: 'Taller', app: 'Órdenes', kpis: ['órdenes abiertas', 'listas', 'presupuestos'], unit: ['', '', ''],
    ev: [['Orden #318 ingresada', 'Fiat Cronos · service', 'run', 'en taller'], ['Presupuesto aprobado', 'VW Gol · frenos', 'ok', 'aprobado'], ['Aviso al cliente: auto listo', 'Ford Ka', 'ok', 'avisado'], ['Repuesto pedido', 'Pastillas de freno', 'wait', 'pedido'], ['Orden #319 ingresada', 'Toyota Hilux', 'run', 'en taller'], ['Pago registrado', 'VW Gol', 'ok', 'cobrado']],
    push: ['Tu auto está listo', 'Ford Ka · podés pasar a retirarlo'] },
  { id: 'inmo', label: 'Inmobiliaria', app: 'Clientes', kpis: ['consultas', 'visitas', 'propuestas'], unit: ['', '', ''],
    ev: [['Consulta por Instagram', 'Apto 2 dorm · Pocitos', 'run', 'nueva'], ['Visita agendada', 'Casa · Carrasco', 'ok', 'agendada'], ['Lead asignado a asesora', 'Consulta web', 'ok', 'asignado'], ['Seguimiento automático', 'Interesado · 3 días', 'wait', 'pendiente'], ['Propiedad publicada', 'Local · Centro', 'ok', 'publicada'], ['Propuesta enviada', 'Apto · Cordón', 'run', 'enviada']],
    push: ['Consulta nueva', 'Apto 2 dorm · Pocitos · vía Instagram'] },
];
---

<section class="pc-demo" data-demo>
  <div class="pc-head">
    <div><p class="pc-eb">{eyebrow}</p><h2>{titulo}</h2></div>
    <p class="pc-side">{bajada}</p>
  </div>

  <div class="pc-tabs" role="tablist" aria-label="Rubro del ejemplo">
    {RUBROS.map((r, i) => <button type="button" role="tab" class:list={[i === 0 && 'on']} data-r={r.id} aria-selected={i === 0 ? 'true' : 'false'}>{r.label}</button>)}
  </div>

  <div class="pc-stage">
    <div class="pc-laptop" aria-hidden="true">
      <div class="pc-screen">
        <div class="pc-wtop"><i></i><i></i><i></i><span data-app>panel · {RUBROS[0].app.toLowerCase()}</span><b class="pc-live"><span></span>en vivo</b></div>
        <div class="pc-body">
          <aside class="pc-nav"><b class="on"></b><b></b><b></b><b></b><b></b></aside>
          <div class="pc-main">
            <div class="pc-kpis">
              {[0, 1, 2].map((k) => <div><small data-kl={k}>{RUBROS[0].kpis[k]}</small><b data-kv={k}>0</b><em>+ hoy</em></div>)}
            </div>
            <div class="pc-split">
              <div class="pc-rows" data-rows></div>
              <div class="pc-chart"><small>últimos 7 días</small><div class="pc-bars" data-bars>{[0,1,2,3,4,5,6].map(() => <i></i>)}</div></div>
            </div>
          </div>
        </div>
      </div>
      <div class="pc-base"></div>
    </div>

    <div class="pc-phone" aria-hidden="true">
      <div class="pc-notch"></div>
      <div class="pc-pscreen">
        <small class="pc-time">09:41</small>
        <div class="pc-push" data-push><b>GENIDEIA</b><strong data-pt>{RUBROS[0].push[0]}</strong><span data-ps>{RUBROS[0].push[1]}</span></div>
        <div class="pc-prows" data-prows></div>
      </div>
    </div>
  </div>
  <p class="pc-note">Datos de ejemplo · cada sistema se diseña sobre tu operación real</p>
  <script type="application/json" data-demo-json set:html={JSON.stringify(RUBROS)} />
</section>

<style is:global>
  .pc-demo{--s:#00C8FF;--p:#007BFF;--sl:#BFEFFF;--ok:#4BE39A;--warn:#FFB84D;--tx:#F2F4F7;--tx2:#B8BEC7;--tx3:#7E8796;--mono:"JetBrains Mono",ui-monospace,Menlo,monospace;--display:"Montserrat","Poppins",system-ui,sans-serif;--ease:cubic-bezier(.2,.7,.2,1);
    color:var(--tx);font-family:"Poppins",system-ui,sans-serif;padding:56px 0}
  .pc-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:22px}
  .pc-head h2{margin:0;font-family:var(--display);font-size:clamp(28px,3.8vw,46px);line-height:1.08;letter-spacing:-.035em;max-width:680px}
  .pc-eb{display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-size:12px;letter-spacing:.06em;color:var(--sl);margin:0 0 14px}
  .pc-eb::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--s);box-shadow:0 0 10px var(--s)}
  .pc-side{max-width:380px;margin:0;text-align:right;color:var(--tx3);font-size:14px;line-height:1.6}
  .pc-tabs{display:flex;gap:4px;padding:4px;border-radius:999px;background:rgba(255,255,255,.04);box-shadow:inset 0 0 0 1px rgba(255,255,255,.06);width:max-content;max-width:100%;overflow:auto;margin-bottom:26px}
  .pc-tabs button{border:0;background:transparent;color:var(--tx3);font:inherit;font-size:13px;font-weight:500;padding:8px 16px;border-radius:999px;cursor:pointer;white-space:nowrap;transition:.25s}
  .pc-tabs button:hover{color:#fff}
  .pc-tabs button.on{color:#fff;background:rgba(0,200,255,.14);box-shadow:inset 0 0 0 1px rgba(0,200,255,.35)}
  .pc-stage{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:30px;align-items:end}

  .pc-laptop{perspective:1600px}
  .pc-screen{position:relative;border-radius:20px 20px 6px 6px;padding:0;background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.015)),rgba(11,19,32,.82);border:1px solid rgba(255,255,255,.12);box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 60px 120px -50px rgba(0,90,255,.7);overflow:hidden;transform:rotateX(4deg);transform-origin:bottom}
  .pc-screen::before{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;background:linear-gradient(140deg,rgba(0,200,255,.55),transparent 35%,transparent 65%,rgba(0,123,255,.45));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
  .pc-base{height:14px;margin:0 -4%;border-radius:0 0 18px 18px;background:linear-gradient(180deg,#2a3444,#121822);box-shadow:0 18px 40px -10px rgba(0,0,0,.8)}
  .pc-wtop{display:flex;align-items:center;gap:7px;padding:11px 14px;border-bottom:1px solid rgba(255,255,255,.07)}
  .pc-wtop>i{width:9px;height:9px;border-radius:50%}.pc-wtop>i:nth-child(1){background:#FF6B7A88}.pc-wtop>i:nth-child(2){background:#FFB84D88}.pc-wtop>i:nth-child(3){background:#4BE39A88}
  .pc-wtop>span{margin-left:8px;font-family:var(--mono);font-size:11px;color:var(--tx3)}
  .pc-live{margin-left:auto;display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-weight:400;font-size:11px;color:var(--ok)}
  .pc-live span{width:7px;height:7px;border-radius:50%;background:var(--ok);animation:pcping 2s infinite}
  @keyframes pcping{0%{box-shadow:0 0 0 0 rgba(75,227,154,.55)}80%,100%{box-shadow:0 0 0 9px rgba(75,227,154,0)}}
  .pc-body{display:grid;grid-template-columns:52px minmax(0,1fr);min-height:330px}
  .pc-nav{display:grid;align-content:start;gap:10px;padding:14px 10px;border-right:1px solid rgba(255,255,255,.06)}
  .pc-nav b{height:30px;border-radius:10px;background:rgba(255,255,255,.05)}
  .pc-nav b.on{background:linear-gradient(135deg,var(--p),var(--s));box-shadow:0 8px 20px -8px rgba(0,160,255,.9)}
  .pc-main{padding:14px}
  .pc-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
  .pc-kpis div{padding:12px 14px;border-radius:14px;background:rgba(255,255,255,.035);box-shadow:inset 0 0 0 1px rgba(255,255,255,.07)}
  .pc-kpis small{display:block;font-family:var(--mono);font-size:10px;color:var(--tx3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pc-kpis b{display:block;font-family:var(--display);font-size:24px;letter-spacing:-.03em;margin-top:2px;transition:color .3s}
  .pc-kpis b.bump{color:var(--sl)}
  .pc-kpis em{font-style:normal;font-family:var(--mono);font-size:10px;color:var(--ok)}
  .pc-split{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:10px;margin-top:10px}
  .pc-rows{display:grid;gap:6px;align-content:start;min-height:220px}
  .pc-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;padding:9px 11px;border-radius:12px;background:rgba(255,255,255,.025);box-shadow:inset 0 0 0 1px rgba(255,255,255,.05);animation:pcin .55s var(--ease) both}
  .pc-row b{display:block;font-weight:500;font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pc-row small{display:block;font-family:var(--mono);font-size:10px;color:var(--tx3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pc-st{font-family:var(--mono);font-size:10px;padding:3px 8px;border-radius:999px;white-space:nowrap}
  .pc-st.ok{color:var(--ok);background:rgba(75,227,154,.1);box-shadow:inset 0 0 0 1px rgba(75,227,154,.3)}
  .pc-st.run{color:var(--sl);background:rgba(0,200,255,.1);box-shadow:inset 0 0 0 1px rgba(0,200,255,.3)}
  .pc-st.wait{color:var(--warn);background:rgba(255,184,77,.1);box-shadow:inset 0 0 0 1px rgba(255,184,77,.3)}
  @keyframes pcin{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
  .pc-chart{padding:12px;border-radius:14px;background:rgba(255,255,255,.025);box-shadow:inset 0 0 0 1px rgba(255,255,255,.05);display:flex;flex-direction:column}
  .pc-chart small{font-family:var(--mono);font-size:10px;color:var(--tx3)}
  .pc-bars{flex:1;display:flex;align-items:flex-end;gap:6px;margin-top:10px;min-height:150px}
  .pc-bars i{flex:1;height:8%;border-radius:6px 6px 3px 3px;background:linear-gradient(180deg,var(--s),var(--p));box-shadow:0 0 14px -4px rgba(0,200,255,.7);transition:height 1s var(--ease)}
  .pc-bars i:last-child{background:linear-gradient(180deg,#9FF0FF,var(--s))}

  .pc-phone{position:relative;width:230px;aspect-ratio:9/19;border-radius:38px;padding:10px;background:linear-gradient(160deg,#2a3444,#0d121b);box-shadow:inset 0 0 0 1px rgba(255,255,255,.14),0 50px 100px -40px rgba(0,90,255,.7);transform:translateY(24px) rotate(2deg)}
  .pc-notch{position:absolute;top:16px;left:50%;transform:translateX(-50%);width:70px;height:20px;border-radius:999px;background:#05080d;z-index:2}
  .pc-pscreen{position:relative;height:100%;border-radius:30px;overflow:hidden;padding:44px 12px 12px;background:radial-gradient(circle at 30% 0%,rgba(0,123,255,.45),transparent 60%),#0A0F1A}
  .pc-time{position:absolute;top:14px;left:22px;font-family:var(--mono);font-size:10px;color:var(--tx2)}
  .pc-push{display:grid;gap:2px;padding:11px 12px;border-radius:16px;background:rgba(255,255,255,.1);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:inset 0 0 0 1px rgba(255,255,255,.14);transition:transform .5s var(--ease),opacity .5s}
  .pc-push.hide{transform:translateY(-120%);opacity:0}
  .pc-push b{font-family:var(--mono);font-weight:400;font-size:9.5px;color:var(--sl)}
  .pc-push strong{font-size:12.5px}
  .pc-push span{font-size:11px;color:var(--tx2);line-height:1.35}
  .pc-prows{display:grid;grid-template-columns:minmax(0,1fr);gap:6px;margin-top:12px}
  .pc-prow{display:flex;justify-content:space-between;gap:6px;align-items:center;padding:9px 10px;border-radius:12px;background:rgba(255,255,255,.04);box-shadow:inset 0 0 0 1px rgba(255,255,255,.06);font-size:11px;animation:pcin .55s var(--ease) both}
  .pc-prow span:first-child{flex:1 1 auto;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pc-prow span:last-child{flex:none}
  .pc-push strong,.pc-push span{overflow-wrap:anywhere}
  .pc-note{font-family:var(--mono);font-size:11px;color:var(--tx3);margin:34px 0 0;text-align:center}

  @media(max-width:980px){.pc-stage{grid-template-columns:minmax(0,1fr) 190px}.pc-phone{width:190px}.pc-split{grid-template-columns:minmax(0,1fr)}.pc-chart{display:none}}
  @media(max-width:700px){
    .pc-head{flex-direction:column;align-items:flex-start;gap:8px}.pc-side{text-align:left}
    .pc-stage{grid-template-columns:minmax(0,1fr)}
    .pc-phone{position:absolute;right:-6px;bottom:-40px;width:128px;border-radius:24px;padding:6px;transform:rotate(4deg)}
    .pc-pscreen{border-radius:19px;padding:30px 7px 7px}.pc-notch{top:10px;width:44px;height:12px}.pc-time{top:8px;left:14px;font-size:8px}
    .pc-push{padding:7px 8px;border-radius:11px}.pc-push strong{font-size:10px}.pc-push span{font-size:9px}.pc-prows{display:none}
    .pc-body{grid-template-columns:minmax(0,1fr)}.pc-nav{display:none}.pc-kpis b{font-size:18px}.pc-kpis div{padding:9px}
    .pc-main{padding:10px 10px 60px}.pc-rows{min-height:200px}
    .pc-note{margin-top:56px}
  }
  @media (prefers-reduced-motion:reduce){.pc-demo *{animation:none!important;transition:none!important}}
</style>

<script is:inline>
(function(){
  document.querySelectorAll('[data-demo]').forEach(function(root){
    var R=JSON.parse(root.querySelector('[data-demo-json]').textContent);
    var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
    var rows=root.querySelector('[data-rows]'),prows=root.querySelector('[data-prows]'),bars=[].slice.call(root.querySelectorAll('[data-bars] i'));
    var push=root.querySelector('[data-push]'),pt=root.querySelector('[data-pt]'),ps=root.querySelector('[data-ps]'),app=root.querySelector('[data-app]');
    var kl=[].slice.call(root.querySelectorAll('[data-kl]')),kv=[].slice.call(root.querySelectorAll('[data-kv]'));
    var cur=R[0],k=0,vals=[0,0,0],timer=0,vis=false;
    function el(tag,cls,html){var e=document.createElement(tag);if(cls)e.className=cls;if(html!=null)e.textContent=html;return e}
    function row(ev){var r=el('div','pc-row'),d=el('div');d.appendChild(el('b',null,ev[0]));d.appendChild(el('small',null,ev[1]));r.appendChild(d);r.appendChild(el('span','pc-st '+ev[2],ev[3]));return r}
    function prow(ev){var r=el('div','pc-prow');r.appendChild(el('span',null,ev[0]));r.appendChild(el('span','pc-st '+ev[2],ev[3]));return r}
    function setK(i,v){vals[i]=v;kv[i].textContent=v+(cur.unit[i]||'');kv[i].classList.remove('bump');void kv[i].offsetWidth;kv[i].classList.add('bump');setTimeout(function(){kv[i].classList.remove('bump')},500)}
    function load(r){
      cur=r;k=0;rows.innerHTML='';prows.innerHTML='';app.textContent='panel · '+r.app.toLowerCase();
      kl.forEach(function(e,i){e.textContent=r.kpis[i]});
      vals=[8+Math.round(Math.random()*10),4+Math.round(Math.random()*6),20+Math.round(Math.random()*30)];vals.forEach(function(v,i){kv[i].textContent=v+(r.unit[i]||'')});
      bars.forEach(function(b){b.style.height=(25+Math.random()*60)+'%'});
      pt.textContent=r.push[0];ps.textContent=r.push[1];
      for(var i=0;i<3;i++)tick(true);
    }
    function tick(silent){
      var ev=cur.ev[k%cur.ev.length];k++;
      rows.insertBefore(row(ev),rows.firstChild);while(rows.children.length>(innerWidth<700?4:5))rows.removeChild(rows.lastChild);
      prows.insertBefore(prow(ev),prows.firstChild);while(prows.children.length>4)prows.removeChild(prows.lastChild);
      if(silent)return;
      var i=k%3;setK(i,vals[i]+1+Math.round(Math.random()*2));
      var b=bars[bars.length-1];b.style.height=Math.min(96,parseFloat(b.style.height)+4)+'%';
      if(k%3===0){push.classList.add('hide');setTimeout(function(){pt.textContent=cur.push[0];ps.textContent=ev[0];push.classList.remove('hide')},500)}
    }
    function run(){clearInterval(timer);if(reduce)return;timer=setInterval(function(){if(vis&&!document.hidden)tick()},1900)}
    root.querySelectorAll('.pc-tabs button').forEach(function(b){b.addEventListener('click',function(){
      root.querySelectorAll('.pc-tabs button').forEach(function(x){x.classList.toggle('on',x===b);x.setAttribute('aria-selected',x===b?'true':'false')});
      load(R.filter(function(r){return r.id===b.dataset.r})[0]);run();
    })});
    load(R[0]);
    if('IntersectionObserver' in window)new IntersectionObserver(function(e){vis=e[0].isIntersecting},{threshold:.2}).observe(root);else vis=true;
    run();
  });
})();
</script>
