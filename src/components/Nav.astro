---
// Barra superior del sitio en formato premium (pill de vidrio, igual que la Academy).
// Cada link lleva directo a su página real, sin contenido duplicado (pedido de Andrés, 17/09).
const navLinks = [
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/experiencia', label: 'Nuestra experiencia' },
  { href: '/academy', label: 'Genideia Academy' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/empresa', label: 'Agendá tu diagnóstico' },
];
const here = Astro.url.pathname.replace(/\/$/, '');
---

<header class="px-top">
  <a class="px-brand" href="/">
    <img src="/img/symbol-gii.png" alt="" width="38" height="38" />
    <span><b>GENIDEIA <em>COMPANY</em></b><small>Sistemas y automatización</small></span>
  </a>
  <nav class="px-links" aria-label="Secciones">
    {navLinks.map((l) => <a href={l.href} aria-current={here && l.href === here ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  <a class="px-btn p sm" href="https://wa.me/59892302941" target="_blank" rel="noopener noreferrer">Hablemos</a>
  <button class="px-burger" id="px-burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="px-menu"><span></span><span></span><span></span></button>
</header>
<nav class="px-menu" id="px-menu" aria-label="Menú">
  {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
  <a href="https://www.instagram.com/genideiacompany.ai" target="_blank" rel="noopener noreferrer">Instagram · @genideiacompany.ai</a>
</nav>
