---
const navLinks = [
  { href: '/feed', label: 'El Feed' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#herramientas', label: 'Herramientas' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/#diagnostico', label: 'Diagnóstico' },
];
---

<header
  style="background:rgba(10,10,10,0.92); border-bottom:1px solid rgba(255,255,255,0.07);"
  class="sticky top-0 z-50 backdrop-blur"
>
  <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 flex-shrink-0">
      <img src="/logo-wsp.jpg" alt="GENIDEIA IA" width="30" height="30"
        style="border-radius:6px; object-fit:cover;" />
      <span style="font-family:'Cormorant Garamond',serif; font-size:1.05rem; font-weight:600; color:#e8e8e8; letter-spacing:1.5px;">
        GENIDEIA <span style="color:#4ab8ff;">IA</span>
      </span>
    </a>

    <!-- Desktop: links principales -->
    <ul class="hidden lg:flex items-center gap-5 text-sm flex-1 justify-center">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            style="color:#a0a0a0; font-weight:300; font-size:0.82rem; letter-spacing:0.2px;"
            class="hover:text-[#4ab8ff] transition-colors whitespace-nowrap"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop: redes + CTA -->
    <div class="hidden lg:flex items-center gap-3 flex-shrink-0">
      <!-- Social icons -->
      <div class="flex items-center gap-1.5">
        <a href="https://instagram.com/andres.albornoz" target="_blank" rel="noopener noreferrer"
          style="color:#a0a0a0;" class="hover:text-[#4ab8ff] transition-colors p-1.5" aria-label="Instagram">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a href="https://linkedin.com/in/andres-marquez" target="_blank" rel="noopener noreferrer"
          style="color:#a0a0a0;" class="hover:text-[#4ab8ff] transition-colors p-1.5" aria-label="LinkedIn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <a href="https://youtube.com/@GenideiaIA" target="_blank" rel="noopener noreferrer"
          style="color:#a0a0a0;" class="hover:text-[#4ab8ff] transition-colors p-1.5" aria-label="YouTube">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.4 19.54C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
            <polygon points="9.75,15.02 15.5,12 9.75,8.98" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a href="mailto:genideiaconsultoraia@gmail.com"
          style="color:#a0a0a0;" class="hover:text-[#4ab8ff] transition-colors p-1.5" aria-label="Email">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-10 7L2 7"/>
          </svg>
        </a>
      </div>

      <!-- Divider -->
      <div style="width:1px; height:18px; background:rgba(255,255,255,0.1);"></div>

      <!-- CTA -->
      <a
        href="https://wa.me/59892302941"
        target="_blank"
        rel="noopener noreferrer"
        style="background:#4ab8ff; color:#0a0a0a; font-weight:600; font-size:0.78rem; letter-spacing:0.3px;"
        class="px-4 py-2 rounded-lg hover:opacity-90 transition-opacity whitespace-nowrap"
      >
        Hablemos
      </a>
    </div>

    <!-- Mobile: CTA + hamburger -->
    <div class="flex lg:hidden items-center gap-3">
      <a
        href="https://wa.me/59892302941"
        target="_blank"
        rel="noopener noreferrer"
        style="background:#4ab8ff; color:#0a0a0a; font-weight:600; font-size:0.78rem;"
        class="px-3.5 py-2 rounded-lg hover:opacity-90 transition-opacity"
      >
        Hablemos
      </a>
      <button
        id="nav-toggle"
        class="flex flex-col justify-center gap-[5px] w-8 h-8 p-1"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <span class="ham-line"></span>
        <span class="ham-line"></span>
        <span class="ham-line"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="nav-mobile"
    style="border-top:1px solid rgba(255,255,255,0.07); background:rgba(10,10,10,0.98);"
    class="lg:hidden hidden"
  >
    <div class="max-w-5xl mx-auto px-6 py-5">
      <ul class="flex flex-col gap-4 mb-6">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              style="color:#a0a0a0; font-weight:300; font-size:1rem;"
              class="nav-mobile-link block hover:text-[#4ab8ff] transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <!-- Redes en mobile menu -->
      <div style="border-top:1px solid rgba(255,255,255,0.07);" class="pt-5 flex items-center gap-4">
        <a href="https://instagram.com/andres.albornoz" target="_blank" rel="noopener noreferrer"
          style="color:#a0a0a0;" class="hover:text-[#4ab8ff] transition-colors" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a href="https://linkedin.com/in/andres-marquez" target="_blank" rel="noopener noreferrer"
          style="color:#a0a0a0;" class="hover:text-[#4ab8ff] transition-colors" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <a href="https://youtube.com/@GenideiaIA" target="_blank" rel="noopener noreferrer"
          style="color:#a0a0a0;" class="hover:text-[#4ab8ff] transition-colors" aria-label="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.4 19.54C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
            <polygon points="9.75,15.02 15.5,12 9.75,8.98" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a href="mailto:genideiaconsultoraia@gmail.com"
          style="color:#a0a0a0;" class="hover:text-[#4ab8ff] transition-colors" aria-label="Email">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-10 7L2 7"/>
          </svg>
        </a>
        <span style="color:rgba(160,160,160,0.4); font-size:0.75rem; font-weight:300;">
          genideiaconsultoraia@gmail.com
        </span>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('nav-mobile');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    toggle.classList.toggle('is-open', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('.nav-mobile-link').forEach(a => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
