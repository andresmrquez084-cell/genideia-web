---
// Portfolio real integrado inline (no como destino aparte) — prueba de ecosistema,
// no casos de automatización con resultado (ver /casos para esos ejemplos).
import { clientes } from '../data/clientes';
---

<div>
  <p class="text-center mb-8" style="color:rgba(160,160,160,0.5); font-size:0.65rem; letter-spacing:3px; font-weight:500;" data-reveal>
    PROYECTOS QUE YA CONSTRUIMOS
  </p>
  <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6" data-reveal data-delay="1">
    {clientes.map((c) => (
      <a href={c.url} target="_blank" rel="noopener noreferrer" class="text-center" style="opacity:0.7;">
        <span style="font-family:'Montserrat',sans-serif; font-size:1.15rem; font-weight:600; color:#F2F4F7; letter-spacing:0.5px; display:block; line-height:1.1;">{c.nombre}</span>
        <span style="color:#B8BEC7; font-size:0.58rem; letter-spacing:1.5px; font-weight:400;" class="uppercase">{c.rubro}</span>
      </a>
    ))}
  </div>
</div>
