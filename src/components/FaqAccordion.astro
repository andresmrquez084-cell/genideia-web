---
interface Item {
  pregunta: string;
  respuesta: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="space-y-3 max-w-3xl mx-auto">
  {items.map((item) => (
    <details
      class="group rounded-xl px-6 py-5"
      style="background:#111111; border:1px solid rgba(255,255,255,0.07);"
    >
      <summary
        style="color:#F2F4F7; font-weight:500;"
        class="cursor-pointer list-none flex items-center justify-between gap-4 text-base"
      >
        {item.pregunta}
        <span style="color:#00C8FF;" class="flex-shrink-0 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
      </summary>
      <p style="color:#B8BEC7; font-weight:300;" class="text-sm leading-relaxed mt-4">
        {item.respuesta}
      </p>
    </details>
  ))}
</div>
