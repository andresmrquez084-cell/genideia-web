---
// Página standalone de UN solo video del embudo de Andrés (sin cascada/gating).
// Para cuando ya se habló con el prospecto y se le manda el link del video puntual
// que necesita ver, en vez del recorrido completo en /andres.
// Reusa el mismo look & feel que /andres pero cada instancia es independiente:
// el CTA a Calendly queda visible siempre (no se desbloquea con el video anterior).
import fs from 'node:fs';
import Loader from '../transitions/Loader.astro';
import '../transitions/transitions.css';
import '../styles/global.css';

export interface Props {
  num: string;
  eyebrow: string;
  titulo: string;
  bajada: string;
  video: string;
  fallback?: string;
  coverHint: string;
  endTitle: string;
  pageTitle: string;
  pageDescription: string;
  noVideoSlot?: boolean;
}

const { num, eyebrow, titulo, bajada, video, fallback, coverHint, endTitle, pageTitle, pageDescription, noVideoSlot } = Astro.props;

const publicDir = new URL('../../public', import.meta.url);
const existeArchivo = (ruta: string) => fs.existsSync(new URL(`.${ruta}`, `${publicDir}/`));
const src = existeArchivo(video) ? video : (fallback && existeArchivo(fallback) ? fallback : '');

const WA = '59892302941';
const waMsg = encodeURIComponent('Hola Andrés, vi tu presentación y quiero coordinar un diagnóstico para mi empresa.');
const waUrl = `https://wa.me/${WA}?text=${waMsg}`;
const CALENDLY = 'https://calendly.com/genideiaconsultoraia/llamada-de-diagnostico';
const calendlyEmbed = `${CALENDLY}?hide_gdpr_banner=1&background_color=0b1324&text_color=f2f4f7&primary_color=00c8ff`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://genideiacompany.com/og-genideia.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://genideiacompany.com/og-genideia.png" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script>import '../transitions/reveal.js';</script>
</head>
<body style="background:#07080D radial-gradient(ellipse 90% 55% at 50% -8%, rgba(0,200,255,0.10), transparent 62%) no-repeat fixed; color:#F2F4F7; font-family:'Poppins',sans-serif; -webkit-font-smoothing:antialiased;">
  <Loader logoSrc="/img/logo-nav.png" />

  <!-- ── HEADER ──────────────────────────────────────────────── -->
  <header style="background:rgba(10,10,10,0.92); border-bottom:1px solid rgba(255,255,255,0.07);" class="sticky top-0 z-50 backdrop-blur">
    <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
      <a href="/andres" class="flex items-baseline gap-2">
        <span style="font-family:'Montserrat',sans-serif; font-size:1.15rem; font-weight:600; color:#F2F4F7; letter-spacing:0.5px;">Andrés Albornoz</span>
        <span style="color:#00C8FF; font-size:0.6rem; letter-spacing:2px;" class="uppercase hidden sm:inline">Soluciones operativas</span>
      </a>
      <a href={waUrl} target="_blank" rel="noopener noreferrer" style="background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:600; font-size:0.78rem;" class="px-4 py-2 rounded-lg hover:opacity-90 transition-opacity">Hablemos</a>
    </nav>
  </header>

  <!-- ── BLOQUE ÚNICO ──────────────────────────────────────── -->
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-16">
    <div class="text-center mb-9" data-reveal>
      <p class="paso-eyebrow">{num} · {eyebrow}</p>
      <h1 class="paso-titulo">{titulo}</h1>
      <p class="paso-bajada">{bajada}</p>
    </div>

    {noVideoSlot ? null : src ? (
      <div class="video-main-wrap" data-video-wrap data-reveal>
        <video id="vid-standalone" controls playsinline preload="metadata" style="width:100%; height:100%; object-fit:contain; display:block; background:#0B1324;">
          <source src={src} type="video/mp4" />
          Tu navegador no soporta el video.
        </video>
        <button type="button" class="video-cover" data-video-cover aria-label="Reproducir video">
          <span class="play-btn"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          <span class="cover-hint">{coverHint}</span>
        </button>
        <div class="video-end" data-video-end>
          <p class="video-end-title">{endTitle}</p>
          <a href="#agenda" class="video-end-btn">Agendá tu diagnóstico →</a>
        </div>
      </div>
    ) : (
      <div class="video-pendiente" data-reveal>Video en producción</div>
    )}

    <!-- Contenido específico del bloque (pasos, tarjetas, ejemplos) -->
    <div class="mt-10">
      <slot />
    </div>
  </section>

  <!-- ── AGENDÁ (Calendly) — siempre visible, sin gate ────────── -->
  <section id="agenda" style="background:#0B1324; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);" class="py-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10" data-reveal>
        <p style="color:#00C8FF; font-size:0.7rem; letter-spacing:3px; font-weight:500;" class="uppercase mb-4">El siguiente paso</p>
        <h2 style="font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.5px; font-size:clamp(2rem, 5vw, 3.2rem);">Agendá tu diagnóstico inicial.</h2>
      </div>
      <div id="calendly-box" class="calendly-inline-widget" data-url={calendlyEmbed} style="min-width:320px; height:700px; border-radius:14px; overflow:hidden; border:1px solid rgba(0,200,255,0.2);" data-reveal></div>
      <p class="text-center mt-6 text-sm" style="color:#B8BEC7; font-weight:300;" data-reveal>
        ¿Preferís escribir? <a href={waUrl} target="_blank" rel="noopener noreferrer" style="color:#00C8FF; text-decoration:underline;">Hablemos por WhatsApp →</a>
      </p>
    </div>
  </section>

  <!-- ── FOOTER ────────────────────────────────────────────── -->
  <footer style="border-top:1px solid rgba(255,255,255,0.07);" class="py-10">
    <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm" style="color:#B8BEC7;">
      <div>
        <p style="font-family:'Montserrat',sans-serif; font-size:1.05rem; color:#F2F4F7;">Andrés Albornoz</p>
        <p style="font-weight:300; font-size:0.8rem;">Cofundador de <a href="/" style="color:#00C8FF;">GENIDEIA Company</a> · Soluciones operativas</p>
      </div>
      <div class="flex flex-col sm:items-end gap-1">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" style="font-weight:300;" class="hover:text-[#00C8FF] transition-colors">WhatsApp +598 92 302 941</a>
        <a href="mailto:andres@genideiacompany.com" style="font-weight:300;" class="hover:text-[#00C8FF] transition-colors">andres@genideiacompany.com</a>
      </div>
    </div>
  </footer>

  <script src="https://assets.calendly.com/assets/external/widget.js" async is:inline></script>

  <script define:vars={{ calendlyEmbed }}>
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => obs.observe(el));

    document.querySelectorAll('[data-video-wrap]').forEach((wrap) => {
      const v = wrap.querySelector('video');
      const cover = wrap.querySelector('[data-video-cover]');
      if (!v || !cover) return;
      cover.addEventListener('click', () => { v.play(); });
      v.addEventListener('play', () => wrap.classList.add('playing'));
      v.addEventListener('ended', () => wrap.classList.add('ended'));
      v.addEventListener('timeupdate', () => { if (v.duration && v.currentTime / v.duration > 0.99) wrap.classList.add('ended'); });
    });

    // El widget de Calendly no renderiza dentro de contenedores recién revelados por scroll → init directo.
    function initCalendly() {
      const box = document.getElementById('calendly-box');
      if (box && window.Calendly && !box.dataset.ready) {
        box.dataset.ready = '1';
        box.innerHTML = '';
        window.Calendly.initInlineWidget({ url: calendlyEmbed, parentElement: box });
      }
    }
    window.addEventListener('load', () => setTimeout(initCalendly, 300));
  </script>

  <style>
    .hero-glow { animation: heroGlowPulse 5s ease-in-out infinite; }
    @keyframes heroGlowPulse { 0%,100% { opacity:0.55; transform:scale(1); } 50% { opacity:1; transform:scale(1.08); } }

    .video-main-wrap { position:relative; width:100%; aspect-ratio:16/9; border-radius:18px; overflow:hidden; border:1px solid rgba(0,200,255,0.25); background:#0B1324; box-shadow:0 12px 60px rgba(0,200,255,0.12); }

    .video-cover { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; cursor:pointer; border:none; background:linear-gradient(180deg, rgba(7,8,13,0.30) 0%, rgba(7,8,13,0.60) 100%); transition:opacity .3s; }
    .video-main-wrap.playing .video-cover { opacity:0; pointer-events:none; }
    .play-btn { width:76px; height:76px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#0A0F1A; background:linear-gradient(135deg,#00C8FF,#007BFF); box-shadow:0 0 0 0 rgba(0,200,255,0.5); animation:playPulse 2.2s ease-in-out infinite; }
    @keyframes playPulse { 0%{ box-shadow:0 0 0 0 rgba(0,200,255,0.45);} 70%{ box-shadow:0 0 0 22px rgba(0,200,255,0);} 100%{ box-shadow:0 0 0 0 rgba(0,200,255,0);} }
    .cover-hint { font-family:'Montserrat',sans-serif; font-weight:600; font-size:1.15rem; line-height:1.25; color:#F2F4F7; text-align:center; text-shadow:0 2px 12px rgba(0,0,0,0.6); }

    .video-end { position:absolute; inset:0; z-index:5; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; padding:24px; text-align:center; background:linear-gradient(180deg, rgba(7,8,13,0.94), rgba(11,19,36,0.97)); opacity:0; pointer-events:none; transition:opacity .5s ease; }
    .video-main-wrap.ended .video-end { opacity:1; pointer-events:auto; }
    .video-end-title { font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(1.15rem, 2.6vw, 1.7rem); line-height:1.2; color:#F2F4F7; max-width:20ch; }
    .video-end-btn { background:linear-gradient(135deg,#00C8FF,#007BFF); color:#0A0F1A; font-weight:700; padding:0.95rem 2.2rem; border-radius:12px; font-size:clamp(1rem,2vw,1.15rem); animation:ctaGlow 2s ease-in-out infinite; }
    @keyframes ctaGlow { 0%,100%{ box-shadow:0 0 0 0 rgba(0,200,255,0); } 50%{ box-shadow:0 0 30px 3px rgba(0,200,255,0.5); } }

    .paso-eyebrow { color:#00C8FF; font-size:0.7rem; letter-spacing:3px; font-weight:500; text-transform:uppercase; margin-bottom:0.9rem; }
    .paso-titulo { font-family:'Montserrat',sans-serif; font-weight:700; letter-spacing:-0.6px; line-height:1.15; font-size:clamp(1.7rem, 4.4vw, 2.9rem); margin-bottom:0.9rem; }
    .paso-bajada { color:#B8BEC7; font-weight:300; line-height:1.65; max-width:56ch; margin:0 auto; }

    .video-pendiente { border:1px dashed rgba(0,200,255,0.3); border-radius:18px; padding:2.6rem 1.5rem; text-align:center; color:rgba(184,190,199,0.7); font-size:0.85rem; font-weight:300; letter-spacing:0.5px; }

    .anecdota { max-width:44ch; margin:2.5rem auto 0; text-align:center; }
    .anecdota-cita { font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(1.35rem,3.4vw,2.1rem); line-height:1.25; color:#F2F4F7; margin-bottom:1rem; }
    .anecdota-pie { color:#B8BEC7; font-weight:300; font-size:0.95rem; line-height:1.65; }
    .parrafo-arg { max-width:56ch; margin:1.8rem auto 0; text-align:center; color:#B8BEC7; font-weight:300; line-height:1.7; }
    .parrafo-giro { color:#D7DBE1; }

    .creencia-card { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-left:2px solid rgba(0,200,255,0.55); border-radius:14px; padding:1.5rem 1.6rem; }
    .pot-tipo { font-family:'Montserrat',sans-serif; font-weight:700; font-size:0.72rem; letter-spacing:2px; text-transform:uppercase; color:#00C8FF; margin-bottom:0.85rem; }
    .pot-hoy { color:#F2F4F7; font-weight:500; font-size:0.95rem; line-height:1.55; margin-bottom:0.7rem; }
    .pot-real { color:#B8BEC7; font-weight:300; font-size:0.92rem; line-height:1.65; padding-top:0.7rem; border-top:1px solid rgba(255,255,255,0.07); }

    .metodo-card { display:flex; gap:1rem; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:1.4rem 1.5rem; }
    .metodo-num { font-family:'Montserrat',sans-serif; font-weight:700; font-size:1.5rem; line-height:1; color:rgba(0,200,255,0.55); flex-shrink:0; }
    .metodo-titulo { font-family:'Montserrat',sans-serif; font-weight:600; font-size:1rem; color:#F2F4F7; margin-bottom:0.4rem; }
    .metodo-desc { color:#B8BEC7; font-weight:300; font-size:0.92rem; line-height:1.6; }

    .ejemplo-card { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:1.3rem 1.4rem; transition:border-color .25s, transform .25s; }
    .ejemplo-card:hover { border-color:rgba(0,200,255,0.4); transform:translateY(-3px); }
    .ejemplo-titulo { font-family:'Montserrat',sans-serif; font-weight:600; font-size:0.95rem; color:#F2F4F7; margin-bottom:0.45rem; line-height:1.3; }
    .ejemplo-desc { color:#B8BEC7; font-weight:300; font-size:0.86rem; line-height:1.55; }

    html { scroll-behavior: smooth; }

    @media (prefers-reduced-motion: reduce) { .hero-glow, .play-btn, .video-end-btn { animation:none; } }
  </style>
</body>
</html>
