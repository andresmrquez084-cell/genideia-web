---
import type { Problema } from '../data/soluciones';

interface Props {
  problema: Problema;
}

const { problema } = Astro.props;
---

<div
  class="card-hover rounded-xl p-7"
  style="background:#111111; border:1px solid rgba(255,255,255,0.07);"
  data-reveal
>
  <h3 style="font-family:'Montserrat',sans-serif; font-weight:600; color:#F2F4F7; font-size:1.15rem;" class="mb-4">
    {problema.titulo}
  </h3>
  <ul class="space-y-2.5">
    {problema.items.map((item) => (
      <li style="color:#B8BEC7; font-weight:300;" class="text-sm flex items-start gap-2.5">
        <span style="color:#00C8FF; flex-shrink:0; margin-top:2px;">→</span>
        {item}
      </li>
    ))}
  </ul>
</div>
