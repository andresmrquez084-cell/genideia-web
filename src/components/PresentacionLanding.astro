---
// Plantilla común de las landings de presentación (general y por rubro).
// Pregunta arriba, video (16:9 o vertical), Instagram de Andrés y de la marca, texto de contacto y WhatsApp.
// Cada rubro solo cambia la pregunta, el video y el mensaje inicial de WhatsApp (src/data/presentaciones.ts).
import Loader from '../transitions/Loader.astro';
import '../transitions/transitions.css';
import '../styles/global.css';
import '../styles/premium.css';

interface Props {
  pregunta: string;
  video: string;
  poster: string;
  titulo: string;
  descripcion: string;
  waTexto: string;
  vertical?: boolean;
}
const { pregunta, video, poster, titulo, descripcion, waTexto, vertical = false } = Astro.props;

const waUrl = 'https://wa.me/59892302941?text=' + encodeURIComponent(waTexto);
const perfiles = [
  {
    nombre: 'Andrés Albornoz',
    rol: 'Fundador',
    handle: '@andresalbornoz.ai',
    url: 'https://instagram.com/andresalbornoz.ai',
    foto: '/img/andres.jpg',
  },
  {
    nombre: 'GENIDEIA Company',
    rol: 'Sistemas y automatización',
    handle: '@genideiacompany.ai',
    url: 'https://www.instagram.com/genideiacompany.ai',
    foto: '/img/logo-genideia.png',
  },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <script is:inline>document.documentElement.classList.add('pxj')</script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <meta name="robots" content="noindex, nofollow" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://genideiacompany.com/og-genideia.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Poppins:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <meta name="theme-color" content="#0A0F1A" />
  <script>import '../transitions/reveal.js';</script>
</head>
<body class="px">
  <div class="px-amb" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
  <div class="px-grain" aria-hidden="true"></div>
  <Loader logoSrc="/img/logo-nav.png" />

  <header class="px-top">
    <a class="px-brand" href="/"><img src="/img/symbol-gii.png" alt="" width="38" height="38" /><span><b>GENIDEIA <em>COMPANY</em></b><small>Sistemas y automatización</small></span></a>
    <a class="px-btn p sm" style="margin-left:auto" href={waUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
  </header>

  <main class="max-w-3xl mx-auto px-6 pt-16 pb-20 text-center">
    <p class="px-eb">Presentación</p>
    <h1 class="px-split" style="font-weight:700; line-height:1.05; letter-spacing:-.04em; font-size:clamp(2.2rem, 6vw, 3.8rem); margin:0 0 2.5rem;">
      {pregunta}
    </h1>

    <!-- Video de presentación (animación con la voz de Andrés; 16:9 o vertical 9:16) -->
    <div data-reveal style={`${vertical ? 'aspect-ratio:9/16; max-width:min(380px, 100%); margin:0 auto;' : 'aspect-ratio:16/9;'} border-radius:26px; overflow:hidden; border:1px solid rgba(255,255,255,.1); background:#0B1324; box-shadow:0 50px 120px -40px rgba(0,90,255,.6);`}>
      <video controls playsinline preload="metadata" poster={poster} style="width:100%; height:100%; display:block; object-fit:cover;">
        <source src={video} type="video/mp4" />
      </video>
    </div>

    <div class="grid sm:grid-cols-2 gap-5 mt-14 text-left" data-reveal>
      {perfiles.map((p) => (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class="px-card px-spot flex items-center gap-5" style="padding:22px">
          <div style="flex-shrink:0; width:64px; height:64px; border-radius:50%; overflow:hidden; background:#0B1324; border:1px solid rgba(255,255,255,0.08);" class="flex items-center justify-center">
            <img src={p.foto} alt={p.nombre} style="width:100%; height:100%; object-fit:cover;" />
          </div>
          <div class="min-w-0">
            <p style="font-family:'Montserrat',sans-serif; font-weight:600; color:#F2F4F7;" class="leading-tight">{p.nombre}</p>
            <p style="color:#B8BEC7; font-size:0.7rem; font-weight:300;" class="mt-1">{p.rol}</p>
            <p style="color:#BFEFFF; font-family:'JetBrains Mono',monospace; font-size:0.75rem;" class="mt-1">Instagram {p.handle}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12" data-reveal>
      <p style="color:#B8BEC7; font-weight:300;" class="mb-5">Contáctame y coordinamos una reunión para detectar dónde se podría ahorrar tiempo en tu negocio.</p>
      <a href={waUrl} target="_blank" rel="noopener noreferrer" class="px-btn p">
        WhatsApp · +598 92 302 941
      </a>
    </div>
  </main>
  <script>import '../scripts/premium.js';</script>
</body>
</html>
