{
  "redirects": [
    {
      "source": "/crm",
      "destination": "/crm/",
      "permanent": true
    },
    {
      "source": "/experiencia",
      "destination": "/experiencia/",
      "permanent": true
    },
    {
      "source": "/empresa",
      "destination": "https://andres.genideiacompany.com/",
      "permanent": true
    },
    {
      "source": "/empresa/",
      "destination": "https://andres.genideiacompany.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "andres.genideiacompany.com"
        }
      ],
      "destination": "/andres",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "presentacion.genideiacompany.com"
        }
      ],
      "destination": "/presentacion",
      "permanent": false
    },
    {
      "source": "/:rubro((?!presentacion$)[a-z-]+)",
      "has": [
        {
          "type": "host",
          "value": "presentacion.genideiacompany.com"
        }
      ],
      "destination": "/presentacion/:rubro",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "links.hechoconelalma.shop"
        }
      ],
      "destination": "/hechoconelalma",
      "permanent": false
    }
  ],
  "rewrites": [],
  "headers": []
}
