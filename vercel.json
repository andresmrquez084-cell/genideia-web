{
  "redirects": [
    {
      "source": "/experiencia",
      "destination": "/experiencia/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "andres.genideiacompany.com" }],
      "destination": "/andres",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "tadeo.genideiacompany.com" }],
      "destination": "/tadeo",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/content-os",
      "destination": "https://content-os-navy-seven.vercel.app/content-os"
    },
    {
      "source": "/content-os/:path*",
      "destination": "https://content-os-navy-seven.vercel.app/content-os/:path*"
    },
    {
      "source": "^/content-os-(.*)$",
      "destination": "https://content-os-navy-seven.vercel.app/content-os-$1"
    },
    {
      "source": "/api/content-os/:path*",
      "destination": "https://content-os-navy-seven.vercel.app/api/content-os/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/content-os/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
